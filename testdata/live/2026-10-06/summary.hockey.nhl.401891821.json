ake Lizotte","shortName":"B. Lizotte"},"type":"shooter"},{"athlete":{"id":"3942459","displayName":"Dan Vladar","shortName":"D. Vladar"},"type":"saver"}]},{"id":"401891821000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Blake Lizotte Wrist Shot saved by Dan Vladar","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"4316983","displayName":"Blake Lizotte","shortName":"B. Lizotte"},"type":"shooter"},{"athlete":{"id":"3942459","displayName":"Dan Vladar","shortName":"D. Vladar"},"type":"saver"}]},{"id":"401891821000000990","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Kris Letang hit Porter Martone","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:09"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"3539","displayName":"Kris Letang","shortName":"K. Letang"},"type":"hit-credited"},{"athlete":{"id":"5291941","displayName":"Porter Martone","shortName":"P. Martone"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1845","fullName":"Xfinity Mobile Arena","address":{"city":"Philadelphia","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1845.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19902,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Malkin scores, Silovs stops 19 shots as Penguins pile on in 7-0 win over Flyers in teams' opener","description":"— Evgeni Malkin, Hendrix Lapierre and Filip Hallander scored in the second period and Arturs Silovs stopped 19 shots to help the Pittsburgh Penguins steamroll the Philadelphia Flyers 7-0 on Wednesday night.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697405/hendrix-lapierre\">Hendrix Lapierre</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4588331/filip-hallander\">Filip Hallander</a> scored in the second period and <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a> stopped 19 shots to help the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> steamroll the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 7-0 on Wednesday night.\n\n\r\n              Silovs posted his third career shutout in his 57th start. <a href=\"http://www.espn.com/nhl/player/_/id/4565275/nick-robertson\">Nick Robertson</a> scored two goals and <a href=\"http://www.espn.com/nhl/player/_/id/4874911/ville-koivunen\">Ville Koivunen</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4697404/egor-chinakhov\">Egor Chinakhov</a> also scored for the Penguins. <a href=\"https://apnews.com/article/pittsburgh-penguins-sidney-crosby-358b6d23abe5b1cbac8242800861ebfe\"><a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a></a> added an assist.\n\n\r\n              The Penguins’ season ended on the same Philadelphia ice in April when the Flyers won a first-round playoff series in six games.\n\n\r\n              The Flyers left the clincher to a roaring ovation on <a href=\"https://apnews.com/article/penguins-flyers-score-ot-0b51f7d4852b83219e485869f8dd471a\">Cam York’s winner</a>. Five months later, the Flyers were soundly booed off the ice – reaching a crescendo after the second period – and the opening night festivities were spoiled for a team trying to become a force in the Eastern Conference.\n\n\r\n              The Penguins are trying to run it back at least one more time between the longtime core of Crosby, Malkin and <a href=\"http://www.espn.com/nhl/player/_/id/3539/kris-letang\">Kris Letang</a>. <a href=\"https://apnews.com/article/evgeni-malkin-pittsburgh-penguins-a3e232b10903308666cfdd65be582740\">Malkin</a> signed a one-year deal to remain in Pittsburgh, and the hope is there’s enough magic left to help put the Penguins in position to win a playoff series for the first time in nearly a decade. \n\n\r\n              The 40-year-old Malkin ripped a one-timer from the slot early in the second period for the 3-0 lead that also gave him 100 career points against the Flyers. He became the sixth player with at least 100 points against the Flyers. Crosby's assist on Robertson's game-opening goal extended his record with 140 career points against Philly.\n\n\r\n              The Penguins scored five goals on their first 18 shots against <a href=\"http://www.espn.com/nhl/player/_/id/3942459/dan-vladar\">Dan Vladar</a>. Vladar didn't play a full period in the preseason as he battled an unspecified injury, and with the Flyers in the first game of a back-to-back set, he was left in the game to take the beating.\n\n\r\n              Vladar knocked Robertson's second goal of the game into the net with the back of his skate in a gaffe that made it 6-0.\n\n\r\n              <hl2>Up next</hl2>\r\n              Penguins play their home opener Saturday against Montreal.\n\n\r\n              Flyers play Thursday at New Jersey.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-01T02:17:39Z"}}