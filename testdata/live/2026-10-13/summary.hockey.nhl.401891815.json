"displayName":"Nikolaj Ehlers","shortName":"N. Ehlers"},"type":"hitted"}]},{"id":"401891815000000850","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jordan Staal hit Alexandre Carrier","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"3541","displayName":"Jordan Staal","shortName":"J. Staal"},"type":"hit-credited"},{"athlete":{"id":"3942064","displayName":"Alexandre Carrier","shortName":"A. Carrier"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Caleb Apperson","displayName":"Caleb Apperson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Taylor Hall scores 2 as Hurricanes beat Canadiens 6-4 in Montreal's home opener","description":"— Taylor Hall scored twice as the Carolina Hurricanes beat Montreal 6-4 in the Canadiens' home opener on Tuesday night.","story":"MONTREAL -- — <a href=\"http://www.espn.com/nhl/player/_/id/5428/taylor-hall\">Taylor Hall</a> scored twice as the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> beat Montreal 6-4 in the Canadiens' home opener on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> added a goal and two assists, while <a href=\"http://www.espn.com/nhl/player/_/id/4319879/eric-robinson\">Eric Robinson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2976849/mark-jankowski\">Mark Jankowski</a> had a goal and an assist each.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4352683/andrei-svechnikov\">Andrei Svechnikov</a> added an empty-net goal and <a href=\"http://www.espn.com/nhl/player/_/id/4996097/brandon-bussi\">Brandon Bussi</a> stopped 16 shots in the rematch of last season’s Eastern Conference final.\n\n\r\n              Zachary Bolduc scored twice, <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4915349/juraj-slafkovsky\">Juraj Slafkovsky</a> also scored for Montreal. <a href=\"http://www.espn.com/nhl/player/_/id/4233880/alexandre-texier\">Alexandre Texier</a> and Chris Krieder had two assists apiece, while <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a> made 28 saves.\n\n\r\n              The Canadiens returned to the Bell Centre for their first regular-season home game since falling to the Hurricanes in the third round. Carolina eliminated Montreal in five games before going on to win the Stanley Cup over the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a>.\n\n\r\n              The teams combined for five goals in the opening 13 minutes. Hall opened the scoring 2:25 into the first period, deflecting Jackson Blake’s shot after Slafkovsky turned the puck over in front of his own net.\n\n\r\n              Bolduc evened the score at 3:23, corralling a rebound and shoveling a backhand into the top corner. Suzuki put Montreal in front 64 seconds later with a snap shot over Bussi’s left shoulder, but Robinson tied it at 9:22 when Jalen Chatfield’s point shot deflected off him and past Dobes.\n\n\r\n              Bolduc gave the Canadiens a 3-2 lead at 12:54, scoring his second of the night on the power play.\n\n\r\n              The lead held until Aho, also with the man advantage, slid a shot through Dobes’ pads 3:56 into the second. Jankowski capitalized on Noah Dobson’s giveaway to give Carolina the lead at 13:24, then Hall made it 5-3 at 12:21 in the third.\n\n\r\n              Slafkovsky jumped on a rebound to pull one back with 3:04 remaining before Svechnikov’s empty-netter.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216860/ivan-demidov\">Ivan Demidov</a> missed the game after the Canadiens announced he would be sidelined two to four weeks with a lower-body injury. \n\n\r\n              <hl2>Up next</hl2>\r\n              Hurricanes: Host Vancouver on Thursday. \n\n\r\n              Canadiens: Host Nashville on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-07T02:28:26Z"}}