Igor Shesterkin","shortName":"I. Shesterkin"},"type":"saver"}]},{"id":"401892452000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892452000000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Bo Horvat faceoff won against J.T. Miller","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"3042002","displayName":"Bo Horvat","shortName":"B. Horvat"},"type":"face-off-winner"},{"athlete":{"id":"2590852","displayName":"J.T. Miller","shortName":"J.T. Miller"}}]}],"gameInfo":{"venue":{"id":"1830","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18006,"officials":[{"fullName":"Francis Charron","displayName":"Francis Charron","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Rehman","displayName":"Kyle Rehman","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ryan Jackson","displayName":"Ryan Jackson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Alexis Lafrenière has a hat trick as the Rangers beat the Islanders for their 4th win in a row","description":"— Alexis Lafrenière recorded a hat trick, with two goals into an empty net, and had an assist as the New York Rangers extended their winning streak to four by defeating the crosstown...","story":"NEW YORK -- — Alexis Lafrenière recorded a hat trick, with two goals into an empty net, and had an assist as <a href=\"https://apnews.com/f5bb8f81b9da4f9a53410eda41779628\">the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a></a> extended their winning streak to four by defeating the crosstown rival Islanders 5-2 on Tuesday night.\n\n\r\n              The Rangers are unbeaten since <a href=\"https://apnews.com/f1d4f273bc184a59be6e35ea7bbc9f2f\">getting shut out</a> in their opener a week ago at Boston. They're 3-0 at home, a year since losing their first seven games at Madison Square Garden last season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042095/oliver-bjorkstrand\">Oliver Bjorkstrand</a> scored twice, and <a href=\"http://www.espn.com/nhl/player/_/id/2562637/mika-zibanejad\">Mika Zibanejad</a> finished with three assists. <a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a> made 17 saves for the victory but had <a href=\"https://apnews.com/027b6115384ed713c16a5b15ef75755f\">his point streak</a> from an assist Sunday and <a href=\"https://apnews.com/article/igor-shesterkin-goalie-goal-3071a38443eb6b8d4410cf5966803d53\">his goalie goal</a> Thursday end at two.\n\n\r\n              The Rangers didn't get a shot until 6:40 in, but Bjorkstrand scored on it for his first goal with his new team. He and Lafrenière took advantage of the Islanders' <a href=\"http://www.espn.com/nhl/player/_/id/3759/semyon-varlamov\">Semyon Varlamov</a> showing some rust in his first game in 676 days.\n\n\r\n              Varlamov was playing in the NHL for the first time since Nov. 29, 2024, completing his comeback from undergoing double partial knee replacement surgeries. He allowed three goals on 22 shots.\n\n\r\n              Captain <a href=\"http://www.espn.com/nhl/player/_/id/3042002/bo-horvat\">Bo Horvat</a> and young forward <a href=\"http://www.espn.com/nhl/player/_/id/5149210/calum-ritchie\">Calum Ritchie</a> scored for the Islanders, while reigning rookie-of-the-year defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5291933/matthew-schaefer\">Matthew Schaefer</a> hit the post twice among his 12 shot attempts.\n\n\r\n              Islanders forward <a href=\"http://www.espn.com/nhl/player/_/id/4565244/simon-holmstrom\">Simon Holmstrom</a> took a puck to the face late in the first period off a clearing attempt by Rangers defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4378683/sean-durzi\">Sean Durzi</a>. Holmstrom returned in the second.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216892/cole-beaudoin\">Cole Beaudoin</a> made his NHL debut for the Rangers. The 20-year-old center, who was part of their return for <a href=\"https://apnews.com/article/nhl-free-agency-trades-2f80e7c072798844671d0d4017e226dc\">trading <a href=\"http://www.espn.com/nhl/player/_/id/2563036/vincent-trocheck\">Vincent Trocheck</a> to Utah</a> on July 1, was called up from the minors after <a href=\"http://www.espn.com/nhl/player/_/id/4352804/joe-veleno\">Joe Veleno</a> was injured against the Mammoth on Sunday.\n\n\r\n              <hl2>Up next</hl2>\r\n              Islanders: Host the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> on Thursday night.\n\n\r\n              Rangers: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> on Friday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-07T08:33:39Z"}}