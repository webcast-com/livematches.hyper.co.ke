layValue":"1:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"},"type":"face-off-winner"},{"athlete":{"id":"3114722","displayName":"Sam Reinhart","shortName":"S. Reinhart"}}]},{"id":"401892551000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:27"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892551000000780","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Anton Lundell faceoff won against Dylan Cozens","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:27"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"4697395","displayName":"Anton Lundell","shortName":"A. Lundell"},"type":"face-off-winner"},{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"}}]},{"id":"401892551000000920","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Warren Foegele hit Aaron Ekblad","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:43"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"3151036","displayName":"Warren Foegele","shortName":"W. Foegele"},"type":"hit-credited"},{"athlete":{"id":"3114717","displayName":"Aaron Ekblad","shortName":"A. Ekblad"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1832","fullName":"Canadian Tire Centre","address":{"city":"Ottawa","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1832.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17010,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Senators beat Panthers 5-1 as Brady Tkachuk scores in return to Ottawa but gets hostile reception","description":"— With fans chanting “We don’t need you!,” the Ottawa Senators defeated Brady Tkachuk and his Florida Panthers 5-1 on Wednesday night.","story":"OTTAWA, Ontario -- — With fans chanting “We don’t need you!,” the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> defeated <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> and his <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> 5-1 on Wednesday night.\n\n\r\n              Tkachuk, who spent eight seasons in Ottawa, including five as captain, was given a <a href=\"https://apnews.com/article/brady-tkachuk-ottawa-senators-florida-panthers-ec91adf946168566eed21a4ff8c6a85a\">hostile reception in his return.</a> He was booed regularly and the crowd aimed derisive chants at him throughout the evening. \n\n\r\n              A number of fans even threw Tkachuk jerseys on the ice.\n\n\r\n              The Senators (7-3-0) lost goaltender <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> to an apparent injury early in the third period. Ullmark, who allowed one goal on 18 shots, made a pad save on Tkachuk and then needed assistance getting off the ice.\n\n\r\n              Sam Ersson faced one shot in relief.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697384/tim-stutzle\">Tim Stutzle</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3775/claude-giroux\">Claude Giroux</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4565255/shane-pinto\">Shane Pinto</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3151036/warren-foegele\">Warren Foegele</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5136706/stephen-halliday\">Stephen Halliday</a> scored for Ottawa.\n\n\r\n              Tkachuk scored the lone goal for the Panthers (5-3-2), who had won three straight. <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a> made 25 saves.\n\n\r\n              Emotions boiled over in the third. Tkachuk, his brother Matthew and their Panthers teammate <a href=\"http://www.espn.com/nhl/player/_/id/3114732/sam-bennett\">Sam Bennett</a> got into it with Senators players in front of Ottawa’s bench. Brady Tkachuk got into a heated exchange with Senators center <a href=\"http://www.espn.com/nhl/player/_/id/4565228/dylan-cozens\">Dylan Cozens</a>.\n\n\r\n              Earlier in the period, Bennett fought Ottawa forward <a href=\"http://www.espn.com/nhl/player/_/id/4697411/ridly-greig\">Ridly Greig</a>.\n\n\r\n              Foegele gave the Senators a 4-1 lead by finishing off a great feed from Cozens at the eight-minute mark of the third. Halliday made it 5-1 when he scored off Stutzle's drop pass.\n\n\r\n              The Senators scored twice in the second. Giroux scored his second goal of the season through traffic from the top of the slot midway through the period.\n\n\r\n              Pinto made it 3-1 at 17:18.\n\n\r\n              Despite the hostile environment, Tkachuk seemed unfazed and opened the scoring with a power-play goal midway through the first period on a feed from his brother.\n\n\r\n              Stutzle tied the game just more than four minutes later with a one-timer off a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4697386/jake-sanderson\">Jake Sanderson</a>.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Play at Pittsburgh on Thursday.\n\n\r\n              Senators: Host the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-22T03:14:20Z"}}