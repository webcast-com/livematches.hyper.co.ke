scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Adam Edstrom","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"2:56"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"27"},"participants":[{"athlete":{"id":"4894222","displayName":"Adam Edstrom","shortName":"A. Edstrom"},"type":"taker"}]}],"gameInfo":{"venue":{"id":"1824","guid":"58cac4d0-a208-3028-b2a6-ff7aba657bc3","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shawn Oliver","displayName":"Shawn Oliver","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Michael DiPietro has first career shutout, David Pastrnak scores 2 as Bruins beat Predators 6-0","description":"— Michael DiPietro made 28 saves for his first career shutout, David Pastrnak had two goals and two assists, and the Boston Bruins cruised to a 6-0 victory over the Nashville Predators on Thursday night.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/4392765/michael-dipietro\">Michael DiPietro</a> made 28 saves for his first career shutout, <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> had two goals and two assists, and the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> cruised to a 6-0 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3988803/charlie-mcavoy\">Charlie McAvoy</a> had a career-high four assists for Boston, and <a href=\"http://www.espn.com/nhl/player/_/id/4233575/casey-mittelstadt\">Casey Mittelstadt</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3041994/elias-lindholm\">Elias Lindholm</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697438/jj-peterka\">JJ Peterka</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4587985/mark-kastelic\">Mark Kastelic</a> also scored.\n\n\r\n              Pastrnak leads the Bruins in goals (six) and assists (10). Boston improved to 6-0-1 in its last seven games, with the only loss coming Tuesday <a href=\"https://apnews.com/article/bruins-stars-score-78daa4fc7eeeaa71778cb6b39f213909\">in overtime at Dallas</a> to conclude a four-game trip.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4393408/justus-annunen\">Justus Annunen</a> stopped 25 shots in first start for Nashville since last season. The Predators have lost four of five.\n\n\r\n              The Bruins went ahead 3:49 into the game when Pastrnak <a href=\"https://x.com/NHLBruins/status/2113410037167051245\">sent a cross-ice pass</a> to Mittelstadt, who fired it past Annunen's right shoulder.\n\n\r\n              Lindholm made it 2-0 on the power play later in the first. Pastrnak scored midway through the second <a href=\"https://x.com/NHLBruins/status/2113429504966177021\">when he deflected McAvoy's shot</a> past Annunen, and the Bruins captain assisted on Peterka's goal late in the period.\n\n\r\n              Pastrnak capped the scoring with 5 minutes remaining and became the eighth player in Bruins history with 20 career four-point games.\n\n\r\n              The Bruins scored six goals for the third time, tied with the Golden Knights, Kraken, Avalanche and Hurricanes for the most in 2026-27.\n\n\r\n              McAvoy became the fourth defenseman in Bruins history with 10 career games of three assists or more, joining Ray Bourque, Bobby Orr and Brad Park.\n\n\r\n              <hl2>Up next</hl2>\r\n              Predators: At Pittsburgh on Saturday.\n\n\r\n              Bruins: Host San Jose on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-23T01:52:08Z"}}