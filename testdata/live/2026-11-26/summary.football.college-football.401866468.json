WinPercentage":0.9432,"playId":"401866468336","tiePercentage":0},{"homeWinPercentage":0.9467,"playId":"401866468334","tiePercentage":0},{"homeWinPercentage":0.9458,"playId":"401866468343","tiePercentage":0},{"homeWinPercentage":0.9496,"playId":"401866468341","tiePercentage":0}],"gameInfo":{"venue":{"id":"3739","guid":"8583e109-c6d2-3606-a402-5af2a5909457","fullName":"Glass Bowl","address":{"city":"Toledo","state":"OH","zipCode":"43606","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3739.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":29216},"article":{"headline":"Richter throws TD pass to Dabbs, Griffith kicks 4 FGs for Toledo in 19-0 win over BGSU","description":"— John Alan Richter threw a 35-yard touchdown pass to Adjatay Dabbs, senior Reice Griffith kicked a career-high four field goals and Toledo beat Bowling Green 19-0 on Friday night for the Rockets' fifth consecutive win.","story":"TOLEDO, Ohio -- — <a href=\"http://www.espn.com/college-football/player/_/id/5082330/john-alan-richter\" target=\"_new\">John Alan Richter</a> threw a 35-yard touchdown pass to <a href=\"http://www.espn.com/college-football/player/_/id/5153399/adjatay-dabbs\" target=\"_new\">Adjatay Dabbs</a>, senior <a href=\"http://www.espn.com/college-football/player/_/id/5153413/reice-griffith\" target=\"_new\">Reice Griffith</a> kicked a career-high four field goals and Toledo beat Bowling Green 19-0 on Friday night for the Rockets' fifth consecutive win. \n\n\r\n              Toledo (9-2) is tied with Western Michigan, Buffalo and Ohio — which the Rockets play in the regular-season finale — atop the Mid-American Conference at 6-1. The top two play the MAC Championship game Dec. 5 in Detroit.\n\n\r\n              Bowling Green (3-8, 3-4) was 1 of 12 on third-down conversions, 0 for 2 on fourth down and went three-and-out four times. The Falcons had one first down in the first quarter, three in the first half and finished with nine. The\n\n\r\n              Griffith was good from 46, 29, 39 and 42 yards. He missed a 43-yard attempt a little more than 4 minutes into the game. \n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5162858/bryson-hammer\" target=\"_new\">Bryson Hammer</a> returned a short punt 12 yards to the Falcons 35. After an incompletion on first down, Richter pumped once and then threw and arcing pass to Dabbs who made a <a href=\"https://x.com/ToledoFB/status/2123960894392787270\">contested catch in the front of the end zone</a> to give Toledo a 16-0 lead with 46 seconds left in the first half. \n\n\r\n              The Falcons put together an eight-play, 51-yard drive (their longest by either count) in the second quarter, aided by <a href=\"http://www.espn.com/college-football/player/_/id/5219017/nakai-amachree\" target=\"_new\">Nakai Amachree</a>'s 20-yard run on the first play and <a href=\"http://www.espn.com/college-football/player/_/id/4912647/austin-novosad\" target=\"_new\">Austin Novosad</a> third-and-3 pass deep down the middle to <a href=\"http://www.espn.com/college-football/player/_/id/5326882/joseph-saffold\" target=\"_new\">Joseph Saffold</a> for 21 yards. BGSU's only trip beyond the Toledo 34-yard line ended at the 14 with a missed 32-yard attempt byTravis Kenner that bounced off the left upright. \n\n\r\n              <hl2>Up next </hl2>\r\n              Bowling Green: Hosts UMass in the regular-season finale on Nov. 28. \n\n\r\n              Toledo: Visits Ohio next Friday. \n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-11-21T06:41:31Z"}}