abbreviation":"shot-missed"},"clock":{"displayValue":"0:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"3042002","displayName":"Bo Horvat","shortName":"B. Horvat"},"type":"shooter"},{"athlete":{"id":"4697683","displayName":"Nico Daws","shortName":"N. Daws"}}]},{"id":"401892749000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mark Scheifele Wrist Shot saved by Semyon Varlamov","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:51"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"2562632","displayName":"Mark Scheifele","shortName":"M. Scheifele"},"type":"shooter"},{"athlete":{"id":"3759","displayName":"Semyon Varlamov","shortName":"S. Varlamov"},"type":"saver"}]},{"id":"401892749000000840","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Josh Morrissey","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"3042016","displayName":"Josh Morrissey","shortName":"J. Morrissey"},"type":"giver"}]},{"id":"401892749000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Emil Heineman shot blocked by Josh Morrissey","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:07"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4697447","displayName":"Emil Heineman","shortName":"E. Heineman"},"type":"shooter"},{"athlete":{"id":"3042016","displayName":"Josh Morrissey","shortName":"J. Morrissey"},"type":"defender"}]},{"id":"401892749000000070","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:08"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892749000000790","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brayden Schenn faceoff won against Brayden Yager","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"5219","displayName":"Brayden Schenn","shortName":"B. Schenn"},"type":"face-off-winner"},{"athlete":{"id":"5149188","displayName":"Brayden Yager","shortName":"B. Yager"}}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13161,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Josh Morrissey scores in OT to lift Jets to 4-3 win over Islanders","description":"— Josh Morrissey scored his first goal of the season with 3:02 left in overtime to lift the Winnipeg Jets to a 4-3 victory over the New York Islanders on Thursday night.","story":"WINNIPEG, Manitoba -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042016/josh-morrissey\">Josh Morrissey</a> scored his first goal of the season with 3:02 left in overtime to lift the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> to a 4-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> scored his team-leading 18th goal and had an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4316970/morgan-barron\">Morgan Barron</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4697392/cole-perfetti\">Cole Perfetti</a> also scored for Winnipeg, which has won seven of eight. <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> tallied three assists and <a href=\"http://www.espn.com/nhl/player/_/id/4233583/gabriel-vilardi\">Gabriel Vilardi</a> added a pair.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697683/nico-daws\">Nico Daws</a> made 22 saves to improve to 3-1 since being acquired from New Jersey in the <a href=\"https://apnews.com/article/hellebuyck-trade-devils-jets-26c70cac1b23930670e1200f298ac80e\"><a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> deal</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042086/anthony-duclair\">Anthony Duclair</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697447/emil-heineman\">Emil Heineman</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5517/kyle-palmieri\">Kyle Palmieri</a> scored for New York, which snapped its season-best win streak at three games. <a href=\"http://www.espn.com/nhl/player/_/id/3759/semyon-varlamov\">Semyon Varlamov</a> stopped 18 shots.\n\n\r\n              After spending much of the overtime period in Winnipeg’s end, Morrissey took a pass from Scheifele and fired a low shot past Varlamov.\n\n\r\n              Winnipeg went 1 for 2 on the power play. New York went 0 for 3 with the man advantage but got a short-handed goal from Heineman.\n\n\r\n              New York had three one-goal leads and never trailed until Morrissey ended it. Islanders star defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5291933/matthew-schaefer\">Matthew Schaefer</a> snapped a six-game point streak.\n\n\r\n              The Islanders scored twice off egregious giveaways by the Jets. The first was from Daws, who tried to backhand a pass to the middle of the ice only to get snuffed out by Heineman. Then, early in the second period, <a href=\"http://www.espn.com/nhl/player/_/id/4233878/dylan-samberg\">Dylan Samberg</a> coughed up a puck that led to Palmieri’s goal.\n\n\r\n              <hl2>Up next </hl2>\r\n              Islanders: At Detroit on Saturday night.\n\n\r\n              Jets: Host Las Vegas on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-20T03:11:33Z"}}