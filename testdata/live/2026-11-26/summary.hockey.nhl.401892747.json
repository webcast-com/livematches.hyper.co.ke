ck":{"displayValue":"1:23"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"4697396","displayName":"Seth Jarvis","shortName":"S. Jarvis"},"type":"taker"}]},{"id":"401892747000001010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"K'Andre Miller shot blocked by Jake Evans","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:25"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"4352770","displayName":"K'Andre Miller","shortName":"K. Miller"},"type":"shooter"},{"athlete":{"id":"4393049","displayName":"Jake Evans","shortName":"J. Evans"},"type":"defender"}]},{"id":"401892747000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:27"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892747000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Phillip Danault faceoff won against Logan Stankoven","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:27"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"2562602","displayName":"Phillip Danault","shortName":"P. Danault"},"type":"face-off-winner"},{"athlete":{"id":"4874899","displayName":"Logan Stankoven","shortName":"L. Stankoven"}}]},{"id":"401892747000000740","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jaccob Slavin Slap Shot Above Crossbar","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"3069836","displayName":"Jaccob Slavin","shortName":"J. Slavin"},"type":"shooter"},{"athlete":{"id":"4697686","displayName":"Jakub Dobes","shortName":"J. Dobes"}}]},{"id":"401892747000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"On-Ice Official","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:48"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"999","fullName":"Lenovo Center","address":{"city":"Raleigh","state":"NC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/999.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18838,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Andrew Smith","displayName":"Andrew Smith","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Hutson strikes twice late, including for the OT winner, as Canadiens beat Hurricanes 2-1","description":"— Lane Hutson scored twice in the final 5-plus minutes, including the finish on a perfect give-and-go feed from Nick Suzuki in the first minute of overtime, to help the Montreal Canadiens rally past the Carolina Hurricanes 2-1 on Thursday night.","story":"RALEIGH, N.C. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5080230/lane-hutson\">Lane Hutson</a> scored twice in the final 5-plus minutes, including the finish on a perfect give-and-go feed from <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> in the first minute of overtime, to help the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> rally past the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> 2-1 on Thursday night.\n\n\r\n              The reigning Stanley Cup champion Hurricanes led this rematch of last year's Eastern Conference Final coming down the stretch of the third period before Hutson struck.\n\n\r\n              First he came in the left side to bang the puck into the top left corner past <a href=\"http://www.espn.com/nhl/player/_/id/4565259/pyotr-kochetkov\">Pyotr Kochetkov</a> to tie it at 1-1 at the 15:01 mark of the third. Then he fed Suzuki on the right side and immediately skated toward the crease with a step on Carolina's <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a>. Suzuki's feed was on target, and Hutson waited out Kochetkov as the goaltender sprawled to the ice before lifting the puck over him and into the net.\n\n\r\n              Suzuki assisted on Hutson's first goal as well, while <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a> finished with 26 saves as Montreal followed <a href=\"https://apnews.com/article/canadiens-devils-score-hellebuyck-383931c26e34bffc03a51997e8841798\">Wednesday’s 3-2 win at New Jersey</a> for wins on back-to-back nights.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114741/nikolaj-ehlers\">Nikolaj Ehlers</a> scored for the Hurricanes, breaking a scoreless tie midway through the third period when he zipped a shot past Dobes into the top left corner. Kochetkov finished with 22 saves.\n\n\r\n              Carolina entered Thursday leading the league in points percentage (.810), ahead of Edmonton as the only other team at 80% or better in the standings. The Hurricanes had won four straight, which included sweeping a two-game set against Seattle in Finland last week by a combined 9-2 score.\n\n\r\n              The Hurricanes had won the first meeting 6-4 in Montreal's home opener in early October, pushing ahead for good midway through the second period. This one marked the Canadiens' first trip to Raleigh <a href=\"https://apnews.com/article/canadiens-hurricanes-score-nhl-playoffs-683ff206a8ba2984cdc3eb979efa87c9\">since a 6-1 loss on May 29</a> that closed out the Eastern final in five games.\n\n\r\n              Montreal played without forward Zachary Bolduc, who left the New Jersey win with an upper-body injury.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canadiens: The Canadiens return home to face the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Saturday.\n\n\r\n              Hurricanes: The Hurricanes host the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-20T03:01:33Z"}}