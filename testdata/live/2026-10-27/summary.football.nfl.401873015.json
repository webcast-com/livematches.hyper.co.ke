inPercentage":0.3128,"playId":"4018730151609","tiePercentage":0},{"homeWinPercentage":0.3114,"playId":"4018730151622","tiePercentage":0},{"homeWinPercentage":0.3078,"playId":"4018730151634","tiePercentage":0},{"homeWinPercentage":0.3039,"playId":"4018730151649","tiePercentage":0},{"homeWinPercentage":0.2824,"playId":"4018730151663","tiePercentage":0},{"homeWinPercentage":0.2689,"playId":"4018730151692","tiePercentage":0},{"homeWinPercentage":0.2533,"playId":"4018730151714","tiePercentage":0},{"homeWinPercentage":0.2606,"playId":"4018730151727","tiePercentage":0},{"homeWinPercentage":0.2575,"playId":"4018730151739","tiePercentage":0},{"homeWinPercentage":0.2632,"playId":"4018730151780","tiePercentage":0},{"homeWinPercentage":0.2658,"playId":"4018730151791","tiePercentage":0},{"homeWinPercentage":0.1711,"playId":"4018730151802","tiePercentage":0},{"homeWinPercentage":0.1681,"playId":"4018730151847","tiePercentage":0},{"homeWinPercentage":0.1682,"playId":"4018730151864","tiePercentage":0},{"homeWinPercentage":0.1686,"playId":"4018730151886","tiePercentage":0}],"gameInfo":{"venue":{"id":"3839","guid":"604c24d0-2641-3553-82bc-1b005ac94765","fullName":"MetLife Stadium","address":{"city":"East Rutherford","state":"NJ","zipCode":"07073","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":72456,"officials":[{"fullName":"Brad Allen","displayName":"Brad Allen","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":1},{"fullName":"Chad Hill","displayName":"Chad Hill","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":2},{"fullName":"Anthony Flemming","displayName":"Anthony Flemming","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Walter Flowers","displayName":"Walter Flowers","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":4},{"fullName":"Tyree Walton","displayName":"Tyree Walton","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":5},{"fullName":"Marcus Woods","displayName":"Marcus Woods","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":6},{"fullName":"Matthew Griebel","displayName":"Matthew Griebel","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Malik Willis sparks first win for Jeff Hafley and Dolphins hold off late Jets rally in 28-25 victory","description":"— Jeff Hafley had a towel draped around his neck as he stepped to the podium and the Miami Dolphins coach wiped his face one last time before taking questions from reporters.","story":"EAST RUTHERFORD, N.J. -- — Jeff Hafley had a towel draped around his neck as he stepped to the podium and the <a href=\"http://www.espn.com/nfl/team/_/name/mia/miami-dolphins\">Miami Dolphins</a> coach wiped his face one last time before taking questions from reporters.\n\n\r\n              He had just been doused by his players in the middle of a jubilant locker room after they held on for a 28-25 victory — his first leading the Dolphins — over the <a href=\"http://www.espn.com/nfl/team/_/name/nyj/new-york-jets\">New York Jets</a> on Sunday.\n\n\r\n              “I grabbed every guy as they ran in,” a happy Hafley said. \"My socks are wet. I had so much water on me. It was a really, really special moment, one that I’m appreciative of and one that I won’t forget. It was fun. \n\n\r\n              “They deserve it. You could feel a lot come out of it. I'm very happy for the players. They did a great job.”\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4242512/malik-willis\">Malik Willis</a> threw two touchdown passes and ran for a score, and made a victory-sealing 2-yard push up the middle on fourth-and-1 as the Dolphins (1-5) came off their bye-week break and avoided their first 0-6 start since 2019. \n\n\r\n              “It was awesome,” said Willis, who was 14 of 21 for 208 yards and two TD passes to rookie <a href=\"http://www.espn.com/nfl/player/_/id/4869645/caleb-douglas\">Caleb Douglas</a>. He also ran for 37 yards on eight carries, but the last one was the biggest of the game.\n\n\r\n              The Jets (2-5) made a late push trailing 28-17. On fourth-and-4, <a href=\"http://www.espn.com/nfl/player/_/id/15864/geno-smith\">Geno Smith</a> completed a short pass to <a href=\"http://www.espn.com/nfl/player/_/id/4695404/isaiah-davis\">Isaiah Davis</a>, who zipped downfield 41 yards to the Dolphins 18. Three plays later, Smith found <a href=\"http://www.espn.com/nfl/player/_/id/4808766/mason-taylor\">Mason Taylor</a> for a 12-yard touchdown, the tight end's second of the game. \n\n\r\n              Penalties negated New York's first two 2-point tries before Smith threw to Taylor to make it 28-25 with 3:24 left.\n\n\r\n              Looking to end it, the Dolphins faced fourth-and-1 from the Jets 49 at the two-minute warning and Hafley went straight to his offensive linemen.\n\n\r\n              “I asked them what they thought,” Hafley said. “When I saw the look in their eyes, I was very confident that we’d get it. As soon as I saw that, there was no doubt in my mind that we’d go for it.”\n\n\r\n              Passing up the punt, Hafley left it to the offense — and Willis pushed forward for 2 yards as the Dolphins celebrated. \n\n\r\n              “He trusted us,” Willis said, \"and we trusted him.”\n\n\r\n              Hafley, who grew up about 20 minutes north of MetLife Stadium in Montvale, got the win in front of about 30 friends and family members.\n\n\r\n              The Jets, meanwhile, dropped to 0-8 against AFC East opponents under Aaron Glenn, including consecutive losses to New England and Miami.\n\n\r\n              “When it comes to this game, highly disappointed,” Glenn said. “Disappointed in myself, first and foremost.”\n\n\r\n              Smith was 23 of 30 for 287 yards and three touchdowns, the two to Taylor and another to <a href=\"http://www.espn.com/nfl/player/_/id/4723820/omar-cooper-jr\">Omar Cooper Jr</a>., and an interception. <a href=\"http://www.espn.com/nfl/player/_/id/4685247/braelon-allen\">Braelon Allen</a> had 104 yards rushing.\n\n\r\n              <hl2>Dolphins and Jets start things off with a scoring spree</hl2>\r\n              The Dolphins started quickly, marching 76 yards on seven plays and taking their first lead in any game this season on Willis' 7-yard touchdown pass to Douglas.\n\n\r\n              It also ended New York's streak of not allowing any points on an opening possession in five straight games.\n\n\r\n              But the Jets came right back with a 13-yard touchdown catch by Taylor — son of former Dolphins star and Pro Football Hall of Famer Jason Taylor — to tie it. It's the third straight game in which New York scored on its opening drive.\n\n\r\n              Miami then went on a 14-play drive that was capped by a 1-yard touchdown run by Gordon, who finished with 103 yards rushing. \n\n\r\n              New York was driving again on its next possession at the Miami 21 when Smith was intercepted by <a href=\"http://www.espn.com/nfl/player/_/id/4880346/michael-taaffe\">Michael Taaffe</a>.\n\n\r\n              The Dolphins' touchdown streak ended on their third possession when they went three-and-out. They got right back at it on their next drive, with Willis scoring on a 2-yard scramble with 6 seconds left in the first half.\n\n\r\n              <hl2>Jets' woes extend into the second half</hl2>\r\n              Allen gave New York some immediate second-half juice with a 27-yard run on the Jets' first play of the third quarter, but the drive stalled. Adding to the misery, <a href=\"http://www.espn.com/nfl/player/_/id/3124679/jason-sanders\">Jason Sanders</a> — a longtime Dolphins kicker in his first season with the Jets — hit the right upright on a 40-yard try.\n\n\r\n              Cooper got New York's next drive started with a 60-yard reception, and ended it five plays later with a 3-yard touchdown catch to make it a one-score game at 21-14 with 5:50 left in the third quarter.\n\n\r\n              The Jets later got to the Dolphins 1, but couldn't punch it in on runs by <a href=\"http://www.espn.com/nfl/player/_/id/3125107/andrew-beck\">Andrew Beck</a> and Allen and settled for a 33-yard field goal when Smith was sacked on third down.\n\n\r\n              Willis side-armed a short toss to Douglas, who tiptoed the sideline after the catch and raced for a 63-yard touchdown that put Miami up 28-17 with 4:44 remaining.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Dolphins: RB <a href=\"http://www.espn.com/nfl/player/_/id/4682745/jaylen-wright\">Jaylen Wright</a> left in the fourth quarter with an injured quadriceps. ... S <a href=\"http://www.espn.com/nfl/player/_/id/4431664/dante-trader-jr\">Dante Trader Jr</a>. hurt his left shoulder in the third quarter. ... CB <a href=\"http://www.espn.com/nfl/player/_/id/4360488/juju-brents\">JuJu Brents</a> left with a stinger in the second half, but returned in the fourth quarter.\n\n\r\n              Jets: DT <a href=\"http://www.espn.com/nfl/player/_/id/4428617/t'vondre-sweat\">T'Vondre Sweat</a> limped off with a knee injury late in the second quarter and didn't return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Dolphins: Host New England next Sunday.\n\n\r\n              Jets: Host Las Vegas next Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-25T20:25:45Z"}}