er":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1839","fullName":"Enterprise Center","address":{"city":"St. Louis","state":"MO","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18096,"officials":[{"fullName":"Tom Chmielewski","displayName":"Tom Chmielewski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Broberg breaks tie on 3rd-period power play, Blues top Jets 2-1","description":"— Philip Broberg scored on a power play at 8:47 of the third period to break a tie in the St. Louis Blues' 2-1 victory over the Winnipeg Jets on Tuesday night.","story":"ST. LOUIS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565229/philip-broberg\">Philip Broberg</a> scored on a power play at 8:47 of the third period to break a tie in the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a>' 2-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233637/robert-thomas\">Robert Thomas</a> set up Broberg's slapper from the middle of the ice above the faceoff circles. Thomas has 332 career assists, one short of matching Brian Sutter for fourth on the Blues’ list.\n\n\r\n              Broberg also assisted on Jimmy Snuggerud’s first-period goal, and <a href=\"http://www.espn.com/nhl/player/_/id/4587909/joel-hofer\">Joel Hofer</a> stopped 32 shots as the Blues opened a five-game homestand. Snuggerud has five goals this season.\n\n\r\n              St. Louis snapped a two-game losing streak to improve to 4-4-1.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697392/cole-perfetti\">Cole Perfetti</a> tied it at 1 for Winnipeg at 32 seconds of the third with his sixth goal of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> made 27 saves for the Jets.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: At Dallas on Thursday night.\n\n\r\n              Blues: Host Vegas on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-21T02:38:08Z"}}