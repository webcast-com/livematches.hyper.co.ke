onny Brodzinski","shortName":"J. Brodzinski"}}]},{"id":"401892542000000900","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Jakob Chychrun","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:47"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"4024950","displayName":"Jakob Chychrun","shortName":"J. Chychrun"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1823","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16182,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Libor Suchanek","displayName":"Libor Suchanek","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Adrian Kempe scores 2 goals and Kings beat Capitals 5-2 for first win of season","description":"— Adrian Kempe scored twice and the Los Angeles Kings got their first win of the season, rallying from an early deficit to beat the Washington Capitals 5-2 on Tuesday night.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114802/adrian-kempe\">Adrian Kempe</a> scored twice and the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> got their first win of the season, rallying from an early deficit to beat the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> 5-2 on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3891952/artemi-panarin\">Artemi Panarin</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3891922/erik-gustafsson\">Erik Gustafsson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2976848/scott-laughton\">Scott Laughton</a> also scored for Los Angeles (1-4-2), and former Capitals goalie <a href=\"http://www.espn.com/nhl/player/_/id/2610321/darcy-kuemper\">Darcy Kuemper</a> made 30 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149172/ryan-leonard\">Ryan Leonard</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5216918/cole-hutson\">Cole Hutson</a> scored for the Capitals, who took a 2-0 lead in the first period but were held scoreless for the final 41:25. Washington's <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> stopped 21 shots.\n\n\r\n              The Kings, who came in having scored just four goals over their previous four games and 12 goals through six games, lost second-line center <a href=\"http://www.espn.com/nhl/player/_/id/4697383/quinton-byfield\">Quinton Byfield</a> to an upper-body injury in the first period. He played just 2:44.\n\n\r\n              Hutson put the Capitals ahead 2-0 on the power play with 1:25 left in the first, but Kempe found the net less than a minute later and Panarin scored 2 seconds before the intermission.\n\n\r\n              Gustafsson put the Kings ahead at 7:28 of the third on the power play. Kempe scored his second goal midway through the third, and Laughton added an empty-netter that gave the Kings their highest-scoring game of the season.\n\n\r\n              Absent the injured Pierre Luc-Dubois and <a href=\"http://www.espn.com/nhl/player/_/id/4697783/justin-sourdif\">Justin Sourdif</a> down the middle of their forward ranks, the Capitals were unable to beat Kuemper, who played for Washington from 2022-24.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kings: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Thursday night.\n\n\r\n              Capitals: Host Buffalo on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-21T01:51:08Z"}}