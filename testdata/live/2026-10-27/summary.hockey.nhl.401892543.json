"shortName":"V. Lettieri"},"type":"hit-credited"},{"athlete":{"id":"5503","displayName":"Erik Gudbranson","shortName":"E. Gudbranson"},"type":"hitted"}]},{"id":"401892543000000920","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Vinni Lettieri hit Charlie Coyle","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:43"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"3095892","displayName":"Vinni Lettieri","shortName":"V. Lettieri"},"type":"hit-credited"},{"athlete":{"id":"2555315","displayName":"Charlie Coyle","shortName":"C. Coyle"},"type":"hitted"}]},{"id":"401892543000000840","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Dmitri Voronkov","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"1:56"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"4915856","displayName":"Dmitri Voronkov","shortName":"D. Voronkov"},"type":"taker"}]},{"id":"401892543000000850","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Marshall Rifai","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:07"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"4419778","displayName":"Marshall Rifai","shortName":"M. Rifai"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1828","fullName":"Nationwide Arena","address":{"city":"Columbus","state":"OH","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1828.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":15073,"officials":[{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Matthews reaches 700 games, scores to help the Maple Leafs beat the Blue Jackets 6-2","description":"— Auston Matthews had a goal and an assist in his 700th NHL game and the Toronto Maple Leafs scored four straight goals in the second period to beat the Columbus Blue Jackets 6-2 on Tuesday for their second road victory of the season.","story":"COLUMBUS, Ohio -- — <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> had a goal and an assist in his 700th NHL game and the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> scored four straight goals in the second period to beat the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> 6-2 on Tuesday for their second road victory of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149211/easton-cowan\">Easton Cowan</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3904098/jack-roslovic\">Jack Roslovic</a> each had a goal and two assists, <a href=\"http://www.espn.com/nhl/player/_/id/3114736/william-nylander\">William Nylander</a> had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/2976833/morgan-rielly\">Morgan Rielly</a> added three assists. <a href=\"http://www.espn.com/nhl/player/_/id/4587996/kirill-marchenko\">Kirill Marchenko</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4419778/marshall-rifai\">Marshall Rifai</a> also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/3067313/anthony-stolarz\">Anthony Stolarz</a> stopped 33 shots for the Maple Leafs.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4392782/jake-christiansen\">Jake Christiansen</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2555315/charlie-coyle\">Charlie Coyle</a> scored for the Blue Jackets. They have been outscored 15-3 in the second period through eight games and lost for the fourth time in five games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4894366/jet-greaves\">Jet Greaves</a> stopped 14 shots before being pulled in the second period after allowing his fifth goal. <a href=\"http://www.espn.com/nhl/player/_/id/5734/cam-talbot\">Cam Talbot</a> stopped two of the three shots he faced in relief.\n\n\r\n              Christiansen’s first goal of the season at 2:38 of the first period gave Columbus the early lead. Marchenko, who faced unrelenting boos in his first visit since being traded by Columbus, pulled Toronto even with a power-play goal at 8:16.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4781553/kent-johnson\">Kent Johnson</a> appeared to put Columbus ahead with a one-timer, but the goal was waved off because time had expired.\n\n\r\n              The second period was all Toronto, starting with goals 46 seconds apart from Nylander and Matthews, who has 16 goals and 27 points in 21 career games against the Blue Jackets. Colton Sissons’ assist on Nylander's goal extended his points streak to four games.\n\n\r\n              Cowan’s short-handed goal gave the Maple Leafs a three-goal lead at 6:48 before Roslovic made it 5-1 and chased Greaves from the net at 12:03.\n\n\r\n              Coyle scored his first goal of the season off the backhand at 4:13 of the third period to make it 5-2 before Rifai extended Toronto's lead with 3:02 to go.\n\n\r\n              <hl2>Up next</hl2>\r\n              Maple Leafs: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Thursday night.\n\n\r\n              Blue Jackets: Host Vegas on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-21T01:55:08Z"}}