,"type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:05"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"5517","displayName":"Kyle Palmieri","shortName":"K. Palmieri"},"type":"shooter"},{"athlete":{"id":"4588165","displayName":"Lukas Dostal","shortName":"L. Dostal"}}]},{"id":"401892541000004380","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Noah Warren hit Kyle Palmieri","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"5080210","displayName":"Noah Warren","shortName":"N. Warren"},"type":"hit-credited"},{"athlete":{"id":"5517","displayName":"Kyle Palmieri","shortName":"K. Palmieri"},"type":"hitted"}]},{"id":"401892541000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ryan Pulock shot blocked by Jeff Malott","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:11"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"3042019","displayName":"Ryan Pulock","shortName":"R. Pulock"},"type":"shooter"},{"athlete":{"id":"4895214","displayName":"Jeff Malott","shortName":"J. Malott"},"type":"defender"}]},{"id":"401892541000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:12"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"7226","fullName":"UBS Arena","address":{"city":"Elmont","state":"NY","zipCode":"11003","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/7226.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13273,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Islanders score 3 1st-period goals, beat Ducks 3-2 for 2nd straight win","description":"— Ondrej Palat, Viktor Eklund and Simon Holmstrom scored first-period goals and the New York Islanders beat the Anaheim Ducks 3-2 on Tuesday night for their second straight victory.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/2590389/ondrej-palat\">Ondrej Palat</a>, Viktor Eklund and <a href=\"http://www.espn.com/nhl/player/_/id/4565244/simon-holmstrom\">Simon Holmstrom</a> scored first-period goals and the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a> 3-2 on Tuesday night for their second straight victory.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3151981/ilya-sorokin\">Ilya Sorokin</a> made 15 saves to help the Islanders improve to 3-0-1 in their last four games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3527554/frank-vatrano\">Frank Vatrano</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4968/alex-killorn\">Alex Killorn</a> scored for Anaheim, which lost its fourth straight game. <a href=\"http://www.espn.com/nhl/player/_/id/4588165/lukas-dostal\">Lukas Dostal</a> finished with 22 saves.\n\n\r\n              Palat opened the scoring with 6:21 left in the first period. <a href=\"http://www.espn.com/nhl/player/_/id/2593131/jean-gabriel-pageau\">Jean-Gabriel Pageau</a> found Palat streaking toward the net, and the forward fired a wrist shot past Dostal.\n\n\r\n              Eklund doubled the lead less than three minutes later. <a href=\"http://www.espn.com/nhl/player/_/id/4697447/emil-heineman\">Emil Heineman</a> floated a wrist shot from the blue line, and Eklund corralled the loose puck and buried it for his second goal of the season.\n\n\r\n              Vatrano pulled the Ducks within a goal 49 seconds later, lifting a backhander past Sorokin off a feed from <a href=\"http://www.espn.com/nhl/player/_/id/3648015/aj-greer\">A.J. Greer</a>.\n\n\r\n              Holmstrom restored New York’s two-goal advantage with a power-play goal with 1:18 left in the first, deflecting Mathew Schaefer’s shot from the point past Dostal.\n\n\r\n              Killorn pulled Anaheim within a goal with 2:40 remaining in the third.\n\n\r\n              <hl2>Up next</hl2>\r\n              <hl2 />\r\n              Ducks: At New Jersey Thursday night.\n\n\r\n              Islanders: Host Los Angeles on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-21T01:45:17Z"}}