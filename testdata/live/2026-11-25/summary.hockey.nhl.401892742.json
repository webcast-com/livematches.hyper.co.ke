d":"401892742000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Gavin McKenna Wrist Shot saved by Darcy Kuemper","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:20"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"5342529","displayName":"Gavin McKenna","shortName":"G. McKenna"},"type":"shooter"},{"athlete":{"id":"2610321","displayName":"Darcy Kuemper","shortName":"D. Kuemper"},"type":"saver"}]},{"id":"401892742000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Troy Stecher shot blocked by Nick Paul","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:29"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"3096102","displayName":"Troy Stecher","shortName":"T. Stecher"},"type":"shooter"},{"athlete":{"id":"3042111","displayName":"Nick Paul","shortName":"N. Paul"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18641,"officials":[{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Morgan MacPhee","displayName":"Morgan MacPhee","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kings rally from 3 down to beat skidding Maple Leafs 4-3 on Kempe's goal in shootout","description":"— Adrian Kempe scored the only goal in a shootout and the Los Angeles Kings roared back from a three-goal deficit to beat Toronto 4-3 on Thursday night, handing the Maple Leafs their eighth straight defeat.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114802/adrian-kempe\">Adrian Kempe</a> scored the only goal in a shootout and the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> roared back from a three-goal deficit to beat Toronto 4-3 on Thursday night, handing the Maple Leafs their eighth straight defeat.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565226/alex-turcotte\">Alex Turcotte</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697725/alex-laferriere\">Alex Laferriere</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2593311/erik-haula\">Erik Haula</a> scored in regulation for Los Angeles (7-11-2), which got 24 saves from <a href=\"http://www.espn.com/nhl/player/_/id/2610321/darcy-kuemper\">Darcy Kuemper</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> had a goal and an assist for Toronto. <a href=\"http://www.espn.com/nhl/player/_/id/5160/john-tavares\">John Tavares</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4588638/dakota-joshua\">Dakota Joshua</a> also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/3067313/anthony-stolarz\">Anthony Stolarz</a> stopped 25 shots. <a href=\"http://www.espn.com/nhl/player/_/id/3114736/william-nylander\">William Nylander</a> added two assists.\n\n\r\n              The reeling Maple Leafs (8-13-3) are 1-9-1 in their last 11 games. Six of those losses came on a recent homestand before a 6-3 setback Tuesday at Chicago.\n\n\r\n              Toronto entered play 27th in the NHL’s overall standings, while Los Angeles was 30th.\n\n\r\n              Maple Leafs coach Jim Hiller faced his former team for the first time. The 57-year-old Hiller spent parts of three seasons with Los Angeles before getting fired following the team’s third straight first-round playoff exit in April.\n\n\r\n              Toronto built a 3-0 lead early in the middle period before Turcotte scored 21 seconds later. Laferriere added another goal on a power play and Haula scored at even strength to tie it through 40 minutes.\n\n\r\n              Kempe scored on his team’s first shootout attempt by deking Stolarz to the ice and then roofing a backhand.\n\n\r\n              Matthews scored the 68th game-opening goal of his career to surpass Mats Sundin for the most in franchise history.\n\n\r\n              Kings winger <a href=\"http://www.espn.com/nhl/player/_/id/2976848/scott-laughton\">Scott Laughton</a> suited up at Scotiabank Arena for the first time since getting traded last March. The Toronto native had 10 goals and six assists in 63 games for the Maple Leafs after being acquired from the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a>.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kings: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> on Saturday.\n\n\r\n              Maple Leafs: Host the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-20T04:06:31Z"}}