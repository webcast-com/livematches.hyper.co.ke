:"4018729811737","tiePercentage":0},{"homeWinPercentage":0.5534,"playId":"4018729811764","tiePercentage":0},{"homeWinPercentage":0.5094,"playId":"4018729811794","tiePercentage":0},{"homeWinPercentage":0.5718,"playId":"4018729811816","tiePercentage":0},{"homeWinPercentage":0.5705,"playId":"4018729811827","tiePercentage":0},{"homeWinPercentage":0.5926,"playId":"4018729811838","tiePercentage":0},{"homeWinPercentage":0.5725,"playId":"4018729811875","tiePercentage":0},{"homeWinPercentage":0.524,"playId":"4018729811898","tiePercentage":0},{"homeWinPercentage":0.5255,"playId":"4018729811909","tiePercentage":0},{"homeWinPercentage":0.5992,"playId":"4018729811920","tiePercentage":0},{"homeWinPercentage":0.5935,"playId":"4018729811949","tiePercentage":0}],"gameInfo":{"venue":{"id":"5534","guid":"022624d9-2dbd-3844-adab-9236c4319f9b","fullName":"Tottenham Hotspur Stadium","address":{"city":"London","country":"England"},"grass":true,"images":[]},"attendance":61322,"officials":[{"fullName":"Barry Anderson","displayName":"Barry Anderson","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":2},{"fullName":"Greg Meyer","displayName":"Greg Meyer","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Ronald Torbert","displayName":"Ronald Torbert","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":4},{"fullName":"Keith Washington","displayName":"Keith Washington","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":3},{"fullName":"Ryan Dickson","displayName":"Ryan Dickson","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":5},{"fullName":"Danny Short","displayName":"Danny Short","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Tripp Sutter","displayName":"Tripp Sutter","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":7}]},"article":{"headline":"Cam Little's 57-yard FG gives Jaguars 19-17 win over Eagles in wild finish in London","description":"— Cam Little grew up playing soccer and watching Premier League games every weekend.","story":"LONDON -- — <a href=\"http://www.espn.com/nfl/player/_/id/4686361/cam-little\">Cam Little</a> grew up playing soccer and watching Premier League games every weekend.\n\n\r\n              So to line up a game-winning kick for the Jaguars in London was something special.\n\n\r\n              Little connected from 57 yards as time expired and Jacksonville beat the <a href=\"http://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles\">Philadelphia Eagles</a> 19-17 in a wild finish at Tottenham Hotspur Stadium on Sunday.\n\n\r\n              “It was the coolest moment of my career,” said Little, who wore a Manchester United jersey at his postgame news conference.\n\n\r\n              Little sprinted from midfield into the opposite end zone with his teammates in pursuit and struck a <a href=\"https://x.com/NFLUKIRE/status/2109340471009140998\">Jude Bellingham-style arms wide celebration</a> in tribute to the England and Real Madrid star.\n\n\r\n              The improbable scenario was made possible by <a href=\"https://x.com/NFL/status/2109331447127441624\">Ameer Abdullah’s 53-yard kickoff return</a> that left 1 second on the clock.\n\n\r\n              The Eagles had taken a 17-16 lead on <a href=\"http://www.espn.com/nfl/player/_/id/3050478/jake-elliott\">Jake Elliott</a>'s 48-yard field goal with 8 seconds left — after Little's extra-point attempt was wide left following <a href=\"http://www.espn.com/nfl/player/_/id/4432620/parker-washington\">Parker Washington</a>'s 27-yard touchdown reception late in the fourth quarter.\n\n\r\n              The Jaguars were using backup snapper <a href=\"http://www.espn.com/nfl/player/_/id/3915520/davon-hamilton\">DaVon Hamilton</a> after <a href=\"http://www.espn.com/nfl/player/_/id/3928931/ross-matiscik\">Ross Matiscik</a> left the game with an injury.\n\n\r\n              Philadelphia, which slipped to 2/3 for the first time since 2021, played without leading rusher <a href=\"http://www.espn.com/nfl/player/_/id/3929630/saquon-barkley\">Saquon Barkley</a> and receiver <a href=\"http://www.espn.com/nfl/player/_/id/4241478/devonta-smith\">DeVonta Smith</a> and with a makeshift offensive line. The Eagles rushed for just 22 yards.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4360310/trevor-lawrence\">Trevor Lawrence</a> completed 24 of 39 passes for 331 yards and two touchdowns — both to Washington — along with an interception for the Jaguars (4-1).\n\n\r\n              “One of the craziest games, maybe the craziest game I’ve ever been a part of,” Lawrence said, “and I’ve been in some pretty wild ones. Just how cool is this sport? The game’s never over.”\n\n\r\n              Washington, who caught a 51-yard touchdown pass in the first quarter, had six receptions for 124 yards.\n\n\r\n              Eagles linebacker <a href=\"http://www.espn.com/nfl/player/_/id/3917657/zack-baun\">Zack Baun</a> ensured his team went into halftime with a 14-7 lead by getting past <a href=\"http://www.espn.com/nfl/player/_/id/4362619/chris-rodriguez-jr\">Chris Rodriguez Jr</a>. and <a href=\"https://x.com/Eagles/status/2109302910366707832\">tackling <a href=\"http://www.espn.com/nfl/player/_/id/4882093/bhayshul-tuten\">Bhayshul Tuten</a></a> for a loss when Jacksonville went for it on fourth-and-goal from the 1 with 1 second left in the half. Eagles coach Nick Sirianni jumped and pumped his first in reaction.\n\n\r\n              Sirianni was asked about not kicking the ball out of bounds at the end.\n\n\r\n              “I didn’t make the right decision, and I lost us that game,” the Eagles coach said. “That’s what I said to our guys, and what hurts there is that, you know, the guys fought so hard and then I don’t make the decision that, you know, that I should make at the end of the game, and I cost us that game, and I put that fully on me.”\n\n\r\n              The <a href=\"http://www.espn.com/nfl/team/_/name/bal/baltimore-ravens\">Baltimore Ravens</a> had used some <a href=\"https://apnews.com/article/ravens-cowboys-score-brazil-grass-f778fcf2d73260eb67f6a9d89fc6fbd8\">late-game heroics in Rio de Janeiro</a> last month to beat the <a href=\"http://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a>, who <a href=\"https://apnews.com/article/cowboys-broncos-nix-mariota-commanders-46664bb4d2b6ec703d43ac27ae577eab\">took heat for coaching decisions</a>.\n\n\r\n              Earlier, Eagles backup running back <a href=\"http://www.espn.com/nfl/player/_/id/4431545/will-shipley\">Will Shipley</a> scored on a 2-yard run and <a href=\"http://www.espn.com/nfl/player/_/id/4715355/darius-cooper\">Darius Cooper</a> caught a 62-yard touchdown pass from <a href=\"http://www.espn.com/nfl/player/_/id/4040715/jalen-hurts\">Jalen Hurts</a>.\n\n\r\n              Hurts completed 21 of 40 passes for 220 yards and one touchdown. <a href=\"http://www.espn.com/nfl/player/_/id/4685759/jalen-carter\">Jalen Carter</a> had two sacks and two forced fumbles for the Eagles.\n\n\r\n              Little's 34-yard field goal in the third quarter made it 14-10.\n\n\r\n              <hl2>Wild start</hl2>\r\n              Jaguars rookie <a href=\"http://www.espn.com/nfl/player/_/id/4879194/josh-cameron\">Josh Cameron</a> returned the opening kickoff 90 yards for a would-be touchdown, but it was called back because of offsetting penalties including a hold by Jacksonville’s <a href=\"http://www.espn.com/nfl/player/_/id/4572704/branson-combs\">Branson Combs</a>.\n\n\r\n              Meanwhile, there was a scrum at midfield, with pushing and shoving on both sides. <a href=\"https://apnews.com/article/eagles-jaguars-ejections-a1dadb99e351b81f1df2e1f82ad21759\">Two players were ejected</a>: Jacksonville’s <a href=\"http://www.espn.com/nfl/player/_/id/4836472/bryan-thomas-jr\">Bryan Thomas Jr</a>. and Philadelphia’s <a href=\"http://www.espn.com/nfl/player/_/id/4432777/jeremiah-trotter-jr\">Jeremiah Trotter Jr</a>.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Eagles: Edge rusher <a href=\"http://www.espn.com/nfl/player/_/id/3916409/jonathan-greenard\">Jonathan Greenard</a> (ankle) warmed up, but was ruled out ahead of the game... OLB <a href=\"http://www.espn.com/nfl/player/_/id/4571162/jalyx-hunt\">Jalyx Hunt</a> was injured on the last play of the first half and was helped off the field. ... DB <a href=\"http://www.espn.com/nfl/player/_/id/4240657/michael-carter\">Michael Carter</a> was ruled out in the third quarter.... CB <a href=\"http://www.espn.com/nfl/player/_/id/4686273/quinyon-mitchell\">Quinyon Mitchell</a> was slow to get up after intercepting a pass in the third quarter but returned... Shipley left the game late in second quarter with a foot injury.\n\n\r\n              Jaguars: LT <a href=\"http://www.espn.com/nfl/player/_/id/4692525/anton-harrison\">Anton Harrison</a> was carted off in the third quarter with what appeared to be a right knee injury... Long snapper Ross Matiscik left the game with an apparent shoulder injury. ... S <a href=\"http://www.espn.com/nfl/player/_/id/2970716/eric-murray\">Eric Murray</a> (concussion) didn’t dress... DB <a href=\"http://www.espn.com/nfl/player/_/id/4047655/jaylon-jones\">Jaylon Jones</a> (hamstring) had been ruled out Friday.\n\n\r\n              <hl2>Up next</hl2>\r\n              Eagles: Host the <a href=\"http://www.espn.com/nfl/team/_/name/car/carolina-panthers\">Carolina Panthers</a> next Sunday.\n\n\r\n              Jaguars: Stay in London and host the <a href=\"http://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> at Wembley Stadium next Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-11T18:09:39Z"}}