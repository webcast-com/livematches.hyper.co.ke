{"header":{"id":"401872981","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401872981","uid":"s:20~l:28~e:401872981~c:401872981","date":"2026-10-11T13:30Z","neutralSite":true,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"30","uid":"s:20~l:28~t:30","order":0,"homeAway":"home","winner":true,"score":"19","possession":false,"linescores":[{"displayValue":"7"},{"displayValue":"0"},{"displayValue":"3"},{"displayValue":"9"}],"team":{"id":"30","abbreviation":"JAX","displayName":"Jacksonville Jaguars","name":"Jaguars","location":"Jacksonville","nickname":"Jaguars","color":"007487","alternateColor":"d7a22a","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/jax.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/jax.png"}]}},{"id":"21","uid":"s:20~l:28~t:21","order":1,"homeAway":"away","winner":false,"score":"17","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"14"},{"displayValue":"0"},{"displayValue":"3"}],"team":{"id":"21","abbreviation":"PHI","displayName":"Philadelphia Eagles","name":"Eagles","location":"Philadelphia","nickname":"Eagles","color":"06424d","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/phi.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/phi.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"21","abbreviation":"PHI","displayName":"Philadelphia Eagles","shortDisplayName":"Eagles","name":"Eagles","location":"Philadelphia","color":"06424d","alternateColor":"000000","logo":"https://a.espncdn.com/i