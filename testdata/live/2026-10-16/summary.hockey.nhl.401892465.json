lete":{"id":"3115032","displayName":"Brandon Montour","shortName":"B. Montour"},"type":"shooter"},{"athlete":{"id":"2590824","displayName":"John Gibson","shortName":"J. Gibson"}}]},{"id":"401892465000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ben Meyers Backhand saved by John Gibson","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4755729","displayName":"Ben Meyers","shortName":"B. Meyers"},"type":"shooter"},{"athlete":{"id":"2590824","displayName":"John Gibson","shortName":"J. Gibson"},"type":"saver"}]},{"id":"401892465000000100","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ben Meyers Wrist Shot Short","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:35"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4755729","displayName":"Ben Meyers","shortName":"B. Meyers"},"type":"shooter"},{"athlete":{"id":"2590824","displayName":"John Gibson","shortName":"J. Gibson"}}]},{"id":"401892465000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892465000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Larkin faceoff won against Ben Meyers","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"3114755","displayName":"Dylan Larkin","shortName":"D. Larkin"},"type":"face-off-winner"},{"athlete":{"id":"4755729","displayName":"Ben Meyers","shortName":"B. Meyers"}}]},{"id":"401892465000000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Lucas Raymond Backhand Short Failed Bank Attempt","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:52"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"4697385","displayName":"Lucas Raymond","shortName":"L. Raymond"},"type":"shooter"},{"athlete":{"id":"5657","displayName":"Philipp Grubauer","shortName":"P. Grubauer"}}]}],"gameInfo":{"venue":{"id":"5404","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17603,"officials":[{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Gaudreau scores twice in 4-goal 2nd period as Kraken beat Red Wings 6-3","description":"— Frederick Gaudreau scored twice, Ben Myers had a goal and two assists and the Seattle Kraken had a four-goal second period in a 6-3 victory over the Detroit Red Wings on Friday night.","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/3149649/frederick-gaudreau\">Frederick Gaudreau</a> scored twice, Ben Myers had a goal and two assists and the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> had a four-goal second period in a 6-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> on Friday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5657/philipp-grubauer\">Philipp Grubauer</a> made 38 saves in Seattle's first regulation victory in Detroit.\n\n\r\n              The fans at Little Caesars Arena’s chant of “Sell The Team! Sell The Team!” got louder and louder as the game drifted to a finish.\n\n\r\n              Detroit dominated early, putting eight shots on goal in the first seven minutes, but Grubauer made several tough saves.\n\n\r\n              The Red Wings were more successful with the man advantage, taking the lead at 9:19 when <a href=\"http://www.espn.com/nhl/player/_/id/3120307/viktor-arvidsson\">Viktor Arvidsson</a> tapped the puck across the line after Grubauer didn't cleanly handle <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a>'s shot. Arvidsson has power-play goals in each of Detroit's last three games.\n\n\r\n              Seattle was being outshot 16-3 before <a href=\"http://www.espn.com/nhl/player/_/id/5216877/berkly-catton\">Berkly Catton</a> took a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4565223/kaapo-kakko\">Kaapo Kakko</a>, drove to the net and put a backhander over Gibson's pad.\n\n\r\n              Detroit defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4697436/william-wallinder\">William Wallinder</a> made it 2-1 at 4:00 of the second with his first NHL goal, but the Kraken answered with three goals on their next four shots to take a two-goal lead.\n\n\r\n              Gaudreau got the first and third goals, both off passes from <a href=\"http://www.espn.com/nhl/player/_/id/4894928/ryan-winterton\">Ryan Winterton</a>. <a href=\"http://www.espn.com/nhl/player/_/id/4874741/mackie-samoskevich\">Mackie Samoskevich</a> scored the middle goal at 6:59 after Wallinder's turnover.\n\n\r\n              Myers, who had the secondary assist on both Gaudreau goals, made it 5-2 at 5:55 left — 12 seconds after coming out of the penalty box. Red Wings coach Todd McLellan pulled <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> and gave <a href=\"http://www.espn.com/nhl/player/_/id/4587994/daniil-tarasov\">Daniil Tarasov</a> his Detroit debut.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904189/vince-dunn\">Vince Dunn</a> extended the lead to 6-2 with 8:07 left in the in the third, scoring on a 5-on-3 power play, but <a href=\"http://www.espn.com/nhl/player/_/id/5216883/michael-brandsegg-nygard\">Michael Brandsegg-Nygard</a> became the second Red Wing to get his first NHL goal to make it 6-3.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kraken: At Washington on Sunday.\n\n\r\n              Red Wings: At Montreal on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">ee AP’s full NHL coverage here</a>","published":"2026-10-10T01:47:27Z"}}