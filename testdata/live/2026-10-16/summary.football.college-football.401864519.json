e":0.6971,"playId":"401864519272","tiePercentage":0},{"homeWinPercentage":0.7281,"playId":"401864519270","tiePercentage":0},{"homeWinPercentage":0.7279,"playId":"401864519277","tiePercentage":0},{"homeWinPercentage":0.7365,"playId":"401864519275","tiePercentage":0},{"homeWinPercentage":0.7359,"playId":"401864519282","tiePercentage":0},{"homeWinPercentage":0.7401,"playId":"401864519280","tiePercentage":0},{"homeWinPercentage":0.7382,"playId":"401864519286","tiePercentage":0},{"homeWinPercentage":0.7258,"playId":"401864519289","tiePercentage":0},{"homeWinPercentage":0.6622,"playId":"401864519293","tiePercentage":0},{"homeWinPercentage":0.6383,"playId":"401864519301","tiePercentage":0},{"homeWinPercentage":0.6172,"playId":"401864519306","tiePercentage":0},{"homeWinPercentage":0.6186,"playId":"401864519310","tiePercentage":0},{"homeWinPercentage":0.6373,"playId":"401864519313","tiePercentage":0},{"homeWinPercentage":0.639,"playId":"401864519318","tiePercentage":0}],"gameInfo":{"venue":{"id":"3935","guid":"721080bb-52d7-3464-9443-1b0ea92f084f","fullName":"CEFCU Stadium","address":{"city":"San Jose","state":"CA","zipCode":"95112","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3935.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":13104},"article":{"headline":"Erik Sandvik makes FG in OT as Wyoming beats San Jose State 16-13 to snap 8-game road losing streak","description":"— Tyler Hughes threw for a touchdown and ran for 92 yards, Erik Sandvik made a short field goal in overtime and Wyoming beat San Jose State 16-13 on Friday night to snap an eight-game road losing streak.","story":"SAN JOSE, Calif. -- — <a href=\"http://www.espn.com/college-football/player/_/id/4838536/tyler-hughes\" target=\"_new\">Tyler Hughes</a> threw for a touchdown and ran for 92 yards, <a href=\"http://www.espn.com/college-football/player/_/id/5163379/erik-sandvik\" target=\"_new\">Erik Sandvik</a> made a short field goal in overtime and Wyoming beat San Jose State 16-13 on Friday night to snap an eight-game road losing streak. \n\n\r\n              Hughes found tight end <a href=\"http://www.espn.com/college-football/player/_/id/5150863/jake-wilson\" target=\"_new\">Jake Wilson</a> in the back of the end zone with 6:25 left in the fourth quarter to tie it at 13-all. The third-down pass capped an 18-play, 75-yard drive.\n\n\r\n              San Jose State had the ball first in overtime, but <a href=\"http://www.espn.com/college-football/player/_/id/5295238/luke-weaver\" target=\"_new\">Luke Weaver</a>'s pass on fourth down was short of his receiver on the outside. \n\n\r\n              Hughes picked up a first down on a 6-yard scramble, and he followed it with a 12-yard run to get to the SJSU 2-yard line.\n\n\r\n              Hughes was 16-of-24 passing for 114 yards with an interception for Wyoming (3-3, 2-1 Mountain West Conference). He also carried it 27 times. Wilson caught seven passes for 39 yards. \n\n\r\n              Weaver was 26 of 38 for 251 yards with an interception for San Jose State (3-3, 1-1). <a href=\"http://www.espn.com/college-football/player/_/id/4685254/jabari-bates\" target=\"_new\">Jabari Bates</a> had 16 carries for 69 yards and a touchdown. <a href=\"http://www.espn.com/college-football/player/_/id/5161012/carson-clark\" target=\"_new\">Carson Clark</a> caught eight passes for 91 yards. \n\n\r\n              The Spartans were looking for their fifth straight home win over Wyoming. \n\n\r\n              <hl2>Up next</hl2>\r\n              Wyoming: Returns home to play Northern Illinois on Oct. 17.\n\n\r\n              San Jose State: At UTEP on Oct. 17.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-10T04:47:26Z"}}