01892468000001520","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Cole Koepke","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:52"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4419679","displayName":"Cole Koepke","shortName":"C. Koepke"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13693,"officials":[{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Trent Knorr","displayName":"Trent Knorr","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Judd Caulfield scores first NHL goal to help the Ducks beat the Jets 5-1","description":"— Rookie Judd Caulfield scored his first NHL goal and added an assist to help the Anaheim Ducks beat Winnipeg 5-1 on Friday night for the Jets' first regulation loss of the season.","story":"WINNIPEG, Manitoba -- — Rookie <a href=\"http://www.espn.com/nhl/player/_/id/4755684/judd-caulfield\">Judd Caulfield</a> scored his first NHL goal and added an assist to help the <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a> beat Winnipeg 5-1 on Friday night for the Jets' first regulation loss of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4996085/tim-washe\">Tim Washe</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5831/mikael-granlund\">Mikael Granlund</a> each had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4697441/sam-colangelo\">Sam Colangelo</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4755696/nikita-nesterenko\">Nikita Nesterenko</a> also scored to help the Ducks improve to 3-1-0. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4588165/lukas-dostal\">Lukas Dostal</a> stopped 15 shots for Anaheim, allowing only Kyle Conner's goal.\n\n\r\n              After the Jets trimmed it to 3-1 midway through the third period, Granlund sunk Winnipeg’s hopes with a goal with 5:54 remaining.\n\n\r\n              Conner, who was playing in his 700th NHL game, pulled the Jets to 3-1 when <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> sent him in alone on Dostal for his sixth goal of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5104602/clay-stevenson\">Clay Stevenson</a> made 12 saves for Winnipeg. The Jets are 3-1-1.\n\n\r\n              <hl2>Up next</hl2>\r\n              Ducks: At Calgary on Saturday night.\n\n\r\n              Jets: Host Minnesota on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-10T02:58:42Z"}}