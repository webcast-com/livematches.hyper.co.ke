0001220","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Trent Frederic hit Zayne Parekh","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:17"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"4024997","displayName":"Trent Frederic","shortName":"T. Frederic"},"type":"hit-credited"},{"athlete":{"id":"5216878","displayName":"Zayne Parekh","shortName":"Z. Parekh"},"type":"hitted"}]},{"id":"401892597000000060","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:36"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"5282","fullName":"Rogers Place","address":{"city":"Edmonton","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5282.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17032,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jarry makes 24 saves in the Oilers' 4-0 victory over the Flames","description":"— Tristan Jarry made 24 saves, Connor McDavid had two more points and the Edmonton Oilers beat the Calgary Flames 4-0 on Wednesday night to snap a two-game losing streak.","story":"EDMONTON, Alberta -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042020/tristan-jarry\">Tristan Jarry</a> made 24 saves, <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> had two more points and the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> 4-0 on Wednesday night to snap a two-game losing streak.\n\n\r\n              McDavid extended his season-starting points streak to 13 games, pushingv his NHL-best points total to 36. He also extended his campaign-starting assists streak to 13, setting a record by surpassing the likes of <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a>, Ken Linseman and Wayne Gretzky for the longest in NHL history.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3941965/mathieu-joseph\">Mathieu Joseph</a>, <a href=\"http://www.espn.com/nhl/player/_/id/2558631/mattias-ekholm\">Mattias Ekholm</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3114775/kasperi-kapanen\">Kasperi Kapanen</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233882/alex-formenton\">Alex Formenton</a> scored to help the Oilers improve to 9-2-2.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562624/ryan-nugent-hopkins\">Ryan Nugent-Hopkins</a> also had assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587952/dustin-wolf\">Dustin Wolf</a> made 20 saves for Calgary, coming in to replace <a href=\"http://www.espn.com/nhl/player/_/id/4319911/devin-cooley\">Devin Cooley</a> (eight saves) after he was injured late in the first period. Cooley was run over in the crease by forward <a href=\"http://www.espn.com/nhl/player/_/id/4874940/colton-dach\">Colton Dach</a>.\n\n\r\n              The Flames dropped to 5-7-0. They had won four in a row.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flames: Host Seattle on Friday night.\n\n\r\n              Oilers: At <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-29T03:39:45Z"}}