","displayName":"Sean Couturier","shortName":"S. Couturier"},"type":"hit-credited"},{"athlete":{"id":"3942924","displayName":"Matt Roy","shortName":"M. Roy"},"type":"hitted"}]},{"id":"401892596000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Strome Snap Shot saved by Joseph Woll","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"3899933","displayName":"Dylan Strome","shortName":"D. Strome"},"type":"shooter"},{"athlete":{"id":"4271575","displayName":"Joseph Woll","shortName":"J. Woll"},"type":"saver"}]},{"id":"401892596000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Porter Martone","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:43"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"5291941","displayName":"Porter Martone","shortName":"P. Martone"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1823","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17391,"officials":[{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kendrick Nicholson","displayName":"Kendrick Nicholson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Tuch scores 2 more goals, Capitals beat Flyers 5-2","description":"— Alex Tuch scored his eighth and ninth goals in his first season with Washington, the second into an empty net to help the Capitals seal a 5-2 victory over the Philadelphia Flyers on Wednesday night.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> scored his eighth and ninth goals in his first season with Washington, the second into an empty net to help the Capitals seal a 5-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Wednesday night.\n\n\r\n              Tuch arrived in a trade from Buffalo and signed an eight-year, $84-million contract extension in June. On Wednesday, he became only the second player in Capitals history to score at least nine goals in his first 11 games for the team, joining Dino Ciccarelli, who scored 12 times in his first 11 Caps appearances to close the 1988-89 season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4062251/jordan-kyrou\">Jordan Kyrou</a> also scored twice, and <a href=\"http://www.espn.com/nhl/player/_/id/4587943/aliaksei-protas\">Aliaksei Protas</a> added his first goal of the season as Washington completed a five-game homestand with four wins.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3899933/dylan-strome\">Dylan Strome</a> had three assists, and <a href=\"http://www.espn.com/nhl/player/_/id/4755690/jack-st-ivany\">Jack St. Ivany</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4024833/pierre-luc-dubois\">Pierre-Luc Dubois</a> each had two. <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> made 23 saves after missing a victory Saturday against Buffalo because of a lower-body injury.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149170/matvei-michkov\">Matvei Michkov</a> scored his ninth goal of the season and fifth on the power play for Philadelphia, which lost its third straight after an overtime defeat to visiting Columbus on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562601/sean-couturier\">Sean Couturier</a> leveled it early in the second, and <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a> made 25 stops for the Flyers.\n\n\r\n              Tuch got started only 1:50 into the game.\n\n\r\n              St. Ivany put the initial attempt on Woll’s net from outside the right faceoff circle, and Strome got a stick to the rebound before Tuch one-timed the puck past Woll from the slot.\n\n\r\n              Tuch put the game away more than 55 minutes later, taking a feed from Dubois on the break to score easily against the Flyers' 6-on-5.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flyers: Host Utah on Sunday.\n\n\r\n              Capitals: At Nashville on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-29T02:22:47Z"}}