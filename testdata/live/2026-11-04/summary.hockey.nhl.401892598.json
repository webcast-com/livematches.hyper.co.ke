ete":{"id":"3904177","displayName":"Mackenzie Blackwood","shortName":"M. Blackwood"},"type":"saver"}]},{"id":"401892598000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:32"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"892","fullName":"Ball Arena","address":{"city":"Denver","state":"CO","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/892.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18101,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Alex Lepkowski","displayName":"Alex Lepkowski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Garrett Rank","displayName":"Garrett Rank","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kadri, Kelly score in 1:02 span early in 3rd in Avalanche's 5-2 win over Devils","description":"— Nazem Kadri and Parker Kelly scored in a 1:02 span early in the third period and the Colorado Avalanche beat New Jersey 5-2 on Wednesday night to end the Devils' winning streak at four.","story":"DENVER -- — <a href=\"http://www.espn.com/nhl/player/_/id/5349/nazem-kadri\">Nazem Kadri</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4392309/parker-kelly\">Parker Kelly</a> scored in a 1:02 span early in the third period and the <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> beat New Jersey 5-2 on Wednesday night to end the Devils' winning streak at four.\n\n\r\n              Kadri gave Colorado a 2-1 lead at 2:45, and Kelly followed at 3:47. <a href=\"http://www.espn.com/nhl/player/_/id/3041969/nathan-mackinnon\">Nathan MacKinnon</a> added his eighth goal of the season with eight minutes remaining, and <a href=\"http://www.espn.com/nhl/player/_/id/5835/jaden-schwartz\">Jaden Schwartz</a> connected 30 seconds later.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904177/mackenzie-blackwood\">Mackenzie Blackwood</a> made 20 saves to help Colorado improve to 7-5-1.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3067951/connor-brown\">Connor Brown</a> scored twice for New Jersey.\n\n\r\n              Brown had a short-handed goal in the first period, and <a href=\"http://www.espn.com/nhl/player/_/id/2562609/gabriel-landeskog\">Gabriel Landeskog</a> tied it on a power play in the second.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5111/jake-allen\">Jake Allen</a> stopped 39 shots for the Devils. They are 8-5-0.\n\n\r\n              <hl2>Up next</hl2>\r\n              Devils: At Vegas on Friday night.\n\n\r\n              Avalanche: Host Calgary on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-29T03:46:45Z"}}