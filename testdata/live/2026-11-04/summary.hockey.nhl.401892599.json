"},{"athlete":{"id":"3096102","displayName":"Troy Stecher","shortName":"T. Stecher"},"type":"defender"}]},{"id":"401892599000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:25"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"7224","fullName":"Climate Pledge Arena","address":{"city":"Seattle","state":"WA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/7224.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17151,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Cody Beach","displayName":"Cody Beach","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Kraken outlast Maple Leafs 5-4 to spoil No. 1 overall pick Gavin McKenna’s big game","description":"— Defenseman Brandon Montour scored with 34 seconds left and the Seattle Kraken beat the Toronto Maple Leafs 5-4 on Wednesday to spoil No. 1 overall pick Gavin McKenna’s first two-goal game and three-point night.","story":"SEATTLE -- — Defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3115032/brandon-montour\">Brandon Montour</a> scored with 34 seconds left and the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> 5-4 on Wednesday to spoil No. 1 overall pick Gavin McKenna’s first two-goal game and three-point night.\n\n\r\n              After scoring on power plays in each of the first two periods, McKenna helped set up <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a>' tying goal with 1:30 remaining and goalie <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> off for an extra attacker.\n\n\r\n              Montour then beat Bobrovsky with a slapper from the top of the right circle. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3067858/chandler-stephenson\">Chandler Stephenson</a> had a goal and an assist to help Seattle improve to 8-4-1. <a href=\"http://www.espn.com/nhl/player/_/id/4874864/ryker-evans\">Ryker Evans</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5216877/berkly-catton\">Berkly Catton</a> and Josh Mahura also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/5657/philipp-grubauer\">Philipp Grubauer</a> made 18 saves.\n\n\r\n              Stephenson gave Seattle a 3-2 lead on a power play at 3:33 of the second period, and assisted on Evans' goal with 9:02 left.\n\n\r\n              McKenna has five goals in 15 games this season. Matthews has 10 goals.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904098/jack-roslovic\">Jack Roslovic</a> also scored for the Maple Leafs, cutting it to 4-3 at 8:02 of the third period. Bobrovsky stopped 12 shots as Toronto dropped to 7-6-2.\n\n\r\n              <hl2>Up next</hl2>\r\n              Maple Leafs: At Vancouver on Saturday night.\n\n\r\n              Kraken: At Calgary on Friday night.\n\n\r\n              ------\n\n\r\n              This story has been corrected to show the Maple Leafs will next play at Vancouver.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-29T04:51:46Z"}}