14,"playId":"4018730291825","tiePercentage":0},{"homeWinPercentage":0.7412,"playId":"4018730291883","tiePercentage":0},{"homeWinPercentage":0.7624,"playId":"4018730291905","tiePercentage":0},{"homeWinPercentage":0.7637,"playId":"4018730291916","tiePercentage":0},{"homeWinPercentage":0.7987,"playId":"4018730291927","tiePercentage":0},{"homeWinPercentage":0.7922,"playId":"4018730291956","tiePercentage":0},{"homeWinPercentage":0.7977,"playId":"4018730291967","tiePercentage":0},{"homeWinPercentage":0.7934,"playId":"4018730291978","tiePercentage":0}],"gameInfo":{"venue":{"id":"3839","guid":"604c24d0-2641-3553-82bc-1b005ac94765","fullName":"MetLife Stadium","address":{"city":"East Rutherford","state":"NJ","zipCode":"07073","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":70080,"officials":[{"fullName":"Allen Baynes","displayName":"Allen Baynes","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":3},{"fullName":"John Hussey","displayName":"John Hussey","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":1},{"fullName":"Tim Podraza","displayName":"Tim Podraza","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":2},{"fullName":"Matt Edwards","displayName":"Matt Edwards","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":4},{"fullName":"Duane Heydt","displayName":"Duane Heydt","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":5},{"fullName":"Brett Bergman","displayName":"Brett Bergman","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Gabriel DeLeon","displayName":"Gabriel DeLeon","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":7}]},"article":{"headline":"Raiders rally past the Jets 38-33 as Kirk Cousins leads a comeback to snap a 4-game skid","description":"— Kirk Cousins got up after his 1-yard touchdown run, crouched near the Raiders' sideline and started flapping his right elbow like a chicken wing.","story":"EAST RUTHERFORD, N.J. -- — <a href=\"http://www.espn.com/nfl/player/_/id/14880/kirk-cousins\">Kirk Cousins</a> got up after his 1-yard touchdown run, crouched near the Raiders' sideline and started <a href=\"https://x.com/Raiders/status/2116987164341010723?a=LI9IuOhWagckrGfKuZo&s=20\">flapping his right elbow</a> like a chicken wing.\n\n\r\n              It made for a viral social media moment on a day filled with highlights for the Las Vegas quarterback.\n\n\r\n              Cousins threw three touchdown passes, including a go-ahead 2-yard toss to <a href=\"http://www.espn.com/nfl/player/_/id/4382466/jalen-nailor\">Jalen Nailor</a> in the fourth quarter, to help the Raiders snap a four-game skid with a 38-33 comeback victory over the <a href=\"http://www.espn.com/nfl/team/_/name/nyj/new-york-jets\">New York Jets</a> on Sunday.\n\n\r\n              Oh, and there was that curious celebration after his TD run made it a two-point game in the third quarter.\n\n\r\n              “I call that my wellness celebration,” the 38-year-old quarterback said with a smile. “We do a lot of tissue work here. At my age, it’s especially helpful. ... So I said someday if I run a touchdown in, I’m going to give a shoutout to all the staff that works so hard to help us feel good and be one of the healthier teams in the league.”\n\n\r\n              Cousins initially forgot to do it until <a href=\"http://www.espn.com/nfl/player/_/id/4432665/brock-bowers\">Brock Bowers</a>, who caught two TD passes from Cousins, reminded him.\n\n\r\n              “Brock, who doesn’t say much,\" Cousins said, \"goes: ‘Hit them with the wellness celebration!’\"\n\n\r\n              Cousins and the Raiders (4-4) certainly felt pretty good after this one, which was sealed when <a href=\"http://www.espn.com/nfl/player/_/id/4043169/jeremy-chinn\">Jeremy Chinn</a> made a toe-tapping interception in the end zone on a desperation heave by <a href=\"http://www.espn.com/nfl/player/_/id/15864/geno-smith\">Geno Smith</a> in the closing seconds.\n\n\r\n              Cousins was 19 of 26 for 247 yards and rookie <a href=\"http://www.espn.com/nfl/player/_/id/4686658/mike-washington-jr\">Mike Washington Jr</a>. ran for 83 yards on 25 carries for the Raiders, who trailed the Jets (2-6) by nine at halftime and allowed New York to score on its first six possessions. <a href=\"http://www.espn.com/nfl/player/_/id/4366963/dylan-laube\">Dylan Laube</a> returned a kickoff 95 yards for a touchdown.\n\n\r\n              “It took everything we had today, but it’s great to get a win,” Cousins said. “To be .500 in November now and playing meaningful football is important.\"\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4890973/ashton-jeanty\">Ashton Jeanty</a>, who earlier in the week said it seemed the Jets' defense has players <a href=\"https://apnews.com/article/jets-raiders-jeanty-5241951ae3d38949abea8da5297afc4a\">who don't like to tackle</a>, ran for 9 yards on just two carries in a reduced role but caught three passes for 64 yards — including a big play on the go-ahead scoring drive.\n\n\r\n              With the Raiders trailing by two, Cousins tossed a screen pass to Jeanty — who stumbled and then zipped downfield for 45 yards to get to the Jets 13. \n\n\r\n              “Ashton is still going to be a big part of our team,\" coach <a href=\"http://www.espn.com/nfl/player/_/id/2181979/klint-kubiak\">Klint Kubiak</a> said. \"He made a huge catch. He’s going to be a huge part of our run game going forward.”\n\n\r\n              Five plays later, Cousins connected with Nailor to put Las Vegas up 35-30 with 11:33 remaining.\n\n\r\n              After New York got a 31-yard field goal by <a href=\"http://www.espn.com/nfl/player/_/id/3124679/jason-sanders\">Jason Sanders</a>, Las Vegas chewed up the clock and got a 53-yarder by <a href=\"http://www.espn.com/nfl/player/_/id/4249087/matt-gay\">Matt Gay</a> with 31 seconds remaining.\n\n\r\n              The Jets got the ball at their 35 with 27 seconds left and a 15-yard catch by <a href=\"http://www.espn.com/nfl/player/_/id/4569618/garrett-wilson\">Garrett Wilson</a> and an unnecessary roughness call on Chinn put the ball at the Raiders 35. But Smith's throw into the end zone with 14 seconds left was picked off by Chinn.\n\n\r\n              “It’s an understatement to say that we’re all disappointed in the way this one ended,\" Jets coach Aaron Glenn said, \"with not getting a victory in this game.”\n\n\r\n              Smith was 20 of 32 for 290 yards and touchdowns to <a href=\"http://www.espn.com/nfl/player/_/id/4597500/adonai-mitchell\">Adonai Mitchell</a> and <a href=\"http://www.espn.com/nfl/player/_/id/2574302/isaiah-williams\">Isaiah Williams</a> and the INT for the Jets, who have dropped three in a row. <a href=\"http://www.espn.com/nfl/player/_/id/4685247/braelon-allen\">Braelon Allen</a> ran for 147 yards and a touchdown on 21 carries.\n\n\r\n              “I think we didn’t do enough to win the game,\" Smith said. \"So that’s really where my focus is, is how can we improve and get better so that we can finish the game?”\n\n\r\n              <hl2>Jets and Raiders go back and forth on the scoreboard to start the game</hl2>\r\n              <hl2 />\r\n              The Jets got a 21-yard field goal by Sanders on their opening drive, and the Raiders followed with Cousins' 12-yard TD pass to Bowers on third-and-goal.\n\n\r\n              Sanders kicked a 36-yarder and Smith threw an 18-yard touchdown pass to Williams on New York's third drive. But Las Vegas snatched the lead right back when Laube returned the ensuing kickoff 95 yards for a touchdown to put the Raiders back up, 14-13. It was the first kickoff returned for a TD in the NFL this season, and the first of Laube's three-year career.\n\n\r\n              Smith's over-the-shoulder fade pass to Mitchell on fourth-and-1 from the 12 for a touchdown put New York up 20-14. \n\n\r\n              <hl2>New York gets a rare score right before halftime</hl2>\r\n              The Jets entered having been outscored 107-6 in the final two minutes of the opening half in two seasons under Glenn. They got a 39-yard field goal to go up 23-14 with 9 seconds left for their first points this season in the last two minutes of the first half.\n\n\r\n              Las Vegas made it a two-point game at 23-21 on Cousins' 2-yard TD pass to Bowers to open the second half.\n\n\r\n              After Allen rumbled 21 yards for a touchdown to put the Jets up 30-21, Cousins pushed forward and over the goal line for a 1-yard TD.\n\n\r\n              The Jets' scoring streak ended on their seventh drive late in the third quarter.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Raiders CB <a href=\"http://www.espn.com/nfl/player/_/id/4430330/darien-porter\">Darien Porter</a> didn't return after injuring his groin on Las Vegas' first defensive play.\n\n\r\n              <hl2>Up next</hl2>\r\n              Raiders: Face the 49ers in San Francisco next Sunday.\n\n\r\n              Jets: Travel to Kansas City to face the Chiefs next Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-01T21:40:46Z"}}