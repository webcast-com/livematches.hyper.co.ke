ron","shortName":"M. Barron"}}]},{"id":"401892601000000940","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Giveaway by Conor Geekie","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"5080155","displayName":"Conor Geekie","shortName":"C. Geekie"},"type":"giver"}]},{"id":"401892601000000950","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Giveaway by Mario Ferraro","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:39"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4233884","displayName":"Mario Ferraro","shortName":"M. Ferraro"},"type":"giver"}]},{"id":"401892601000001000","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Giveaway by Cole Koepke","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:53"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4419679","displayName":"Cole Koepke","shortName":"C. Koepke"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1396","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Libor Suchanek","displayName":"Libor Suchanek","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Holmberg has a career-high 4 points as the Lightning beat the Jets 6-4 to remain unbeaten at home","description":"— Pontus Holmberg set a career high with four points on a goal and three assists, Brandon Hagel and Anthony Cirelli each had a goal and two assists, and the Tampa Bay Lightning remain unbeaten at home with a 6-4 victory over the Winnipeg Jets on...","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4588205/pontus-holmberg\">Pontus Holmberg</a> set a career high with four points on a goal and three assists, <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> each had a goal and two assists, and the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> remain unbeaten at home with a 6-4 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3151187/brayden-point\">Brayden Point</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080155/conor-geekie\">Conor Geekie</a> all scored for Tampa Bay. <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> stopped 17 shots.\n\n\r\n              The Lightning improved to 6-0 at home to tie a franchise record to start a season. \n\n\r\n              Neil Pionk, playing his 600th game, scored twice. <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233878/dylan-samberg\">Dylan Samberg</a> also scored for the Jets and Mark Scheilffele had three assists. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> allowed five goals on 21 shots before being replaced by <a href=\"http://www.espn.com/nhl/player/_/id/4697683/nico-daws\">Nico Daws</a> to start the third period. Daws finished with nine saves in his Winnipeg debut.\n\n\r\n              Winnipeg is winless (0-5-2) in the past seven games, including three consecutive regulation losses since trading goaltender <a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> to New Jersey. \n\n\r\n              The Jets' last victory came on Oct. 13.\n\n\r\n              After Point and Pionk traded goals in the first period, Tampa Bay pulled away in the second period with four goals, including three in the final 4:04.\n\n\r\n              Geekie backhanded in a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4997033/dominic-james\">Dominic James</a> at 9:43 before Cirelli scored a power-play goal at 15:56, getting his stick on a cross-crease pass from Holmberg. Carlson made it 4-1 at 18:07 as he one-timed Holmberg's pass from the left faceoff dot. Hagel finished off the period with a tap-in from Cirelli at the back post with 56 seconds left in the period.\n\n\r\n              Winnipeg scored two goals less than two minutes apart in the third to cut into the lead. Perfetti fed Samberg for a one-handed redirect at 7:00 while Pionk scored his second at 8:50, with <a href=\"http://www.espn.com/nhl/player/_/id/4697401/dawson-mercer\">Dawson Mercer</a> registering his first point with the Jets on the play. Connor scored with 2:49 left to make it a one-goal game.\n\n\r\n              Holmberg added an empty-net goal with 1:33 left.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: At <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> on Friday.\n\n\r\n              Lightning: At Nashville on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-30T02:03:45Z"}}