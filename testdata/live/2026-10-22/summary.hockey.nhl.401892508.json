id":"401892508000001380","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Nick Seeler hit Alex DeBrincat","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:02"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"2564164","displayName":"Nick Seeler","shortName":"N. Seeler"},"type":"hit-credited"},{"athlete":{"id":"4063433","displayName":"Alex DeBrincat","shortName":"A. DeBrincat"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"5404","guid":"6be97869-fecf-343e-bc15-c9fef2f0ced1","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17551,"officials":[{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Red Wings send Flyers to franchise record-extending 9th straight loss to start season","description":"— Andrew Copp broke a tie with 4:38 left and the Detroit Red Wings sent the Philadelphia Flyers to their franchise record-extending ninth straight loss to start the season, winning 2-1 on Thursday night.","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042114/andrew-copp\">Andrew Copp</a> broke a tie with 4:38 left and the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> sent the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> to their franchise record-extending ninth straight loss to start the season, winning 2-1 on Thursday night.\n\n\r\n              The Flyers dropped to 0-6-3. The skid is tied for the ninth-longest in the NHL to open a season, and worst since San Jose started 0-7-2 in 2024-25. Three teams have gone winless in their first 10 games, and the record is held by the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a>, who opened the 1943-44 season with 14 losses and a tie.\n\n\r\n              After Copp put Detroit ahead with a point-blank shot, the Flyers had one more chance but <a href=\"http://www.espn.com/nhl/player/_/id/5149199/oliver-bonk\">Oliver Bonk</a> shot wide from 10 feet with eight seconds left.\n\n\r\n              The Flyers scored first when <a href=\"http://www.espn.com/nhl/player/_/id/5149170/matvei-michkov\">Matvei Michkov</a>'s baseball swing put a bouncing puck past <a href=\"http://www.espn.com/nhl/player/_/id/4587994/daniil-tarasov\">Daniil Tarasov</a> with 2:28 left in the first period.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114755/dylan-larkin\">Dylan Larkin</a> set up the tying goal, passing across the slot on a 2-on-1 to set up Anton Johansson’s first NHL goal at 4:31 of the second period.\n\n\r\n              Johannson is the third Scandanavian rookie to score his first career goal this season for Detroit, joining fellow Swede <a href=\"http://www.espn.com/nhl/player/_/id/4697436/william-wallinder\">William Wallinder</a> and Norwegian <a href=\"http://www.espn.com/nhl/player/_/id/5216883/michael-brandsegg-nygard\">Michael Brandsegg-Nygard</a>.\n\n\r\n              Tarasov stopped 17 shots. <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a> made 24 saves for Philadelphia.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flyers: Host Ottawa on Saturday night.\n\n\r\n              Red Wings: Host San Jose on Saturday night.","published":"2026-10-16T02:30:27Z"}}