{"header":{"id":"401873003","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873003","uid":"s:20~l:28~e:401873003~c:401873003","date":"2026-10-18T17:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"11","uid":"s:20~l:28~t:11","order":0,"homeAway":"home","winner":false,"score":"20","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"13"},{"displayValue":"0"},{"displayValue":"7"}],"team":{"id":"11","abbreviation":"IND","displayName":"Indianapolis Colts","name":"Colts","location":"Indianapolis","nickname":"Colts","color":"003b75","alternateColor":"ffffff","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ind.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/ind.png"}]}},{"id":"10","uid":"s:20~l:28~t:10","order":1,"homeAway":"away","winner":true,"score":"26","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"0"},{"displayValue":"6"},{"displayValue":"20"}],"team":{"id":"10","abbreviation":"TEN","displayName":"Tennessee Titans","name":"Titans","location":"Tennessee","nickname":"Titans","color":"4495d2","alternateColor":"001532","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ten.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/ten.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"10","abbreviation":"TEN","displayName":"Tennessee Titans","shortDisplayName":"Titans","name":"Titans","location":"Tennessee","color":"4495d2","alternateColor":"001532","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ten.png"},"statistics":[{"name":"firstDowns","value":11,"displayValue":"11","label":"1st Downs"},{"name":"firstDownsPassing","value":6,"displayValue":"6","label":"Passing 1st downs"},{"name":"firstDownsRushing","value":4,"displayValue":"4","label":"Rushing 1st downs"},{"name":"firstDownsPenalty","value":1,"displayValue":"1","label":"1st downs from penalties"},{"name":"thirdDownEff","value":0.3,"displayValue":"3-10","label":"3rd down efficiency"},{"name":"fourthDownEff","value":"-","displayValue":"0-0","label":"4th down efficiency"},{"name":"totalOffensivePlays","value":45,"displayValue":"45","label":"Total Plays"},{"name":"totalYards","value":"-","displayValue":"186","label":"Total Yards"},{"name":"yardsPerPlay","value":4.1333333333,"displayValue":"4.1","label":"Yards per Play"},{"name":"totalDrives","value":10,"displayValue":"10","label":"Total Drives"},{"name":"netPassingYards","value":102,"displayValue":"102","label":"Passing"},{"name":"completionAttempts","value":"-","displayValue":"11/22","label":"Comp/Att"},{"name":"yardsPerPass","value":4.636363636363637,"displayValue":"4.6","label":"Yards per pass"},{"name":"interceptions","value":1,"displayValue":"1","label":"Interceptions thrown"},{"name":"sacksYardsLost","value":"-","displayValue":"0-0","label":"Sacks-Yards Lost"},{"name":"rushingYards","value":84,"displayValue":"84","label":"Rushing"},{"name":"rushingAttempts","value":23,"displayValue":"23","label":"Rushing Attempts"},{"name":"yardsPerRushAttempt","value":3.652,"displayValue":"3.7","label":"Yards per rush"},{"name":"redZoneAttempts","value":0.5,"displayValue":"1-2","label":"Red Zone (Made-Att)"},{"name":"totalPenaltiesYards","value":"-","displayValue":"8-54","label":"Penalties"},{"name":"turnovers","value":"-","displayValue":"1","label":"Turnovers"},{"name":"fumblesLost","value":0,"displayValue":"0","label":"Fumbles lost"},{"name":"interceptions","value":1,"displayValue":"1","label":"Interceptions thrown"},{"name":"defensiveTouchdowns","value":1,"disp