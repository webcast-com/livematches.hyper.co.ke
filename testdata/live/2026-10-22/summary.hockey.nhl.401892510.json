er"},{"athlete":{"id":"4996099","displayName":"Max Sasson","shortName":"M. Sasson"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1840","guid":"f00bda1b-21b7-372c-838c-b5c9977d1834","fullName":"Amerant Bank Arena","address":{"city":"Sunrise","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1840.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18900,"officials":[{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Brady Tkachuk completes his 2nd straight natural hat trick in OT as Panthers stun Canucks","description":"— Brady Tkachuk completed his second straight natural hat trick with a nifty move up the middle in overtime to give the Florida Panthers a 3-2 victory over the Vancouver Canucks on Thursday night.","story":"SUNRISE, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> completed his second straight natural hat trick with a nifty move up the middle in overtime to give the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> a 3-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> on Thursday night.\n\n\r\n              Tkachuk also scored three straight goals Tuesday night in Columbus in the second period of a 7-3 victory over the Blue Jackets.\n\n\r\n              With goalie <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a> off for an extra attacker, Tkachuk tied it with 13 seconds left in regulation with a one-timer from the right faceoff circle. He started the run with 8:49 to go, firing a shot from the top of the right circle past goalie <a href=\"http://www.espn.com/nhl/player/_/id/4894703/leevi-merilainen\">Leevi Merilainen</a>.\n\n\r\n              Merilainen made 36 saves, and <a href=\"http://www.espn.com/nhl/player/_/id/5080163/liam-ohgren\">Liam Ohgren</a> and defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4233566/elias-pettersson\">Elias Pettersson</a> scored first-period goals for Vancouver. The Canucks have lost six straight, the last five to start a six-game trip.\n\n\r\n              Schmid stopped 15 shots.\n\n\r\n              Ohgren opened the scoring at 7:23. After a Florida turnover, he took a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4587713/linus-karlsson\">Linus Karlsson</a> and snapped in a shot from the high slot.\n\n\r\n              Pettersson struck with 2:54 left in the first with his third goal of the season. <a href=\"http://www.espn.com/nhl/player/_/id/4233643/filip-chytil\">Filip Chytil</a> — making his season debut after returning from preseason shoulder injury — set up the defender for a shot from the slot. \n\n\r\n              The Panthers lost forward <a href=\"http://www.espn.com/nhl/player/_/id/4233877/eetu-luostarinen\">Eetu Luostarinen</a> midway through the third period when he crashed into the back boards off a clean hit from Pettersson.\n\n\r\n              Before the game, the Canucks traded Aatu Raty to Toronto for fellow forwards Jacob Quillan and Brandon Buhr.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canucks: At Tampa Bay on Saturday.\n\n\r\n              Panthers: Host Seattle on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-16T02:01:27Z"}}