:"saver"}]},{"id":"401892511000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Braden Schneider","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"1:30"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4697402","displayName":"Braden Schneider","shortName":"B. Schneider"},"type":"taker"}]},{"id":"401892511000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Braden Schneider shot blocked by Johnathan Kovacevic","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:40"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"4697402","displayName":"Braden Schneider","shortName":"B. Schneider"},"type":"shooter"},{"athlete":{"id":"4587933","displayName":"Johnathan Kovacevic","shortName":"J. Kovacevic"},"type":"defender"}]},{"id":"401892511000000830","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Amadeus Lombardi Wrist Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"2:20"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"5173500","displayName":"Amadeus Lombardi","shortName":"A. Lombardi"},"type":"shooter"},{"athlete":{"id":"4697705","displayName":"Dylan Garand","shortName":"D. Garand"}}]}],"gameInfo":{"venue":{"id":"1826","fullName":"Prudential Center","address":{"city":"Newark","state":"NJ","zipCode":"07199","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1826.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16527,"officials":[{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Devils score four goals in just over five minutes on the way to routing the Rangers 7-1","description":"— Evan Rodrigues scored with 29.6 seconds left in the first period to begin a barrage of four goals in just over five minutes, and the New Jersey Devils rolled over the New York Rangers 7-1 on Thursday night in the first matchup this season between...","story":"NEWARK, N.J. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3648008/evan-rodrigues\">Evan Rodrigues</a> scored with 29.6 seconds left in the first period to begin a barrage of four goals in just over five minutes, and the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> rolled over the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> 7-1 on Thursday night in the first matchup this season between the cross-Hudson River rivals.\n\n\r\n              The bubble burst on the Rangers and <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a>, the minor-league callup who had been spectacular in his first two starts — <a href=\"https://apnews.com/b5e780701acd76585415e7c07191b21e\">and wins</a> — since franchise goaltender <a href=\"https://apnews.com/article/igor-shesterkin-rangers-knee-injury-dbd661e9c2097c02d217e9496c717ae6\"><a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a> was lost</a> to a season-ending injury. Teammates did him few favors this time.\n\n\r\n              Captain <a href=\"http://www.espn.com/nhl/player/_/id/2590852/jt-miller\">J.T. Miller</a>, who was spectacular on a 5-on-3 penalty kill and had a strong offensive-zone shift near the end of the first, whiffed on a passing attempt that put the puck on Rodrigues' stick in prime scoring territory. Top-pairing defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3942292/vladislav-gavrikov\">Vladislav Gavrikov</a> had a giveaway that led to <a href=\"http://www.espn.com/nhl/player/_/id/4874719/luke-hughes\">Luke Hughes</a>' first of two goals, which came 18 seconds out of intermission.\n\n\r\n              Garand made a puck-handling mistake that led to Devils captain <a href=\"http://www.espn.com/nhl/player/_/id/4233555/nico-hischier\">Nico Hischier</a> scoring on a tap-in. The shift after New York coach Mike Sullivan called timeout to attempt to stunt his opponent's momentum, <a href=\"http://www.espn.com/nhl/player/_/id/4915855/arseny-gritsyuk\">Arseny Gritsyuk</a> scored on a juicy rebound to end Garand's night following four goals on 13 shots.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042069/spencer-martin\">Spencer Martin</a> allowed goals to Hughes, <a href=\"http://www.espn.com/nhl/player/_/id/2562623/stefan-noesen\">Stefan Noesen</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233568/cody-glass\">Cody Glass</a> in relief.\n\n\r\n              New Jersey's <a href=\"http://www.espn.com/nhl/player/_/id/4697683/nico-daws\">Nico Daws</a> was perfect until <a href=\"http://www.espn.com/nhl/player/_/id/4587588/pavel-dorofeyev\">Pavel Dorofeyev</a> scored a deflection goal on a power play in the third and finished with 18 saves. Hughes registered the first multigoal game of his NHL career, while <a href=\"http://www.espn.com/nhl/player/_/id/3899978/timo-meier\">Timo Meier</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3025535/brett-pesce\">Brett Pesce</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5173500/amadeus-lombardi\">Amadeus Lombardi</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697401/dawson-mercer\">Dawson Mercer</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2562605/dougie-hamilton\">Dougie Hamilton</a> each had a pair of assists for the Devils, who won their second in a row and handed the Rangers just their third defeat in nine games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Rangers: Visit Columbus on Saturday night.\n\n\r\n              Devils: Visit Washington on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-16T01:43:27Z"}}