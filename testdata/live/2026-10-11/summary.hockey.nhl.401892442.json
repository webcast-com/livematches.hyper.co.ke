,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4316970","displayName":"Morgan Barron","shortName":"M. Barron"},"type":"hit-credited"},{"athlete":{"id":"5188599","displayName":"Emmitt Finnie","shortName":"E. Finnie"},"type":"hitted"}]},{"id":"401892442000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Michael Brandsegg-Nygård Tip-In saved by Stuart Skinner","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:31"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"5216883","displayName":"Michael Brandsegg-Nygard","shortName":"M. Brandsegg-Nygard"},"type":"shooter"},{"athlete":{"id":"4268767","displayName":"Stuart Skinner","shortName":"S. Skinner"},"type":"saver"}]},{"id":"401892442000011910","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Viktor Arvidsson Wrist Shot saved by Stuart Skinner","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:32"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"3120307","displayName":"Viktor Arvidsson","shortName":"V. Arvidsson"},"type":"shooter"},{"athlete":{"id":"4268767","displayName":"Stuart Skinner","shortName":"S. Skinner"},"type":"saver"}]},{"id":"401892442000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Emmitt Finnie shot blocked by Neal Pionk","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"5188599","displayName":"Emmitt Finnie","shortName":"E. Finnie"},"type":"shooter"},{"athlete":{"id":"3988847","displayName":"Neal Pionk","shortName":"N. Pionk"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"5404","guid":"6be97869-fecf-343e-bc15-c9fef2f0ced1","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17426,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kyle Connor scores a pair of power-play goals as Jets squeak past Red Wings 3-2","description":"— Kyle Connor scored two of Winnipeg's three power-play goals and added an assist on the third as the Jets held off the Detroit Red Wings 3-2 on Sunday.","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> scored two of Winnipeg's three power-play goals and added an assist on the third as the Jets held off the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> 3-2 on Sunday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697392/cole-perfetti\">Cole Perfetti</a> scored the Jets' other goal and had two assists, while <a href=\"http://www.espn.com/nhl/player/_/id/3042016/josh-morrissey\">Josh Morrissey</a> also had two assists. <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> made 33 saves in Winnipeg's first victory. The <a href=\"https://apnews.com/article/bruins-jets-score-6b78a34d31514ce797a17ea19e0baca2\">Jets lost to Boston in overtime</a> in their season opener on Friday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3120307/viktor-arvidsson\">Viktor Arvidsson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5188599/emmitt-finnie\">Emmitt Finnie</a> scored for the Red Wings and <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> stopped 24 saves. <a href=\"https://apnews.com/article/rangers-red-wings-score-7e54d97cfe78e7930b5d7de38417247c\">Detroit was blanked 2-0 by the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a></a> in its opener on Friday.\n\n\r\n              Prominent members of the United States' gold-medal squad at the Milan Cortina Olympics were not on the ice. Detroit center <a href=\"http://www.espn.com/nhl/player/_/id/3114755/dylan-larkin\">Dylan Larkin</a> was sidelined with an upper-body injury, while Winnipeg goaltender <a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> remained on the suspended/inactive list. Both players have requested trades from their teams.\n\n\r\n              Detroit defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4874720/simon-edvinsson\">Simon Edvinsson</a> (unsigned) and forward <a href=\"http://www.espn.com/nhl/player/_/id/5080152/marco-kasper\">Marco Kasper</a> (upper body) also missed the game.\n\n\r\n              The Jets took advantage of unsportsmanlike conduct penalties against <a href=\"http://www.espn.com/nhl/player/_/id/3941546/keegan-kolesar\">Keegan Kolesar</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3041995/jt-compher\">J.T. Compher</a> in the first period on goals by Perfetti and Connor.\n\n\r\n              Connor scored his second power-play goal from the right circle during the second period. Arvidsson ended the Red Wings' scoring drought with 3:08 left in the period.\n\n\r\n              Finnie's goal at 4:56 of the third cut the Jets' lead to 3-2. The Red Wings failed to take advantage of a late power-play opportunity and Skinner made a nifty save against <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> in the final minute to preserve the Jets' lead.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: Visit Pittsburgh on Monday.\n\n\r\n              Red Wings: Host Ottawa on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-04T19:52:27Z"}}