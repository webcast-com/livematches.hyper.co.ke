{"header":{"id":"401872969","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401872969","uid":"s:20~l:28~e:401872969~c:401872969","date":"2026-10-04T17:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"4","uid":"s:20~l:28~t:4","order":0,"homeAway":"home","winner":false,"score":"17","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"3"},{"displayValue":"7"},{"displayValue":"7"}],"team":{"id":"4","abbreviation":"CIN","displayName":"Cincinnati Bengals","name":"Bengals","location":"Cincinnati","nickname":"Bengals","color":"fb4f14","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/cin.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/cin.png"}]}},{"id":"30","uid":"s:20~l:28~t:30","order":1,"homeAway":"away","winner":true,"score":"22","possession":false,"linescores":[{"displayValue":"3"},{"displayValue":"10"},{"displayValue":"3"},{"displayValue":"6"}],"team":{"id":"30","abbreviation":"JAX","displayName":"Jacksonville Jaguars","name":"Jaguars","location":"Jacksonville","nickname":"Jaguars","color":"007487","alternateColor":"d7a22a","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/jax.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/jax.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"30","abbreviation":"JAX","displayName":"Jacksonville Jaguars","shortDisplayName":"Jaguars","name":"Jaguars","location":"Jacksonville","color":"007487","alternateColor":"d7a22a","logo":"https://a.espncdn.com/i