Play":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:15"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892482000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Strome faceoff won against Ben Meyers","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:15"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"3899933","displayName":"Dylan Strome","shortName":"D. Strome"},"type":"face-off-winner"},{"athlete":{"id":"4755729","displayName":"Ben Meyers","shortName":"B. Meyers"}}]},{"id":"401892482000000780","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Alex Ovechkin Slap Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:16"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"3101","displayName":"Alex Ovechkin","shortName":"A. Ovechkin"},"type":"shooter"},{"athlete":{"id":"3942073","displayName":"Joey Daccord","shortName":"J. Daccord"}}]}],"gameInfo":{"venue":{"id":"1823","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18107,"officials":[{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kraken overcome Alex Ovechkin's first goal of the season to beat the Capitals 5-3","description":"— Jared McCann broke a tie with 5:27 left and the Seattle Kraken overcame NHL career leader Alex Ovechkin's first goal of the season to beat the Washington Capitals 5-3 on Sunday night.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114777/jared-mccann\">Jared McCann</a> broke a tie with 5:27 left and the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> overcame NHL career leader <a href=\"http://www.espn.com/nhl/player/_/id/3101/alex-ovechkin\">Alex Ovechkin</a>'s first goal of the season to beat the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> 5-3 on Sunday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5032/jordan-eberle\">Jordan Eberle</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3149649/frederick-gaudreau\">Frederick Gaudreau</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4565223/kaapo-kakko\">Kaapo Kakko</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4894928/ryan-winterton\">Ryan Winterton</a> also scored to help the Kraken improve to 4-2-0. <a href=\"http://www.espn.com/nhl/player/_/id/3942073/joey-daccord\">Joey Daccord</a> stopped 33 shots.\n\n\r\n              On the deciding goal, McCann cut to the middle and beat goalie <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> on a quick shot. Ryan Winterton iced it with 2:40 left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4062251/jordan-kyrou\">Jordan Kyrou</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2563054/boone-jenner\">Boone Jenner</a> also scored for Washington as the Capitals dropped to 3-2-0. Thompson made 22 saves.\n\n\r\n              After back-to-back penalty kills, Seattle got off to a quick start, with Kakko sneaking in a rebound just 6:06 minutes into the game.\n\n\r\n              The Capitals responded with two goals in a 5:06 span. First, Kyrou buried a cross-ice feed from <a href=\"http://www.espn.com/nhl/player/_/id/5216918/cole-hutson\">Cole Hutson</a> for his first with Washington. Then, after a strong forecheck and forced turnover from brothers Aliaksei and <a href=\"http://www.espn.com/nhl/player/_/id/5229146/ilya-protas\">Ilya Protas</a>, Ovechkin got the puck alone in front and sniped a quick shot past Daccord for his 930th NHL goal.\n\n\r\n              After Eberle tied it with 10 seconds left in the first, the Kraken pulled ahead 3-2 with 6:36 to go in the second when Gaudreau slid a backhander past Thompson. The Capitals tied it 46 seconds into the third, with Jenner scoring off this own rebound.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kraken: At Philadelphia on Tuesday night.\n\n\r\n              Capitals: At Carolina on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-12T00:00:27Z"}}