hortName":"S. Benoit"},"type":"giver"}]},{"id":"401892484000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jaccob Slavin shot blocked by David Jiricek","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"3069836","displayName":"Jaccob Slavin","shortName":"J. Slavin"},"type":"shooter"},{"athlete":{"id":"5080147","displayName":"David Jiricek","shortName":"D. Jiricek"},"type":"defender"}]},{"id":"401892484000002010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Sebastian Aho Snap Shot Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"3904173","displayName":"Sebastian Aho","shortName":"S. Aho"},"type":"shooter"},{"athlete":{"id":"4271575","displayName":"Joseph Woll","shortName":"J. Woll"}}]},{"id":"401892484000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jackson Blake shot blocked by Nick Seeler","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:16"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"5103645","displayName":"Jackson Blake","shortName":"J. Blake"},"type":"shooter"},{"athlete":{"id":"2564164","displayName":"Nick Seeler","shortName":"N. Seeler"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1845","fullName":"Xfinity Mobile Arena","address":{"city":"Philadelphia","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1845.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18914,"officials":[{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"CJ Murray","displayName":"CJ Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Hurricanes send Flyers to franchise-record 7th straight loss to open season","description":"— Andrei Svechnikov and Sebastian Aho each had a goal and an assist and the Carolina Hurricanes beat Philadelphia 4-1 on Sunday night, handing the Flyers their franchise-record seventh straight loss to open the season.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nhl/player/_/id/4352683/andrei-svechnikov\">Andrei Svechnikov</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> each had a goal and an assist and the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> beat Philadelphia 4-1 on Sunday night, handing the Flyers their franchise-record seventh straight loss to open the season.\n\n\r\n              The Flyers dropped to 0-5-2, breaking the record set by the 1999-00 team and matched by the 2008-09 squad. Both of those teams rebounded to make the playoffs. \n\n\r\n              Carolina earned at least a point in its 12th straight game in Philadelphia. The defending champion Hurricanes have won five in a row after dropping their first two.\n\n\r\n              Flyers rookie defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5149199/oliver-bonk\">Oliver Bonk</a> had a rough second period in his season debut and was a factor in three Carolina goals.\n\n\r\n              Svecnhikov scored his fourth goal of the season at 10:16 of the second period to open the scoring. Bonk turned it over to former Flyer <a href=\"http://www.espn.com/nhl/player/_/id/4272905/sean-walker\">Sean Walker</a> at the blue line, and Walker fed Svechnikov, who skated into the slot and snapped a wrister past goalie <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a>. \n\n\r\n              Aho fed a pass through Bonk, who turned around at the side of his own net, to another former Flyer, <a href=\"http://www.espn.com/nhl/player/_/id/3025662/shayne-gostisbehere\">Shayne Gostisbehere</a>, who banged home his second goal of the season to make it 2-0. Both of Gostisbehere's goals this season have come against his former team.\n\n\r\n              Aho later netted his sixth goal of the season on a pass from <a href=\"http://www.espn.com/nhl/player/_/id/3042054/william-carrier\">William Carrier</a>. Svechnikov stripped Own Tippett in the neutral zone and fed Carrier, who blew past Bonk and slid the pass to Aho, who had an open net to shoot and score the Hurricanes' third goal.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976849/mark-jankowski\">Mark Jankowski</a> added his fourth goal of the season with 4:51 left in the third period.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3115035/christian-dvorak\">Christian Dvorak</a> scored for Philadelphia.\n\n\r\n              <hl2>Up next</hl2>\r\n              Hurricanes: Host Washington on Tuesday night.\n\n\r\n              Flyers: Host Seattle on Tuesday night.\n\n\r\n              ------ <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-12T01:54:39Z"}}