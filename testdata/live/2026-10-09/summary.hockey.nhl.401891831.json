ge"},"clock":{"displayValue":"1:17"},"period":{"number":1,"displayValue":"1st"}},{"id":"401891831000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Elias Lindholm faceoff won against Adam Lowry","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:17"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"3041994","displayName":"Elias Lindholm","shortName":"E. Lindholm"},"type":"face-off-winner"},{"athlete":{"id":"2563066","displayName":"Adam Lowry","shortName":"A. Lowry"}}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":15209,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mike Sullivan","displayName":"Mike Sullivan","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"JJ Peterka scores in OT to lift the Bruins past the Jets, 4-3","description":"— Elias Lindholm tied it on a tip with 1:38 left in regulation and JJ Peterka scored at 3:21 of overtime to give the Boston Bruins a 4-3 victory over the Winnipeg Jets on Friday night.","story":"WINNIPEG, Manitoba -- — <a href=\"http://www.espn.com/nhl/player/_/id/3041994/elias-lindholm\">Elias Lindholm</a> tied it on a tip with 1:38 left in regulation and <a href=\"http://www.espn.com/nhl/player/_/id/4697438/jj-peterka\">JJ Peterka</a> scored at 3:21 of overtime to give the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> a 4-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> on Friday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> set up both late goals, with goalie <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> off for an extra attacker on Lindholm's goal.\n\n\r\n              Peterka also had the winner Tuesday night against the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> in the Bruins’ opener.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2968818/hampus-lindholm\">Hampus Lindholm</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5275337/james-hagens\">James Hagens</a> also scored, and Swayman made 30 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2590861/dylan-demelo\">Dylan DeMelo</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233884/mario-ferraro\">Mario Ferraro</a> scored for Winnipeg in the Jets opener. <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> stopped 26 shots.\n\n\r\n              Connor and Ferraro scored in the second period to give the Jets a 3-2 lead.\n\n\r\n              <hl2>Up next</hl2>\r\n              Bruins: At Minnesota on Saturday night.\n\n\r\n              Jets: At Detroit on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-03T03:28:27Z"}}