eaway"},"clock":{"displayValue":"0:54"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"2563054","displayName":"Boone Jenner","shortName":"B. Jenner"},"type":"giver"}]},{"id":"401892432000000850","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"William Carrier hit Boone Jenner","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"0:54"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"3042054","displayName":"William Carrier","shortName":"W. Carrier"},"type":"hit-credited"},{"athlete":{"id":"2563054","displayName":"Boone Jenner","shortName":"B. Jenner"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"999","fullName":"Lenovo Center","address":{"city":"Raleigh","state":"NC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/999.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18905,"officials":[{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ryan Jackson","displayName":"Ryan Jackson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Tuch scores twice in his first game for Washington, helping the Capitals beat the Hurricanes 5-2","description":"— Alex Tuch scored twice in his first game for Washington, Alex Ovechkin opened his 22nd NHL season with an assist and the Capitals beat the Stanley Cup champion Carolina Hurricanes 5-2 on Friday night.","story":"RALEIGH, N.C. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> scored twice in his first game for Washington, <a href=\"http://www.espn.com/nhl/player/_/id/3101/alex-ovechkin\">Alex Ovechkin</a> opened his 22nd NHL season with an assist and the Capitals beat the Stanley Cup champion <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> 5-2 on Friday night.\n\n\r\n              Tuch joined the Capitals in an offseason trade after five seasons with Buffalo. The 41-year-old Ovechkin assisted on Tuch's opening goal in Washington's three-goal first period.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216918/cole-hutson\">Cole Hutson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4024950/jakob-chychrun\">Jakob Chychrun</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149172/ryan-leonard\">Ryan Leonard</a> also scored for the Capitals, and <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> made 31 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874899/logan-stankoven\">Logan Stankoven</a> scored for Carolina, and <a href=\"http://www.espn.com/nhl/player/_/id/4996097/brandon-bussi\">Brandon Bussi</a> stopped 22 shots. The Hurricanes opened Tuesday night at home with a 1-0 overtime loss to Florida.\n\n\r\n              Tuch opened the scoring at 6:33 of the first period, beating Busso with a wrist shot. Hutson scored on a snap shot with 8:27 left in the period, and Tuch connected on a backhander with 5:37 to go.\n\n\r\n              Jakob Chychrun made it 4-0 on a power play at 1:36 of second.\n\n\r\n              Aho got one back for Carolina on a power play with 3:10 left in the second, and Leonard made it 5-1 eight seconds later. Stankoven scored midway through the third.\n\n\r\n              <hl2>Up next</hl2>\r\n              Capitals: At Tampa Bay on Saturday night.\n\n\r\n              Hurricanes: At Philadelphia on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-03T01:47:27Z"}}