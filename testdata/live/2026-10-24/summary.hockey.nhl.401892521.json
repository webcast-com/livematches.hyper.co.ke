"Z. Girgensons"},"type":"shooter"},{"athlete":{"id":"4063607","displayName":"Filip Hronek","shortName":"F. Hronek"},"type":"defender"}]},{"id":"401892521000000960","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Paul Cotter hit Emil Lilleberg","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:48"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"22"},"participants":[{"athlete":{"id":"4331579","displayName":"Paul Cotter","shortName":"P. Cotter"},"type":"hit-credited"},{"athlete":{"id":"5146599","displayName":"Emil Lilleberg","shortName":"E. Lilleberg"},"type":"hitted"}]},{"id":"401892521000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brandon Hagel Tip-In saved by Kevin Lankinen","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"4065019","displayName":"Brandon Hagel","shortName":"B. Hagel"},"type":"shooter"},{"athlete":{"id":"4341584","displayName":"Kevin Lankinen","shortName":"K. Lankinen"},"type":"saver"}]},{"id":"401892521000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892521000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brayden Point faceoff won against Drew O'Connor","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3151187","displayName":"Brayden Point","shortName":"B. Point"},"type":"face-off-winner"},{"athlete":{"id":"4712146","displayName":"Drew O'Connor","shortName":"D. O'Connor"}}]},{"id":"401892521000000810","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"J.J. Moser Wrist Shot High and Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"2:07"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"4874929","displayName":"J.J. Moser","shortName":"J.J. Moser"},"type":"shooter"},{"athlete":{"id":"4341584","displayName":"Kevin Lankinen","shortName":"K. Lankinen"}}]}],"gameInfo":{"venue":{"id":"1396","guid":"713cae18-f94f-330c-ab1a-eb284df12c97","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Francis Charron","displayName":"Francis Charron","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Lightning storm back from 2-goal deficit to beat the Canucks 4-2","description":"— Nikita Kucherov scored twice, Jake Guentzel had a goal and an assist, and Dennis Hildeby stopped 12 shots as the Tampa Bay Lightning defeated the Vancouver Canucks 4-2 on Saturday.","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> scored twice, <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/5174160/dennis-hildeby\">Dennis Hildeby</a> stopped 12 shots as the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> defeated the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> 4-2 on Saturday.\n\n\r\n              Guentzel scored the winner in the third period as Tampa Bay came back from a two-goal deficit.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4588205/pontus-holmberg\">Pontus Holmberg</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/3151187/brayden-point\">Brayden Point</a> finished with two assists for Tampa Bay, which improved to 5-0 at home.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587713/linus-karlsson\">Linus Karlsson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233566/elias-pettersson\">Elias Pettersson</a> scored while <a href=\"http://www.espn.com/nhl/player/_/id/4341584/kevin-lankinen\">Kevin Lankinen</a> finished with 31 saves for the Canucks, who finished winless (0-4-1) on a five-game road trip. Vancouver is winless in the past seven games (0-6-1) overall.\n\n\r\n              Guentzel picked up the winner at 2:04 of the third after <a href=\"http://www.espn.com/nhl/player/_/id/4588175/charle-edouard-d'astous\">Charle-Edouard D'Astous</a> slid a pass off the wall to Guentzel for the quick snap shot that deflected off the stick of Vancouver's <a href=\"http://www.espn.com/nhl/player/_/id/5080163/liam-ohgren\">Liam Ohgren</a>.\n\n\r\n              For the second consecutive game, the Canucks had a 2-0 lead they were not able to hold.\n\n\r\n              Karlsson put Vancouver up 1-0 at 15:32 of the first period with a shot from the right point. Pettersson put the Canucks up 2-0 with a power-play goal at 4:35 of the second period.\n\n\r\n              Kucherov scored twice in the span of 4:53 to pull the Lightning even. He scored his first goal off his own rebound on the power play at 6:30. Kucherov scored again as Point pulled a faceoff back to Kucherov for the quick shot at 11:23.\n\n\r\n              Holmberg capped the scoring, getting to a loose puck off a faceoff and beating Lankinen through the pads at 15:57.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canucks: Host the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> on Tuesday night.\n\n\r\n              Lightning: Travel to face the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-17T22:54:27Z"}}