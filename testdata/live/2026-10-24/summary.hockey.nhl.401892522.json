id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"0:50"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892522000000670","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Sam Bennett faceoff won against Chandler Stephenson","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"0:50"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3114732","displayName":"Sam Bennett","shortName":"S. Bennett"},"type":"face-off-winner"},{"athlete":{"id":"3067858","displayName":"Chandler Stephenson","shortName":"C. Stephenson"}}]},{"id":"401892522000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Matthew Tkachuk Wrist Shot saved by Joey Daccord","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"4024854","displayName":"Matthew Tkachuk","shortName":"M. Tkachuk"},"type":"shooter"},{"athlete":{"id":"3942073","displayName":"Joey Daccord","shortName":"J. Daccord"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1840","fullName":"Amerant Bank Arena","address":{"city":"Sunrise","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1840.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19169,"officials":[{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Verhaeghe, Bennett each get hat tricks, Panthers roll past Kraken 8-3","description":"— Carter Verhaeghe had a history-making natural hat trick, Sam Bennett scored his first three goals of the season and the Florida Panthers rolled past the Seattle Kraken 8-3 on Saturday night.","story":"SUNRISE, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042088/carter-verhaeghe\">Carter Verhaeghe</a> had a history-making natural hat trick, <a href=\"http://www.espn.com/nhl/player/_/id/3114732/sam-bennett\">Sam Bennett</a> scored his first three goals of the season and the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> rolled past the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> 8-3 on Saturday night.\n\n\r\n              The Panthers became the first team in NHL history with natural hat tricks in three consecutive games, after <a href=\"https://apnews.com/article/panthers-brady-tkachuk-hat-tricks-d90295a09df536b15b604969dda8af72?utm--source=copy&utm--medium=share\"><a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> had them</a> in wins over Columbus on Tuesday and Vancouver on Thursday. Florida also became only the third team in 30 years to have a hat trick — of any variety — in three consecutive games.\n\n\r\n              With four hat tricks already this season — all coming in the last three games — Florida has matched its total from the last three regular seasons combined. <a href=\"http://www.espn.com/nhl/player/_/id/3942354/niko-mikkola\">Niko Mikkola</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114722/sam-reinhart\">Sam Reinhart</a> also scored for the Panthers, and <a href=\"http://www.espn.com/nhl/player/_/id/4024854/matthew-tkachuk\">Matthew Tkachuk</a> had three assists.\n\n\r\n              Freddy Gaudreau, <a href=\"http://www.espn.com/nhl/player/_/id/5080144/shane-wright\">Shane Wright</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874864/ryker-evans\">Ryker Evans</a> had goals for Seattle, while <a href=\"http://www.espn.com/nhl/player/_/id/4565223/kaapo-kakko\">Kaapo Kakko</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5216877/berkly-catton\">Berkly Catton</a> both had two-assist games.\n\n\r\n              Verhaeghe got his first two goals of the night 1:11 apart late in the first period, then struck again with 13:58 left in the second to push Florida's lead to 4-1. Bennett opened the scoring for Florida just 1:05 into the game, and he added goals in both the second and third periods.\n\n\r\n              Former Panthers forward <a href=\"http://www.espn.com/nhl/player/_/id/4874741/mackie-samoskevich\">Mackie Samoskevich</a> made his return to Florida, after joining the Kraken this offseason.\n\n\r\n              Samoskevich scored 27 goals in 156 games with Florida over the last three seasons, getting his name on the Stanley Cup after the Panthers won their second consecutive title in 2025. Florida traded him to Seattle in June for a pair of picks, one of which was used that same day to help complete the Panthers' trade with Ottawa for Brady Tkachuk.\n\n\r\n              Samoskevich had three goals and an assist for the Kraken in their first seven games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kraken: Host Detroit on Tuesday.\n\n\r\n              Panthers: Visit Ottawa on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-18T00:52:28Z"}}