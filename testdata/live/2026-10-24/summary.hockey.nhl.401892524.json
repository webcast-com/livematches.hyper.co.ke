yName":"Arber Xhekaj","shortName":"A. Xhekaj"},"type":"shooter"},{"athlete":{"id":"4697681","displayName":"Louis Crevier","shortName":"L. Crevier"},"type":"defender"}]},{"id":"401892524000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Beck Malenstyn hit Alexandre Carrier","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:23"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4063240","displayName":"Beck Malenstyn","shortName":"B. Malenstyn"},"type":"hit-credited"},{"athlete":{"id":"3942064","displayName":"Alexandre Carrier","shortName":"A. Carrier"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Caufield scores his second goal in OT to lift Canadiens over Sabres 4-3","description":"— Cole Caufield scored his second goal of the game 54 seconds into overtime to lift the Montreal Canadiens over the Buffalo Sabres 4-3 on Saturday night.","story":"MONTREAL -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565236/cole-caufield\">Cole Caufield</a> scored his second goal of the game 54 seconds into overtime to lift the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> over the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 4-3 on Saturday night.\n\n\r\n              Caufield had a breakaway after <a href=\"http://www.espn.com/nhl/player/_/id/4233627/josh-norris\">Josh Norris</a> missed his shot on a 3-on-1 rush. He ripped a shot into the top-left corner, extending his franchise record with his 14th regular-season overtime goal.\n\n\r\n              Zachary Bolduc and <a href=\"http://www.espn.com/nhl/player/_/id/4233880/alexandre-texier\">Alexandre Texier</a> also scored while Montreal built a two-goal lead before Buffalo stormed back. <a href=\"http://www.espn.com/nhl/player/_/id/4915349/juraj-slafkovsky\">Juraj Slafkovsky</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3942064/alexandre-carrier\">Alexandre Carrier</a> added two assists each.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5188437/jacob-fowler\">Jacob Fowler</a> stopped 23 shots in his fourth start in five games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> and Norris scored for Buffalo, which fell 4-3 in a shootout to the Canadiens on Tuesday. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> made 30 saves.\n\n\r\n              Thompson tied it at 3 with 9:48 remaining in the third period after <a href=\"http://www.espn.com/nhl/player/_/id/4874870/josh-doan\">Josh Doan</a> found him alone at the side of the net to eventually force overtime.\n\n\r\n              The Sabres went on the power play with 2:17 remaining in regulation after Slafkovsky tripped <a href=\"http://www.espn.com/nhl/player/_/id/5080176/jiri-kulich\">Jiri Kulich</a> but couldn’t capitalize despite spending the majority of the time in Montreal’s zone.\n\n\r\n              UP NEXT\n\n\r\n              Sabres: Host the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Wednesday.\n\n\r\n              Canadiens: Host the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-18T02:26:30Z"}}