:"shooter"},{"athlete":{"id":"5111","displayName":"Jake Allen","shortName":"J. Allen"},"type":"saver"}]},{"id":"401892519000002010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Alex Ovechkin Snap Shot saved by Jake Allen","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:30"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"3101","displayName":"Alex Ovechkin","shortName":"A. Ovechkin"},"type":"shooter"},{"athlete":{"id":"5111","displayName":"Jake Allen","shortName":"J. Allen"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1823","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16834,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Ryan Leonard scores highlight-reel goal, leads the Capitals over the Devils 4-2","description":"— Ryan Leonard scored a highlight-reel goal and the Washington Capitals beat the New Jersey Devils 4-2 on Saturday afternoon.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/5149172/ryan-leonard\">Ryan Leonard</a> scored a highlight-reel goal and the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> 4-2 on Saturday afternoon.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5229146/ilya-protas\">Ilya Protas</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3899933/dylan-strome\">Dylan Strome</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2563054/boone-jenner\">Boone Jenner</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/4392260/vincent-desharnais\">Vincent Desharnais</a> had two assists for the Capitals, who have won back-to-back games.\n\n\r\n              Arsenal Gritsyuk and <a href=\"http://www.espn.com/nhl/player/_/id/3899978/timo-meier\">Timo Meier</a> scored for the Devils, who dropped to 4-4-0 to open the season.\n\n\r\n              The Devils got on the board first roughly halfway through the first period, when Gritsyuk beat <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> through traffic at the end of New Jersey’s second power play of the period.\n\n\r\n              With 3:18 to go in the first, though, Leonard would even the score and change the momentum with his spectacular goal. In the final seconds of Washington’s power play, Leonard took the puck up ice himself, going coast to coast before beating <a href=\"http://www.espn.com/nhl/player/_/id/4874719/luke-hughes\">Luke Hughes</a>, cutting to the inside and deking out <a href=\"http://www.espn.com/nhl/player/_/id/5111/jake-allen\">Jake Allen</a> for his third goal of the season.\n\n\r\n              From there, the Capitals took over the game, starting with back-to-back goals in a span of 4 minutes, 46 seconds to open the second period. First, Protas buried a cross-zone feed from <a href=\"http://www.espn.com/nhl/player/_/id/3101/alex-ovechkin\">Alex Ovechkin</a> to give Washington the 2-1 lead. Then, Strome finished off a passing play from <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4062251/jordan-kyrou\">Jordan Kyrou</a> to put Washington up by two.\n\n\r\n              Later in the frame, Jenner tucked in a point drive that bounced to the front for his fourth goal in five games, extending the lead to 4-1 going into the third.\n\n\r\n              New Jersey pushed hard in the third and pulled within two late when Meier scored with 18.4 seconds to go in regulation, but otherwise, Thompson shut them down with 29 saves on 31 shots to secure the win for the Capitals.\n\n\r\n              Allen had 21 saves in the loss for New Jersey.\n\n\r\n              <hl2>Up next</hl2>\r\n              Capitals: Host the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> on Tuesday.\n\n\r\n              Devils: Return home to face the <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-17T19:48:36Z"}}