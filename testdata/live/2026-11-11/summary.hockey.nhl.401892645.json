"saver"}]},{"id":"401892645000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Ryan Donato","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:14"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"4"},"participants":[{"athlete":{"id":"3115033","displayName":"Ryan Donato","shortName":"R. Donato"},"type":"giver"}]},{"id":"401892645000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Aaron Ekblad Snap Shot saved by Spencer Knight","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:17"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3114717","displayName":"Aaron Ekblad","shortName":"A. Ekblad"},"type":"shooter"},{"athlete":{"id":"4565234","displayName":"Spencer Knight","shortName":"S. Knight"},"type":"saver"}]},{"id":"401892645000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:18"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1840","guid":"f00bda1b-21b7-372c-838c-b5c9977d1834","fullName":"Amerant Bank Arena","address":{"city":"Sunrise","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1840.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19482,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Trevor Hanson","displayName":"Trevor Hanson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Sandis Vilmanis has 1st 2-goal game, Panthers top Blackhawks 5-3 to cap homestand","description":"— Sandis Vilmanis had the first two-goal game of his career, Sam Reinhart provided a goal and two assists, and the Florida Panthers beat the Chicago Blackhawks 5-3 on Wednesday night to wrap up a three-game homestand.","story":"SUNRISE, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5103599/sandis-vilmanis\">Sandis Vilmanis</a> had the first two-goal game of his career, <a href=\"http://www.espn.com/nhl/player/_/id/3114722/sam-reinhart\">Sam Reinhart</a> provided a goal and two assists, and the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> 5-3 on Wednesday night to wrap up a three-game homestand.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3041992/seth-jones\">Seth Jones</a> scored against his former team and <a href=\"http://www.espn.com/nhl/player/_/id/3042088/carter-verhaeghe\">Carter Verhaeghe</a> had a goal and an assist for the Panthers, who are 4-1-0 in their last five games and 7-3-0 in their past 10. Vilmanis added two assists to finish with four points.\n\n\r\n              Florida improved to 9-0-1 when allowing three goals or fewer this season. Reinhart's goal was an empty-netter to seal the win with 1:27 left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080157/frank-nazar\">Frank Nazar</a> had two third-period goals and <a href=\"http://www.espn.com/nhl/player/_/id/5149231/roman-kantserov\">Roman Kantserov</a> also scored for Chicago. <a href=\"http://www.espn.com/nhl/player/_/id/4894726/ethan-del-mastro\">Ethan Del Mastro</a> got two assists — his first points of the season, and the first multi-point game of his career. <a href=\"http://www.espn.com/nhl/player/_/id/5149125/connor-bedard\">Connor Bedard</a> had two assists.\n\n\r\n              The Blackhawks are 1-6-1 in their last eight games. They gave up the final five goals in a 5-2 home loss to Colorado on Monday, then got down 3-0 in Florida before Kantserov got Chicago on the board.\n\n\r\n              By then, the Panthers were already in full control. Vilmanis scored 4:43 into the game, and Verhaeghe’s power-play goal was assisted by <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4024854/matthew-tkachuk\">Matthew Tkachuk</a> at 12:29 of the first.\n\n\r\n              Jones beat former Florida goalie <a href=\"http://www.espn.com/nhl/player/_/id/4565234/spencer-knight\">Spencer Knight</a> — they were traded for one another in the deal that sent Jones to the Panthers — for a 3-0 lead in the second.\n\n\r\n              Nazar beat Panthers goalie Jacob Markström on a short-handed breakaway to cut Florida’s lead midway through the third.\n\n\r\n              Vilmanis struck again with 8:59 left, restoring the two-goal edge. Nazar got his second of the game with 3:51 left, but Reinhart scored his ninth of the season to all but end the Blackhawks' comeback hopes.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blackhawks: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> on Thursday.\n\n\r\n              Panthers: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-05T03:34:34Z"}}