ff"},"clock":{"displayValue":"1:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"8"},"participants":[{"athlete":{"id":"2976848","displayName":"Scott Laughton","shortName":"S. Laughton"},"type":"face-off-winner"},{"athlete":{"id":"5080175","displayName":"Filip Bystedt","shortName":"F. Bystedt"}}]}],"gameInfo":{"venue":{"id":"1841","fullName":"crypto.com Arena","address":{"city":"Los Angeles","state":"CA","zipCode":"90185","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1841.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17010,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kendrick Nicholson","displayName":"Kendrick Nicholson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Adrian Kempe scores a hat trick as the Kings beat the Sharks 7-2","description":"— Adrian Kempe had a hat trick and an assist, Quinton Byfield scored two goals, and the Los Angeles Kings routed the San Jose Sharks 7-2 on Wednesday night.","story":"LOS ANGELES -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114802/adrian-kempe\">Adrian Kempe</a> had a hat trick and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/4697383/quinton-byfield\">Quinton Byfield</a> scored two goals, and the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> routed the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> 7-2 on Wednesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2593311/erik-haula\">Erik Haula</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2562596/joel-armia\">Joel Armia</a> also scored for the Kings and <a href=\"http://www.espn.com/nhl/player/_/id/2610321/darcy-kuemper\">Darcy Kuemper</a> made 30 saves. <a href=\"http://www.espn.com/nhl/player/_/id/3891952/artemi-panarin\">Artemi Panarin</a> had four assists.\n\n\r\n              It was the 37th multigoal game Kempe has had with the Kings, moving him past Dustin Brown for sole possession of ninth place in the history of the franchise. Kempe returned to the lineup after missing a 3-2 loss to the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> on Saturday because of an undisclosed injury. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5206628/macklin-celebrini\">Macklin Celebrini</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5361709/ivar-stenberg\">Ivar Stenberg</a> scored power-play goals and <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a> made 20 saves for the Sharks, who have now lost three games in a row. <a href=\"http://www.espn.com/nhl/player/_/id/3891922/erik-gustafsson\">Erik Gustafsson</a> assisted on both goals.\n\n\r\n              Kempe scored his first goal just 1:23 into the game and added a second later in the first period as the Kings jumped to a 3-0 lead after one. Kempe completed the hat trick with a power-play goal with 4:09 left in the second period. The Kings were 3 for 5 on the power play in the game.\n\n\r\n              The game marked the NHL debut for San Jose defenseman Eric Pohlkamp, called up from the AHL before the game.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sharks: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a> on Friday night.\n\n\r\n              Kings: Host the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> on Saturday night.\n\n\r\n              ------\n\n\r\n              The Associated Press created this story using technology provided by <a href=\"https://www.dataskrive.com/\">Data Skrive</a> and data from <a href=\"https://www.sportradar.com/\">Sportradar</a>.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-05T06:09:34Z"}}