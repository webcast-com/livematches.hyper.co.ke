":{"id":"3024798","displayName":"Nate Schmidt","shortName":"N. Schmidt"},"type":"assister"},{"athlete":{"id":"2563036","displayName":"Vincent Trocheck","shortName":"V. Trocheck"},"type":"assister"}]},{"id":"401892648000000770","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Nick Schmaltz faceoff won against Jake Evans","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"3114770","displayName":"Nick Schmaltz","shortName":"N. Schmaltz"},"type":"face-off-winner"},{"athlete":{"id":"4393049","displayName":"Jake Evans","shortName":"J. Evans"}}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Trent Knorr","displayName":"Trent Knorr","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Cole Caufield scores in OT in Canadiens' 5-4 victory over Mammoth","description":"— Cole Caufield scored 30 seconds into overtime and the Montreal Canadiens overcame Logan Cooley’s hat trick to beat the Utah Mammoth 5-4 on Thursday night.","story":"MONTREAL -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565236/cole-caufield\">Cole Caufield</a> scored 30 seconds into overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> overcame Logan Cooley’s hat trick to beat the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> 5-4 on Thursday night.\n\n\r\n              Captain <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> had a goal and two assists in his return from a six-game absence for Montreal (10-3-3). <a href=\"http://www.espn.com/nhl/player/_/id/5188450/adam-engstrom\">Adam Engstrom</a> added his first career goal, and <a href=\"http://www.espn.com/nhl/player/_/id/4565224/kirby-dach\">Kirby Dach</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4893969/arber-xhekaj\">Arber Xhekaj</a> also scored.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a> made 16 saves two nights after the Canadiens made some unwanted history. Montreal lost 5-4 in overtime to Winnipeg on Tuesday after blowing a 4-0 lead with 2:39 remaining, marking the latest four-goal comeback in NHL history.\n\n\r\n              Cooley had his second hat trick in four games and added an assist. At 228 career games, Cooley became the fastest active player to have five career hat tricks, besting <a href=\"http://www.espn.com/nhl/player/_/id/3101/alex-ovechkin\">Alex Ovechkin</a> by two games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114770/nick-schmaltz\">Nick Schmaltz</a> had a goal and two assists for Utah (10-6-1). <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a> stopped 30 shots.\n\n\r\n              Montreal tied it at 4 when Engstrom beat Cossa with a wrist shot with 5:06 to go in the third.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: At Ottawa on Saturday night.\n\n\r\n              Canadiens: At Toronto on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-06T03:19:34Z"}}