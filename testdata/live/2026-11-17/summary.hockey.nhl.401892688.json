892688000000880","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Adam Lowry hit Nico Hischier","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"2563066","displayName":"Adam Lowry","shortName":"A. Lowry"},"type":"hit-credited"},{"athlete":{"id":"4233555","displayName":"Nico Hischier","shortName":"N. Hischier"},"type":"hitted"}]},{"id":"401892688000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Timo Meier Wrist Shot saved by Nico Daws","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3899978","displayName":"Timo Meier","shortName":"T. Meier"},"type":"shooter"},{"athlete":{"id":"4697683","displayName":"Nico Daws","shortName":"N. Daws"},"type":"saver"}]},{"id":"401892688000000990","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Evan Rodrigues","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:48"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3648008","displayName":"Evan Rodrigues","shortName":"E. Rodrigues"},"type":"giver"}]},{"id":"401892688000001000","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jesper Boqvist shot blocked by Tyrel Bauer","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"3:33"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4233872","displayName":"Jesper Boqvist","shortName":"J. Boqvist"},"type":"shooter"},{"athlete":{"id":"4697648","displayName":"Tyrel Bauer","shortName":"T. Bauer"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":15209,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Mercer, Connor each score twice to lift Jets to an emotional 4-2 win over Devils","description":"— Dawson Mercer and Kyle Connor each scored twice to lead the Winnipeg Jets to an emotional 4-2 victory over the New Jersey Devils on Tuesday night.","story":"WINNIPEG, Manitoba -- — <a href=\"http://www.espn.com/nhl/player/_/id/4697401/dawson-mercer\">Dawson Mercer</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> each scored twice to lead the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> to an emotional 4-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> on Tuesday night.\n\n\r\n              The game marked the return of former Jets goaltender <a href=\"https://apnews.com/article/connor-hellebuyck-winnipeg-jets-new-jersey-devils-2fd01123d7188a0bdec0745ce9074bd1\"><a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a></a> to Winnipeg for the first time since his trade to the Devils, although he did not play. Instead, <a href=\"http://www.espn.com/nhl/player/_/id/5111/jake-allen\">Jake Allen</a> started in net and stopped 21 shots for New Jersey.\n\n\r\n              Former Devils netminder <a href=\"http://www.espn.com/nhl/player/_/id/4697683/nico-daws\">Nico Daws</a> made 19 saves for Winnipeg.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233568/cody-glass\">Cody Glass</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4268771/jesper-bratt\">Jesper Bratt</a> scored for the Devils. \n\n\r\n              The victory extended Winnipeg’s win streak to four games, and halted New Jersey’s at five games.\n\n\r\n              After Mercer gave the Jets a 3-2 lead on the power play at 11:58 of the third period, Connor sealed the outcome with an unassisted empty-net goal.\n\n\r\n              The Devils, who trailed 2-0 after the first period, tied the game in the second period with a pair of goals 44 seconds apart. Bratt scored at 1:14 on a setup from <a href=\"http://www.espn.com/nhl/player/_/id/4915855/arseny-gritsyuk\">Arseny Gritsyuk</a> from behind the net. <a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a> also assisted to extend his point streak to six games.\n\n\r\n              Glass tied the game at 1:58 when he deflected Jonathan Kovacevic’s shot past Daws.\n\n\r\n              Connor scored during a two-man advantage at 15:06 of the first period when he deflected Cole Perfetti’s pass past Allen. <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> also assisted, moving him into a second-place tie with Dale Hawerchuk in assists in franchise history with 550.\n\n\r\n              Mercer opened the scoring at 7:54 when his snap shot from the faceoff circle beat Allen.\n\n\r\n              The Jets came out energized by the crowd booing and taunting Hellebuyck to express their anger and jumped to a 2-0 lead. \n\n\r\n              It took the Devils 13 minutes before they got a shot on net in the third period.\n\n\r\n              <hl2>Up next</hl2>\r\n              Devils: Host the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> on Thursday night.\n\n\r\n              Jets: At the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-11T03:39:36Z"}}