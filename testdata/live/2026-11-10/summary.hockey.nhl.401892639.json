}]},{"id":"401892639000000600","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Shea Theodore shot blocked by Nick Robertson","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"0:46"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"3042055","displayName":"Shea Theodore","shortName":"S. Theodore"},"type":"shooter"},{"athlete":{"id":"4565275","displayName":"Nick Robertson","shortName":"N. Robertson"},"type":"defender"}]},{"id":"401892639000000060","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:02"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892639000000630","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"William Karlsson faceoff won against Blake Lizotte","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:02"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"2563057","displayName":"William Karlsson","shortName":"W. Karlsson"},"type":"face-off-winner"},{"athlete":{"id":"4316983","displayName":"Blake Lizotte","shortName":"B. Lizotte"}}]},{"id":"401892639000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ivan Barbashev shot blocked by Samuel Girard","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"3114985","displayName":"Ivan Barbashev","shortName":"I. Barbashev"},"type":"shooter"},{"athlete":{"id":"4063401","displayName":"Samuel Girard","shortName":"S. Girard"},"type":"defender"}]},{"id":"401892639000000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Noah Hanifin Wrist Shot saved by Arturs Silovs","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"3652964","displayName":"Noah Hanifin","shortName":"N. Hanifin"},"type":"shooter"},{"athlete":{"id":"4576894","displayName":"Arturs Silovs","shortName":"A. Silovs"},"type":"saver"}]},{"id":"401892639000000950","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Ben Kindel","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"2:48"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"5291947","displayName":"Ben Kindel","shortName":"B. Kindel"},"type":"taker"}]},{"id":"401892639000001060","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brayden McNabb hit Justin Brazeau","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"5202","displayName":"Brayden McNabb","shortName":"B. McNabb"},"type":"hit-credited"},{"athlete":{"id":"4063605","displayName":"Justin Brazeau","shortName":"J. Brazeau"},"type":"hitted"}]},{"id":"401892639000001160","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Marc Gatcomb hit Spencer Stastney","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:35"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"5103547","displayName":"Marc Gatcomb","shortName":"M. Gatcomb"},"type":"hit-credited"},{"athlete":{"id":"4393406","displayName":"Spencer Stastney","shortName":"S. Stastney"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1837","fullName":"PPG Paints Arena","address":{"city":"Pittsburgh","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1837.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":15740,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Tomas Hertl's 2nd goal of the game with 32 seconds remaining lifts Vegas by Pittsburgh 3-2","description":"— Tomas Hertl's second goal of the night with 32 seconds left in regulation lifted the Vegas Golden Knights past the Pittsburgh Penguins 3-2 on Tuesday night.","story":"PITTSBURGH -- — <a href=\"http://www.espn.com/nhl/player/_/id/2976844/tomas-hertl\">Tomas Hertl</a>'s second goal of the night with 32 seconds left in regulation lifted the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> past the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> 3-2 on Tuesday night.\n\n\r\n              Vegas won in Pittsburgh for just the second time in franchise history when Hertl tipped a pass from <a href=\"http://www.espn.com/nhl/player/_/id/5545/mark-stone\">Mark Stone</a> past Pittsburgh goaltender <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a>. The winner came shortly after the Golden Knights killed a late 5-on-3 power play.\n\n\r\n              Pittsburgh forward <a href=\"http://www.espn.com/nhl/player/_/id/3942061/tommy-novak\">Tommy Novak</a>, who scored and added an assist during a third-period rally, was called for tripping shortly after the teams returned to even strength. Hertl's second power-play goal of the night — and the second allowed by the Penguins' penalty kill at home — sent Pittsburgh to a third straight loss.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3939714/adin-hill\">Adin Hill</a> stopped 23 shots for the Golden Knights, who found their legs late a night <a href=\"https://apnews.com/article/golden-knights-bruins-score-20630aa39e9f01a0da35379415cf82e6\">after a shootout loss in Boston</a>. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216887/trevor-connelly\">Trevor Connelly</a>'s breakaway goal with 8:41 left tied it after Novak and <a href=\"http://www.espn.com/nhl/player/_/id/2562629/rickard-rakell\">Rickard Rakell</a> had erased a one-goal deficit to briefly give Pittsburgh the lead.\n\n\r\n              Silovs stopped 20 shots for the Penguins, who lost for the seventh time in nine games. Pittsburgh captain <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a> did not record a point and remains tied with Marcel Dionne for sixth on the NHL's all-time scoring list with 1,771 points.\n\n\r\n              A little over two weeks after the Golden Knights <a href=\"https://apnews.com/article/penguins-golden-knights-score-242efb8e58f23601c3d02508d9faf75f\">drilled the Penguins</a> in Las Vegas, the teams played on more even terms in the rematch.\n\n\r\n              Hertl's sixth goal of the season late in the first period served as the only scoring in the first 40 minutes. <a href=\"http://www.espn.com/nhl/player/_/id/3899937/mitch-marner\">Mitch Marner</a> picked up the primary assist to push his points streak to 11 games.\n\n\r\n              Pittsburgh surged in the third thanks to Novak and Rakell, who scored for a fourth straight game.\n\n\r\n              It just wasn't enough on a night the Penguins played without forward <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a>, who sat out with a lower-body injury. \n\n\r\n              <hl2>Up next</hl2>\r\n              Golden Knights: Continue their road trip Thursday in Detroit.\n\n\r\n              Penguins: Welcome Boston to PPG Paints Arena on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-04T03:11:46Z"}}