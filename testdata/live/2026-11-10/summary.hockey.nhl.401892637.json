e":"Theo Lindstein","shortName":"T. Lindstein"},"type":"shooter"},{"athlete":{"id":"4697705","displayName":"Dylan Garand","shortName":"D. Garand"},"type":"saver"}]},{"id":"401892637000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892637000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dalibor Dvorsky faceoff won against Will Cuylle","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"19"},"participants":[{"athlete":{"id":"5149178","displayName":"Dalibor Dvorsky","shortName":"D. Dvorsky"},"type":"face-off-winner"},{"athlete":{"id":"4697468","displayName":"Will Cuylle","shortName":"W. Cuylle"}}]}],"gameInfo":{"venue":{"id":"1830","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16950,"officials":[{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Adam Fox sparks Rangers to a 3-1 win over the Blues, snapping 4-game skid","description":"— Adam Fox had a goal and an assist, Dylan Garand made 32 saves, and the New York Rangers snapped a four-game losing streak with a 3-1 win over the St. Louis Blues on Tuesday night.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/4197146/adam-fox\">Adam Fox</a> had a goal and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a> made 32 saves, and the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> snapped a four-game losing streak with a 3-1 win over the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a> on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042095/oliver-bjorkstrand\">Oliver Bjorkstrand</a> also had a goal for the Rangers and <a href=\"http://www.espn.com/nhl/player/_/id/4233720/eeli-tolvanen\">Eeli Tolvanen</a> scored an empty-netter and had an assist. <a href=\"http://www.espn.com/nhl/player/_/id/2590852/jt-miller\">J.T. Miller</a> had a pair of assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4271732/pius-suter\">Pius Suter</a> scored with 59 seconds to play for the Blues to spoil Garand's shutout bid. <a href=\"http://www.espn.com/nhl/player/_/id/4587909/joel-hofer\">Joel Hofer</a> had 28 saves for St. Louis.\n\n\r\n              The Blues went scoreless on the power play in six chances. The Rangers were 0 for 3 on the power play.\n\n\r\n              The Rangers are now 7-2 at home this season and have won seven games when leading after the first period. They allowed two or fewer goals in a game for the ninth time this season.\n\n\r\n              The Blues' <a href=\"http://www.espn.com/nhl/player/_/id/3067822/ross-johnston\">Ross Johnston</a> was back in the lineup for the first time since Oct. 15 against Minnesota. He was injured in practice soon after that game and placed on injured reserve with a lower-body injury on Oct. 18.\n\n\r\n              The Blues were coming off a dramatic 5-4 comeback win over the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> on Saturday night.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blues: Play the third game of a four-game road trip at New Jersey on Thursday night.\n\n\r\n              Rangers: Play host to Philadelphia on Thursday night.\n\n\r\n              ------\n\n\r\n              The Associated Press created this story using technology provided by <a href=\"https://www.dataskrive.com/\">Data Skrive</a> and data from <a href=\"https://www.sportradar.com/\">Sportradar</a>.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-04T03:10:46Z"}}