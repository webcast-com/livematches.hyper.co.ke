,{"homeWinPercentage":0.74,"playId":"401866454327","tiePercentage":0},{"homeWinPercentage":0.7588,"playId":"401866454331","tiePercentage":0},{"homeWinPercentage":0.7498,"playId":"401866454336","tiePercentage":0},{"homeWinPercentage":0.7791,"playId":"401866454339","tiePercentage":0},{"homeWinPercentage":0.7848,"playId":"401866454343","tiePercentage":0}],"gameInfo":{"venue":{"id":"3996","guid":"a97cb83b-e9f9-3924-9940-d9dd85ceb1f7","fullName":"Yager Stadium","address":{"city":"Oxford","state":"OH","zipCode":"45056","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3996.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":10618},"article":{"headline":"Wright accounts for 4TDs to send Buffalo past Miami (Ohio) 34-31 in OT","description":"— Jason Wright threw for 358 yards and accounted for four touchdowns and Buffalo rallied in the fourth quarter to beat Miami of Ohio 34-31 in overtime on Tuesday night.","story":"MIAMI, Ohio -- — <a href=\"http://www.espn.com/college-football/player/_/id/4077876/jason-wright\" target=\"_new\">Jason Wright</a> threw for 358 yards and accounted for four touchdowns and Buffalo rallied in the fourth quarter to beat Miami of Ohio 34-31 in overtime on Tuesday night.\n\n\r\n              Wright threw for two touchdowns and ran for two scores. <a href=\"http://www.espn.com/college-football/player/_/id/4869601/chance-morrow\" target=\"_new\">Chance Morrow</a> had 199 yards on 12 receptions and two touchdowns for Buffalo.\n\n\r\n              Caleb Heavener threw for 154 yards and a touchdown, and a <a href=\"http://www.espn.com/college-football/player/_/id/5193270/d'shawntae-jones\" target=\"_new\">D'Shawntae Jones</a> ran for 117 yards on 12 carries for Miami.\n\n\r\n              After <a href=\"http://www.espn.com/college-football/player/_/id/5295440/oliver-hautanen\" target=\"_new\">Oliver Hautanen</a> made a 27-yard field goal to give the Bulls (6-3, 4-1 Mid-American) a 34-31 lead in its half of the first overtime, Miami's <a href=\"http://www.espn.com/college-football/player/_/id/5151442/kellan-mclaughlin\" target=\"_new\">Kellan McLaughlin</a> missed a 45-yard field goal attempt to end the game.\n\n\r\n              Wright's 2-yard touchdown run with 1:35 left in regulation ended a 12-play, 80-yard drive that brought Buffalo into a 31-all tie.\n\n\r\n              Almost 7 1/2 minutes prior, Wright threw a 4-yard scoring pass to Chance Morrow to end an 11-play, 75-yard drive to get the Bulls within 31-24.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5293035/scoop-smith\" target=\"_new\">Scoop Smith</a>'s 6-yard touchdown run with 12:01 remaining gave Miami (5-4, 3-2) its largest lead at 31-16.\n\n\r\n              <hl2>Up next</hl2>\r\n              Buffalo: Travels to face Ball State on Nov. 11.\n\n\r\n              Miami: Hosts Ohio on Nov. 10.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>. Visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-11-04T05:38:45Z"}}