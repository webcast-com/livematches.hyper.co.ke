splayName":"Andreas Englund","shortName":"A. Englund"},"type":"hit-credited"},{"athlete":{"id":"5118","displayName":"John Carlson","shortName":"J. Carlson"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1396","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Trevor Hanson","displayName":"Trevor Hanson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Brayden Point scores 2 goals to lift the Lightning to a 4-2 victory over the Red Wings","description":"— Brayden Point scored two goals, Anthony Cirelli got one and the Tampa Bay Lightning beat the Detroit Red Wings 4-2 on Tuesday night for their seventh straight home win.","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3151187/brayden-point\">Brayden Point</a> scored two goals, <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> got one and the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> 4-2 on Tuesday night for their seventh straight home win.\n\n\r\n              Reigning NHL MVP <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had two assists in his first home game since asking the Lightning for a trade, and goalie <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> stopped 19 shots.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3041995/jt-compher\">J.T. Compher</a> scored Detroit’s goals. The Red Wings pulled their goalie for an extra shooter for the final three minutes and put plenty of pressure on Vasilevskiy but couldn't get the tying goal. <a href=\"http://www.espn.com/nhl/player/_/id/4954/ryan-mcdonagh\">Ryan McDonagh</a> slid an empty-netter down the ice with 1 second left. \n\n\r\n              Point gave the Lightning 1-0 lead with a power-play goal in the first period. He didn’t quite get everything on his shot in the low slot off Kucherov’s centering pass but it went past goalie <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a>.\n\n\r\n              Point snapped a shot over Gibson’s glove 5:07 later to make it 2-0. Kucherov set it up with another perfect pass. Gibson was replaced by <a href=\"http://www.espn.com/nhl/player/_/id/4587994/daniil-tarasov\">Daniil Tarasov</a> to start the second period after stopping 11 of 13 shots in the first. \n\n\r\n              Cirelli lifted his fifth goal past Tarasov into the top left corner for a 3-0 lead in the second period.\n\n\r\n              Raymond fired a shot from the left point past Vasilevskiy midway through the second to cut it to 3-1. The Red Wings got within 3-2 less than six minutes into the third when Compher scored a power-play goal, blasting a shot from the right circle underneath Vasilevskiy’s left pad.\n\n\r\n              Kucherov has five assists in two games since informing the team he wants to be traded. Kucherov said Monday he made the request because he feels disrespected by a lack of communication with general manager Julien BriseBois.\n\n\r\n              Kucherov is in the final season of an eight-year, $76 million contract signed in 2018 before he helped Tampa Bay win the Stanley Cup twice, led the NHL in scoring three times and won the Hart Trophy in 2018-19 and 2025-26.\n\n\r\n              “It was never about the money for me,” Kucherov said Monday. “More about poor communication and respect. Over the last four months, we only have had two conversations and Julien, in the end, made it clear that I’m free to walk on July 1.”\n\n\r\n              <hl2>Up next</hl2>\r\n              Red Wings: Host Las Vegas on Thursday night.\n\n\r\n              Lightning: Host Chicago on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-04T02:46:47Z"}}