3,"playId":"401871058333","tiePercentage":0},{"homeWinPercentage":0.3448,"playId":"401871058331","tiePercentage":0},{"homeWinPercentage":0.3408,"playId":"401871058338","tiePercentage":0},{"homeWinPercentage":0.353,"playId":"401871058336","tiePercentage":0},{"homeWinPercentage":0.3326,"playId":"401871058342","tiePercentage":0},{"homeWinPercentage":0.3201,"playId":"401871058346","tiePercentage":0},{"homeWinPercentage":0.324,"playId":"401871058358","tiePercentage":0},{"homeWinPercentage":0.3518,"playId":"401871058364","tiePercentage":0},{"homeWinPercentage":0.3541,"playId":"401871058370","tiePercentage":0},{"homeWinPercentage":0.3365,"playId":"401871058368","tiePercentage":0},{"homeWinPercentage":0.3325,"playId":"401871058375","tiePercentage":0},{"homeWinPercentage":0.3294,"playId":"401871058373","tiePercentage":0}],"gameInfo":{"venue":{"id":"3725","guid":"4b7e2309-d825-3689-abc1-f8a26e4973ca","fullName":"Johnny \"Red\" Floyd Stadium","address":{"city":"Murfreesboro","state":"TN","zipCode":"37130","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3725.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":10005},"article":{"headline":"Rickie Collins' 3 passing TDs help Kennesaw State beat Middle Tennessee 44-28 in Conference USA play","description":"— Rickie Collins threw for 206 yards and three touchdowns, and Tywon Christopher returned an interception 59 yards for a score as Kennesaw State pulled away from Middle Tennessee 44-28 on Wednesday night.","story":"MURFREESBORO, Tenn. -- — <a href=\"http://www.espn.com/college-football/player/_/id/4870645/rickie-collins\" target=\"_new\">Rickie Collins</a> threw for 206 yards and three touchdowns, and <a href=\"http://www.espn.com/college-football/player/_/id/5193295/tywon-christopher\" target=\"_new\">Tywon Christopher</a> returned an interception 59 yards for a score as Kennesaw State pulled away from Middle Tennessee 44-28 on Wednesday night.\n\n\r\n              The Owls (2-6, 1/3 Conference USA) led 19-17 at halftime before Christopher’s pick-six early in the third quarter pushed the advantage to 27-17.\n\n\r\n              Collins connected with <a href=\"http://www.espn.com/college-football/player/_/id/5081089/dylan-gary\" target=\"_new\">Dylan Gary</a> for touchdown passes of 31 and 28 yards and also found <a href=\"http://www.espn.com/college-football/player/_/id/5083103/davis-bryson\" target=\"_new\">Davis Bryson</a> for a 23-yard score, the first touchdown reception of his career.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5220641/boogie-woods\" target=\"_new\">Boogie Woods III</a> added touchdown runs of 12 and 2 yards and finished with 67 yards on 12 carries for Kennesaw State.\n\n\r\n              Middle Tennessee (4-4, 2-2) took a 14-7 lead in the second quarter on Antonio Martin’s 7-yard touchdown run, but Kennesaw State answered with 12 straight points before halftime.\n\n\r\n              The Owls scored 25 uncontested points after Middle Tennessee cut the deficit to 19-17.\n\n\r\n              Collins completed 16 of his 19 passes with one interception. Gary caught two passes for 59 yards, both touchdowns.\n\n\r\n              Martin rushed for 106 yards and a touchdown for Middle Tennessee, while <a href=\"http://www.espn.com/college-football/player/_/id/5194626/roman-gagliano\" target=\"_new\">Roman Gagliano</a> threw for 183 yards with two interceptions and added 47 yards and a score on the ground.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/4870691/santana-fleming\" target=\"_new\">Santana Fleming</a> returned a kickoff 100 yards for a touchdown late in the fourth for MTSU.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kennesaw State: Hosts Delaware on Nov. 7.\n\n\r\n              Middle Tennessee: Plays Western Kentucky at home on Nov. 7.\n\n\r\n              ------\n\n\r\n            