e":0.2267,"playId":"401871057353","tiePercentage":0},{"homeWinPercentage":0.2051,"playId":"401871057358","tiePercentage":0}],"gameInfo":{"venue":{"id":"3601","guid":"d04c5806-b1fb-3a13-969d-53e94cb5197a","fullName":"Aggie Memorial Stadium","address":{"city":"Las Cruces","state":"NM","zipCode":"88003","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3601.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":0},"article":{"headline":"Creel's career-high 211 yards rushing, TD lead Jacksonville State's route of New Mexico State 24-0","description":"— Quarterback Caden Creel rushed for a career-high 211 yards and a touchdown as Jacksonville State shut out New Mexico State 24-0 on Wednesday night.","story":"LAS CRUCES, N.M. -- — Quarterback <a href=\"http://www.espn.com/college-football/player/_/id/5122157/caden-creel\" target=\"_new\">Caden Creel</a> rushed for a career-high 211 yards and a touchdown as Jacksonville State shut out New Mexico State 24-0 on Wednesday night.\n\n\r\n              The Gamecocks (6-2, 4-0 Conference USA) won their fifth straight game and clinched bowl eligibility for the fourth straight season at the Bowl Subdivision level.\n\n\r\n              Creel became the first Jacksonville State quarterback to rush for 200 yards in a game, surpassing his previous career high of 161 yards against Southern Miss in 2025.\n\n\r\n              He broke loose for a career-long 84-yard run late in the third quarter to set up Jalen Likely’s 1-yard touchdown, which extended the lead to 17-0.\n\n\r\n              Creel opened the scoring with a 3-yard touchdown run in the second quarter, and <a href=\"http://www.espn.com/college-football/player/_/id/5150909/garrison-rippa\" target=\"_new\">Garrison Rippa</a> added a 49-yard field goal in the third. Creel connected with <a href=\"http://www.espn.com/college-football/player/_/id/5265478/luke-gilbert\" target=\"_new\">Luke Gilbert</a> for a 29-yard touchdown in the fourth.\n\n\r\n              Jacksonville State rushed for a season-high 324 yards, topping its previous best of 276 against Middle Tennessee.\n\n\r\n              The Gamecocks also held New Mexico State scoreless and limited the Aggies to 29 yards passing. <a href=\"http://www.espn.com/college-football/player/_/id/5180148/marc-woods\" target=\"_new\">Marc Woods</a> intercepted <a href=\"http://www.espn.com/college-football/player/_/id/5152503/adam-damante\" target=\"_new\">Adam Damante</a> in the second half.\n\n\r\n              New Mexico State rushed for 192 yards, led by <a href=\"http://www.espn.com/college-football/player/_/id/5220253/james-jones\" target=\"_new\">James Jones</a>' 112.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jacksonville State: Plays Sam Houston at home on Nov. 7.\n\n\r\n              New Mexico State: Hosts Liberty on Nov. 7.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-29T03:27:45Z"}}