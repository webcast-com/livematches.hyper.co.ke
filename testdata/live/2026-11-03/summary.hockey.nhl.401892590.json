ortName":"B. Dillon"},"type":"shooter"},{"athlete":{"id":"3025540","displayName":"Casey DeSmith","shortName":"C. DeSmith"}}]},{"id":"401892590000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Johnathan Kovacevic hit Roope Hintz","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:28"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"4587933","displayName":"Johnathan Kovacevic","shortName":"J. Kovacevic"},"type":"hit-credited"},{"athlete":{"id":"3904183","displayName":"Roope Hintz","shortName":"R. Hintz"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"516","fullName":"American Airlines Center","address":{"city":"Dallas","state":"TX","zipCode":"75398","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/516.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18532,"officials":[{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Connor Hellebuyck earns win in his Devils debut as New Jersey beats Dallas 5-1","description":"— Connor Hellebuyck stopped 16 of the 17 shots he faced to win his New Jersey debut, Nico Hischier scored two goals, and the Devils beat the Dallas Stars 5-1 on Tuesday night.","story":"DALLAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> stopped 16 of the 17 shots he faced to win his New Jersey debut, <a href=\"http://www.espn.com/nhl/player/_/id/4233555/nico-hischier\">Nico Hischier</a> scored two goals, and the Devils beat the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> 5-1 on Tuesday night.\n\n\r\n              Hellebuyck, the three-time Vezina Trophy winner, started four days after being <a href=\"https://apnews.com/article/hellebuyck-trade-devils-jets-26c70cac1b23930670e1200f298ac80e\">traded by the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a></a> following his suspension for failing to report to training camp. It was his first win since April 9 at St. Louis, 3-2.\n\n\r\n              The Hughes brothers, Jack and Luke, and <a href=\"http://www.espn.com/nhl/player/_/id/4233872/jesper-boqvist\">Jesper Boqvist</a>, also scored for the Devils, who have won four consecutive games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5229176/justin-hryckowian\">Justin Hryckowian</a> scored for the Stars, who had a five-game winning streak snapped. <a href=\"http://www.espn.com/nhl/player/_/id/3025540/casey-desmith\">Casey DeSmith</a>, making his third start of the season, made 22 saves after allowing only two goals in each of his previous outings.\n\n\r\n              The five goals are the season high against Dallas, which went into play leading the NHL with a 1.68 goals-against average.\n\n\r\n              Hischier, the team captain in his 10th season with New Jersey, provided a 2-0 lead at 2:41 of the first period and 38 seconds into the second. Dallas’ challenge for goaltender interference against <a href=\"http://www.espn.com/nhl/player/_/id/3899978/timo-meier\">Timo Meier</a> on the first goal was denied. Hischier has a team-high seven goals and two two-goal games.\n\n\r\n              Boqvist made it 3-0 midway through the second. After Hryckowian’s deflection pulled Dallas back within two goals at 16:08 of the second, <a href=\"http://www.espn.com/nhl/player/_/id/4874719/luke-hughes\">Luke Hughes</a> answered 28 seconds later.\n\n\r\n              The Stars’ second-ranked penalty kill went 3 for 3 for 22 consecutive successful kills over six games.\n\n\r\n              The game was Dallas’ fourth in a season-long six-game homestand and began a road back-to-back for New Jersey.\n\n\r\n              Stars defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3939716/kyle-capobianco\">Kyle Capobianco</a> was helped off the ice five minutes into the third period with an apparent leg injury and didn’t return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Devils: Visit Colorado on Wednesday night.\n\n\r\n              Stars: Host Montreal on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-28T02:50:46Z"}}