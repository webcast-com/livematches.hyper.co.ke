splayName":"Joel Armia","shortName":"J. Armia"},"type":"shooter"},{"athlete":{"id":"4565234","displayName":"Spencer Knight","shortName":"S. Knight"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1847","fullName":"United Center","address":{"city":"Chicago","state":"IL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1847.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16437,"officials":[{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Wyatt Kaiser scores as the Chicago Blackhawks stop a 3-game slide, topping the Los Angeles Kings 2-1","description":"— Wyatt Kaiser snapped a third-period tie, Spencer Knight made 25 saves and the Chicago Blackhawks beat the Los Angeles Kings 2-1 on Tuesday night.","story":"CHICAGO -- — <a href=\"http://www.espn.com/nhl/player/_/id/4697717/wyatt-kaiser\">Wyatt Kaiser</a> snapped a third-period tie, <a href=\"http://www.espn.com/nhl/player/_/id/4565234/spencer-knight\">Spencer Knight</a> made 25 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> 2-1 on Tuesday night.\n\n\r\n              Chicago stopped a three-game slide while improving to 3-4-0 on a seven-game homestand. <a href=\"http://www.espn.com/nhl/player/_/id/5149231/roman-kantserov\">Roman Kantserov</a> scored in the second, and the Blackhawks killed off a double-minor penalty on defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5080173/sam-rinzel\">Sam Rinzel</a> for high-sticking.\n\n\r\n              Kaiser picked up his first goal of the season at 7:17, beating <a href=\"http://www.espn.com/nhl/player/_/id/3036851/anton-forsberg\">Anton Forsberg</a> through the goaltender's legs with a well-placed shot from the left circle. It was the 11th goal for the defenseman in 187 career games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874923/samuel-helenius\">Samuel Helenius</a> scored for Los Angeles in the finale of a 3-2-0 trip. Forsberg stopped 25 shots.\n\n\r\n              Kings captain <a href=\"http://www.espn.com/nhl/player/_/id/3995/drew-doughty\">Drew Doughty</a> and forward <a href=\"http://www.espn.com/nhl/player/_/id/2273/corey-perry\">Corey Perry</a> were scratched after they played in Monday night’s <a href=\"https://apnews.com/article/kings-rangers-score-626c60c27096e24c7d843998f5ae6eba\">6-3 victory</a> over the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a>.\n\n\r\n              The Blackhawks played without defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4565225/bowen-byram\">Bowen Byram</a>, who missed his fifth consecutive game with an upper-body injury.\n\n\r\n              Los Angeles got off to a fast start. <a href=\"http://www.espn.com/nhl/player/_/id/5104200/jared-wright\">Jared Wright</a>'s shot trickled past Knight, and Helenius poked it home at 2:31 for his first goal of the season.\n\n\r\n              The Kings carried their 1-0 lead deep into the second period. But <a href=\"http://www.espn.com/nhl/player/_/id/2562596/joel-armia\">Joel Armia</a> was whistled for tripping at 14:26 and interference at 16:29, and <a href=\"http://www.espn.com/nhl/player/_/id/5149125/connor-bedard\">Connor Bedard</a> set up Kantserov for the rookie's team-high fifth goal at 16:40.\n\n\r\n              The Blackhawks are 4 for 39 (10.3%) on the power play in 12 games. They converted 16.9% of their chances last season, ranking 29th in the NHL.\n\n\r\n              <hl2>Up next</hl2>\r\n              Both teams play on Thursday night. The Kings host the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a>, and the Blackhawks visit the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a>.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-28T02:48:46Z"}}