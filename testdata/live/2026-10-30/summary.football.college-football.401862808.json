Id":"401862808340","tiePercentage":0},{"homeWinPercentage":0.3396,"playId":"401862808344","tiePercentage":0},{"homeWinPercentage":0.3396,"playId":"401862808351","tiePercentage":0},{"homeWinPercentage":0.338,"playId":"401862808352","tiePercentage":0},{"homeWinPercentage":0.3218,"playId":"401862808349","tiePercentage":0},{"homeWinPercentage":0.3222,"playId":"401862808358","tiePercentage":0},{"homeWinPercentage":0.3246,"playId":"401862808356","tiePercentage":0},{"homeWinPercentage":0.3243,"playId":"401862808364","tiePercentage":0}],"gameInfo":{"venue":{"id":"3674","guid":"26aa1b95-3732-3b7c-bbe7-d784905b178b","fullName":"H. A. Chapman Stadium","address":{"city":"Tulsa","state":"OK","zipCode":"74104","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3674.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":20247},"article":{"headline":"Dawson Jones' 50-yard FG on final play lifts Army over Tulsa 38-35","description":"— Dawson Jones kicked a 50-yard field goal on the final play of the game and Army rallied last in a 38-35 victory over Tulsa on Friday night.","story":"TULSA, Okla. -- — <a href=\"http://www.espn.com/college-football/player/_/id/5219470/dawson-jones\" target=\"_new\">Dawson Jones</a> kicked a 50-yard field goal on the final play of the game and Army rallied last in a 38-35 victory over Tulsa on Friday night.\n\n\r\n              Jones kicked a career-long 51-yarder for a 10-7 first-quarter lead, and was good from 34 yards out to give Army (5-2, 4-1 American Conference) a 20-14 lead at halftime.\n\n\r\n              Quarterback <a href=\"http://www.espn.com/college-football/player/_/id/5150297/cale-hellums\" target=\"_new\">Cale Hellums</a> carried 30 times for 121 yards and three touchdowns for the Black Knights, while adding 64 yards on 7-for-12 passing. <a href=\"http://www.espn.com/college-football/player/_/id/5293685/godspower-nwawuihe\" target=\"_new\">Godspower Nwawuihe</a> finished with 12 rushes for 135 yards and a score. \n\n\r\n              Hellums broke free for a 41-yard touchdown on a fourth-and-1 run and Army took a 7-0 lead on the game's opening possession.\n\n\r\n              Tulsa (4-4, 1-3) answered with an 8-yard touchdown run by <a href=\"http://www.espn.com/college-football/player/_/id/5229589/javon-ross\" target=\"_new\">Javon Ross</a> to tie it 7-all.\n\n\r\n              Ross hauled in a 17-yard scoring toss from <a href=\"http://www.espn.com/college-football/player/_/id/5224011/baylor-hayes\" target=\"_new\">Baylor Hayes</a> and the Golden Hurricane led 14-10 early in the second quarter.\n\n\r\n              Hellums bulled his way in from a yard out on fourth down and Army moved ahead 17-14 thanks to a drive that lasted 15 plays and took 9:51 off the clock.\n\n\r\n              Nwawuihe raced 66 yards for a touchdown on Army's second play of the third quarter, and <a href=\"http://www.espn.com/college-football/player/_/id/5082118/zach-mundell\" target=\"_new\">Zach Mundell</a> added a two-point run for a 28-14 lead.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5157287/david-wells-jr\" target=\"_new\">David Wells Jr</a>. answered with an 11-yard touchdown run, and <a href=\"http://www.espn.com/college-football/player/_/id/5295930/trequan-jones\" target=\"_new\">Trequan Jones</a> followed with a 59-yarder to tie it 28-all heading to the fourth quarter.\n\n\r\n              Hayes connected with <a href=\"http://www.espn.com/college-football/player/_/id/4429804/jimmy-calloway\" target=\"_new\">Jimmy Calloway</a> for a 13-yard touchdown with 13:25 left to play to give Tulsa the lead.\n\n\r\n              Army's <a href=\"http://www.espn.com/college-football/player/_/id/5390363/david-jakande\" target=\"_new\">David Jakande</a> blocked and recovered a punt at the Tulsa 13-yard line, and Hellums scored on a 1-yard plunge with 1:50 remaining to tie it 35-all.\n\n\r\n              Hayes totaled 262 yards on 23-for-34 passing for Tulsa, and Calloway had 10 catches for 88 yards.\n\n\r\n              <hl2>Up next</hl2>\r\n              Army: At Memphis on Oct. 31.\n\n\r\n              Tulsa: At Tulane on Nov. 7.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>. Visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-10-24T04:33:54Z"}}