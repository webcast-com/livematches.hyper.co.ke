{"header":{"id":"401873017","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873017","uid":"s:20~l:28~e:401873017~c:401873017","date":"2026-10-25T17:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"1","uid":"s:20~l:28~t:1","order":0,"homeAway":"home","winner":true,"score":"29","possession":false,"linescores":[{"displayValue":"3"},{"displayValue":"9"},{"displayValue":"7"},{"displayValue":"10"}],"team":{"id":"1","abbreviation":"ATL","displayName":"Atlanta Falcons","name":"Falcons","location":"Atlanta","nickname":"Falcons","color":"a71930","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png"}]}},{"id":"25","uid":"s:20~l:28~t:25","order":1,"homeAway":"away","winner":false,"score":"20","possession":false,"linescores":[{"displayValue":"7"},{"displayValue":"7"},{"displayValue":"0"},{"displayValue":"6"}],"team":{"id":"25","abbreviation":"SF","displayName":"San Francisco 49ers","name":"49ers","location":"San Francisco","nickname":"49ers","color":"aa0000","alternateColor":"b3995d","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/sf.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/sf.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"25","abbreviation":"SF","displayName":"San Francisco 49ers","shortDisplayName":"49ers","name":"49ers","location":"San Francisco","color":"aa0000","alternateColor":"b3995d","logo":"https://a.espncdn.com/i/teamlogos/nfl/500