playValue":"2:32"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"4"},"participants":[{"athlete":{"id":"3900260","displayName":"Jordan Greenway","shortName":"J. Greenway"},"type":"shooter"},{"athlete":{"id":"5188437","displayName":"Jacob Fowler","shortName":"J. Fowler"},"type":"saver"}]},{"id":"401892564000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:33"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892564000000790","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ryan Greene faceoff won against Alex Newhook","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:33"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"4"},"participants":[{"athlete":{"id":"5080227","displayName":"Ryan Greene","shortName":"R. Greene"},"type":"face-off-winner"},{"athlete":{"id":"4565237","displayName":"Alex Newhook","shortName":"A. Newhook"}}]}],"gameInfo":{"venue":{"id":"1847","fullName":"United Center","address":{"city":"Chicago","state":"IL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1847.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19592,"officials":[{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Morgan MacPhee","displayName":"Morgan MacPhee","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Jake Evans scores twice in the Canadiens' 4-1 victory over the Blackhawks","description":"— Jake Evans scored twice and assisted on Kaiden Guhle’s goal and the Montreal Canadiens beat the Chicago Blackhawks 4-1 on Friday night.","story":"CHICAGO -- — <a href=\"http://www.espn.com/nhl/player/_/id/4393049/jake-evans\">Jake Evans</a> scored twice and assisted on Kaiden Guhle’s goal and the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> 4-1 on Friday night.\n\n\r\n              Evans’ third point, a feed to Guhle with 1:34 left in the second period, matched his career high. Montreal is 4-1-1 in its last six games, while Chicago has dropped two straight and four of its last six.\n\n\r\n              A wide-open game tightened up late in the first period, which worked to Montreal’s advantage. Chicago opened the scoring on Connor Bedard’s second goal of the season 4:23 in, but the Canadiens began to control the play, and by mid-period were limiting Chicago’s chances.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5188437/jacob-fowler\">Jacob Fowler</a>, who made 20 saves, was lightly tested the rest of the game despite five Chicago power plays, and needed to make only three saves in the final period.\n\n\r\n              Evans’ first goal of the game and season tied it with 2:31 left in the first. His second, a wrist shot over goalie Spencer Knight’s stick side with the Canadiens skating short-handed, gave Montreal a 2-1 lead 7:51 into the second period.\n\n\r\n              Guhle also beat Knight on the stick side, his shot from the left point screened by <a href=\"http://www.espn.com/nhl/player/_/id/3069687/josh-anderson\">Josh Anderson</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976851/mike-matheson\">Mike Matheson</a> added an empty-net goal with 2:38 remaining.\n\n\r\n              Knight stopped 24 shots.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canadiens: At Winnipeg on Sunday for the outdoor Heritage Classic.\n\n\r\n              Blackhawks: Hosts Florida on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-24T02:56:46Z"}}