rtName":"D. Hunt"},"type":"hit-credited"},{"athlete":{"id":"2967072","displayName":"Jonathan Marchessault","shortName":"J. Marchessault"},"type":"hitted"}]},{"id":"401891816000001090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Bobby Brink hit Adam Wilsby","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"30"},"participants":[{"athlete":{"id":"4565257","displayName":"Bobby Brink","shortName":"B. Brink"},"type":"hit-credited"},{"athlete":{"id":"4697765","displayName":"Adam Wilsby","shortName":"A. Wilsby"},"type":"hitted"}]},{"id":"401891816000001100","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ryan Hartman hit Mavrik Bourque","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:02"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"30"},"participants":[{"athlete":{"id":"3042063","displayName":"Ryan Hartman","shortName":"R. Hartman"},"type":"hit-credited"},{"athlete":{"id":"4697413","displayName":"Mavrik Bourque","shortName":"M. Bourque"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1834","fullName":"Bridgestone Arena","address":{"city":"Nashville","state":"TN","zipCode":"37250","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1834.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17284,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"A fast first period sets the tone as the Wild open with a 3-1 win over Nashville","description":"— Nick Foligno and Blake Coleman scored first-period goals, and the Minnesota Wild beat the Nashville Predators 3-1 on Thursday night in the...","story":"NASHVILLE, Tenn. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3535/nick-foligno\">Nick Foligno</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2563026/blake-coleman\">Blake Coleman</a> scored first-period goals, and the <a href=\"https://apnews.com/hub/minnesota-wild\"><a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a></a> beat the <a href=\"https://apnews.com/hub/nashville-predators\"><a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a></a> 3-1 on Thursday night in the season opener for both teams. \n\n\r\n              The Wild lost in the second round of the Western Conference playoffs last spring in <a href=\"https://apnews.com/article/wild-avalanche-stanley-cup-playoffs-score-26d81dc30c6d36930da9fdbcdaca985d\">five games to Colorado.</a> After giving coach John Hynes a <a href=\"https://apnews.com/article/wild-hynes-contract-extension-8db723a7d92af57c643cb01b7a446fab\">contract extension</a> last month, Minnesota is targeting a third straight postseason berth. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3942335/kirill-kaprizov\">Kirill Kaprizov</a> also had a goal for Minnesota, which is playing 21 of its first 31 games on the road this season. <a href=\"http://www.espn.com/nhl/player/_/id/4874737/jesper-wallstedt\">Jesper Wallstedt</a> made 19 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5436/roman-josi\">Roman Josi</a> scored for Nashville, which went 0 of 4 with the man advantage. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2968772/filip-forsberg\">Filip Forsberg</a> matched an NHL record with an assist on Josi's goal, giving him at least a point in 11 straight season openers. Forsberg now has 15 points in 11 openers, tying the mark held by Viktor Kozlov (1997-98, 2008-09) and Vincent Lecavalier (2002-03 and 2013-14).\n\n\r\n              The Predators had an offseason of change with Chris MacFarland hired away from Colorado to take over as general manager and president of hockey operations. Nashville has missed the playoffs three of the past four seasons, and <a href=\"https://apnews.com/article/nashville-predators-38f895b13f649ab7597f3e5c2cd3a135\">MacFarland made a few changes</a> trying to retool and avoid a rebuild.\n\n\r\n              Foligno scored from the high slot off a rebound at 9:35 of the first, and Coleman made it 2-0 at 13:48 with a power-play goal. Minnesota nearly had a 3-0 lead, but <a href=\"http://www.espn.com/nhl/player/_/id/3904188/yakov-trenin\">Yakov Trenin</a>'s goal at 15:05 was wiped off when Nashville won its challenge for goaltender interference for <a href=\"http://www.espn.com/nhl/player/_/id/3042063/ryan-hartman\">Ryan Hartman</a> making contact with <a href=\"http://www.espn.com/nhl/player/_/id/3042109/juuse-saros\">Juuse Saros</a>, who had 27 saves.\n\n\r\n              Nashville pulled within 2-1 when Josi scored on a slap shot at 9:23 of the second. \n\n\r\n              Kaprisov helped seal the win tipping in <a href=\"http://www.espn.com/nhl/player/_/id/4320548/quinn-hughes\">Quinn Hughes</a>' shot through traffic over Saros' stick arm at 4:42 of the third. \n\n\r\n              <hl2>Up next </hl2>\r\n              Minnesota hosts Boston on Saturday night for the Wild's home opener.\n\n\r\n              The Predators host Dallas on Saturday night. \n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-02T02:49:43Z"}}