splayName":"Alexis Lafreniere","shortName":"A. Lafreniere"},"type":"hitted"}]},{"id":"401891819000000680","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Braden Schneider Snap Shot saved by Andrei Vasilevskiy","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:11"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4697402","displayName":"Braden Schneider","shortName":"B. Schneider"},"type":"shooter"},{"athlete":{"id":"2976847","displayName":"Andrei Vasilevskiy","shortName":"A. Vasilevskiy"},"type":"saver"}]},{"id":"401891819000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Braden Schneider Snap Shot saved by Andrei Vasilevskiy","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:18"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4697402","displayName":"Braden Schneider","shortName":"B. Schneider"},"type":"shooter"},{"athlete":{"id":"2976847","displayName":"Andrei Vasilevskiy","shortName":"A. Vasilevskiy"},"type":"saver"}]},{"id":"401891819000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:20"},"period":{"number":1,"displayValue":"1st"}},{"id":"401891819000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Anthony Cirelli faceoff won against Noah Laba","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:20"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3941973","displayName":"Anthony Cirelli","shortName":"A. Cirelli"},"type":"face-off-winner"},{"athlete":{"id":"5188370","displayName":"Noah Laba","shortName":"N. Laba"}}]}],"gameInfo":{"venue":{"id":"1830","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18006,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ryan Daisy","displayName":"Ryan Daisy","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Morgan MacPhee","displayName":"Morgan MacPhee","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Igor Shesterkin becomes first Rangers goalie to score in 5-1 win over Lightning in home opener","description":"— Igor Shesterkin became the first New York Rangers goalie to score when he lofted the puck the length of the ice into an empty net, capping a 5-1 victory over the Tampa Bay Lightning on Thursday night.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a> became the first <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> goalie to score when he lofted the puck the length of the ice into an empty net, capping a 5-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> on Thursday night.\n\n\r\n              A year after <a href=\"https://3ed48d84c95334499ccef7a2d0c5aab1\">failing to score</a> in their first three home games last season, the Rangers wasted little time preventing a repeat performance, getting a goal from <a href=\"http://www.espn.com/nhl/player/_/id/2562637/mika-zibanejad\">Mika Zibanejad</a> less than six minutes into their Madison Square Garden opener.\n\n\r\n              <a href=\"https://apnews.com/article/dorofeyev-brady-tkachuk-bobrovsky-abd319ccdf03a8fe9610096157fc5c7e\"><a href=\"http://www.espn.com/nhl/player/_/id/4587588/pavel-dorofeyev\">Pavel Dorofeyev</a></a> and <a href=\"https://apnews.com/article/rangers-sign-eeli-tolvanen-5b3512afa162b82ae9d727dcfd8ba9a0\"><a href=\"http://www.espn.com/nhl/player/_/id/4233720/eeli-tolvanen\">Eeli Tolvanen</a></a> each scored his first goal with his new team, and top prospect-turned-important contributor <a href=\"http://www.espn.com/nhl/player/_/id/5149204/gabe-perreault\">Gabe Perreault</a> deflected in a shot by No. 1 defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4197146/adam-fox\">Adam Fox</a>. \n\n\r\n              Shesterkin scored with 2:34 remaining, becoming the 18th goalie in NHL history with a goal. The first of his career was the 21st by a player at the position, counting the playoffs. \n\n\r\n              It was a far cry from the nightmare start at MSG in October 2025, when the Rangers went nearly 181 minutes before setting off the goal horn there. They <a href=\"https://3ed48d84c95334499ccef7a2d0c5aab1\">became the first team in league history</a> to get shut out in the first three home games of a season.\n\n\r\n              The crowd at this home opener didn't even have much of a chance to get nervous. Coming off <a href=\"https://apnews.com/f1d4f273bc184a59be6e35ea7bbc9f2f\">getting blanked</a> 3-0 on the road Tuesday night at Boston, New York was the aggressor early. Drawing a penalty paved the way for Zibanejad to score on the power play.\n\n\r\n              The offensive outburst allowed the Rangers to put up four goals on 24 shots against <a href=\"https://apnews.com/article/andrei-vasilevskiy-vezina-trophy-e7f9628b1b2d1fc01ee47b8e211afb3b\">two-time Vezina Trophy-</a> and Stanley Cup-winning goaltender <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a>. In a matchup of two of the best at the position in the world, Shesterkin stopped 24 of the 25 shots he faced, leading to chants of “Igor's better!” \n\n\r\n              The only goal Shesterkin gave up was to <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a>, the <a href=\"https://apnews.com/article/nikita-kucherov-hart-trophy-ba9288fd8e5cdd2320152f1a02a954ac\">reigning MVP</a> who banked the puck in off the right skate of Rangers center <a href=\"http://www.espn.com/nhl/player/_/id/5188370/noah-laba\">Noah Laba</a>. \n\n\r\n              More “Igor!” chants followed his goal.\n\n\r\n              <hl2>Up next</hl2>\r\n              Lightning: Host Washington in their home opener Saturday night.\n\n\r\n              Rangers: With backup goalie <a href=\"https://apnews.com/article/rangers-joonas-korpisalo-injury-a5621ed2f676d087d586cdfb456a9eaf\"><a href=\"http://www.espn.com/nhl/player/_/id/3069266/joonas-korpisalo\">Joonas Korpisalo</a> injured</a>, Dylan Garand appears in line to start Friday night at Detroit.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-02T02:09:40Z"}}