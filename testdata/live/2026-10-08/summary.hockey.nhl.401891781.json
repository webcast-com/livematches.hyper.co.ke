:[{"athlete":{"id":"3042198","displayName":"Carson Soucy","shortName":"C. Soucy"},"type":"shooter"},{"athlete":{"id":"4233889","displayName":"Ukko-Pekka Luukkonen","shortName":"U. Luukkonen"},"type":"saver"}]},{"id":"401891781000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"0:31"},"period":{"number":1,"displayValue":"1st"}},{"id":"401891781000000630","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Adam Fantilli faceoff won against Sam Carrick","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"0:31"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"5136617","displayName":"Adam Fantilli","shortName":"A. Fantilli"},"type":"face-off-winner"},{"athlete":{"id":"5474","displayName":"Sam Carrick","shortName":"S. Carrick"}}]},{"id":"401891781000000660","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jiri Kulich Wrist Shot saved by Jet Greaves","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"0:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"5080176","displayName":"Jiri Kulich","shortName":"J. Kulich"},"type":"shooter"},{"athlete":{"id":"4894366","displayName":"Jet Greaves","shortName":"J. Greaves"},"type":"saver"}]},{"id":"401891781000000100","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"0:40"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1828","fullName":"Nationwide Arena","address":{"city":"Columbus","state":"OH","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1828.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18207,"officials":[{"fullName":"Francis Charron","displayName":"Francis Charron","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Libor Suchanek","displayName":"Libor Suchanek","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Knies has 2 goals and an assist in Columbus debut as Blue Jackets beat Sabres 6-3","description":"— Matthew Knies had two goals and an assist in his Columbus debut and the Blue Jackets beat the Buffalo Sabres 6-3 on Thursday night for their first season-opening victory in five years.","story":"COLUMBUS, Ohio -- — <a href=\"http://www.espn.com/nhl/player/_/id/4874919/matthew-knies\">Matthew Knies</a> had two goals and an assist in his Columbus debut and the Blue Jackets beat the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 6-3 on Thursday night for their first season-opening victory in five years.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874725/cole-sillinger\">Cole Sillinger</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5136617/adam-fantilli\">Adam Fantilli</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3041996/sean-monahan\">Sean Monahan</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4064781/mathieu-olivier\">Mathieu Olivier</a> also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/2555315/charlie-coyle\">Charlie Coyle</a> added three assists. Reigning Norris Trophy winner <a href=\"http://www.espn.com/nhl/player/_/id/3899972/zach-werenski\">Zach Werenski</a> had two assists, and <a href=\"http://www.espn.com/nhl/player/_/id/4894366/jet-greaves\">Jet Greaves</a> stopped 23 shots.\n\n\r\n              Knies, acquired from Toronto on Monday, became the first Columbus player to score twice in his Blue Jackets debut. The three points tied the franchise record for a debut set by <a href=\"http://www.espn.com/nhl/player/_/id/3891952/artemi-panarin\">Artemi Panarin</a>, who had three assists in 2017.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4378656/mattias-samuelsson\">Mattias Samuelsson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5216882/konsta-helenius\">Konsta Helenius</a> scored for Buffalo, and <a href=\"http://www.espn.com/nhl/player/_/id/5080160/noah-ostlund\">Noah Ostlund</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4781556/owen-power\">Owen Power</a> each had two assists. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> stopped 16 shots.\n\n\r\n              Samuelsson, back after suffering a lower-body injury in the preseason, gave the Sabres the lead at 7:21 of the first period while the teams were skating 4 on 4. Sillinger tied it with 7:09 to go in the period, burying Coyle’s drop pass in front of the net.\n\n\r\n              Knies scored his first Blue Jackets goal on the power play with 2:02 left, then assisted on Fantilli’s goal with 1:16 to go to give Columbus a 3-1 lead.\n\n\r\n              Quinn pulled Buffalo within a goal 1:25 into the second period before Knies restored the two-goal lead. Helenius made it 4-3, and Monahan added a power-play goal with 5:39 to go in the third. Olivier made it 6-3 with an empty-net goal with 2:07 remaining.\n\n\r\n              Columbus has won four straight home games against Buffalo. \n\n\r\n              <hl2>Up next</hl2>\r\n              Sabres: Host Chicago on Saturday night in their home opener.\n\n\r\n              Blue Jackets: Host Utah on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-02T02:06:30Z"}}