"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:21"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4233884","displayName":"Mario Ferraro","shortName":"M. Ferraro"},"type":"hit-credited"},{"athlete":{"id":"5103825","displayName":"Declan Carlile","shortName":"D. Carlile"},"type":"hitted"}]},{"id":"401892447000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:52"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1837","fullName":"PPG Paints Arena","address":{"city":"Pittsburgh","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1837.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17767,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jets edge Penguins 3-2 as Cole Perfetti scores 9 seconds after tying goal","description":"— Alex Iafallo had a goal and an assist, Clay Stevenson made 29 saves, and the Winnipeg Jets beat the Pittsburgh Penguins 3-2 on Monday night.","story":"PITTSBURGH -- — <a href=\"http://www.espn.com/nhl/player/_/id/3652598/alex-iafallo\">Alex Iafallo</a> had a goal and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/5104602/clay-stevenson\">Clay Stevenson</a> made 29 saves, and the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> 3-2 on Monday night.\n\n\r\n              Pittsburgh's <a href=\"http://www.espn.com/nhl/player/_/id/5103825/declan-carlile\">Declan Carlile</a> scored 8:53 into the third period to tie the game at 2-2, but <a href=\"http://www.espn.com/nhl/player/_/id/4697392/cole-perfetti\">Cole Perfetti</a> scored the winner on a wrist shot just nine seconds later, assisted by <a href=\"http://www.espn.com/nhl/player/_/id/3042016/josh-morrissey\">Josh Morrissey</a>, to put the Jets ahead to stay.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2563066/adam-lowry\">Adam Lowry</a> also scored for the Jets, who have won two in a row after losing their season opener.\n\n\r\n              Benjamin Kindel also scored for the Penguins and Carlile added an assist. <a href=\"http://www.espn.com/nhl/player/_/id/5188366/sergei-murashov\">Sergei Murashov</a> made 30 saves for the Penguins.\n\n\r\n              The Jets outhit the Penguins by 12, 23 to 11.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: Host the <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> on Wednesday night.\n\n\r\n              Penguins: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>\r\n              \n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: Host the Colorado Avalanche on Wednesday.\n\n\r\n              Penguins: At the Washington Capitals on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-06T02:54:28Z"}}