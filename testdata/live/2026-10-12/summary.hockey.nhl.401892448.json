":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jason Robertson Wrist Shot Above Crossbar","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:23"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"9"},"participants":[{"athlete":{"id":"4233875","displayName":"Jason Robertson","shortName":"J. Robertson"},"type":"shooter"},{"athlete":{"id":"4697394","displayName":"Yaroslav Askarov","shortName":"Y. Askarov"}}]},{"id":"401892448000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892448000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ty Dellandrea faceoff won against Justin Hryckowian","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"4352747","displayName":"Ty Dellandrea","shortName":"T. Dellandrea"},"type":"face-off-winner"},{"athlete":{"id":"5229176","displayName":"Justin Hryckowian","shortName":"J. Hryckowian"}}]}],"gameInfo":{"venue":{"id":"516","fullName":"American Airlines Center","address":{"city":"Dallas","state":"TX","zipCode":"75398","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/516.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18532,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kendrick Nicholson","displayName":"Kendrick Nicholson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Oettinger earns 17th career shutout as Stars beat Sharks 5-0; San Jose's Celebrini scratched","description":"— Jake Oettinger stopped the 14 shots and earned his 17th career shutout as the Dallas Stars beat the San Jose Sharks 5-0 on Monday night for their first victory of the season.","story":"DALLAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4196914/jake-oettinger\">Jake Oettinger</a> stopped the 14 shots and earned his 17th career shutout as the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> 5-0 on Monday night for their first victory of the season.\n\n\r\n              The Sharks were without star center <a href=\"http://www.espn.com/nhl/player/_/id/5206628/macklin-celebrini\">Macklin Celebrini</a>, who was scratched a few minutes before the start of the game due to a lower-body injury.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3998/jamie-benn\">Jamie Benn</a> had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4233536/miro-heiskanen\">Miro Heiskanen</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4587910/joel-kiviranta\">Joel Kiviranta</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4233875/jason-robertson\">Jason Robertson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3899938/mikko-rantanen\">Mikko Rantanen</a> also scored for Dallas.\n\n\r\n              Heiskanen's goal on a backhand shot with 1:09 left in the first period proved to be the winner. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a> had 21 saves for the Sharks.\n\n\r\n              Celebrini, who was recently named San Jose's captain, took part in warmups but left the ice earlier than usual.\n\n\r\n              Former Stars forward <a href=\"http://www.espn.com/nhl/player/_/id/4352747/ty-dellandrea\">Ty Dellandrea</a> made his season debut in place of Celebrini, the 20-year-old face of the franchise who assisted on <a href=\"https://apnews.com/f6cc835f406b5717e30b1943cef676a8\">Igor Chernyshov’s overtime goal</a> Saturday that made San Jose 2-0.\n\n\r\n              Celebrini over the summer <a href=\"https://apnews.com/6d7baefb64f974e4b847df24afb65a75\">signed a five-year, $94 million extension</a>.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sharks: At the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a> on Thursday.\n\n\r\n              Stars: At the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-06T03:01:32Z"}}