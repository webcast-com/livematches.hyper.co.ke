on":"hit"},"clock":{"displayValue":"2:14"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"5149211","displayName":"Easton Cowan","shortName":"E. Cowan"},"type":"hit-credited"},{"athlete":{"id":"4697413","displayName":"Mavrik Bourque","shortName":"M. Bourque"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18792,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Matthews scores OT winner, McKenna gets his first NHL goal, as Maple Leafs beat Predators 5-4","description":"— Auston Matthews scored with 14 seconds left in overtime and had three assists in regulation and the Toronto Maple Leafs erased a three-goal deficit in a 5-4 win over the Nashville Predators on Tuesday night.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> scored with 14 seconds left in overtime and had three assists in regulation and the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> erased a three-goal deficit in a 5-4 win over the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a> on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114736/william-nylander\">William Nylander</a>, <a href=\"https://apnews.com/article/gavin-mckenna-toronto-maple-leafs-5d5e2fdcba64e203c803e0a35ff914fb\">No. 1 overall pick <a href=\"http://www.espn.com/nhl/player/_/id/5342529/gavin-mckenna\">Gavin McKenna</a></a> — with his first as a professional — <a href=\"http://www.espn.com/nhl/player/_/id/5160/john-tavares\">John Tavares</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3904098/jack-roslovic\">Jack Roslovic</a> had the other goals for Toronto, which got 21 saves from <a href=\"http://www.espn.com/nhl/player/_/id/3067313/anthony-stolarz\">Anthony Stolarz</a>.\n\n\r\n              McKenna also picked up an assist on Tavares’ goal for his first NHL point. Nylander chipped in two assists and Roslovic added one.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5037/steven-stamkos\">Steven Stamkos</a> scored twice for Nashville to move into 17th place on the NHL’s career goals list, while <a href=\"http://www.espn.com/nhl/player/_/id/4565263/nils-hoglander\">Nils Hoglander</a> also scored twice. <a href=\"http://www.espn.com/nhl/player/_/id/2968772/filip-forsberg\">Filip Forsberg</a> had two assists and <a href=\"http://www.espn.com/nhl/player/_/id/3042109/juuse-saros\">Juuse Saros</a> made 33 stops. \n\n\r\n              Stamkos opened the scoring at 7:13 of the first period on a power play. Nashville doubled its lead at 9:08 when Hoglander collected a rebound off the end boards and slotted it home before making it 3-0 at 3:03 of the second on another tap-in.\n\n\r\n              Tavares got Toronto going off the rush at 4:56 of the middle period and Nylander connected on a man advantage at 6:58 to make it 3-2. Stamkos scored his second to restore a two-goal lead at 13:30, but McKenna scored his first NHL goal 61 seconds later.\n\n\r\n              Roslovic tied things at 8:54 of the third.\n\n\r\n              Stamkos broke a tie with Joe Sakic and Jarome Iginla on the league’s career scoring list with his first-period goal — the 626th of his career — before adding another in the second. Dave Andreychuk is 16th in NHL history with 640 career goals.\n\n\r\n              Stamkos became the third active player to score 100 game-opening goals in his career. <a href=\"http://www.espn.com/nhl/player/_/id/3101/alex-ovechkin\">Alex Ovechkin</a> leads with 154 followed by <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a> at 127.\n\n\r\n              <hl2>Up next</hl2>\r\n              Predators: At Montreal on Thursday.\n\n\r\n              Maple Leafs: At Vegas on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-07T02:19:27Z"}}