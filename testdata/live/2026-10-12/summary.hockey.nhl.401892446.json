"id":"1"},"participants":[{"athlete":{"id":"3041994","displayName":"Elias Lindholm","shortName":"E. Lindholm"},"type":"face-off-winner"},{"athlete":{"id":"4697384","displayName":"Tim Stutzle","shortName":"T. Stutzle"}}]},{"id":"401892446000000620","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Connor Clifton shot blocked by Jordan Spence","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"0:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"3042191","displayName":"Connor Clifton","shortName":"C. Clifton"},"type":"shooter"},{"athlete":{"id":"4588190","displayName":"Jordan Spence","shortName":"J. Spence"},"type":"defender"}]},{"id":"401892446000002010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Elias Lindholm Between Legs saved by Linus Ullmark","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"0:46"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"3041994","displayName":"Elias Lindholm","shortName":"E. Lindholm"},"type":"shooter"},{"athlete":{"id":"3069285","displayName":"Linus Ullmark","shortName":"L. Ullmark"},"type":"saver"}]},{"id":"401892446000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Thomas Chabot","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"0:58"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"3900219","displayName":"Thomas Chabot","shortName":"T. Chabot"},"type":"taker"}]},{"id":"401892446000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Carter Yakemchuk Slap Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:25"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"5216868","displayName":"Carter Yakemchuk","shortName":"C. Yakemchuk"},"type":"shooter"},{"athlete":{"id":"4712036","displayName":"Jeremy Swayman","shortName":"J. Swayman"}}]},{"id":"401892446000000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Cozens Wrap-around saved by Jeremy Swayman","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:07"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"},"type":"shooter"},{"athlete":{"id":"4712036","displayName":"Jeremy Swayman","shortName":"J. Swayman"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1824","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Stutzle's 3-point game, Ullmark and Ersson power Senators to a 4-1 win over Bruins","description":"— Tim Stutzle had two goals and an assist and goalies Linus Ullmark and Samuel Ersson combined to stop 18 of 19 shots as the Ottawa Senators defeated the Boston Bruins 4-1 on Monday night.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/4697384/tim-stutzle\">Tim Stutzle</a> had two goals and an assist and goalies <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4587815/samuel-ersson\">Samuel Ersson</a> combined to stop 18 of 19 shots as the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> defeated the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> 4-1 on Monday night. \n\n\r\n              Stutzle’s multi-point game moved him into sole possession of sixth place for most points in Ottawa history with 413. \n\n\r\n              Ullmark started in goal for Ottawa, but wasn’t on the ice at the start of the third period. The onetime Bruin netminder, who stopped all 10 shots he faced in the first two periods, was on the bench five minutes into the final period. Ersson made eight saves in the final period for the Senators.\n\n\r\n              Ottawa’s <a href=\"http://www.espn.com/nhl/player/_/id/3149829/michael-amadio\">Michael Amadio</a> had a goal and assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4271734/drake-batherson\">Drake Batherson</a> also scored.\n\n\r\n              Boston rookie James Hagan spoiled Ottawa's shutout bid with a goal in the third period. <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> made 20 saves for the Bruins, who have lost two straight after opening the season with two wins.\n\n\r\n              Boston was outshot 24-19 and failed to score on four power plays.\n\n\r\n              Stutzle came close to two short-handed goals on the same power play. He scored on the man advantage at 7:39 of the first. Seconds after Ottawa successfully shut down Boston on the power play, Stutzle scored on a 2-on-1 chance, making it 2-0.\n\n\r\n              Batherson scored 66 seconds into the second period, taking advantage of a Boston turnover and scoring with a backhand shot.\n\n\r\n              Amadio converted on a feed from <a href=\"http://www.espn.com/nhl/player/_/id/4565255/shane-pinto\">Shane Pinto</a> to give Ottawa a 4-0 lead, prompting Bruins head coach Marco Sturm to call at timeout at 14:41.\n\n\r\n              Ullmark was slow getting up after Boston’s <a href=\"http://www.espn.com/nhl/player/_/id/4697438/jj-peterka\">JJ Peterka</a> crashed into him at 4:25 of the second. The 2022-23 Venza Trophy winner with Boston is in his third season with Ottawa after being traded before the 2024-25 season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Senators: At Detroit on Tuesday night. \n\n\r\n              Bruins: Host Utah on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-06T02:39:30Z"}}