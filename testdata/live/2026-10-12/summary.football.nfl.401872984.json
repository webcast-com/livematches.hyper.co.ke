18729841683","tiePercentage":0},{"homeWinPercentage":0.1634,"playId":"4018729841713","tiePercentage":0},{"homeWinPercentage":0.1795,"playId":"4018729841738","tiePercentage":0},{"homeWinPercentage":0.1893,"playId":"4018729841772","tiePercentage":0},{"homeWinPercentage":0.189,"playId":"4018729841783","tiePercentage":0},{"homeWinPercentage":0.2016,"playId":"4018729841794","tiePercentage":0},{"homeWinPercentage":0.163,"playId":"4018729841826","tiePercentage":0},{"homeWinPercentage":0.1713,"playId":"4018729841846","tiePercentage":0},{"homeWinPercentage":0.1591,"playId":"4018729841869","tiePercentage":0}],"gameInfo":{"venue":{"id":"3810","guid":"2ce67339-d170-3f5a-af8f-85c1869b9e23","fullName":"Nissan Stadium","address":{"city":"Nashville","state":"TN","zipCode":"37213","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3810.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3810.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":52097,"officials":[{"fullName":"Rusty Baynes","displayName":"Rusty Baynes","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":1},{"fullName":"Sean Petty","displayName":"Sean Petty","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":2},{"fullName":"Scott Helverson","displayName":"Scott Helverson","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":3},{"fullName":"Jim Quirk","displayName":"Jim Quirk","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":4},{"fullName":"Alex Kemp","displayName":"Alex Kemp","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":5},{"fullName":"Brandon Ellison","displayName":"Brandon Ellison","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":6},{"fullName":"Matthew Griebel","displayName":"Matthew Griebel","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Stroud runs for a TD, throws for another as Houston beats Titans for 1st win of season","description":"— C.J. Stroud carried the Houston Texans to their first victory of the season, then his coach announced the quarterback is being reunited with his old Ohio State teammate after a ","story":"NASHVILLE, Tenn. -- — <a href=\"http://www.espn.com/nfl/player/_/id/4432577/cj-stroud\">C.J. Stroud</a> carried the <a href=\"http://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> to their first victory of the season, then his coach announced the quarterback is being reunited with his old Ohio State teammate after a <a href=\"https://apnews.com/article/texans-cardinals-harrison-trade-4900dc9b941a96fe9e79df10cff17bea\">trade with Arizona.</a>\n\n\r\n              A very nice Sunday indeed for both Stroud and the Texans. \n\n\r\n              Stroud threw for 261 yards and a touchdown and ran for another score and the <a href=\"https://apnews.com/hub/houston-texans\">Texans</a> snapped their winless start to the <a href=\"https://See AP’s full NFL coverage here\">season</a> by routing the <a href=\"http://www.espn.com/nfl/team/_/name/ten/tennessee-titans\">Tennessee Titans</a> 26-3. \n\n\r\n              After the win, Stroud was excited at getting to work with wide receiver <a href=\"http://www.espn.com/nfl/player/_/id/4432708/marvin-harrison-jr\">Marvin Harrison Jr</a>. again.\n\n\r\n              “I loved him in college,” Stroud said. “He’s probably the hardest worker I’ve ever been around in my life. And then just who he is off the field, he’s a great dude, quiet guy, but definitely you feel his presence. So, I’m excited to get him in here and get him learning, and get him around other guys. And I think it’s perfect for him. I think fresh starts are good.”\n\n\r\n              This is the second straight season Houston (1-4) ended an opening winless skid by beating Tennessee. This time, the Texans forced two turnovers and <a href=\"http://www.espn.com/nfl/player/_/id/4685724/will-anderson-jr\">Will Anderson Jr</a>. had three of Houston's four sacks with coach DeMeco Ryans taking over the defensive play-calling this week. \n\n\r\n              “We’re thankful right now to get our first win,” Ryans said. “It’s been a long time coming. Our guys, they poured into work, and they came out, and the work showed itself again on game day. We just have to keep that formula. Everybody just stay humble, keep working the way we work, and we’ll be just fine.”\n\n\r\n              Ka’imi Fairbairn also kicked four field goals giving the Texans taking a 12-3 halftime lead. \n\n\r\n              Houston played keep-away over the second and third quarters outgaining the Titans 225-49 and outscoring them 16-0. The Texans held Tennessee to a season-low 187 total yards.\n\n\r\n              <a href=\"https://apnews.com/hub/tennessee-titans\">The Titans</a> (0-5) now have lost 11 straight in the AFC South and six straight going back to the end of last season. It's the worst start to a season for this franchise since losing the first six games in 2009. \n\n\r\n              “We’ve got a lot of work to do,” first-year coach Robert Saleh said. “One game is not going to define us. We’re going to continue to work. We’re going to continue to find ways to get better. This organization and team will have its day in the sun.”\n\n\r\n              Tennessee led only after opening with a drive for a 30-yard field goal by <a href=\"http://www.espn.com/nfl/player/_/id/3124084/joey-slye\">Joey Slye</a>. <a href=\"http://www.espn.com/nfl/player/_/id/4688380/cam-ward\">Cam Ward</a> finished throwing for 170 yards.\n\n\r\n              Then the Texans forced the Titans three-and-out, safety <a href=\"http://www.espn.com/nfl/player/_/id/4241223/jalen-pitre\">Jalen Pitre</a> recovered a fumble by <a href=\"http://www.espn.com/nfl/player/_/id/4428557/tyjae-spears\">Tyjae Spears</a> on the next Tennessee drive. <a href=\"http://www.espn.com/nfl/player/_/id/4033812/jake-hansen\">Jake Hansen</a> picked off Ward's pass up the middle on the ensuing drive. Houston then forced another three-and-out by the Titans.\n\n\r\n              Tennessee managed only one sack as Stroud scrambled safely to the sideline. The Titans' secondary didn't have safety <a href=\"http://www.espn.com/nfl/player/_/id/4036134/amani-hooker\">Amani Hooker</a> still in the concussion protocol, and the injuries grew quickly after kickoff. Safety <a href=\"http://www.espn.com/nfl/player/_/id/4685617/kevin-winston-jr\">Kevin Winston Jr</a>. will have an MRI exam for the tight quadriceps muscle that sidelined him, cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4429607/cor'dale-flott\">Cor'Dale Flott</a> hurt his chest and <a href=\"http://www.espn.com/nfl/player/_/id/4240532/tony-adams\">Tony Adams</a> returned after clearing a concussion evaluation.\n\n\r\n              Stroud picked apart the Titans, and only the Texans' inability to convert twice inside the Tennessee 20 in the first half kept the final score from being worse. Houston also had to settle for field goals of 35 and 26 yards from Fairbairn after the turnovers.\n\n\r\n              Houston put the game away in the third quarter with a 17-play drive using up 8 minutes, 23 seconds. Stroud kept the drive alive on third-and-11 escaping All-Pro tackle <a href=\"http://www.espn.com/nfl/player/_/id/4035369/jeffery-simmons\">Jeffery Simmons</a> to find <a href=\"http://www.espn.com/nfl/player/_/id/4429022/kayshon-boutte\">Kayshon Boutte</a> for a <a href=\"https://x.com/NFL/status/2109355389947195549?s=20\">tiptoe-catch on the sideline</a> for 23 yards. Stroud finished the drive with a <a href=\"https://x.com/NFL/status/2109356999964311948?s=20\">2-yard keeper</a> for 19-3 lead.\n\n\r\n              Stroud added a 9-yard TD pass to <a href=\"http://www.espn.com/nfl/player/_/id/4586312/jaylin-noel\">Jaylin Noel</a> to start the fourth quarter.\n\n\r\n              <hl2>Self-inflicted mistakes</hl2>\r\n              Houston hurt itself repeatedly, piling up 11 penalties for 95 yards. The Titans didn't pick up a penalty until 2:49 left in the third quarter and finished with seven for 83 yards. \n\n\r\n              <hl2>Injuries</hl2>\r\n              Texans running back <a href=\"http://www.espn.com/nfl/player/_/id/4035538/david-montgomery\">David Montgomery</a> hurt a groin muscle in the second quarter and didn't return. He had just five carries for 11 yards, and Ryans said Montgomery may miss some time. Pitre hurt a shoulder late and will have further tests.\n\n\r\n              Flott didn't return after hurting his chest. The injury happened when teammate <a href=\"http://www.espn.com/nfl/player/_/id/3915437/isaiah-oliver\">Isaiah Oliver</a>, promoted from the practice squad, hit both Flott and Texans tight end <a href=\"http://www.espn.com/nfl/player/_/id/3117256/dalton-schultz\">Dalton Schultz</a> on an overthrown pass in the end zone. \n\n\r\n              <hl2>Up next</hl2>\r\n              The Texans play the Jaguars in London on Sunday. \n\n\r\n              The Titans visit Indianapolis on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-11T20:05:27Z"}}