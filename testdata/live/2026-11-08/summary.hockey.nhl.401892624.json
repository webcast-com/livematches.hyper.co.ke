ner","shortName":"S. Skinner"}}]},{"id":"401892624000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Seth Jarvis shot blocked by Adam Lowry","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4697396","displayName":"Seth Jarvis","shortName":"S. Jarvis"},"type":"shooter"},{"athlete":{"id":"2563066","displayName":"Adam Lowry","shortName":"A. Lowry"},"type":"defender"}]},{"id":"401892624000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:02"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"999","fullName":"Lenovo Center","address":{"city":"Raleigh","state":"NC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/999.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18818,"officials":[{"fullName":"Kyle Rehman","displayName":"Kyle Rehman","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Onni Hautamaki","displayName":"Onni Hautamaki","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kochetkov makes 26 saves, Walker scores twice as Hurricanes beat Jets 7-0","description":"— Pyotr Kochetkov’s 26-save shutout gave him 10 straight victories to begin the season, Sean Walker scored two goals, and the Carolina Hurricanes beat the Winnipeg Jets 7-0 on Sunday.","story":"RALEIGH, N.C. -- — Pyotr Kochetkov’s 26-save shutout gave him 10 straight victories to begin the season, <a href=\"http://www.espn.com/nhl/player/_/id/4272905/sean-walker\">Sean Walker</a> scored two goals, and the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> 7-0 on Sunday.\n\n\r\n              Kochetkov became the third goalie in NHL history to start a season at 10-0.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4233611/juuso-valimaki\">Juuso Valimaki</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4874899/logan-stankoven\">Logan Stankoven</a>, <a href=\"http://www.espn.com/nhl/player/_/id/2976849/mark-jankowski\">Mark Jankowski</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4352692/jesperi-kotkaniemi\">Jesperi Kotkaniemi</a> also scored for the Hurricanes, who’ve won four in a row. Stankoven, <a href=\"http://www.espn.com/nhl/player/_/id/4697396/seth-jarvis\">Seth Jarvis</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3114741/nikolaj-ehlers\">Nikolaj Ehlers</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3025662/shayne-gostisbehere\">Shayne Gostisbehere</a> all had two assists.\n\n\r\n              Kochetkov tied Carey Price’s 10-win mark with Montreal from 10 years ago for the second-longest season-opening streak. \n\n\r\n              Only Jack Campbell holds a longer season-beginning mark with 11 consecutive victories for the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> in 2020-21.\n\n\r\n              Kochetkov’s second shutout of the season pushed his career total to 13 in 135 games.\n\n\r\n              The Jets have lost nine games in a row (0-7-2). <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a>, who made 12 saves, was pulled after allowing the fifth goal. <a href=\"http://www.espn.com/nhl/player/_/id/5104602/clay-stevenson\">Clay Stevenson</a> stopped 13 shots in relief.\n\n\r\n              Walker’s short-handed goal began the scoring 5:16 into the game. Aho’s power-play tally came during Carolina’s four-goal spree in the first 10 minutes of the second period.\n\n\r\n              Stankoven’s goal at 9:09 of the second period stretched the lead to 5-0. At the time, the Jets had five total shots on goal.\n\n\r\n              It’s Walker’s his first two-goal output in two seasons with the Hurricanes.\n\n\r\n              Winnipeg has allowed 23 goals in its past four games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: Tuesday night at Montreal to end a four-game road trip.\n\n\r\n              Hurricanes: at Nashville on Tuesday night.\n\n\r\n              ------\n\n\r\n              AP NHL: <a href=\"https://apnews.com/hub/nhl\">https://apnews.com/hub/nhl</a>","published":"2026-11-01T20:57:45Z"}}