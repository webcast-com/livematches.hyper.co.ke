000000690","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Adam Fox shot blocked by Mattias Ekholm","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:16"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"4197146","displayName":"Adam Fox","shortName":"A. Fox"},"type":"shooter"},{"athlete":{"id":"2558631","displayName":"Mattias Ekholm","shortName":"M. Ekholm"},"type":"defender"}]},{"id":"401892627000001140","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Mattias Ekholm hit Oliver Bjorkstrand","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:19"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"2558631","displayName":"Mattias Ekholm","shortName":"M. Ekholm"},"type":"hit-credited"},{"athlete":{"id":"3042095","displayName":"Oliver Bjorkstrand","shortName":"O. Bjorkstrand"},"type":"hitted"}]},{"id":"401892627000000850","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Giveaway by Noah Laba","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:54"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"5188370","displayName":"Noah Laba","shortName":"N. Laba"},"type":"giver"}]},{"id":"401892627000001280","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Will Cuylle hit Shakir Mukhamadullin","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:55"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4697468","displayName":"Will Cuylle","shortName":"W. Cuylle"},"type":"hit-credited"},{"athlete":{"id":"4697403","displayName":"Shakir Mukhamadullin","shortName":"S. Mukhamadullin"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1830","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18006,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Connor McDavid has a goal and an assist to lead the Oilers past the Rangers, 4-1","description":"— Connor McDavid scored a goal and extended his NHL record season-opening assists streak to 15 games, powering the Edmonton Oilers past the New York...","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> scored a goal and extended his <a href=\"https://apnews.com/article/oilers-islanders-score-c411ce929d509070b23a16a71c66d7a5\">NHL record season-opening assists streak</a> to 15 games, powering the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> past the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> 4-1 on Sunday. \n\n\r\n              On his first shift, McDavid added to his highlight reel and showed why he is considered the best hockey player in the world. He banked the puck off the boards to himself, shifted into another gear, blew past defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3942292/vladislav-gavrikov\">Vladislav Gavrikov</a> and beat <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a>.\n\n\r\n              The goal 50 seconds in broke a tie with two Hall of Famers: the 418th of his career passed Glenn Anderson for the fourth most in franchise history, and his eighth in the first minute of a game put him past Mark Messier for the most with the Oilers. McDavid is the fastest player in league history to 30 assists, leads all scorers with 39 points and is on pace to join Wayne Gretzky as the only players to reach 200 in a season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4352722/evan-bouchard\">Evan Bouchard</a> had a goal and two assists to join Bobby Orr, Al MacInnis and Denis Potvin as the only defensemen with 25-plus points in his first 15 games. Journeyman goaltender <a href=\"http://www.espn.com/nhl/player/_/id/3069614/matt-tomkins\">Matt Tomkins</a>, making his first start for Edmonton and seventh in the NHL, backstopped the team to its third consecutive victory by making some important saves among his 27.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874940/colton-dach\">Colton Dach</a> had two goals, including an empty-netter with 39.4 seconds left to seal it. The Oilers are 7-0 on the road.\n\n\r\n              Garand, allowed three goals on 24 shots in his ninth consecutive appearance since <a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a> went down with a right knee injury. <a href=\"http://www.espn.com/nhl/player/_/id/4587588/pavel-dorofeyev\">Pavel Dorofeyev</a> scored for the Rangers, who have lost four in a row and six of their past seven after a strong start.\n\n\r\n              <hl2>Up next</hl2>\r\n              Oilers: At New Jersey on Tuesday night.\n\n\r\n              Rangers: Host St. Louis on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-02T01:42:45Z"}}