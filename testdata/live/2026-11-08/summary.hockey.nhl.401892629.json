"id":"5545","displayName":"Mark Stone","shortName":"M. Stone"},"type":"defender"}]},{"id":"401892629000000920","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Hampus Lindholm shot blocked by Ivan Barbashev","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"4:02"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"2968818","displayName":"Hampus Lindholm","shortName":"H. Lindholm"},"type":"shooter"},{"athlete":{"id":"3114985","displayName":"Ivan Barbashev","shortName":"I. Barbashev"},"type":"defender"}]},{"id":"401892629000000930","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Charlie McAvoy shot blocked by Mark Stone","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"4:07"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"3988803","displayName":"Charlie McAvoy","shortName":"C. McAvoy"},"type":"shooter"},{"athlete":{"id":"5545","displayName":"Mark Stone","shortName":"M. Stone"},"type":"defender"}]},{"id":"401892629000001130","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jeremy Lauzon hit Elias Lindholm","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"4:12"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"3904185","displayName":"Jeremy Lauzon","shortName":"J. Lauzon"},"type":"hit-credited"},{"athlete":{"id":"3041994","displayName":"Elias Lindholm","shortName":"E. Lindholm"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1824","guid":"58cac4d0-a208-3028-b2a6-ff7aba657bc3","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"CJ Murray","displayName":"CJ Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Pastrnak scores lone shootout goal to give Bruins 3-2 win over Golden Knights","description":"— David Pastrnak slipped a shot past Carter Hart to break a shootout stalemate and give the Boston Bruins a 3-2 victory over the Vegas Golden Knights on Monday night.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> slipped a shot past <a href=\"http://www.espn.com/nhl/player/_/id/4064582/carter-hart\">Carter Hart</a> to break a shootout stalemate and give the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> a 3-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> on Monday night.\n\n\r\n              Boston’s <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> stopped Vegas’ <a href=\"http://www.espn.com/nhl/player/_/id/5216887/trevor-connelly\">Trevor Connelly</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3648002/jack-eichel\">Jack Eichel</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3899937/mitch-marner\">Mitch Marner</a> to set up Pastrnak for the winner in the third round. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5275337/james-hagens\">James Hagens</a> <a href=\"https://nhl.com/video/vgk-bos-geekie-scores-ppg-against-carter-hart-6407815344112\">scored his sixth goal of the season</a>, and <a href=\"http://www.espn.com/nhl/player/_/id/4268466/morgan-geekie\">Morgan Geekie</a> added a <a href=\"https://twitter.com/NESN/status/2117426023096541593\">power-play goal</a> to help Boston to its sixth consecutive home victory.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3041994/elias-lindholm\">Elias Lindholm</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3042021/nikita-zadorov\">Nikita Zadorov</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3899949/pavel-zacha\">Pavel Zacha</a> and Pastrnak had assists for the Bruins, who’ve won two in a row following back-to-back losses. Jeremy Swayman made 21 saves.\n\n\r\n              Connelly tied it 7:23 into the third period when he gathered a loose puck in front of the net and slipped it past Swayman. <a href=\"http://www.espn.com/nhl/player/_/id/3652964/noah-hanifin\">Noah Hanifin</a> and Marner assisted. <a href=\"http://www.espn.com/nhl/player/_/id/5545/mark-stone\">Mark Stone</a> also scored for Vegas.\n\n\r\n              The Golden Knights have lost five of their last six since starting the season 8-2. They also continue to struggle killing off power plays, having allowed a power-play goal in seven of their last eight games.\n\n\r\n              Carter Hart had 25 saves for Vegas.\n\n\r\n              The Bruins led 2-0 in the second before Stone knocked in a loose puck for a power-play goal, with assists from <a href=\"http://www.espn.com/nhl/player/_/id/2976844/tomas-hertl\">Tomas Hertl</a> and Marner, to cut Vegas’ deficit to 2-1.\n\n\r\n              <hl2>Up next</hl2>\r\n              Golden Knights: At Pittsburgh on Tuesday night.\n\n\r\n              Bruins: At Pittsburgh on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-03T03:08:46Z"}}