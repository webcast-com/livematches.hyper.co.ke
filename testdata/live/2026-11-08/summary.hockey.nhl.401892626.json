displayName":"Vincent Trocheck","shortName":"V. Trocheck"},"type":"giver"}]},{"id":"401892626000001030","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Cole Knuble hit Andrew Peeke","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:21"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"5188341","displayName":"Cole Knuble","shortName":"C. Knuble"},"type":"hit-credited"},{"athlete":{"id":"4064936","displayName":"Andrew Peeke","shortName":"A. Peeke"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1845","fullName":"Xfinity Mobile Arena","address":{"city":"Philadelphia","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1845.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18378,"officials":[{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Travis Konecny scores in return as Flyers beat Utah Mammoth 6-3","description":"— Travis Konecny scored a goal and assisted on another in his first game since missing more than three weeks with an injury as the Philadelphia Flyers beat the Utah Mammoth 6-3 on Sunday.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nhl/player/_/id/3900169/travis-konecny\">Travis Konecny</a> scored a goal and assisted on another in his first game since missing more than three weeks with an injury as the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> 6-3 on Sunday. \n\n\r\n              Konecny, who missed 10 games with a lower-body injury, scored his first goal of the season at 1:06 of the second period, banking a shot off Utah goalie <a href=\"http://www.espn.com/nhl/player/_/id/3942065/karel-vejmelka\">Karel Vejmelka</a> to put Philadelphia up 2-1. \n\n\r\n              He later set up <a href=\"http://www.espn.com/nhl/player/_/id/3115035/christian-dvorak\">Christian Dvorak</a> for a one-timer from the high slot to extend the lead to 4-1. Konecny also set the tone with his physical play, finishing with four hits. <a href=\"http://www.espn.com/nhl/player/_/id/4392072/owen-tippett\">Owen Tippett</a>, who missed the last six games with an upper body injury, also returned to the lineup for Philadelphia.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149170/matvei-michkov\">Matvei Michkov</a> scored the Flyers' first goal, snapping a shot past Vejmelka for his 10th of the season. He became the first Flyer to score 10 goals in his first 17 games of a season since Konecny did it in 2023. \n\n\r\n              Dvorak and <a href=\"http://www.espn.com/nhl/player/_/id/4419682/noah-cates\">Noah Cates</a> also finished with a goal and an assist each. <a href=\"http://www.espn.com/nhl/player/_/id/5149199/oliver-bonk\">Oliver Bonk</a> added a goal for Philadelphia and <a href=\"http://www.espn.com/nhl/player/_/id/3942459/dan-vladar\">Dan Vladar</a> made 19 saves as the Flyers snapped a three-game winless streak (0-2-1). \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149158/dmitri-simashev\">Dmitri Simashev</a> scored Utah's first goal, <a href=\"http://www.espn.com/nhl/player/_/id/4024868/mikhail-sergachev\">Mikhail Sergachev</a> added a late power-play goal for Utah, and <a href=\"http://www.espn.com/nhl/player/_/id/5080143/logan-cooley\">Logan Cooley</a> scored his eighth goal this season with the extra attacker on the ice, before <a href=\"http://www.espn.com/nhl/player/_/id/5188341/cole-knuble\">Cole Knuble</a> iced the game for Philadelphia with an empty-net goal. \n\n\r\n              Vejmelka made 15 saves as the Mammoth have alternated wins and losses over their past eight games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: Continue their six-game road trip in Toronto on Tuesday night.\n\n\r\n              Flyers: Host Minnesota on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-02T00:02:50Z"}}