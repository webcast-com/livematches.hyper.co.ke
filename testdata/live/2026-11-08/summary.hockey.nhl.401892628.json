"abbreviation":"stoppage"},"clock":{"displayValue":"1:04"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1842","fullName":"Honda Center","address":{"city":"Anaheim","state":"CA","zipCode":"92899","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1842.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17174,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Trevor Hanson","displayName":"Trevor Hanson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Cutter Gauthier has a hat trick in the Ducks' 6-3 victory over the Senators","description":"— Cutter Gauthier had his second career hat trick, scoring the go-ahead goal early in the third period, and the Anaheim Ducks overcame a three-goal deficit to beat the Ottawa Senators 6-3 on Sunday night.","story":"ANAHEIM, Calif. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5080145/cutter-gauthier\">Cutter Gauthier</a> had his second career hat trick, scoring the go-ahead goal early in the third period, and the <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a> overcame a three-goal deficit to beat the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> 6-3 on Sunday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4755684/judd-caulfield\">Judd Caulfield</a> scored twice, rookie <a href=\"http://www.espn.com/nhl/player/_/id/5291946/roger-mcqueen\">Roger McQueen</a> added another and <a href=\"http://www.espn.com/nhl/player/_/id/5149153/leo-carlsson\">Leo Carlsson</a> had three assists to help the Ducks win for the second time in nine games. Anaheim went 4 for 5 on the power play.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3026526/laurent-brossoit\">Laurent Brossoit</a> made 20 saves in his Anaheim debut. Brossoit played his second NHL game in three seasons after being recalled from San Diego of the AHL on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3775/claude-giroux\">Claude Giroux</a> had a goal and an assist as the Senators lost for the third time on a five-game trip. <a href=\"http://www.espn.com/nhl/player/_/id/3900219/thomas-chabot\">Thomas Chabot</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3149829/michael-amadio\">Michael Amadio</a> also scored first-period goals while <a href=\"http://www.espn.com/nhl/player/_/id/3115546/jonas-johansson\">Jonas Johansson</a> made 27 saves.\n\n\r\n              After the Ducks rallied to tie it at 3 in the second period, they took advantage of a two-man advantage at 1:50 of the third when Gauthier scored from a sharp angle past Johansson. While still on a man advantage, Gauthier scored 36 seconds later for a two-goal cushion.\n\n\r\n              <hl2>Up next</hl2>\r\n              Senators: At Buffalo on Wednesday night.\n\n\r\n              Ducks: At Vancouver on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-02T03:58:46Z"}}