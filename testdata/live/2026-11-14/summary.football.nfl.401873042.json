{"header":{"id":"401873042","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873042","uid":"s:20~l:28~e:401873042~c:401873042","date":"2026-11-08T18:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"15","uid":"s:20~l:28~t:15","order":0,"homeAway":"home","winner":false,"score":"9","possession":false,"linescores":[{"displayValue":"3"},{"displayValue":"0"},{"displayValue":"3"},{"displayValue":"3"}],"team":{"id":"15","abbreviation":"MIA","displayName":"Miami Dolphins","name":"Dolphins","location":"Miami","nickname":"Dolphins","color":"008e97","alternateColor":"fc4c02","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/mia.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/mia.png"}]}},{"id":"8","uid":"s:20~l:28~t:8","order":1,"homeAway":"away","winner":true,"score":"19","possession":false,"linescores":[{"displayValue":"3"},{"displayValue":"3"},{"displayValue":"10"},{"displayValue":"3"}],"team":{"id":"8","abbreviation":"DET","displayName":"Detroit Lions","name":"Lions","location":"Detroit","nickname":"Lions","color":"0076b6","alternateColor":"bbbbbb","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/det.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/det.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"8","abbreviation":"DET","displayName":"Detroit Lions","shortDisplayName":"Lions","name":"Lions","location":"Detroit","color":"0076b6","alternateColor":"bbbbbb","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/det.png"},"statistics"