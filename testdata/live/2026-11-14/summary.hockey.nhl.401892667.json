Value":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3025535","displayName":"Brett Pesce","shortName":"B. Pesce"},"type":"shooter"},{"athlete":{"id":"3151981","displayName":"Ilya Sorokin","shortName":"I. Sorokin"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"7226","fullName":"UBS Arena","address":{"city":"Elmont","state":"NY","zipCode":"11003","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/7226.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17345,"officials":[{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jordan Samuels-Thomas","displayName":"Jordan Samuels-Thomas","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jack Hughes scores in overtime as Devils rally past Islanders 5-4","description":"— Jack Hughes scored in overtime to lift the New Jersey Devils to a 5-4 victory over the New York Islanders on Saturday.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a> scored in overtime to lift the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> to a 5-4 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562605/dougie-hamilton\">Dougie Hamilton</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697446/luke-evangelista\">Luke Evangelista</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4587929/declan-chisholm\">Declan Chisholm</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3648008/evan-rodrigues\">Evan Rodrigues</a> also scored for New Jersey, which extended its winning streak to four games. <a href=\"http://www.espn.com/nhl/player/_/id/5111/jake-allen\">Jake Allen</a> made 19 saves.\n\n\r\n              Hughes scored with 3:42 remaining in overtime, keeping the puck on a two-on-one rush before firing a shot past Ilya Sorokin’s blocker.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042086/anthony-duclair\">Anthony Duclair</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5291933/matthew-schaefer\">Matthew Schaefer</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4565244/simon-holmstrom\">Simon Holmstrom</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5291952/victor-eklund\">Victor Eklund</a> scored for New York, which lost its third straight game. Sorokin finished with 45 saves and captain <a href=\"http://www.espn.com/nhl/player/_/id/3042002/bo-horvat\">Bo Horvat</a> added two assists.\n\n\r\n              The Devils erased a two-goal deficit in the third period, capped by Hamilton’s power-play goal with 6:18 remaining in regulation. Jack Hughes curled around the net before finding Hamilton in the slot for the tying goal.\n\n\r\n              Evangelista started the comeback when he pulled New Jersey within a goal at 6:08 of the third period.\n\n\r\n              The Islanders took a 2-1 lead after the first period. Duclair opened the scoring with less than five minutes remaining, Rodrigues tied it 17 seconds later and Schaefer put New York back ahead with his fifth goal of the season.\n\n\r\n              Chisholm tied the score at 2 just 4:42 into the second period when <a href=\"http://www.espn.com/nhl/player/_/id/4268771/jesper-bratt\">Jesper Bratt</a> fired a shot off the end boards that took an awkward bounce around the net, allowing Chisholm to bury the rebound.\n\n\r\n              Two of Islanders goaltender Ilya Sorokin’s best saves came against Devils captain <a href=\"http://www.espn.com/nhl/player/_/id/4233555/nico-hischier\">Nico Hischier</a>. Sorokin denied Hischier on a breakaway in the closing seconds of the second period and stopped a one-timer in the opening minute of the third.\n\n\r\n              <hl2>Up next</hl2>\r\n              Devils: At Toronto on Sunday.\n\n\r\n              Islanders: At San Jose on Monday. \n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-08T03:09:34Z"}}