e":{"id":"4587815","displayName":"Samuel Ersson","shortName":"S. Ersson"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1832","fullName":"Canadian Tire Centre","address":{"city":"Ottawa","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1832.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17054,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Alex Lepkowski","displayName":"Alex Lepkowski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Trent Knorr","displayName":"Trent Knorr","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Cousins breaks tie with 2:18 left in the Senators' 4-2 victory over the Mammoth","description":"— Nick Cousins broke a tie on a deflection with 2:18 left and the Ottawa Senators beat the Utah Mammoth 4-2 on Saturday night.","story":"OTTAWA, Ontario -- — <a href=\"http://www.espn.com/nhl/player/_/id/2563027/nick-cousins\">Nick Cousins</a> broke a tie on a deflection with 2:18 left and the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> 4-2 on Saturday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565255/shane-pinto\">Shane Pinto</a> added an empty-net goal with 16 seconds left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587837/fabian-zetterlund\">Fabian Zetterlund</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3149829/michael-amadio\">Michael Amadio</a> also scored for the Senators (11-6-1). <a href=\"http://www.espn.com/nhl/player/_/id/4587815/samuel-ersson\">Samuel Ersson</a> turned away 30 shots for his third victory of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024857/clayton-keller\">Clayton Keller</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4352699/barrett-hayton\">Barrett Hayton</a> scored for the Mammoth (10-7-1), with <a href=\"http://www.espn.com/nhl/player/_/id/3942065/karel-vejmelka\">Karel Vejmelka</a> making 17 saves.\n\n\r\n              The Mammoth played the fifth and final game of a trip where they went 2-2-1.\n\n\r\n              The Senators took a 2-1 lead at 6:29 of the third on a little give-and-go. <a href=\"http://www.espn.com/nhl/player/_/id/3775/claude-giroux\">Claude Giroux</a> took a pass down low from Amadio and fed it right back for Amadio to score into the open net.\n\n\r\n              The Mammoth tied it just over three minutes later when Hayton tipped Keller’s shot from just inside the blue line.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: At Vegas on Wednesday night.\n\n\r\n              Senators: Host Washington on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-08T03:13:34Z"}}