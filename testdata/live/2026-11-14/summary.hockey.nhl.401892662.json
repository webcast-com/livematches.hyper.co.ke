"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:38"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1823","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18347,"officials":[{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Capitals rally for a 4-3 win over Florida despite Wilson's ejection for a hit on Vilmanis","description":"— Alex Tuch and Aliaksei Protas scored in the second period to lift the Washington Capitals to a 4-3 victory over the Florida Panthers on Saturday.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4587943/aliaksei-protas\">Aliaksei Protas</a> scored in the second period to lift the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> to a 4-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> scored two goals for the Panthers in the first, the latter coming on an extended power play after Washington's <a href=\"http://www.espn.com/nhl/player/_/id/2970615/tom-wilson\">Tom Wilson</a> was ejected for a hit on Sandis Valmanis, but the Capitals rallied in the second.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4755690/jack-st-ivany\">Jack St. Ivany</a> scored his first career goal for the Capitals in the first, and <a href=\"http://www.espn.com/nhl/player/_/id/4024833/pierre-luc-dubois\">Pierre-Luc Dubois</a> added one in the third. <a href=\"http://www.espn.com/nhl/player/_/id/3114732/sam-bennett\">Sam Bennett</a> brought the Panthers within one with 46.6 seconds to play.\n\n\r\n              Valmanis <a href=\"https://apnews.com/article/panthers-sandis-vilmanis-tom-wilson-e6a59c72d07611193ae71240237d6de0\">did not return</a> after Wilson's hit to his back knocked him headfirst into the area where the boards and glass meet. Wilson was given a major penalty for boarding, and Tkachuk put Florida ahead 2-1.\n\n\r\n              Tuch tied it with his 11th goal of the season, and then Washington took the lead with a nice team goal. <a href=\"http://www.espn.com/nhl/player/_/id/5149172/ryan-leonard\">Ryan Leonard</a> battled behind the net and sent the puck to Dubois in the left circle. He made one more pass to Protas on the right doorstep, and he had an open net to shoot at.\n\n\r\n              Protas returned the favor in the final period with an assist to Dubois.\n\n\r\n              St. Ivany opened the scoring 2:21 into the game with a soft shot from the right boards that slipped past goalie <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a>. Tkachuk answered less than a minute later after Washington's <a href=\"http://www.espn.com/nhl/player/_/id/3899933/dylan-strome\">Dylan Strome</a> turned the puck over in the defensive zone. It was Tkachuk's ninth goal of the season, and he'd add one more before the period was over.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: At Boston on Sunday.\n\n\r\n              Capitals: At Ottawa on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-07T20:20:43Z"}}