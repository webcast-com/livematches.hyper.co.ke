S. Monahan"},"type":"face-off-winner"},{"athlete":{"id":"3042063","displayName":"Ryan Hartman","shortName":"R. Hartman"}}]}],"gameInfo":{"venue":{"id":"1835","guid":"ce0fbdb0-ab35-391e-9caf-9eff525fe619","fullName":"Grand Casino Arena","address":{"city":"Saint Paul","state":"MN","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1835.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18012,"officials":[{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kaprizov, Wallstedt carry the Wild past the Blue Jackets, 2-1","description":"— Kirill Kaprizov broke a second-period tie with his NHL-leading 10th goal, Jesper Wallstedt stopped 13 shots and the Minnesota Wild beat the Columbus Blue Jackets 2-1 on Sunday night.","story":"ST. PAUL, Minn. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3942335/kirill-kaprizov\">Kirill Kaprizov</a> broke a second-period tie with his NHL-leading 10th goal, <a href=\"http://www.espn.com/nhl/player/_/id/4874737/jesper-wallstedt\">Jesper Wallstedt</a> stopped 13 shots and the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> 2-1 on Sunday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080172/danila-yurov\">Danila Yurov</a> also scored to help the Central Division-leading Wild improve to 6-2-1.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5136617/adam-fantilli\">Adam Fantilli</a> scored for Columbus. <a href=\"http://www.espn.com/nhl/player/_/id/5734/cam-talbot\">Cam Talbot</a> made 32 saves.\n\n\r\n              Kaprizov broke a 1-1 tie with a power-play goal at 3:06 of the second, beating Talbot over the shoulder from the bottom of the left faceoff circle.\n\n\r\n              Both goalies stood tall early in the first period. Wallstedt denied Connor Garland on a breakaway two minutes into the game. Then Talbot made three saves as the Blue Jackets killed off a 5-on-3 power play that lasted 1:52.\n\n\r\n              Minnesota got on the board late in the first period. <a href=\"http://www.espn.com/nhl/player/_/id/3904188/yakov-trenin\">Yakov Trenin</a> scooped up a turnover at the Columbus blue line, beat a defender on the way to the net, then feathered a pass across the slot where Yurov was waiting to tap it in.\n\n\r\n              Columbus tied it a minute later during a delayed penalty when Fantilli fired a slap shot through traffic that beat Wallstedt.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blue Jackets: Host Toronto on Tuesday night.\n\n\r\n              Wild: At Edmonton on Tuesday night to start a five-game trip.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-19T00:37:27Z"}}