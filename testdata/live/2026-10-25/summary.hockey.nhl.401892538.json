":"16"},"participants":[{"athlete":{"id":"2591155","displayName":"Bryan Rust","shortName":"B. Rust"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"3093","fullName":"Delta Center","address":{"city":"Salt Lake City","state":"UT","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/3093.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14111,"officials":[{"fullName":"Kyle Rehman","displayName":"Kyle Rehman","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Graedy Hamilton","displayName":"Graedy Hamilton","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Mammoth hold off late charge from Penguins for 5-4 win","description":"— Clayton Keller, Kevin Stenlund, Nate Schmidt and Nick Schmaltz all tallied a goal and an assist to help the Utah Mammoth beat the Pittsburgh Penguins 5-4 on Monday night.","story":"SALT LAKE CITY -- — <a href=\"http://www.espn.com/nhl/player/_/id/4024857/clayton-keller\">Clayton Keller</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3904191/kevin-stenlund\">Kevin Stenlund</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3024798/nate-schmidt\">Nate Schmidt</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114770/nick-schmaltz\">Nick Schmaltz</a> all tallied a goal and an assist to help the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> 5-4 on Monday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233648/kailer-yamamoto\">Kailer Yamamoto</a> added a goal, and <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a> had 15 stops for Utah.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5164/erik-karlsson\">Erik Karlsson</a>, Richard Rakell, <a href=\"http://www.espn.com/nhl/player/_/id/4697404/egor-chinakhov\">Egor Chinakhov</a>, and <a href=\"http://www.espn.com/nhl/player/_/id/5103825/declan-carlile\">Declan Carlile</a> each scored for Pittsburgh. <a href=\"http://www.espn.com/nhl/player/_/id/2591155/bryan-rust\">Bryan Rust</a> assisted on two goals. <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a> tallied 24 saves.\n\n\r\n              Karlsson’s deflected power-play goal put the Penguins on the board just 71 seconds into the game.\n\n\r\n              Keller leveled the score with a backhand at 6:00 of the first with his third goal in three games. <a href=\"http://www.espn.com/nhl/player/_/id/3899951/lawson-crouse\">Lawson Crouse</a> snagged the puck near the boards and redirected it around Karlsson’s leg to Keller between the circles.\n\n\r\n              Stenlund tapped in the puck from close range with 9:50 left in the first to give the Mammoth their first lead.\n\n\r\n              Rakell tied it up on another power play goal at 7:01 of the second, flicking in a wrist shot near the left post.\n\n\r\n              Utah surged back in front with a pair of goals late in the second. Schmidt reclaimed the lead with 8:16 to go, blasting a slapshot home from near the blue line. Yamamoto tipped in the puck from the low slot with 5:20 left to extend the lead.\n\n\r\n              Schmaltz’s power play goal made it 5-2 for Utah at 1:36 of the third. Silovs denied his initial shot, but Schmaltz threaded a backhand around the goalie’s left leg on second effort.\n\n\r\n              The Penguins cut the deficit to one late in the third period with goals from Chinakhov and Carlile. Chinakhov found the back of the net at 2:55 of the third. Carlile followed with a score off a wrist shot with 5:05 left.\n\n\r\n              <hl2>Up next</hl2>\r\n              Penguins: Host Florida on Thursday.\n\n\r\n              Mammoth: At Seattle on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://na01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fapnews.com%2Fhub%2Fnhl&data=05%7C02%7C%7C7df55516b4824ea300ae08df134b201b%7C84df9e7fe9f640afb435aaaaaaaaaaaa%7C1%7C0%7C639250885543797966%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=G2ZE7%2B%2BqQtkkt%2BdC3sL%2F%2BQOrQQ3SoPGszmeleHbeX%2BE%3D&reserved=0\">See AP’s full NHL coverage here</a>","published":"2026-10-20T04:01:07Z"}}