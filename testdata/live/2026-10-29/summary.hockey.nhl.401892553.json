:1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18872,"officials":[{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ryan Jackson","displayName":"Ryan Jackson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Stecher scores late goal to lift the Maple Leafs past the Rangers, 5-4","description":"— Troy Stecher scored with 26.3 seconds left in regulation and the Toronto Maple Leafs outlasted the New York Rangers 5-4 on Thursday night for their third straight victory.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/3096102/troy-stecher\">Troy Stecher</a> scored with 26.3 seconds left in regulation and the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> outlasted the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> 5-4 on Thursday night for their third straight victory.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4197009/brandon-duhaime\">Brandon Duhaime</a> had a goal and two assists, and <a href=\"http://www.espn.com/nhl/player/_/id/3024916/teddy-blueger\">Teddy Blueger</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4587996/kirill-marchenko\">Kirill Marchenko</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149211/easton-cowan\">Easton Cowan</a> also scored for Toronto (6-4-2).\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> made 21 saves. <a href=\"http://www.espn.com/nhl/player/_/id/4063569/zack-macewen\">Zack MacEwen</a> added two assists. Blueger also had an assist for a two-point night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562637/mika-zibanejad\">Mika Zibanejad</a>, with a goal and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/3042095/oliver-bjorkstrand\">Oliver Bjorkstrand</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4588750/tye-kartye\">Tye Kartye</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4697382/alexis-lafreniere\">Alexis Lafreniere</a> replied for New York (7-4-1), which got 31 stops from <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a>. <a href=\"http://www.espn.com/nhl/player/_/id/4197146/adam-fox\">Adam Fox</a> had four assists.\n\n\r\n              Stecher’s winner came on a delayed penalty after he took a pass from <a href=\"http://www.espn.com/nhl/player/_/id/2976833/morgan-rielly\">Morgan Rielly</a> and ripped a high shot.\n\n\r\n              Bobrovsky tied former Rangers star Henrik Lundqvist for the most wins by a non-North American goalie with 459.\n\n\r\n              <hl2>Up next</hl2>\r\n              Rangers: At Ottawa on Saturday night.\n\n\r\n              Maple Leafs: At Edmonton on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-23T02:09:08Z"}}