type":"hitted"}]},{"id":"401892556000002160","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Garnet Hathaway hit Kaedan Korczak","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3149633","displayName":"Garnet Hathaway","shortName":"G. Hathaway"},"type":"hit-credited"},{"athlete":{"id":"4565264","displayName":"Kaedan Korczak","shortName":"K. Korczak"},"type":"hitted"}]},{"id":"401892556000000960","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Elmer Soderblom Wrist Shot saved by Cooper Black","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"3:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"5075840","displayName":"Elmer Soderblom","shortName":"E. Soderblom"},"type":"shooter"},{"athlete":{"id":"5206956","displayName":"Cooper Black","shortName":"C. Black"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1837","fullName":"PPG Paints Arena","address":{"city":"Pittsburgh","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1837.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14898,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Silovs, Penguins blank Panthers 4-0 to spoil Florida goalie Cooper Black’s record-setting NHL debut","description":"— Pittsburgh's Arturs Silovs stopped 25 shots to spoil the history-making debut of Florida counterpart Cooper Black as the Penguins...","story":"PITTSBURGH -- — Pittsburgh's <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a> stopped 25 shots to spoil the <a href=\"https://apnews.com/article/florida-panthers-cooper-black-tall-goalie-8e428bda39d635f4e8d58416a268ad51\">history-making debut</a> of Florida counterpart <a href=\"http://www.espn.com/nhl/player/_/id/5206956/cooper-black\">Cooper Black</a> as the Penguins beat the Panthers 4-0 on Thursday.\n\n\r\n              Black, who at 6-foot-9 became the tallest goalie ever to appear in an NHL regular season game, made 18 saves but it wasn't enough to stop the Panthers from dropping their second game in as many nights.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565275/nick-robertson\">Nick Robertson</a> scored twice for Pittsburgh. <a href=\"http://www.espn.com/nhl/player/_/id/4697405/hendrix-lapierre\">Hendrix Lapierre</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a> both finished with a goal and an assist as the Penguins shook off a miserable Western Conference road trip in which they were badly outplayed in losses to Chicago, Colorado, Vegas and Utah.\n\n\r\n              The trip ended with 19-year-old forward <a href=\"http://www.espn.com/nhl/player/_/id/5291947/ben-kindel\">Ben Kindel</a> <a href=\"https://apnews.com/article/penguins-ben-kindel-medical-emergency-utah-15d85dd84fb2acfe109ca9fbd3589767\">collapsing on Tuesday</a> during the flight back to Pittsburgh. Kindel spent the night in a Salt Lake City hospital for observation and <a href=\"https://apnews.com/article/pittsburgh-penguins-0ce741ad568b9180dbed6e35ced0b7c5\">returned to the Penguins’ facility</a> on Thursday. The team placed him on injured reserve but is hopeful may be able to return to practice as early as next week.\n\n\r\n              Pittsburgh coach Dan Muse shuffled his lines in hopes of a spark, and the Penguins responded by solving the towering Black, a 25-year-old from Michigan, three times.\n\n\r\n              Black, called up from Florida's AHL affiliate in Charlotte recently after <a href=\"http://www.espn.com/nhl/player/_/id/5452/jacob-markstrom\">Jacob Markstrom</a> sustained a shoulder injury, was sharp early as the Panthers struggled to find their legs a night after an <a href=\"https://apnews.com/article/panthers-senators-score-dd094d374d06a1340c665f0347830af7\">emotionally charged loss in Ottawa</a>.\n\n\r\n              Lapierre doubled Pittsburgh's lead at the game's halfway point after taking a pretty feed on the rush from <a href=\"http://www.espn.com/nhl/player/_/id/4874911/ville-koivunen\">Ville Koivunen</a> and Malkin's third goal in four games was more than enough for Silovs, who was only sporadically challenged while picking up his second shutout of the season and fourth of his career.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Continue their four-game road trip on Sunday in Chicago.\n\n\r\n              Penguins: Host Nashville on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-23T01:53:07Z"}}