 Rodrigues"},"type":"taker"}]},{"id":"401892555000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Evan Rodrigues Wrist Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:33"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3648008","displayName":"Evan Rodrigues","shortName":"E. Rodrigues"},"type":"shooter"},{"athlete":{"id":"3151137","displayName":"Ville Husso","shortName":"V. Husso"}}]},{"id":"401892555000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Frank Vatrano Wrist Shot saved by Nico Daws","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"3527554","displayName":"Frank Vatrano","shortName":"F. Vatrano"},"type":"shooter"},{"athlete":{"id":"4697683","displayName":"Nico Daws","shortName":"N. Daws"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1826","fullName":"Prudential Center","address":{"city":"Newark","state":"NJ","zipCode":"07199","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1826.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16049,"officials":[{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Alex Lepkowski","displayName":"Alex Lepkowski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Gritsyuk and Hischier score in 1st period in the Devils' 4-1 victory over the Ducks","description":"— Arseny Gritsyuk and Nico Hischier scored first-period goals, Nico Daws made 16 saves and the New Jersey Devils beat the Anaheim Ducks 4-1 on Thursday night.","story":"NEWARK, N.J. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4915855/arseny-gritsyuk\">Arseny Gritsyuk</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233555/nico-hischier\">Nico Hischier</a> scored first-period goals, <a href=\"http://www.espn.com/nhl/player/_/id/4697683/nico-daws\">Nico Daws</a> made 16 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a> 4-1 on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042037/anthony-mantha\">Anthony Mantha</a> restored the two-goal lead with 6:33 left in the third, and <a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a> added an empty-netter with 6.1 seconds remaining. New Jersey won its second straight to improve to 6-4-0, while Anaheim dropped its fifth in a row to fall to 4-6-0.\n\n\r\n              Gritsyuk and Hischier each scored their fifth goal of the season, with <a href=\"http://www.espn.com/nhl/player/_/id/4268771/jesper-bratt\">Jesper Bratt</a> assisting on both scores. Hughes assisted on Gritsyuk's goal.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4996085/tim-washe\">Tim Washe</a> scored for Anaheim on a tip at 8:20 of the third period. <a href=\"http://www.espn.com/nhl/player/_/id/3151137/ville-husso\">Ville Husso</a> made 25 saves for the Ducks.\n\n\r\n              Gritsyuk opened the scoring at 4:38 of the first, connecting from close range off Bratt's centering pass. Hischier scored off a rebound on a power play with 41 seconds left in the period.\n\n\r\n              <hl2>Up next</hl2>\r\n              Ducks: At Philadelphia on Saturday\n\n\r\n              Devils: Host Los Angeles on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-23T01:36:08Z"}}