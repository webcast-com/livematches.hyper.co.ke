d":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"27"},"participants":[{"athlete":{"id":"5149189","displayName":"Matthew Wood","shortName":"M. Wood"},"type":"shooter"},{"athlete":{"id":"2976847","displayName":"Andrei Vasilevskiy","shortName":"A. Vasilevskiy"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1834","fullName":"Bridgestone Arena","address":{"city":"Nashville","state":"TN","zipCode":"37250","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1834.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17180,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Shawn Oliver","displayName":"Shawn Oliver","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Stamkos scores in regulation and only goal in shootout to lead Predators over Lightning 5-4","description":"— Steven Stamkos scored the tying goal in regulation and the only goal of the shootout to lead the Nashville Predators to a 5-4 victory over the Tampa Bay Lightning on Saturday.","story":"NASHVILLE, Tenn. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5037/steven-stamkos\">Steven Stamkos</a> scored the tying goal in regulation and the only goal of the shootout to lead the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a> to a 5-4 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080180/reid-schaefer\">Reid Schaefer</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4894222/adam-edstrom\">Adam Edstrom</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565269/jayden-struble\">Jayden Struble</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/4393408/justus-annunen\">Justus Annunen</a> made 22 saves in regulation and overtime for the Predators, who had lost two straight. <a href=\"http://www.espn.com/nhl/player/_/id/2968772/filip-forsberg\">Filip Forsberg</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4419638/nick-perbix\">Nick Perbix</a> each had a pair of assists.\n\n\r\n              Just one day after <a href=\"https://apnews.com/article/lightning-nikita-kucherov-trade-request-bee0eae71f28b2ba25488db2a010edd8\">reportedly asking to be traded</a>, Tampa Bay forward <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had three assists. <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a> had a goal and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5157/victor-hedman\">Victor Hedman</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080155/conor-geekie\">Conor Geekie</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> made 29 saves for the Lightning, losers of three of four.\n\n\r\n              Nashville had lost their first five games that had extended past regulation this season before Saturday. \n\n\r\n              Stamkos, the former Lightning captain, made it 4-4 with a power-play goal at 7:27 of the third.\n\n\r\n              It was the 246th power-play goal of Stamkos’ career, tying him with Phil Esposito for sixth in NHL history.\n\n\r\n              Schaefer scored the game’s first goal at 11:14 of the opening period.\n\n\r\n              Coming into the Tampa Bay zone on the right side on a two-on-one break with <a href=\"http://www.espn.com/nhl/player/_/id/2967072/jonathan-marchessault\">Jonathan Marchessault</a>, Schaefer fired a wrist shot that beat Vasilevskiy on the far side. It was Schaefer’s first goal of the season.\n\n\r\n              Carlson made it 1-1 at 13:38 of the first when his slap shot from the right side deflected off the stick of Edstrom and past Annunen.\n\n\r\n              Kucherov has assists in three straight games.\n\n\r\n              Guentzel’s goal just 18 seconds after the opening faceoff of the second period gave the Lightning a 2-1 lead, but that lead was short-lived, as Edstrom’s goal at 45 seconds of the second evened the game once again.\n\n\r\n              <hl2>Up next</hl2>\r\n              Lightning: Host Detroit on Tuesday night.\n\n\r\n              Predators: Host on Carolina on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-31T21:07:46Z"}}