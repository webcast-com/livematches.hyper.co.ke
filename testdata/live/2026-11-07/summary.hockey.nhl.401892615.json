ggerud","shortName":"J. Snuggerud"},"type":"shooter"},{"athlete":{"id":"3114997","displayName":"Andreas Englund","shortName":"A. Englund"},"type":"defender"}]},{"id":"401892615000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892615000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dalibor Dvorsky faceoff won against J.T. Compher","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"19"},"participants":[{"athlete":{"id":"5149178","displayName":"Dalibor Dvorsky","shortName":"D. Dvorsky"},"type":"face-off-winner"},{"athlete":{"id":"3041995","displayName":"J.T. Compher","shortName":"J.T. Compher"}}]},{"id":"401892615000000880","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Connor McMichael hit Nate Danielson","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:47"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"19"},"participants":[{"athlete":{"id":"4565246","displayName":"Connor McMichael","shortName":"C. McMichael"},"type":"hit-credited"},{"athlete":{"id":"5149175","displayName":"Nate Danielson","shortName":"N. Danielson"},"type":"hitted"}]},{"id":"401892615000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:56"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"5404","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17565,"officials":[{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Morgan MacPhee","displayName":"Morgan MacPhee","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Kaskimaki's first career NHL goal caps Blues' rally in 5-4 victory over Red Wings","description":"— Aleksanteri Kaskimaki scored his first career NHL goal to cap the St. Louis Blues' rally from a two-goal, third-period deficit in a 5-4 victory over the Detroit Red Wings on Saturday.","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/5188510/aleksanteri-kaskimaki\">Aleksanteri Kaskimaki</a> scored his first career NHL goal to cap the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a>' rally from a two-goal, third-period deficit in a 5-4 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> on Saturday.\n\n\r\n              Kaskimaki tapped in an <a href=\"http://www.espn.com/nhl/player/_/id/4392454/alexey-toropchenko\">Alexey Toropchenko</a> pass with 6:45 remaining to complete the comeback after <a href=\"http://www.espn.com/nhl/player/_/id/3042081/pavel-buchnevich\">Pavel Buchnevich</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4697408/justin-barron\">Justin Barron</a> scored earlier in the period. The 22-year-old from Finland was playing in his 11th NHL game.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080171/jimmy-snuggerud\">Jimmy Snuggerud</a> scored his team-high eighth goal and <a href=\"http://www.espn.com/nhl/player/_/id/5149178/dalibor-dvorsky\">Dalibor Dvorsky</a> added the Blues' other goal. <a href=\"http://www.espn.com/nhl/player/_/id/4587909/joel-hofer\">Joel Hofer</a> made 24 saves in the opener of St. Louis' four-game road trip.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> had a goal and an assist to lead the Red Wings. <a href=\"http://www.espn.com/nhl/player/_/id/3041995/jt-compher\">J.T. Compher</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3941546/keegan-kolesar\">Keegan Kolesar</a> scored the first goals of the season for Detroit. Kolesar’s goal was his first point in 14 games since he was acquired from Vegas in an offseason trade.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5188599/emmitt-finnie\">Emmitt Finnie</a> added a power-play goal for the Red Wings, while <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> made 10 saves.\n\n\r\n              The Red Wings were playing their second game since center and former captain <a href=\"https://apnews.com/article/red-wings-dylan-larkin-1f13ee2ba18e94ee89da619c2f7551c9\">Dylan Larkin was suspended without pay</a>. Larkin, who requested a trade during the offseason, decided after the team's road trip earlier this week that he would sit out until he's dealt.\n\n\r\n              The Blues had only one shot on goal in the first period, but it found the back of the net, as Dvorsky scored at 2:29 on a backhander. Compher scored into an empty net at 8:13 to tie it after Hofer misplayed the puck behind the net.\n\n\r\n              Kolesar scored on a breakaway 41 seconds into the second period. Raymond's unassisted goal was matched by Snuggerud's tip-in in the final minute of the second.\n\n\r\n              Finnie's goal at 3:29 of the third gave Detroit a 4-2 lead.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blues: Visit <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Tuesday.\n\n\r\n              Red Wings: Visit Florida on Monday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-31T19:52:46Z"}}