t":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4874863","displayName":"Olen Zellweger","shortName":"O. Zellweger"},"type":"shooter"},{"athlete":{"id":"3036851","displayName":"Anton Forsberg","shortName":"A. Forsberg"}}]},{"id":"401892618000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mattias Samuelsson Slap Shot saved by Anton Forsberg","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:00"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4378656","displayName":"Mattias Samuelsson","shortName":"M. Samuelsson"},"type":"shooter"},{"athlete":{"id":"3036851","displayName":"Anton Forsberg","shortName":"A. Forsberg"},"type":"saver"}]},{"id":"401892618000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892618000000830","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Scott Laughton faceoff won against Peyton Krebs","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"8"},"participants":[{"athlete":{"id":"2976848","displayName":"Scott Laughton","shortName":"S. Laughton"},"type":"face-off-winner"},{"athlete":{"id":"4565238","displayName":"Peyton Krebs","shortName":"P. Krebs"}}]}],"gameInfo":{"venue":{"id":"1841","fullName":"crypto.com Arena","address":{"city":"Los Angeles","state":"CA","zipCode":"90185","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1841.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16161,"officials":[{"fullName":"Ryan Gibbons","displayName":"Ryan Gibbons","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Cody Beach","displayName":"Cody Beach","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Tage Thompson scores twice as Sabres extend road point streak to 7 with 3-2 win over Kings","description":"— Tage Thompson scored twice, including the go-ahead goal with 6:20 remaining, and the Buffalo Sabres beat the Los Angeles Kings 3-2 on Saturday to extend their road point streak to seven games.","story":"LOS ANGELES -- — <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> scored twice, including the go-ahead goal with 6:20 remaining, and the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> 3-2 on Saturday to extend their road point streak to seven games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> had a goal and an assist, <a href=\"http://www.espn.com/nhl/player/_/id/5149186/zach-benson\">Zach Benson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4294163/rasmus-dahlin\">Rasmus Dahlin</a> each had two assists, and the Sabres won their third straight overall. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> made 27 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2273/corey-perry\">Corey Perry</a> had a power-play goal, <a href=\"http://www.espn.com/nhl/player/_/id/4997131/andre-lee\">Andre Lee</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/3036851/anton-forsberg\">Anton Forsberg</a> stopped 28 shots for the Kings.\n\n\r\n              Thompson put the Sabres back in front on a one-timer off a pass from Quinn on a power play at 13:40 of the third period. Buffalo had controlled long stretches of the game before allowing the Kings to get back into it by taking some unnecessary penalties.\n\n\r\n              Buffalo controlled the first period but only led 1-0 on Quinn’s eighth goal when he scored on a power play at 6:35.\n\n\r\n              Even with Los Angeles gaining momentum in the second half of the second period, the Sabres made it 2-0 on Thompson’s ninth with 4:22 left.\n\n\r\n              Perry got the Kings on the board on a power play with 2:36 to go, though they needed a coach’s challenge to overturn a goaltender interference call. Lee tied it 1:29 into the third.\n\n\r\n              The Kings were without top forward <a href=\"http://www.espn.com/nhl/player/_/id/3114802/adrian-kempe\">Adrian Kempe</a>, who is day to day because of an undisclosed injury. <a href=\"http://www.espn.com/nhl/player/_/id/4697667/martin-chromiak\">Martin Chromiak</a> made his NHL debut, taking Kempe’s place on the first line and the power play.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sabres: Host the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> on Wednesday.\n\n\r\n              Kings: Host the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-31T23:15:46Z"}}