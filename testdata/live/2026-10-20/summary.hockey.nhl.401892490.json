text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:30"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892490000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Chris Kreider faceoff won against Noah Ostlund","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:30"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"5833","displayName":"Chris Kreider","shortName":"C. Kreider"},"type":"face-off-winner"},{"athlete":{"id":"5080160","displayName":"Noah Ostlund","shortName":"N. Ostlund"}}]},{"id":"401892490000000110","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Benches","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:40"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892490000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jake Evans faceoff won against Josh Norris","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:40"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"4393049","displayName":"Jake Evans","shortName":"J. Evans"},"type":"face-off-winner"},{"athlete":{"id":"4233627","displayName":"Josh Norris","shortName":"J. Norris"}}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ryan Daisy","displayName":"Ryan Daisy","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Zachary Bolduc scores decisive goal in shootout for 2nd straight game as Canadiens beat Sabres 4-3","description":"— Zachary Bolduc scored the decisive goal in a shootout for the second straight game, and the Montreal Canadiens beat the Buffalo Sabres 4-3 after blowing a two-goal lead Tuesday night.","story":"MONTREAL -- — Zachary Bolduc scored the decisive goal in a shootout for the second straight game, and the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 4-3 after blowing a two-goal lead Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080230/lane-hutson\">Lane Hutson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565236/cole-caufield\">Cole Caufield</a> each had a goal and an assist for Montreal. <a href=\"http://www.espn.com/nhl/player/_/id/3069687/josh-anderson\">Josh Anderson</a> also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/4915349/juraj-slafkovsky\">Juraj Slafkovsky</a> added two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5188437/jacob-fowler\">Jacob Fowler</a> made 14 saves in his third consecutive start after stopping 30 shots in <a href=\"https://apnews.com/article/canadiens-red-wings-score-e007af43bed0417fd904872f0886d7f6\">Saturday’s 1-0 win over Detroit</a>, which was decided by Bolduc's goal in the sixth shootout round.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874863/olen-zellweger\">Olen Zellweger</a> had two goals and <a href=\"http://www.espn.com/nhl/player/_/id/4233627/josh-norris\">Josh Norris</a> also scored for Buffalo as the teams met for the first time since the Canadiens eliminated the Sabres in the second round of last season's playoffs.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> stopped 35 shots, and <a href=\"http://www.espn.com/nhl/player/_/id/4063240/beck-malenstyn\">Beck Malenstyn</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4378656/mattias-samuelsson\">Mattias Samuelsson</a> had two assists apiece.\n\n\r\n              The Sabres scored twice in 61 seconds to erase a two-goal lead and tie the score at 3-3 at 5:25 of the third period. Norris bounced a point shot off defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5188450/adam-engstrom\">Adam Engstrom</a> before Zellweger converted his second with a wrist shot through a crowd.\n\n\r\n              In the shootout, Cole Caufield and <a href=\"http://www.espn.com/nhl/player/_/id/4233880/alexandre-texier\">Alexandre Texier</a> scored for Montreal. <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> scored for Buffalo, but <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> missed to open the door for Bolduc.\n\n\r\n              Zellweger opened the scoring on the game’s first shot when his point attempt hit Engstrom and bounced into the net.\n\n\r\n              Hutson answered with a wrist shot past a screened Luukkonen on a 5-on-3 power play to tie the game at 14:28 of the first period. Caufield then one-timed a pass from Slafkovsky to give Montreal a 2-1 lead early in the second.\n\n\r\n              Hutson showcased his skill again late in the second, stickhandling in from the blue line before sliding a no-look backhand pass to Anderson, who fired into the open net with 50 seconds remaining in the period.\n\n\r\n              Sabres captain <a href=\"https://apnews.com/article/buffalo-sabres-rasmus-dahlin-e5cf3bc9d29b13a448f7c12c49f1b01e\"><a href=\"http://www.espn.com/nhl/player/_/id/4294163/rasmus-dahlin\">Rasmus Dahlin</a></a> did not travel to Montreal after appearing to hurt his lower back in <a href=\"https://apnews.com/article/panthers-sabres-score-4ef58c0b273bec59a28ffbb7e6d46789\">Monday’s 5-3 win</a> over Florida. Zellweger stepped into Buffalo’s top pairing and scored his first goals since being acquired by Buffalo last summer.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sabres: At Toronto on Thursday.\n\n\r\n              Canadiens: At Washington on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-14T01:58:26Z"}}