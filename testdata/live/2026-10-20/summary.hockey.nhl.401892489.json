ff-winner"},{"athlete":{"id":"3041996","displayName":"Sean Monahan","shortName":"S. Monahan"}}]},{"id":"401892489000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Carter Verhaeghe Snap Shot saved by Cam Talbot","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:28"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3042088","displayName":"Carter Verhaeghe","shortName":"C. Verhaeghe"},"type":"shooter"},{"athlete":{"id":"5734","displayName":"Cam Talbot","shortName":"C. Talbot"},"type":"saver"}]},{"id":"401892489000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Damon Severson","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"1:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"3068087","displayName":"Damon Severson","shortName":"D. Severson"},"type":"taker"}]},{"id":"401892489000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Damon Severson","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"3068087","displayName":"Damon Severson","shortName":"D. Severson"},"type":"giver"}]},{"id":"401892489000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Carter Verhaeghe Snap Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:47"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3042088","displayName":"Carter Verhaeghe","shortName":"C. Verhaeghe"},"type":"shooter"},{"athlete":{"id":"5734","displayName":"Cam Talbot","shortName":"C. Talbot"}}]},{"id":"401892489000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dmitry Kulikov Snap Shot Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:51"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"5328","displayName":"Dmitry Kulikov","shortName":"D. Kulikov"},"type":"shooter"},{"athlete":{"id":"5734","displayName":"Cam Talbot","shortName":"C. Talbot"}}]}],"gameInfo":{"venue":{"id":"1828","fullName":"Nationwide Arena","address":{"city":"Columbus","state":"OH","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1828.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13538,"officials":[{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mike Sullivan","displayName":"Mike Sullivan","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Brady Tkachuk has natural hat trick, brother Matthew has 5 assists as Panthers roll Blue Jackets 7-3","description":"— Brady Tkachuk had a natural hat trick in the second period, his brother Matthew Tkachuk matched a club record with five assists and the Florida Panthers rolled past the Columbus Blue...","story":"COLUMBUS, Ohio -- — <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> had <a href=\"https://x.com/BR--OpenIce/status/2110154772737151356\">a natural hat trick</a> in the second period, his brother <a href=\"http://www.espn.com/nhl/player/_/id/4024854/matthew-tkachuk\">Matthew Tkachuk</a> matched a club record with five assists and the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> rolled past the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> 7-3 on Tuesday night to snap a two-game skid.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042088/carter-verhaeghe\">Carter Verhaeghe</a> scored twice and <a href=\"http://www.espn.com/nhl/player/_/id/3114722/sam-reinhart\">Sam Reinhart</a> added two goals and an assist, extending his point streak against Columbus to a franchise-record 12 games.\n\n\r\n              Matthew Tkachuk assisted on all three of his brother's goals and had an assist on Verhaeghe's goal in the second for the first four-assist period in Panthers history. He extended his points streak to six games.\n\n\r\n              Brady Tkachuk became the ninth Panthers player with three goals in a period. He also had four points in the second as the brothers became the third and fourth Florida players with a four-point period.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3041992/seth-jones\">Seth Jones</a> contributed four assists, and <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a> stopped 24 shots a night after replacing <a href=\"http://www.espn.com/nhl/player/_/id/5452/jacob-markstrom\">Jacob Markstrom</a> following the first period of the Panthers’ loss at Buffalo.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4781553/kent-johnson\">Kent Johnson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5080156/denton-mateychuk\">Denton Mateychuk</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874725/cole-sillinger\">Cole Sillinger</a> scored for Columbus, and <a href=\"http://www.espn.com/nhl/player/_/id/3068087/damon-severson\">Damon Severson</a> had two assists. The Blue Jackets lost for the third time in four games and have allowed seven power-play goals in 18 opportunities.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5734/cam-talbot\">Cam Talbot</a> stopped 17 shots before being replaced after allowing his sixth goal at 3:28 of the third period. <a href=\"http://www.espn.com/nhl/player/_/id/4894366/jet-greaves\">Jet Greaves</a> made four saves in relief.\n\n\r\n              Columbus took a 1-0 lead on Johnson's unassisted goal at 14:11 of the first period, but Florida took control from there.\n\n\r\n              Brady Tkachuk took advantage of a turnover by <a href=\"http://www.espn.com/nhl/player/_/id/3042198/carson-soucy\">Carson Soucy</a> in the Florida zone and pulled the Panthers even at 2:27 of the second with his first goal of the season. He added a power-play goal 3 1/2 minutes later and completed his fourth career hat trick, and second against Columbus, with another power-play goal at 10:30.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4064781/mathieu-olivier\">Mathieu Olivier</a> was assessed a major penalty and game misconduct for slashing <a href=\"http://www.espn.com/nhl/player/_/id/5142461/uvis-balinskis\">Uvis Balinskis</a> at 13:44 of the second, leaving Columbus short-handed for five minutes. Verhaeghe scored on the ensuing power play.\n\n\r\n              Reinhart’s power-play goal 1:20 into the third gave him a Panthers-record 86 career power-play goals.\n\n\r\n              Columbus made it 6-3 with third-period goals from Mateychuk and Sillinger 22 seconds apart. Reinhart had an empty-netter.\n\n\r\n              Florida improved to 11-2-0 against Columbus since the start of the 2022-23 season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Host Vancouver on Thursday.\n\n\r\n              Blue Jackets: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-14T01:25:26Z"}}