866459351","tiePercentage":0},{"homeWinPercentage":0.701,"playId":"401866459356","tiePercentage":0}],"gameInfo":{"venue":{"id":"3700","guid":"322d1e92-af9c-396e-8788-359fd99949a8","fullName":"Doyt L. Perry Stadium","address":{"city":"Bowling Green","state":"OH","zipCode":"43403","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3700.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":10254},"article":{"headline":"Novosad and Amachree help Bowling Green edge Kent State 33-28","description":"— Austin Novosad threw for 229 yards and three touchdowns in his first career start, and Nakai Amachree scored twice as Bowling Green rallied past Kent State 33-28 on Tuesday night.","story":"BOWLING GREEN, Ohio -- — <a href=\"http://www.espn.com/college-football/player/_/id/4912647/austin-novosad\" target=\"_new\">Austin Novosad</a> threw for 229 yards and three touchdowns in his first career start, and <a href=\"http://www.espn.com/college-football/player/_/id/5219017/nakai-amachree\" target=\"_new\">Nakai Amachree</a> scored twice as Bowling Green rallied past Kent State 33-28 on Tuesday night.\n\n\r\n              The Falcons (3-7, 3-3 Mid-American Conference) trailed 28-27 after Kent State's <a href=\"http://www.espn.com/college-football/player/_/id/5119841/dru-deshields\" target=\"_new\">Dru DeShields</a> scored on a 25-yard run with 2:00 remaining, but Amachree answered nine seconds later with a 48-yard touchdown run to put Bowling Green back in front.\n\n\r\n              Amachree finished with 110 yards rushing on 19 carries and added three catches for 87 yards. His 70-yard touchdown reception from Novosad opened the scoring in the first quarter.\n\n\r\n              Novosad completed 15 of 25 passes without an interception. He connected with <a href=\"http://www.espn.com/college-football/player/_/id/5193300/eli-jacon-duffy\" target=\"_new\">Eli Jacon-Duffy</a> for a 23-yard touchdown late in the second quarter and <a href=\"http://www.espn.com/college-football/player/_/id/4879925/blane-cleaver\" target=\"_new\">Blane Cleaver</a> for a 1-yard score in the third.\n\n\r\n              Bowling Green led 17-14 at halftime and extended the advantage to 27-14 before Kent State rallied with two fourth-quarter touchdowns.\n\n\r\n              DeShields threw for 332 yards and two touchdowns and rushed for 35 yards and two more scores for Kent State (3-7, 2-4). <a href=\"http://www.espn.com/college-football/player/_/id/5147053/wayne-harris\" target=\"_new\">Wayne Harris</a> caught eight passes for 143 yards and two touchdowns, while Da’Realyst Clark had five catches for 107 yards.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5177469/travis-kenner\" target=\"_new\">Travis Kenner</a> made field goals of 46 and 38 yards for Bowling Green.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kent State: Hosts Miami (OH) next Tuesday.\n\n\r\n              Bowling Green: At Toledo on Nov. 20.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-11-11T03:50:33Z"}}