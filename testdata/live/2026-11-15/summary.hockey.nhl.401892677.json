t":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3042083","displayName":"Jake Guentzel","shortName":"J. Guentzel"},"type":"face-off-winner"},{"athlete":{"id":"4316970","displayName":"Morgan Barron","shortName":"M. Barron"}}]},{"id":"401892677000000910","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Cole Koepke","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4419679","displayName":"Cole Koepke","shortName":"C. Koepke"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14307,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Garrett Rank","displayName":"Garrett Rank","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Scheifele scores on power play with 1.6 seconds left to lift Jets past Lightning, 4-3","description":"— Mark Scheifele scored on a 5-on-3 power play with 1.6 seconds left and the Winnipeg Jets beat the Tampa Bay Lightning 4-3 on Sunday after blowing a late three-goal lead.","story":"WINNIPEG, Manitoba -- — <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> scored on a 5-on-3 power play with 1.6 seconds left and the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> 4-3 on Sunday after blowing a late three-goal lead.\n\n\r\n              Scheifele scored on a one-timer from the high slot off a feed from <a href=\"http://www.espn.com/nhl/player/_/id/4697392/cole-perfetti\">Cole Perfetti</a>.\n\n\r\n              After <a href=\"http://www.espn.com/nhl/player/_/id/5149188/brayden-yager\">Brayden Yager</a> gave Winnipeg a 3-0 lead on a power play at 8:10 of the third with his first NHL goal, the Lightning tied it in a 4:07 burst. <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> scored with 9:38 to go, and <a href=\"http://www.espn.com/nhl/player/_/id/4588205/pontus-holmberg\">Pontus Holmberg</a> struck twice — with 5:59 left and 5:33 remaining.\n\n\r\n              Perfetti, <a href=\"http://www.espn.com/nhl/player/_/id/4316970/morgan-barron\">Morgan Barron</a> and Brayden Yager also scored for Winnipeg (7-8-3), and <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> made 18 saves. The Jets have won three in a row after dropping nine straight.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> stopped 21 shots for Tampa Bay (11-4-2) in the opener of a three-game trip The Lightning had won three in a row.\n\n\r\n              Winnipeg went 3 or 5 on the power play, and Tampa Bay was 0 for 4.\n\n\r\n              <hl2>Up next</hl2>\r\n              Lightning: At Buffalo on Wednesday night.\n\n\r\n              Jets: Host New Jersey on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-09T02:24:34Z"}}