0,"homeScore":0,"text":"Peyton Krebs shot blocked by Tage Thompson","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:32"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4565238","displayName":"Peyton Krebs","shortName":"P. Krebs"},"type":"shooter"},{"athlete":{"id":"4024988","displayName":"Tage Thompson","shortName":"T. Thompson"},"type":"defender"}]},{"id":"401892675000000680","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Zach Benson Tip-In saved by Adin Hill","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"5149186","displayName":"Zach Benson","shortName":"Z. Benson"},"type":"shooter"},{"athlete":{"id":"3939714","displayName":"Adin Hill","shortName":"A. Hill"},"type":"saver"}]},{"id":"401892675000000780","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Noah Ostlund shot blocked by Dylan Coghlan","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"5080160","displayName":"Noah Ostlund","shortName":"N. Ostlund"},"type":"shooter"},{"athlete":{"id":"4063606","displayName":"Dylan Coghlan","shortName":"D. Coghlan"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1848","fullName":"KeyBank Center","address":{"city":"Buffalo","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1848.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19070,"officials":[{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tom Chmielewski","displayName":"Tom Chmielewski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Tomas Hertl scores twice as Golden Knights beat Sabres 4-1 for third straight win","description":"— Tomas Hertl scored two goals and the Vegas Golden Knights won their third straight game, 4-1 over the Buffalo Sabres on Sunday.","story":"BUFFALO, N.Y. -- — <a href=\"http://www.espn.com/nhl/player/_/id/2976844/tomas-hertl\">Tomas Hertl</a> scored two goals and the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> won their third straight game, 4-1 over the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> on Sunday.\n\n\r\n              Hertl scored both of his goals in the third period to help put the game away for the Golden Knights, who finished their road trip 3-0-1.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3648002/jack-eichel\">Jack Eichel</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3899937/mitch-marner\">Mitch Marner</a> also scored for Vegas while <a href=\"http://www.espn.com/nhl/player/_/id/3939714/adin-hill\">Adin Hill</a> made 27 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4063240/beck-malenstyn\">Beck Malenstyn</a> scored and <a href=\"http://www.espn.com/nhl/player/_/id/4736758/colten-ellis\">Colten Ellis</a> made 21 saves for Buffalo, which has lost two of its last three games.\n\n\r\n              Marner opened the scoring with a short-handed goal at 12:17 of the second period following a turnover by <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a>.\n\n\r\n              Eichel, who was the Sabres first-round draft pick in 2015 and traded to Vegas in 2021, made it 2-0 one minute and 26 seconds later with his eighth goal of the season. He has seven goals and three assists in eight games against Buffalo in his career.\n\n\r\n              Malenstyn cut the Vegas lead to 2-1 with his first goal on a goalmouth scrum at 4:26 of the third period, but Hertl made it 3-1 just 1:17 later.\n\n\r\n              Hertl’s second of the game and ninth of the season made it 4-1 at 10:00.\n\n\r\n              <hl2>Up next</hl2>\r\n              Buffalo concludes a four-game homestand against Tampa Bay on Wednesday night.\n\n\r\n              Vegas begins a five-game homestand against Utah on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-08T23:16:34Z"}}