on":"Delaying Game-Puck over glass"},"clock":{"displayValue":"0:31"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"3151784","displayName":"Gustav Forsling","shortName":"G. Forsling"}}]},{"id":"401892674000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Morgan Geekie faceoff won against Anton Lundell","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"0:31"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"4268466","displayName":"Morgan Geekie","shortName":"M. Geekie"},"type":"face-off-winner"},{"athlete":{"id":"4697395","displayName":"Anton Lundell","shortName":"A. Lundell"}}]},{"id":"401892674000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"David Pastrnak Slap Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"0:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"3114778","displayName":"David Pastrnak","shortName":"D. Pastrnak"},"type":"shooter"},{"athlete":{"id":"5452","displayName":"Jacob Markstrom","shortName":"J. Markstrom"}}]},{"id":"401892674000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Morgan Geekie hit Eetu Luostarinen","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"0:41"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"4268466","displayName":"Morgan Geekie","shortName":"M. Geekie"},"type":"hit-credited"},{"athlete":{"id":"4233877","displayName":"Eetu Luostarinen","shortName":"E. Luostarinen"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1824","guid":"58cac4d0-a208-3028-b2a6-ff7aba657bc3","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Elias Lindholm scores 1st of Boston's 3 goals in 1st period, carrying Bruins past Panthers, 4-1","description":"— Elias Lindholm, Mikey Eyssimont and Morgan Geekie each scored a goal in an opening period that started out testy, carrying the Boston Bruins past the Florida Panthers 4-1 on Sunday.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3041994/elias-lindholm\">Elias Lindholm</a>, Mikey Eyssimont and <a href=\"http://www.espn.com/nhl/player/_/id/4268466/morgan-geekie\">Morgan Geekie</a> each scored a goal in an opening period that started out testy, carrying the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> past the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> 4-1 on Sunday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> made 40 saves, 17 coming in the first period, for the Bruins, who improved to 7-0-0 at home by winning their fourth straight game a day after placing young star <a href=\"http://www.espn.com/nhl/player/_/id/5275337/james-hagens\">James Hagens</a> on injured reserve.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697438/jj-peterka\">JJ Peterka</a> added a goal for Boston, which owns a plus-21 goal differential at TD Garden. <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3899949/pavel-zacha\">Pavel Zacha</a> each added two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042088/carter-verhaeghe\">Carter Verhaeghe</a> scored a power-play goal for the Panthers, and <a href=\"http://www.espn.com/nhl/player/_/id/5452/jacob-markstrom\">Jacob Markstrom</a> stopped 32 shots. Florida has lost three of four games.\n\n\r\n              Boston’s 6-foot-7 defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3042021/nikita-zadorov\">Nikita Zadorov</a> dropped the gloves against 6-foot-1 forward <a href=\"http://www.espn.com/nhl/player/_/id/4319858/brady-tkachuk\">Brady Tkachuk</a> at the opening faceoff, setting the stage for 126 total penalty minutes.\n\n\r\n              Just over six minutes later, Florida’s <a href=\"http://www.espn.com/nhl/player/_/id/3149633/garnet-hathaway\">Garnet Hathaway</a> squared off against forward <a href=\"http://www.espn.com/nhl/player/_/id/4587985/mark-kastelic\">Mark Kastelic</a>. \n\n\r\n              The Panthers swept the three games against Boston last season, winning each by one goal.\n\n\r\n              Following a lengthy review, Lindholm was credited with a goal that made it 1-0 just 4:50 into the game after his wrister broke off Markstrom and trickled behind him, nearing the goal line as he attempted to pull it back with his glove.\n\n\r\n              Eyssimont poked a loose puck into the net following his wraparound shot, making it 2-0 less than two minutes later.\n\n\r\n              Geekie then scored for the fourth straight game, one-timing a shot for a power-play goal at 15:59 with the Bruins on a two-man advantage.\n\n\r\n              Verhaeghe’s one-timer cut it to 3-1. \n\n\r\n              The Bruins, who entered with the NHL’s second-best goal differential behind Carolina, were off since rolling to a <a href=\"https://apnews.com/article/penguins-bruins-score-b3f11451292f0f37b1c10118dddfecc3\">6-2 victory at Pittsburgh</a> on Thursday.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Close their three-game road trip Tuesday at Columbus.\n\n\r\n              Bruins: Play the second of four straight at home Thursday, facing longtime rival Montreal.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-08T21:14:34Z"}}