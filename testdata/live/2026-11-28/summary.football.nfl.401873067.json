rcentage":0.9632,"playId":"4018730671597","tiePercentage":0},{"homeWinPercentage":0.9632,"playId":"4018730671608","tiePercentage":0},{"homeWinPercentage":0.9785,"playId":"4018730671619","tiePercentage":0},{"homeWinPercentage":0.9788,"playId":"4018730671660","tiePercentage":0},{"homeWinPercentage":0.9765,"playId":"4018730671667","tiePercentage":0},{"homeWinPercentage":0.9774,"playId":"4018730671697","tiePercentage":0},{"homeWinPercentage":0.9794,"playId":"4018730671722","tiePercentage":0},{"homeWinPercentage":0.983,"playId":"4018730671745","tiePercentage":0},{"homeWinPercentage":0.9824,"playId":"4018730671768","tiePercentage":0},{"homeWinPercentage":0.9824,"playId":"4018730671778","tiePercentage":0},{"homeWinPercentage":0.9844,"playId":"4018730671787","tiePercentage":0}],"gameInfo":{"venue":{"id":"3622","guid":"abb5abf3-0c80-3f8d-a148-dc5cf8be2e7a","fullName":"Arrowhead Stadium","address":{"city":"Kansas City","state":"MO","zipCode":"64129","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3622.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3622.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":73511,"officials":[{"fullName":"Ian Malepeai","displayName":"Ian Malepeai","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":1},{"fullName":"Sarah Thomas","displayName":"Sarah Thomas","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":2},{"fullName":"Brad Allen","displayName":"Brad Allen","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":3},{"fullName":"Chad Hill","displayName":"Chad Hill","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":4},{"fullName":"Anthony Flemming","displayName":"Anthony Flemming","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":5},{"fullName":"Walter Flowers","displayName":"Walter Flowers","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":6},{"fullName":"Tyree Walton","displayName":"Tyree Walton","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":7}]},"article":{"headline":"Mahomes throws 3 TD passes, Kelce catches 2 of them, as KC routs Cardinals 34-7 for 3rd straight win","description":"— Patrick Mahomes slinging touchdown passes to Travis Kelce.","story":"KANSAS CITY, Mo. -- — <a href=\"http://www.espn.com/nfl/player/_/id/3139477/patrick-mahomes\">Patrick Mahomes</a> slinging touchdown passes to <a href=\"http://www.espn.com/nfl/player/_/id/15847/travis-kelce\">Travis Kelce</a>. \n\n\r\n              The Chiefs dominating long stretches with an underrated running game. \n\n\r\n              And an opportunistic Kansas City defense that can make life downright miserable for opposing offenses.\n\n\r\n              It's been the same formula for nearly a decade now. \n\n\r\n              Rarely has it worked better than Sunday.\n\n\r\n              Mahomes threw for 324 yards and three touchdowns in just over three quarters, Kelce hauled in two of the TD passes, and the Chiefs whipped the woebegone <a href=\"http://www.espn.com/nfl/team/_/name/ari/arizona-cardinals\">Arizona Cardinals</a> 34-7 — their third straight lopsided win heading into a crucial five-game stretch.\n\n\r\n              The AFC West-leading Chiefs (8-2) head to Buffalo for a Thanksgiving night showdown between Super Bowl contenders. Then, after heading back across the country to face the Rams, the Chiefs play the Bengals, Patriots and 49ers in quick succession.\n\n\r\n              “I'm excited for the rest of the season,” Mahomes said, “but it all begins Thursday night.”\n\n\r\n              Kansas City hopes to have running back Kenneth Walker back for that stretch after <a href=\"https://apnews.com/article/kansas-city-chiefs-kenneth-walker-nfl-53111b6fd471fb2f73dba7c8f28dad25\">missing his second game to a groin injury</a>. \n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4832955/emmett-johnson\">Emmett Johnson</a> filled in again Sunday, and just like in <a href=\"https://apnews.com/article/emmett-johnson-chiefs-f5646c710b1a2585ad0ba3e9cde435a2\">last week's blowout of Atlanta</a>, the fifth-round pick out of Nebraska proved to be a load for the Cardinals. He carried 23 times for 105 yards while reaching the end zone for the fourth straight game.\n\n\r\n              The Chiefs, who have won three straight by an average of 24 points, finished with 435 yards in a game they easily could have overlooked. They held Arizona to just 205, and 72 of that came on a fourth-quarter drive that ended on downs.\n\n\r\n              “That comes from the locker room. The senior leadership,” Chiefs coach Andy Reid said. “They understand where we're at in the season. Every game counts. They hear it from the coaches, but hearing it from your peers is important. They don't let anything slide.”\n\n\r\n              The injury-plagued Cardinals (3-8) <a href=\"https://apnews.com/article/arizona-cardinals-carson-beck-josh-johnson-d3dd3d6458396f1ee66397b9361aaab9\">planned to start <a href=\"http://www.espn.com/nfl/player/_/id/4430841/carson-beck\">Carson Beck</a> at quarterback</a> for the second straight week, but the rookie was ruled out Saturday because of back spasms. They ended up turning to 40-year-old journeyman <a href=\"http://www.espn.com/nfl/player/_/id/11394/josh-johnson\">Josh Johnson</a>, their fourth starter in four games, who had joined his 15th franchise when Arizona claimed him off the Bengals practice squad a couple of weeks ago.\n\n\r\n              Johnson ended up 18 of 31 for 155 yards with a touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4360739/simi-fehoko\">Simi Fehoko</a>. He also was sacked three times.\n\n\r\n              “It’s been one helluva stretch for us. It’s been one helluva stretch really since Week 2,” said Cardinals coach Mike LaFleur, whose team has managed 16 points total in the past three games. \"We’ve done some good, but more bad. But we have six weeks left.”\n\n\r\n              The Cardinals have lost six of their past seven against the Chiefs, and they have never won in five tries at Arrowhead Stadium.\n\n\r\n              “We made some plays here and there, and showed flashes,\" Johnson said, \"but flashes against good teams don’t get you nothing.”\n\n\r\n              The tone was set in the first 15 minutes, when the Chiefs ran 27 plays for 152 yards and the Cardinals ran just four for 13.\n\n\r\n              Kansas City opened with a 72-yard march that ended with Kelce's first touchdown reception, then put together an 80-yard drive that Johnson capped with his short TD run. After the Cardinals answered with a touchdown of their own — on a 10-play, 63-yard drive that proved to be their only real bright spot — the Chiefs tacked on two field goals and another touchdown.\n\n\r\n              The first field goal came after Kansas City stuffed Arizona on fourth down. The second came after a three-and-out gave the Chiefs the ball with just over a minute left in the first half, and Mahomes and Co. got them within <a href=\"http://www.espn.com/nfl/player/_/id/3055899/harrison-butker\">Harrison Butker</a>'s range.\n\n\r\n              The Chiefs' embattled kicker was perfect Sunday, hitting both of his field-goal attempts and all four PATs.\n\n\r\n              Arizona held the ball for less than 10 minutes in the first half and gained a mere 78 yards, and things weren't a whole lot better after the break. The Cardinals punted on their first three possessions before that fourth-quarter drive that ended on downs.\n\n\r\n              The Chiefs, meanwhile, added a 97-yard touchdown drive. It ended on the first play of the fourth quarter, when <a href=\"http://www.espn.com/nfl/player/_/id/4683062/xavier-worthy\">Xavier Worthy</a> outran a linebacker on a dump-off pass to make it 34-7, and it proved to be the final play for Mahomes and several other starters.\n\n\r\n              “I'll make it to bedtime tonight, put the kids to bed,” Mahomes said, “and then I'll be onto Buffalo.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Cardinals: LB <a href=\"http://www.espn.com/nfl/player/_/id/4429071/cody-simon\">Cody Simon</a> left in the third quarter with a calf injury.\n\n\r\n              Chiefs: TE <a href=\"http://www.espn.com/nfl/player/_/id/4240472/noah-gray\">Noah Gray</a> left in the fourth quarter with a rib injury. FB <a href=\"http://www.espn.com/nfl/player/_/id/4372070/ben-vansumeren\">Ben VanSumeren</a> hurt his knee.\n\n\r\n              <hl2>Up next</hl2>\r\n              Arizona begins a three-game homestand against Washington next Sunday.\n\n\r\n              Kansas City heads to Buffalo on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-22T20:56:33Z"}}