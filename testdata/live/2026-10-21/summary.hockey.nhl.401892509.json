lete":{"id":"4954","displayName":"Ryan McDonagh","shortName":"R. McDonagh"},"type":"defender"}]},{"id":"401892509000000740","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Ryker Evans","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:20"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4874864","displayName":"Ryker Evans","shortName":"R. Evans"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1396","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Victor Hedman's goal 2:07 into overtime lifts Lightning past Kraken 4-3","description":"— Captain Victor Hedman scored just over two minutes into overtime to give the Tampa Bay Lightning a 4-3 victory over the Seattle Kraken on Thursday...","story":"TAMPA, Fla. -- — <a href=\"https://x.com/ginohard--/status/2110912769402998984?s=46&t=k9ViX1I2UGQuWELjkV-5Dw\">Captain <a href=\"http://www.espn.com/nhl/player/_/id/5157/victor-hedman\">Victor Hedman</a> scored just over two minutes into overtime</a> to give the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> a 4-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> on Thursday night.\n\n\r\n              Hedman crossed the blue line, split the defense and drove straight to the net, tapping the puck through the legs of Seattle goalie <a href=\"http://www.espn.com/nhl/player/_/id/5657/philipp-grubauer\">Philipp Grubauer</a>, who was trying to poke the puck away. <a href=\"http://www.espn.com/nhl/player/_/id/4588205/pontus-holmberg\">Pontus Holmberg</a> got an assist on the goal 2:07 into OT.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> scored twice and <a href=\"http://www.espn.com/nhl/player/_/id/4422415/ilya-mikheyev\">Ilya Mikheyev</a> added a goal for the Lightning, who improved to 4-0-0 at home. The last time Tampa Bay opened a season with four straight wins in 2020-21, when they opened 6-0.\n\n\r\n              Tampa Bay led 2-1 after two periods and was 3-0 when leading after 40 minutes entering Thursday's game. Last season, the Lightning were 33-1 when leading after two periods.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114777/jared-mccann\">Jared McCann</a>, Matthew Beniers and <a href=\"http://www.espn.com/nhl/player/_/id/4894928/ryan-winterton\">Ryan Winterton</a> scored for the Kraken. Beniers’ tip-in goal in the third tied the game with 4:19 left in regulation.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> made 24 saves in the win for the Lightning. Grubauer had 31 saves for the Kraken.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kraken: At the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> on Saturday.\n\n\r\n              Lightning: Host the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-16T02:17:26Z"}}