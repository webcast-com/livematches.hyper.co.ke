ff","abbreviation":"faceoff"},"clock":{"displayValue":"1:54"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"5229146","displayName":"Ilya Protas","shortName":"I. Protas"},"type":"face-off-winner"},{"athlete":{"id":"4393049","displayName":"Jake Evans","shortName":"J. Evans"}}]},{"id":"401892504000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Kaiden Guhle hit Ivan Miroshnichenko","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"4697399","displayName":"Kaiden Guhle","shortName":"K. Guhle"},"type":"hit-credited"},{"athlete":{"id":"5080168","displayName":"Ivan Miroshnichenko","shortName":"I. Miroshnichenko"},"type":"hitted"}]},{"id":"401892504000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Cole Hutson shot blocked by Alexandre Carrier","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"5216918","displayName":"Cole Hutson","shortName":"C. Hutson"},"type":"shooter"},{"athlete":{"id":"3942064","displayName":"Alexandre Carrier","shortName":"A. Carrier"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1823","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16719,"officials":[{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Alex Tuch has 2 goals and an assist in the Capitals' 5-4 win over the Canadiens","description":"— Alex Tuch scored twice and added an assist and the Washington Capitals beat the Montreal Canadiens 5-4 on Wednesday night.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> scored twice and added an assist and the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> 5-4 on Wednesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4062251/jordan-kyrou\">Jordan Kyrou</a> had a goal and assist, <a href=\"http://www.espn.com/nhl/player/_/id/5763/justin-holl\">Justin Holl</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080168/ivan-miroshnichenko\">Ivan Miroshnichenko</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/3095975/charlie-lindgren\">Charlie Lindgren</a> stopped 26 shots to help the Capitals snap a two-game losing streak. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3069687/josh-anderson\">Josh Anderson</a> scored twice and <a href=\"http://www.espn.com/nhl/player/_/id/5080230/lane-hutson\">Lane Hutson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> added goals for the Canadiens.\n\n\r\n              Both teams played on Tuesday night, with Washington falling 4-2 at Carolina, and Montreal edging Buffalo 4-3 in a shootout at home.\n\n\r\n              Montreal got off to a quick start when Anderson, alone at the net front, buried a feed from <a href=\"http://www.espn.com/nhl/player/_/id/4565237/alex-newhook\">Alex Newhook</a> 4:56 into play. Minutes later, Kryou responded, cutting to the middle before rifling a quick shot past <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a>.\n\n\r\n              Roughly halfway through the first, Montreal regained the lead, as Hutson, playing against younger brother Cole for the first time, beat Charlie Lindgren on a quick shot from the slot. With 25 seconds to go in the period, the Capitals tied it 2 on a power play. Ivan Miroshnichenko’s backdoor feed to Tuch went off Anderson’s stick and in.\n\n\r\n              Washington took a 3-2 lead 6:16 into the second period, when Tuch had a short-handed goal. Anderson tied it again from close range.\n\n\r\n              Justin Holl broke the tie with 7:31 minutes to go, beating Dobes on a point shot through traffic. Tuch added an insurance goal minutes later for his fifth of the season.\n\n\r\n              Suzuki pulled the Canadiens within one with 1:39 to go on a power play with an extra attacker.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canadiens: Host Buffalo on Saturday night.\n\n\r\n              Capitals: Host New Jersey on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-15T02:41:28Z"}}