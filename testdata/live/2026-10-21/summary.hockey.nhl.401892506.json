":"Ukko-Pekka Luukkonen","shortName":"U. Luukkonen"}}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18886,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Owen Power scores in OT to complete Sabres' rally for 5-4 win over Maple Leafs","description":"— Owen Power scored in overtime and the Buffalo Sabres rallied from two goals down in the third period to overcome Kirill Marchenko's hat trick and beat the Toronto Maple Leafs 5-4 on Thursday.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/4781556/owen-power\">Owen Power</a> scored in overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> rallied from two goals down in the third period to overcome <a href=\"http://www.espn.com/nhl/player/_/id/4587996/kirill-marchenko\">Kirill Marchenko</a>'s hat trick and beat the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> 5-4 on Thursday.\n\n\r\n              Marchenko had the fifth hat trick of his career in his 300th NHL game. His third goal, at 16:51 of the second period, put the Leafs ahead 4-2.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> had a pair of goals for Buffalo before <a href=\"http://www.espn.com/nhl/player/_/id/3942030/dennis-gilbert\">Dennis Gilbert</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4378656/mattias-samuelsson\">Mattias Samuelsson</a> scored in the third to tie it at 4-all. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> stopped 26 shots for the Sabres, who were coming off a shootout loss to Montreal two nights earlier.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> also scored for Toronto, and <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> made 29 saves.\n\n\r\n              Power took a feed from Quinn at center ice and <a href=\"https://x.com/BuffaloSabres/status/2110914403944010203\">ripped it past Bobrovsky</a> at 3:14 of overtime.\n\n\r\n              Acquired from Columbus on Sept. 28, just before the season began, Marchenko had scored only once for Toronto before Thursday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5160/john-tavares\">John Tavares</a> had two assists before he left the game early in the third after he collided with Buffalo forward <a href=\"http://www.espn.com/nhl/player/_/id/4233627/josh-norris\">Josh Norris</a>. The former Toronto captain appeared to favor his left leg as he left the ice.\n\n\r\n              Toronto was sloppy with the puck in the first period — Quinn’s first goal came on a giveaway by defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4781550/nick-blankenburg\">Nick Blankenburg</a> — but the Sabres only managed eight shots to Toronto’s 15 in the frame. Buffalo got back into the game in the third with Tavares not available to anchor the Leafs’ second line.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sabres: At the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> on Saturday.\n\n\r\n              Maple Leafs: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-16T02:26:27Z"}}