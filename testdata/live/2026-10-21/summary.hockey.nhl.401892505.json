ame":"Jason Robertson","shortName":"J. Robertson"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"892","fullName":"Ball Arena","address":{"city":"Denver","state":"CO","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/892.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18107,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Roope Hintz scores in 4th round of shootout as Stars outlast Avalanche 3-2","description":"— Roope Hintz scored in the fourth round of the shootout and the Dallas Stars beat Colorado 3-2 on Wednesday night in a game where the Avalanche had two early goals disallowed.","story":"DENVER -- — <a href=\"http://www.espn.com/nhl/player/_/id/3904183/roope-hintz\">Roope Hintz</a> scored in the fourth round of the shootout and the <a href=\"https://apnews.com/hub/dallas-stars\"><a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a></a> beat Colorado 3-2 on Wednesday night in a game where the Avalanche had two early goals disallowed.\n\n\r\n              Hintz sent a wrist shot past <a href=\"http://www.espn.com/nhl/player/_/id/5622/scott-wedgewood\">Scott Wedgewood</a>. <a href=\"http://www.espn.com/nhl/player/_/id/3025540/casey-desmith\">Casey DeSmith</a> secured the win by stopping <a href=\"http://www.espn.com/nhl/player/_/id/5798/brock-nelson\">Brock Nelson</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233536/miro-heiskanen\">Miro Heiskanen</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5209793/arttu-hyry\">Arttu Hyry</a> scored for the Stars, who split a back-to back set of games with the Avalanche. They <a href=\"https://apnews.com/article/dallas-stars-martin-necas-colorado-avalanche-colorado-8573454dc5e74b06ba52d3c8304268f8\">lost 3-2 at home</a> the night before.\n\n\r\n              Hyry nearly won it in overtime but sent a bouncing puck off the post. Hyry’s short-handed tally off a steal against <a href=\"http://www.espn.com/nhl/player/_/id/4233563/cale-makar\">Cale Makar</a> gave the Stars a 2-1 lead early in the third period before Nelson tied it with 11:39 left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562609/gabriel-landeskog\">Gabriel Landeskog</a> also had a goal for Colorado.\n\n\r\n              The Avalanche had quite a night of disallowed goals and close calls. <a href=\"http://www.espn.com/nhl/player/_/id/5835/jaden-schwartz\">Jaden Schwartz</a> saw his score overturned in the first period after the Stars successfully challenged for offsides. Later in the period, Gabriel Landeskog's goal was taken off the board when it was ruled the captain made a kicking motion to knock in the puck.\n\n\r\n              In the third, Gavin Brindley thought he scored and even began celebrating with teammates. But the officials never ruled it a goal and replays showed it glanced off both posts and didn't go into the net.\n\n\r\n              DeSmith finished with 25 saves for Dallas. He stopped three of four in the shootout. Stars forward <a href=\"http://www.espn.com/nhl/player/_/id/4894398/oskar-back\">Oskar Back</a> suffered an upper-body injury in the first period and didn't return. \n\n\r\n              Makar returned to the lineup after missing Tuesday's game against the Stars. He and his wife welcomed twin boys on Wednesday morning. \n\n\r\n              <hl2>Up next</hl2>\r\n              Stars: At Chicago on Saturday.\n\n\r\n              Avalanche: Host <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a> and the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> on Friday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-15T03:44:26Z"}}