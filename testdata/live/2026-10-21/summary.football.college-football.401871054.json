54276","tiePercentage":0},{"homeWinPercentage":0.5832,"playId":"401871054282","tiePercentage":0},{"homeWinPercentage":0.6131,"playId":"401871054280","tiePercentage":0},{"homeWinPercentage":0.6062,"playId":"401871054286","tiePercentage":0},{"homeWinPercentage":0.6304,"playId":"401871054290","tiePercentage":0},{"homeWinPercentage":0.6324,"playId":"401871054295","tiePercentage":0},{"homeWinPercentage":0.647,"playId":"401871054300","tiePercentage":0},{"homeWinPercentage":0.6478,"playId":"401871054304","tiePercentage":0},{"homeWinPercentage":0.6347,"playId":"401871054309","tiePercentage":0},{"homeWinPercentage":0.599,"playId":"401871054312","tiePercentage":0},{"homeWinPercentage":0.5975,"playId":"401871054318","tiePercentage":0},{"homeWinPercentage":0.6173,"playId":"401871054316","tiePercentage":0},{"homeWinPercentage":0.6066,"playId":"401871054322","tiePercentage":0},{"homeWinPercentage":0.5829,"playId":"401871054326","tiePercentage":0},{"homeWinPercentage":0.579,"playId":"401871054331","tiePercentage":0},{"homeWinPercentage":0.5853,"playId":"401871054337","tiePercentage":0},{"homeWinPercentage":0.6065,"playId":"401871054335","tiePercentage":0},{"homeWinPercentage":0.595,"playId":"401871054341","tiePercentage":0},{"homeWinPercentage":0.6251,"playId":"401871054346","tiePercentage":0},{"homeWinPercentage":0.6515,"playId":"401871054350","tiePercentage":0}],"gameInfo":{"venue":{"id":"3878","guid":"6fd7b755-81cd-35bd-9002-d155e9665ead","fullName":"Robert W. Plaster Stadium","address":{"city":"Springfield","state":"MO","zipCode":"65897","country":"USA"},"grass":false,"images":[]},"attendance":9044},"article":{"headline":"Obeid kicks 20-yard FG as time expires, Missouri State beats Kennesaw State 24-21","description":"— Yousef Obeid kicked a 20-yard field goal as time expired, Henry Belin IV had a career-high 300 yards passing and threw two touchdown passes to Isaiah Myers, and Missouri State defeated Kennesaw State 24-21 on Wednesday night.","story":"SPRINGFIELD, Mo. -- — <a href=\"http://www.espn.com/college-football/player/_/id/5155163/yousef-obeid\" target=\"_new\">Yousef Obeid</a> kicked a 20-yard field goal as time expired, <a href=\"http://www.espn.com/college-football/player/_/id/4685252/henry-belin-iv\" target=\"_new\">Henry Belin IV</a> had a career-high 300 yards passing and threw two touchdown passes to <a href=\"http://www.espn.com/college-football/player/_/id/5219476/isaiah-myers\" target=\"_new\">Isaiah Myers</a>, and Missouri State defeated Kennesaw State 24-21 on Wednesday night.\n\n\r\n              The win was the first Bowl Subdivision victory for the Bears (2-4, 1-1 Conference USA) in the Casey Woods era. They previously defeated Championship Subdivision member Lindenwood <a href=\"https://apnews.com/article/lindenwood-missouri-state-e59f8b6c626065dee8032843b43e4b9d\">on Sept. 12</a>.\n\n\r\n              Myers had seven catches for 135 yards, twice tying the game in the second half with scoring grabs of 14 and 12 yards. Belin was 28-of-39 passing, and eight different receivers had catches.\n\n\r\n              The Bears held a 6-0 lead late in the second quarter thanks to two field goals from Obeid, but Kennesaw State took the lead into halftime with a 10-yard pass from <a href=\"http://www.espn.com/college-football/player/_/id/4870645/rickie-collins\" target=\"_new\">Rickie Collins</a> to <a href=\"http://www.espn.com/college-football/player/_/id/5081089/dylan-gary\" target=\"_new\">Dylan Gary</a>.\n\n\r\n              The teams traded scores in the second half until Missouri State took over possession with 6:06 remaining in regulation. They marched down the field with a 12-yard, 68-yard drive to set up Obeid's go-ahead field goal.\n\n\r\n              The Owls (1-5, 0-2) were paced by Collins's 260 yards passing on 27-of-35 passing, and Gary had 10 receptions for 135 yards. Kennesaw State has lost five straight since a <a href=\"https://apnews.com/article/west-georgia-kennesaw-state-football-score-b4feb47a0f793f94c04eef8e7cfdc023\">47-0</a> win over West Georgia in the season opener. \n\n\r\n              <hl2>Up next</hl2>\r\n              Kennesaw State: host Liberty on Oct. 22.\n\n\r\n              Missouri State: at Delaware on Oct. 20. ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-15T03:20:26Z"}}