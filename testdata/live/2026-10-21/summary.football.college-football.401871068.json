10","tiePercentage":0},{"homeWinPercentage":0.3579,"playId":"401871068315","tiePercentage":0},{"homeWinPercentage":0.3321,"playId":"401871068319","tiePercentage":0},{"homeWinPercentage":0.3334,"playId":"401871068330","tiePercentage":0},{"homeWinPercentage":0.3368,"playId":"401871068333","tiePercentage":0},{"homeWinPercentage":0.336,"playId":"401871068338","tiePercentage":0}],"gameInfo":{"venue":{"id":"3647","guid":"673b94cd-94fa-385a-ad66-034d46f0834f","fullName":"Elliott T. Bowers Stadium","address":{"city":"Huntsville","state":"TX","zipCode":"77340","country":"USA"},"grass":false,"images":[]},"attendance":7291},"article":{"headline":"Campbell hits 3 FGs as Western Kentucky defeats Sam Houston 16-3","description":"— Brock Glenn and Coleson Arends connected on the game's lone touchdown, Karl Campbell hit all three of his field goal attempts, and Western Kentucky took down Sam Houston 16-3 on Wednesday night.","story":"HUNTSVILLE, Texas -- — <a href=\"http://www.espn.com/college-football/player/_/id/4920158/brock-glenn\" target=\"_new\">Brock Glenn</a> and <a href=\"http://www.espn.com/college-football/player/_/id/5159815/coleson-arends\" target=\"_new\">Coleson Arends</a> connected on the game's lone touchdown, <a href=\"http://www.espn.com/college-football/player/_/id/5394214/karl-campbell\" target=\"_new\">Karl Campbell</a> hit all three of his field goal attempts, and Western Kentucky took down Sam Houston 16-3 on Wednesday night.\n\n\r\n              The Hilltoppers (3-4, 2-1 Conference USA) remain perfect against Sam Houston since the Bearkats (1-5, 0-2) joined CUSA in 2023, and are 4-1 in the series.\n\n\r\n              Freshman <a href=\"http://www.espn.com/college-football/player/_/id/5290902/jonathan-stafford-jr\" target=\"_new\">Jonathan Stafford Jr</a>. had five catches for 37 yards, and his 41 receptions are third on WKU's freshman receiving list.\n\n\r\n              WKU scored on its first possession of the game after forcing a Sam Houston three-and-out in just 50 seconds of game time. \n\n\r\n              Arends reeled in a 23-yard pass from Glenn to cap an 11-play, 65-yard drive.\n\n\r\n              Campbell connected on field goals of 33, 35, and 39 yards.\n\n\r\n              The Bearkats' only points came from <a href=\"http://www.espn.com/college-football/player/_/id/5154317/sam-carpenter\" target=\"_new\">Sam Carpenter</a>'s 42-yard field goal in the second quarter. They were held to 177 total yards, and managed just 12 first downs.\n\n\r\n              Freshman <a href=\"http://www.espn.com/college-football/player/_/id/5266918/westen-ard\" target=\"_new\">Westen Ard</a> had a career-high 10 total tackles and 1 1/2 sacks.\n\n\r\n              <hl2>Up next</hl2>\r\n              Western Kentucky: host Delaware on Oct. 27.\n\n\r\n              Sam Houston: host New Mexico State on Oct. 21. ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-15T03:51:26Z"}}