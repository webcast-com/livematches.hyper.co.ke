2","displayName":"Victor Eklund","shortName":"V. Eklund"},"type":"hitted"}]},{"id":"401892507000001010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brayden Schenn hit Cameron Crotty","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"5219","displayName":"Brayden Schenn","shortName":"B. Schenn"},"type":"hit-credited"},{"athlete":{"id":"4587571","displayName":"Cameron Crotty","shortName":"C. Crotty"},"type":"hitted"}]},{"id":"401892507000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:14"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892507000000840","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Cozens faceoff won against Jean-Gabriel Pageau","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:14"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"},"type":"face-off-winner"},{"athlete":{"id":"2593131","displayName":"Jean-Gabriel Pageau","shortName":"J. Pageau"}}]},{"id":"401892507000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Anthony Duclair shot blocked by Dylan Cozens","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:17"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"3042086","displayName":"Anthony Duclair","shortName":"A. Duclair"},"type":"shooter"},{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1832","fullName":"Canadian Tire Centre","address":{"city":"Ottawa","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1832.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14534,"officials":[{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kendrick Nicholson","displayName":"Kendrick Nicholson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Pinto scores the shootout winner to send the Senators to a 2-1 victory over the Islanders","description":"— Shane Pinto scored the shootout winner to lead the Ottawa Senators to a 2-1 win over the New York Islanders on Thursday night.","story":"OTTAWA, Ontario -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565255/shane-pinto\">Shane Pinto</a> scored the shootout winner to lead the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> to a 2-1 win over the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697411/ridly-greig\">Ridly Greig</a> scored in regulation and <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> made 20 saves for Ottawa (6-2-0). Ullmark has won his first six starts of the season.\n\n\r\n              Matias Macelli scored and <a href=\"http://www.espn.com/nhl/player/_/id/3759/semyon-varlamov\">Semyon Varlamov</a>, making his second start of the season, stopped 18 shots for the Islanders (3-3-1).\n\n\r\n              The Islanders’ <a href=\"http://www.espn.com/nhl/player/_/id/3069621/adam-pelech\">Adam Pelech</a> took a hooking penalty with 3:08 remaining in overtime. Varlamov made two saves to extend the game before <a href=\"http://www.espn.com/nhl/player/_/id/4565228/dylan-cozens\">Dylan Cozens</a> took a tripping penalty catching Pelech as he came out of the box and looked to break in on Ullmark. <a href=\"http://www.espn.com/nhl/player/_/id/3042002/bo-horvat\">Bo Horvat</a> had the lone shot on the power play.\n\n\r\n              Trailing 1-0, the Senators tied the game late in the second on a 2-on-1. <a href=\"http://www.espn.com/nhl/player/_/id/3151036/warren-foegele\">Warren Foegele</a> broke in and made a cross-ice pass to Greig, who beat Varlamov high on the stick side.\n\n\r\n              New York opened the scoring with 11.2 seconds remaining in the period when Maccelli stripped Pinto of the puck at Ottawa’s blueline, took two strides and wristed a shot past Ullmark.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4712021/artem-zub\">Artem Zub</a> made his season debut Thursday, assisting on Greig’s goal. The Senators defenseman hadn’t played since sustaining a knee injury in Game 1 of the first round of last season’s playoffs.\n\n\r\n              The Senators had two goals called back in the first period. Foegele believed he had opened the scoring but upon review, it was clear the puck hit the outside of the crossbar and never crossed the goal line. Just over seven minutes later, <a href=\"http://www.espn.com/nhl/player/_/id/5136706/stephen-halliday\">Stephen Halliday</a> beat Varlamov, but upon review Ottawa was offside.\n\n\r\n              Ottawa’s <a href=\"http://www.espn.com/nhl/player/_/id/4874721/william-eklund\">William Eklund</a> had surgery Wednesday to repair a torn tendon in his ankle and is expected to miss 10 to 12 weeks. \n\n\r\n              <hl2>Up next</hl2>\r\n              Islanders: At the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> on Saturday.\n\n\r\n              Senators: At the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-16T02:32:27Z"}}