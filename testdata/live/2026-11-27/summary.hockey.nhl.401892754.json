d":{"number":1,"displayValue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"3114775","displayName":"Kasperi Kapanen","shortName":"K. Kapanen"},"type":"hit-credited"},{"athlete":{"id":"3042054","displayName":"William Carrier","shortName":"W. Carrier"},"type":"hitted"}]},{"id":"401892754000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Filip Hallander shot blocked by Alexander Nikishin","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:50"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"4588331","displayName":"Filip Hallander","shortName":"F. Hallander"},"type":"shooter"},{"athlete":{"id":"4915850","displayName":"Alexander Nikishin","shortName":"A. Nikishin"},"type":"defender"}]},{"id":"401892754000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Crowd","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:13"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"999","fullName":"Lenovo Center","address":{"city":"Raleigh","state":"NC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/999.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18855,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Hurricanes surge past Oilers for 7-4 victory","description":"— Andrei Svechnikov scored two goals and Sebastian Aho had a goal and two assists to lead the Carolina Hurricanes to a 7-4 win over the Edmonton Oilers on Saturday.","story":"RALEIGH, N.C. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4352683/andrei-svechnikov\">Andrei Svechnikov</a> scored two goals and <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> had a goal and two assists to lead the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> to a 7-4 win over the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4272905/sean-walker\">Sean Walker</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4063449/jalen-chatfield\">Jalen Chatfield</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5428/taylor-hall\">Taylor Hall</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4915850/alexander-nikishin\">Alexander Nikishin</a> also scored for the Hurricanes, who have a six-game points streak (5-0-1). <a href=\"http://www.espn.com/nhl/player/_/id/4565259/pyotr-kochetkov\">Pyotr Kochetkov</a> stopped 11 shots for his 13th win of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5206840/owen-michaels\">Owen Michaels</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3114727/leon-draisaitl\">Leon Draisaitl</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3941965/mathieu-joseph\">Mathieu Joseph</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565231/vasily-podkolzin\">Vasily Podkolzin</a> scored for the Oilers, who have lost two straight after winning the first three games of their road trip. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4894487/devon-levi\">Devon Levi</a> made 29 saves and <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> had two assists for Edmonton.\n\n\r\n              Saturday was the second and final meeting between two of the top teams in the NHL this season. Edmonton won the first matchup at home 6-5 in a shootout on Oct. 22.\n\n\r\n              Trailing 2-0 after the first period after the Oilers got goals from Michaels and Draisaitl, the Hurricanes scored five goals in the second period.\n\n\r\n              The Hurricanes trailed 3-1 in the second period before scoring three goals in a span of 3:05. Svechnikov scored on a power play at 12:34 of the second to give the Hurricanes their first lead at 4-3 and then he scored again at 8:20 in the third to extend Carolina’s lead to 6-4. Svechnikov has 13 goals on the season.\n\n\r\n              Podkolzin tied the game at 4-4 with 3:05 left in the second period on Edmonton’s second power-play goal of the game, but Carolina answered with a power-play goal by Aho with 26 seconds left to take a 5-4 lead in the third period. \n\n\r\n              The second period had the teams combining for seven goals by seven different players.\n\n\r\n              <hl2>Up next</hl2>\r\n              Oilers: Close out a 6-game road trip at St. Louis on Sunday.\n\n\r\n              Hurricanes: at the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-21T21:40:31Z"}}