858529276","tiePercentage":0},{"homeWinPercentage":0.0945,"playId":"401858529281","tiePercentage":0},{"homeWinPercentage":0.056,"playId":"401858529284","tiePercentage":0},{"homeWinPercentage":0.0637,"playId":"401858529292","tiePercentage":0},{"homeWinPercentage":0.0691,"playId":"401858529296","tiePercentage":0},{"homeWinPercentage":0.0753,"playId":"401858529299","tiePercentage":0},{"homeWinPercentage":0.0668,"playId":"401858529302","tiePercentage":0},{"homeWinPercentage":0.0667,"playId":"401858529305","tiePercentage":0},{"homeWinPercentage":0.067,"playId":"401858529309","tiePercentage":0},{"homeWinPercentage":0.0642,"playId":"401858529313","tiePercentage":0},{"homeWinPercentage":0.0657,"playId":"401858529319","tiePercentage":0},{"homeWinPercentage":0.0629,"playId":"401858529317","tiePercentage":0},{"homeWinPercentage":0.0645,"playId":"401858529325","tiePercentage":0},{"homeWinPercentage":0.0641,"playId":"401858529323","tiePercentage":0},{"homeWinPercentage":0.0682,"playId":"401858529328","tiePercentage":0},{"homeWinPercentage":0.0775,"playId":"401858529331","tiePercentage":0},{"homeWinPercentage":0.0774,"playId":"401858529337","tiePercentage":0},{"homeWinPercentage":0.0619,"playId":"401858529335","tiePercentage":0}],"gameInfo":{"venue":{"id":"3936","guid":"f25f162c-d080-34d8-970c-b3ae3bf8d4a8","fullName":"Spartan Stadium","address":{"city":"East Lansing","state":"MI","zipCode":"48824","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/3936.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3936.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":61331},"article":{"headline":"Smith runs for 121 yards and 2 TDs, No. 14 Oregon routs Michigan St 45-7 holding onto playoff hopes","description":"— No. 14 Oregon routed Michigan State 45-7 on Friday night, trying to show that they deserve a spot in the ","story":"EAST LANSING, Mich. -- — <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">No. 14 Oregon</a> routed Michigan State 45-7 on Friday night, trying to show that they deserve a spot in the <a href=\"https://apnews.com/article/college-football-playoff-rankings-3f917a59dd1f908edcd8e020bb57e5fe\">College Football Playoff</a>.\n\n\r\n              “We’re certainly an exciting team to watch,” Ducks coach Dan Lanning said.\n\n\r\n              Oregon (8-3, 6-2 Big Ten) has won four straight games, climbing to No. 13 in the CFP rankings with time running out to play its way into the 12-team playoff, heading into the final regular season game against rival Washington.\n\n\r\n              “No love lost,” Lanning said.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/2990271/brandon-smith\" target=\"_new\">Brandon Smith</a> set career highs with 121 yards and two touchdowns — filling in for <a href=\"https://apnews.com/article/dieree-hill-injured-oregon-382123e5c0f7449f6e8e095250b0d7f7\">Dierre Hill</a> — and kicker <a href=\"http://www.espn.com/college-football/player/_/id/5192414/gage-hurych\" target=\"_new\">Gage Hurych</a> ran for a 15-yard score on a fake field goal for the Ducks.\n\n\r\n              The Spartans (3-8, 1-7) made costly mistakes in the second quarter, hurting their chances to stay competitive before getting outscored 28-7 in the second half.\n\n\r\n              “We didn't give ourselves a chance to win in those two quarters,” coach Pat Fitzgerald said.\n\n\r\n              While Oregon did win the game, it lost another player in the backfield due to injury.\n\n\r\n              Smith limped off the field in the first quarter after getting tackled and was on crutches in the second half with a boot on his left leg.\n\n\r\n              “I don’t anticipate this being a long-term injury,” Lanning said.\n\n\r\n              Oregon running back <a href=\"https://apnews.com/article/northwestern-oregon-score-f86d9bf0c2caf1fe85649dad7ed634bc\"><a href=\"http://www.espn.com/college-football/player/_/id/5141423/jordon-davison\" target=\"_new\">Jordon Davison</a></a> missed his third straight game with a leg injury and quarterback <a href=\"https://apnews.com/article/oregon-dante-moore-out-concussion-ec0dd16a69273b321154e55194d69282\"><a href=\"http://www.espn.com/college-football/player/_/id/4870921/dante-moore\" target=\"_new\">Dante Moore</a></a> has not played <a href=\"https://apnews.com/article/oregon-dante-moore-injury-usc-1502ede194080b31984ac8cc9453829f\">since getting concussed</a> in the fourth game of the season.\n\n\r\n              Smith, who was the team's third-string running back, broke a scoreless tie with a 5-yard touchdown run late in the first quarter and the freshman also ran for a 1-yard touchdown in the third.\n\n\r\n              “Brandon has been getting more and more reps that allowed him to perform,” Lanning said.\n\n\r\n              Lanning pulled off another <a href=\"https://x.com/BigTenNetwork/status/2123969926654287982\">trick play</a> in the final seconds of the first half to put his team ahead 17-0.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5296355/bailey-ettridge\" target=\"_new\">Bailey Ettridge</a> took the snap, put the ball on the grass and pitched it to Hurych, who sprinted to the left and broke a tackle on a touchdown run that showed some of the athleticism that helped him have five offers to play Division I lacrosse.\n\n\r\n              “The guy can dunk it,” Lanning said. “He’s an athlete.”\n\n\r\n              Michigan State scored on <a href=\"http://www.espn.com/college-football/player/_/id/5081332/jaziun-patterson\" target=\"_new\">Jaziun Patterson</a>'s 1-yard touchdown run late in the third quarter.\n\n\r\n              The Spartans were in Oregon territory twice in the second quarter, but <a href=\"http://www.espn.com/college-football/player/_/id/5081440/liam-boyd\" target=\"_new\">Liam Boyd</a> missed a 47-yard kick and freshman quarterback <a href=\"http://www.espn.com/college-football/player/_/id/5266583/kayd-coffman\" target=\"_new\">Kayd Coffman</a> stumbled to the ground without getting touched on a fourth-down run. Michigan State punt returner <a href=\"http://www.espn.com/college-football/player/_/id/4869599/chrishon-mccray\" target=\"_new\">Chrishon McCray</a> lost a fumble on a punt return, setting up Hurych's 40-yard field goal in the pivotal quarter.\n\n\r\n              Coffman, starting for a second time for the injured <a href=\"http://www.espn.com/college-football/player/_/id/5146670/alessio-milivojevic\" target=\"_new\">Alessio Milivojevic</a>, was 10 of 19 for 106 yards with an interception.\n\n\r\n              Oregon's <a href=\"http://www.espn.com/college-football/player/_/id/5079572/dylan-raiola\" target=\"_new\">Dylan Raiola</a> completed 21 of 34 passes for 234 yards with a 31-yard touchdown pass to <a href=\"http://www.espn.com/college-football/player/_/id/5141586/dakorien-moore\" target=\"_new\">Dakorien Moore</a>, who made a one-handed catch in the end zone.\n\n\r\n              <hl2>The takeaway</hl2>\r\n              Oregon: Trying to climb in the CFP rankings with a large margin of victory, Raiola was throwing passes late in the fourth quarter to set up another touchdown to take a 38-point lead.\n\n\r\n              “I thought it was important to continue to operate,” Lanning said.\n\n\r\n              Earlier in the week, Fitzgerald said the Ducks were more talented than the Notre Dame and the UCLA team he faced this season.\n\n\r\n              “I was right,\" Fitzgerald said. “Wasn't I?”\n\n\r\n              Michigan State: Fitzgerald is about a week away from turning his focus to next year after a disappointing debut season as the latest coach tasked with turning around a program that has had five straight seasons with losing records.\n\n\r\n              Fitzgerald, though, has been pleased with his team's effort.\n\n\r\n              “I’m really proud of these guys,” he said.\n\n\r\n              Lanning said he respects Fitzgerald, who he believes will turn the Spartans into a winner.\n\n\r\n              “He’s building something here,” Lanning said.\n\n\r\n              <hl2>Up next</hl2>\r\n              Oregon host Washington on Nov. 28.\n\n\r\n              Michigan State ends the season at Rutgers on Nov. 28.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts</a> here. Visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-11-21T04:50:31Z"}}