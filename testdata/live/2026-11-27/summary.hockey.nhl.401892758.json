shortName":"C. Clifton"},"type":"shooter"},{"athlete":{"id":"3095975","displayName":"Charlie Lindgren","shortName":"C. Lindgren"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1824","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Riley Brace","displayName":"Riley Brace","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Elias Lindholm's 1st NHL 4-goal game and 1st trick with Boston carries Bruins to 7-5 win over Caps","description":"— Elias Lindholm had the first four-goal game of his NHL career to carry the Boston Bruins past the Washington Capitals 7-5 on Saturday.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3041994/elias-lindholm\">Elias Lindholm</a> had the first four-goal game of his NHL career to carry the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> past the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> 7-5 on Saturday.\n\n\r\n              It was his first hat trick with Boston and the third of his career. <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4064780/tanner-jeannot\">Tanner Jeannot</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080207/fraser-minten\">Fraser Minten</a> also scored for Boston. <a href=\"http://www.espn.com/nhl/player/_/id/3988803/charlie-mcavoy\">Charlie McAvoy</a> added three assists to reach 301 for his career. Minten’s goal was an empty-netter.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> made 30 saves and had a secondary assist on Lindholm’s second score at 8:54 of the second period that gave Boston a 4-2 lead.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a>, <a href=\"http://www.espn.com/nhl/player/_/id/2970615/tom-wilson\">Tom Wilson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4024833/pierre-luc-dubois\">Pierre-Luc Dubois</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3899933/dylan-strome\">Dylan Strome</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4024950/jakob-chychrun\">Jakob Chychrun</a> scored goals for the Capitals, who have lost five straight.\n\n\r\n              Lindholm’s third came on a tip of Connor Clifton’s shot that moved Boston ahead 5-4 late in the second.\n\n\r\n              Because it was tipped, most of the fans didn’t realize he completed the hat trick and only one hat was thrown onto the ice until about a half dozen came at the end of the period after his goal was announced.\n\n\r\n              His fourth goal was on the tip of Pastrnak’s shot that popped over goalie <a href=\"http://www.espn.com/nhl/player/_/id/3095975/charlie-lindgren\">Charlie Lindgren</a> 4:07 into the third, prompting a delayed celebration with many more hats sailing onto the ice as Frankie Valli’s “Can’t Take My Eyes Off You” played over the PA. Lindgren had 16 saves.\n\n\r\n              Back home after ending a three-game losing streak with a <a href=\"https://apnews.com/article/bruins-red-wings-score-8a1c5ad0f3c54d456c71217f6e9aca41\">victory at Detroit on Wednesday</a>, the Bruins scored three times in the opening nine minutes of the second.\n\n\r\n              Pastrnak circled with the puck in the Capitals’ zone before his wrister tied it at 2 just over two minutes into period.\n\n\r\n              Jeannot’s tip-in made it 3-2 at 6:23. Lindholm split a pair of defensemen before flipping the puck into the net 2:31 later for his second. \n\n\r\n              Lindholm’s first goal was a power-play score on a tip of Pastrnak’s shot.\n\n\r\n              <hl2>Up Next</hl2>\r\n              Capitals: Host Philadelphia on Wednesday night.\n\n\r\n              Bruins: Face Winnipeg at home Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-22T03:04:32Z"}}