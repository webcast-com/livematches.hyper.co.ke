62,"playId":"4018730761418","tiePercentage":0},{"homeWinPercentage":0.7165,"playId":"4018730761454","tiePercentage":0},{"homeWinPercentage":0.7098,"playId":"4018730761482","tiePercentage":0},{"homeWinPercentage":0.7537,"playId":"4018730761507","tiePercentage":0},{"homeWinPercentage":0.7015,"playId":"4018730761532","tiePercentage":0},{"homeWinPercentage":0.6795,"playId":"4018730761557","tiePercentage":0},{"homeWinPercentage":0.6624,"playId":"4018730761582","tiePercentage":0},{"homeWinPercentage":0.6674,"playId":"4018730761607","tiePercentage":0},{"homeWinPercentage":0.6678,"playId":"4018730761620","tiePercentage":0},{"homeWinPercentage":0.6797,"playId":"4018730761632","tiePercentage":0},{"homeWinPercentage":0.6957,"playId":"4018730761662","tiePercentage":0},{"homeWinPercentage":0.7411,"playId":"4018730761687","tiePercentage":0},{"homeWinPercentage":0.7387,"playId":"4018730761710","tiePercentage":0},{"homeWinPercentage":0.7387,"playId":"4018730761720","tiePercentage":0},{"homeWinPercentage":0.7479,"playId":"4018730761730","tiePercentage":0},{"homeWinPercentage":0.7195,"playId":"4018730761760","tiePercentage":0},{"homeWinPercentage":0.7269,"playId":"4018730761771","tiePercentage":0},{"homeWinPercentage":0.7374,"playId":"4018730761782","tiePercentage":0}],"gameInfo":{"venue":{"id":"3806","guid":"a1e68291-b8a7-3428-9754-7bfc568e5d71","fullName":"Lincoln Financial Field","address":{"city":"Philadelphia","state":"PA","zipCode":"19148","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3806.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3806.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":69879,"officials":[{"fullName":"Brad Freeman","displayName":"Brad Freeman","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Mark Pellis","displayName":"Mark Pellis","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":2},{"fullName":"Jabir Walker","displayName":"Jabir Walker","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Land Clark","displayName":"Land Clark","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":4},{"fullName":"Dave Hawkshaw","displayName":"Dave Hawkshaw","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":5},{"fullName":"Dale Keller","displayName":"Dale Keller","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Stephen Ray","displayName":"Stephen Ray","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":7}]},"article":{"headline":"Eagles snap 7-game losing streak and keep Steelers winless in Philly since 1965 with 19-16 victory","description":"— Joe Milton made a perfect throw to DeVonta Smith and the wide receiver rolled out of bounds to get the first down that closed out the Philadelphia Eagles' first win since September.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nfl/player/_/id/4360698/joe-milton\">Joe Milton</a> made a perfect throw to <a href=\"http://www.espn.com/nfl/player/_/id/4241478/devonta-smith\">DeVonta Smith</a> and the wide receiver rolled out of bounds to get the first down that closed out the <a href=\"http://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles\">Philadelphia Eagles</a>' first win since September.\n\n\r\n              The catch ignited a sideline celebration of hugs and helmet slaps that was long overdue for a team accustomed to championship expectations that instead was mired in the franchise's worst losing streak in 14 years.\n\n\r\n              “We got a win,” defensive tackle <a href=\"http://www.espn.com/nfl/player/_/id/4362116/moro-ojomo\">Moro Ojomo</a> said, “which felt like the Super Bowl.”\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3929630/saquon-barkley\">Saquon Barkley</a> ran 38 yards for a first-quarter touchdown to provide a rare offensive spark, and the Eagles snapped a seven-game skid with a 19-16 win over an ineffective <a href=\"http://www.espn.com/nfl/player/_/id/8439/aaron-rodgers\">Aaron Rodgers</a> and the <a href=\"http://www.espn.com/nfl/team/_/name/pit/pittsburgh-steelers\">Pittsburgh Steelers</a> on Sunday.\n\n\r\n              “It definitely feels better winning football games,” Barkley said. “Not to look too far ahead, but sometimes it only takes one.”\n\n\r\n              Pittsburgh’s losing streak in Philly spans 12 games over six decades, three stadiums, five Steelers coaches — including Chuck Noll, Bill Cowher, Mike Tomlin and now Mike McCarthy — and now against a last-place Eagles team using its third starting quarterback of the season.\n\n\r\n              The Steelers’ <a href=\"https://apnews.com/article/steelers-eagles-preview-2d62a24b8580088bd8043b552c4eb515\">last win in Philadelphia</a> came on Oct. 24, 1965.\n\n\r\n              “We expected to win this game, especially given some of the challenges and changes that our opponent was going through,” McCarthy said.\n\n\r\n              Rodgers, who turns 43 on Dec. 2, looked every bit the aging quarterback against a mostly dominant Eagles defense. He lived on screens and shorter passes to complete 17 of 20 attempts in the first half for the Steelers (6-4), but for just 95 yards. He averaged 0.5 <a href=\"https://x.com/ESPNInsights/status/2124588159421886897?a=NI3a--uD4TdmSJj8AGuk&s=20\">air yards per attempt</a> in the first half.\n\n\r\n              The Eagles had five sacks.\n\n\r\n              “I just think for us as an offense,” McCarthy said, “we need to take a step back and look at some things.”\n\n\r\n              Rodgers threw for 227 yards and had a late 20-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4694237/max-hurleman\">Max Hurleman</a> with 1:21 left to make it 19-16.\n\n\r\n              The Eagles (3-7) ended their longest skid since they lost eight straight in 2012.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3050478/jake-elliott\">Jake Elliott</a> kicked four field goals. He converted from of 41 and 29 yards in the first half and his 53- and 55-yarders in the second half pushed the lead to 19-9.\n\n\r\n              Milton made his second straight start after <a href=\"http://www.espn.com/nfl/player/_/id/4685201/tanner-mckee\">Tanner McKee</a> was benched and <a href=\"http://www.espn.com/nfl/player/_/id/4040715/jalen-hurts\">Jalen Hurts</a> was sidelined with blood clots. He completed 11 of 21 passes for 141 yards without a touchdown or an interception.\n\n\r\n              His completion on third-and-6 to Smith for 7 yards with 1:09 left wiped out any shot of a last-gasp Steelers comeback.\n\n\r\n              Milton’s most curious play came when he simply stared at the ball after he lost a fumble instead of trying to pounce on it.\n\n\r\n              It was that kind of game.\n\n\r\n              Barkley, who has endured an injury-plagued season, broke loose in the first quarter to give the Eagles a 13-0 lead. He has a rushing touchdown in four straight games for the first time in his career, and it marked the first time in 33 games the Eagles scored three times in the first quarter.\n\n\r\n              “It's like I'm contagious to get back into the end zone,” Barkley said.\n\n\r\n              The Eagles returned from a bye without any major changes — other than trading defensive tackle <a href=\"https://apnews.com/article/jaguars-jordan-davis-8468d652cfc66b39a02bf1a084a5fd0b\"><a href=\"http://www.espn.com/nfl/player/_/id/4381558/jordan-davis\">Jordan Davis</a></a> to Jacksonville — and the offense under embattled coordinator <a href=\"http://www.espn.com/nfl/player/_/id/2517017/sean-mannion\">Sean Mannion</a> showed little creativity or innovation.\n\n\r\n              Without Davis on the pass rush, the Eagles held the Steelers to 73 yards rushing.\n\n\r\n              The win was enough to at least cool the hot seat under coach Nick Sirianni. Well, for one day.\n\n\r\n              “Man, we missed this,” Sirianni said.\n\n\r\n              The Steelers were still reeling from a <a href=\"https://apnews.com/article/steelers-bengals-score-d82e6f3afe41f6ffab821ba69237cbd9\">38-18 beatdown</a> at the hands of <a href=\"http://www.espn.com/nfl/player/_/id/3915511/joe-burrow\">Joe Burrow</a>, Ja’Marr Chase and the <a href=\"https://apnews.com/hub/cincinnati-bengals\"><a href=\"http://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals\">Cincinnati Bengals</a></a>, and McCarthy now has to figure out how much more they can squeeze out of Rodgers down the stretch to try and make the playoffs.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/17372/chris-boswell\">Chris Boswell</a> kicked field goals of 25, 40 and 52 yards for the Steelers.\n\n\r\n              “Doesn’t matter who you’re playing, scoring three is not usually a winning formula,” Rodgers said.\n\n\r\n              The Steelers caught a break when Eagles returner <a href=\"http://www.espn.com/nfl/player/_/id/4685279/jaydon-blue\">Jaydon Blue</a> fumbled the opening kickoff in the second half. <a href=\"http://www.espn.com/nfl/player/_/id/4429490/carson-bruener\">Carson Bruener</a> recovered and brought the ball to the Eagles 24-yard line. Rodgers threw two incomplete passes and the Steelers settled for the field goal.\n\n\r\n              <hl2>Metcalf tossed</hl2>\r\n              Steelers wide receiver <a href=\"https://apnews.com/article/steelers-metcalf-ejected-3a3006437f54f93672523472745414b0\"><a href=\"http://www.espn.com/nfl/player/_/id/4047650/dk-metcalf\">DK Metcalf</a> was ejected</a> for unsportsmanlike conduct in the third quarter.\n\n\r\n              Metcalf was twice involved in fights against the Eagles.\n\n\r\n              He was flagged for unnecessary roughness earlier in the game after he went after cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4682618/cooper-dejean\">Cooper DeJean</a>. Metcalf appeared to poke DeJean in the eye in the second scuffle, leading to his ejection.\n\n\r\n              Metcalf finished with one catch for 2 yards. He was ejected for the third time in his career.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Steelers: LB <a href=\"http://www.espn.com/nfl/player/_/id/4037333/alex-highsmith\">Alex Highsmith</a> was ruled out in the second half with an ankle injury.\n\n\r\n              Eagles: CB <a href=\"http://www.espn.com/nfl/player/_/id/4686273/quinyon-mitchell\">Quinyon Mitchell</a> suffered a hamstring injury.\n\n\r\n              <hl2>Up next</hl2>\r\n              Steelers: Host Denver on Friday.\n\n\r\n              Eagles: At Dallas on Thanksgiving Day.\n\n\r\n              ------\n\n\r\n              This story has been corrected to show that Chris Boswell kicked field goals of 40 and 52 yards, not 50 and 42 yards, for the Steelers.\n\n\r\n              ------ \n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-22T21:29:32Z"}}