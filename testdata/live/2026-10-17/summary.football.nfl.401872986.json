{"header":{"id":"401872986","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401872986","uid":"s:20~l:28~e:401872986~c:401872986","date":"2026-10-11T17:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"17","uid":"s:20~l:28~t:17","order":0,"homeAway":"home","winner":true,"score":"45","possession":false,"linescores":[{"displayValue":"14"},{"displayValue":"7"},{"displayValue":"14"},{"displayValue":"10"}],"team":{"id":"17","abbreviation":"NE","displayName":"New England Patriots","name":"Patriots","location":"New England","nickname":"Patriots","color":"002a5c","alternateColor":"c60c30","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ne.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/ne.png"}]}},{"id":"13","uid":"s:20~l:28~t:13","order":1,"homeAway":"away","winner":false,"score":"17","possession":false,"linescores":[{"displayValue":"7"},{"displayValue":"0"},{"displayValue":"3"},{"displayValue":"7"}],"team":{"id":"13","abbreviation":"LV","displayName":"Las Vegas Raiders","name":"Raiders","location":"Las Vegas","nickname":"Raiders","color":"000000","alternateColor":"a5acaf","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/lv.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/lv.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"13","abbreviation":"LV","displayName":"Las Vegas Raiders","shortDisplayName":"Raiders","name":"Raiders","location":"Las Vegas","color":"000000","alternateColor":"a5acaf","logo":"https://a.espncdn.com/i/teamlogo