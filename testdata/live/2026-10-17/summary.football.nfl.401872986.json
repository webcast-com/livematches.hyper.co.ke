48","tiePercentage":0},{"homeWinPercentage":0.7835,"playId":"4018729861460","tiePercentage":0},{"homeWinPercentage":0.7836,"playId":"4018729861501","tiePercentage":0},{"homeWinPercentage":0.7837,"playId":"4018729861511","tiePercentage":0},{"homeWinPercentage":0.7734,"playId":"4018729861521","tiePercentage":0},{"homeWinPercentage":0.7806,"playId":"4018729861558","tiePercentage":0},{"homeWinPercentage":0.7838,"playId":"4018729861593","tiePercentage":0},{"homeWinPercentage":0.7497,"playId":"4018729861615","tiePercentage":0},{"homeWinPercentage":0.7736,"playId":"4018729861645","tiePercentage":0},{"homeWinPercentage":0.7718,"playId":"4018729861662","tiePercentage":0},{"homeWinPercentage":0.7399,"playId":"4018729861679","tiePercentage":0},{"homeWinPercentage":0.7527,"playId":"4018729861716","tiePercentage":0},{"homeWinPercentage":0.7198,"playId":"4018729861738","tiePercentage":0},{"homeWinPercentage":0.7364,"playId":"4018729861763","tiePercentage":0},{"homeWinPercentage":0.7511,"playId":"4018729861786","tiePercentage":0},{"homeWinPercentage":0.7851,"playId":"4018729861808","tiePercentage":0},{"homeWinPercentage":0.7946,"playId":"4018729861828","tiePercentage":0},{"homeWinPercentage":0.7947,"playId":"4018729861837","tiePercentage":0},{"homeWinPercentage":0.8084,"playId":"4018729861846","tiePercentage":0},{"homeWinPercentage":0.7263,"playId":"4018729861883","tiePercentage":0},{"homeWinPercentage":0.6973,"playId":"4018729861932","tiePercentage":0},{"homeWinPercentage":0.7064,"playId":"4018729861957","tiePercentage":0},{"homeWinPercentage":0.7753,"playId":"4018729861979","tiePercentage":0},{"homeWinPercentage":0.7501,"playId":"4018729862001","tiePercentage":0},{"homeWinPercentage":0.7512,"playId":"4018729862014","tiePercentage":0}],"gameInfo":{"venue":{"id":"3738","guid":"ed71e174-10c3-3e30-bc8d-4134bb06188e","fullName":"Gillette Stadium","address":{"city":"Foxborough","state":"MA","zipCode":"02035","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3738.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3738.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":64628,"officials":[{"fullName":"Max Causey","displayName":"Max Causey","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":2},{"fullName":"Frank Steratore","displayName":"Frank Steratore","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":1},{"fullName":"Ian Malepeai","displayName":"Ian Malepeai","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":3},{"fullName":"Craig Wrolstad","displayName":"Craig Wrolstad","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":4},{"fullName":"Rich Martinez","displayName":"Rich Martinez","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":5},{"fullName":"Jeff Shears","displayName":"Jeff Shears","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":6},{"fullName":"John Braun","displayName":"John Braun","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Drake Maye accounts for 5 TDs as Patriots roll past Raiders 45-17","description":"— Drake Maye didn't have his top receiver, and the New England Patriots were missing both of their starting cornerbacks.","story":"FOXBOROUGH, Mass. -- — <a href=\"http://www.espn.com/nfl/player/_/id/4431452/drake-maye\">Drake Maye</a> didn't have his top receiver, and the <a href=\"http://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a> were missing both of their starting cornerbacks.\n\n\r\n              The third-year quarterback found plenty of other targets, and his defense still found a way to slow down <a href=\"http://www.espn.com/nfl/player/_/id/14880/kirk-cousins\">Kirk Cousins</a> and the <a href=\"http://www.espn.com/nfl/team/_/name/lv/las-vegas-raiders\">Las Vegas Raiders</a>.\n\n\r\n              Maye threw four <a href=\"https://x.com/Patriots/status/2109355256526098731?s=20\">touchdown passes</a> and <a href=\"https://x.com/Patriots/status/2109363444176613855?s=20\">ran for another score</a>, helping the Patriots pull away in the second half of a 45-17 victory on Sunday.\n\n\r\n              Maye was 26 of 34 for 374 yards passing in the second 300-yard game of his career. Two TDs went to Pop Douglas and one each to <a href=\"http://www.espn.com/nfl/player/_/id/3046439/hunter-henry\">Hunter Henry</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4252364/kyle-williams\">Kyle Williams</a>.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4569173/rhamondre-stevenson\">Rhamondre Stevenson</a> added a scoring run in a second consecutive victory that answered a sluggish start for the defending AFC champions.\n\n\r\n              With receiver <a href=\"http://www.espn.com/nfl/player/_/id/2991662/mack-hollins\">Mack Hollins</a> missing the first of at least four games with a calf injury, Maye had five players catch at least three passes, including Stevenson. Two pass-catchers who didn't score — <a href=\"http://www.espn.com/nfl/player/_/id/4695193/efton-chism\">Efton Chism III</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4831959/eli-raridon\">Eli Raridon</a> — each had five catches, the team high, for 57 yards. \n\n\r\n              “It was beautiful to be a part of today,\" Maye said. \"There’s still some out there.” \n\n\r\n              On a day the Patriots celebrated the 25th anniversary of the first of their six first Super Bowl championships, Maye became the first with back-to-back games of at least three TDs passing for New England since Tom Brady in 2018. It was also Maye’s first game this season without a turnover. He scored on a 3-yard run.\n\n\r\n              The Patriots (3-2) finished with season-high 536 yards, and the defense forced while holding Las Vegas under 26 points for the first time this season without injured cornerbacks <a href=\"http://www.espn.com/nfl/player/_/id/4686772/christian-gonzalez\">Christian Gonzalez</a> and <a href=\"http://www.espn.com/nfl/player/_/id/3916923/carlton-davis\">Carlton Davis III</a>.\n\n\r\n              “That’s what it has to be,\" coach Mike Vrabel said. \"They realize when you get an opportunity, you do something with it.”\n\n\r\n              Cousins was 19 of 28 for 243 yards with a touchdown to <a href=\"http://www.espn.com/nfl/player/_/id/4432665/brock-bowers\">Brock Bowers</a> that pulled the Raiders (3-2) even early, but they were trailing by 28 points when they finally found the end zone again in the fourth quarter.\n\n\r\n              Cousins had limited time to operate throughout the game and was sacked three times. \n\n\r\n              \"They did a nice job with their pressures, getting home quickly. Made it hard for us,\" Cousins said.\n\n\r\n              Raiders coach <a href=\"http://www.espn.com/nfl/player/_/id/2181979/klint-kubiak\">Klint Kubiak</a> said it's clear there is work to do after back-to-back losses.\n\n\r\n              “We’re not happy with what happened today, and we’ve got to go do something about it,” Kubiak said.\n\n\r\n              No. 1 overall draft pick <a href=\"http://www.espn.com/nfl/player/_/id/4837248/fernando-mendoza\">Fernando Mendoza</a> replaced Cousins with the game out of reach later in the fourth. Kubiak said Mendoza's appearance doesn't change the QB depth chart for now. \n\n\r\n              \"Just wanted to get (Mendoza) some exposure,\" Kubiak said.\n\n\r\n              <hl2>Scoring quickly</hl2>\r\n              Four of the Patriots seven scoring drives lasted less than three minutes. New England scored touchdowns on four of five trips inside the 20-yard line.\n\n\r\n              <hl2>Fast start for Patriots</hl2>\r\n              It didn’t take long for New England’s offense to get going.\n\n\r\n              After a quick three-and-out by the Raiders to open the game, New England needed just five plays to cap a 79-yard drive with a 35-yard TD pass from Maye to a wide-open Douglas.\n\n\r\n              The drive included a 16-yard pass to <a href=\"http://www.espn.com/nfl/player/_/id/4361432/romeo-doubs\">Romeo Doubs</a> to get the Patriots into Las Vegas territory.\n\n\r\n              The Raiders responded on the next series. First, Cousins connected on long completions to Bowers and Coby White. He then capitalized on a pass interference call on <a href=\"http://www.espn.com/nfl/player/_/id/2574056/kevin-byard\">Kevin Byard</a> that set up a 13-yard scoring pass to Bowers, who had eight catches for 110 yards.\n\n\r\n              New England kept its momentum going after Bowers' TD, scoring on a 5-yard run by Stevenson.\n\n\r\n              Las Vegas had a chance before halftime after <a href=\"http://www.espn.com/nfl/player/_/id/4431431/corey-kiner\">Corey Kiner</a> fumbled at the New England 37. But Matt Gay’s 49-yard field goal try hit the left upright, and the Patriots took a 14-point halftime lead on Maye's 11-yard pass to Henry 24 seconds before the break.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Raiders: DT <a href=\"http://www.espn.com/nfl/player/_/id/4429109/tonka-hemingway\">Tonka Hemingway</a> left in the first quarter with a neck injury and was ruled out. ... DE <a href=\"http://www.espn.com/nfl/player/_/id/4243916/patrick-johnson\">Patrick Johnson</a> (neck) left in the second quarter.\n\n\r\n              Patriots: RB <a href=\"http://www.espn.com/nfl/player/_/id/4432710/treveyon-henderson\">TreVeyon Henderson</a> limped to the locker room in the second quarter with an ankle injury. Two plays later, LT <a href=\"http://www.espn.com/nfl/player/_/id/4685298/will-campbell\">Will Campbell</a> was helped off with a right knee injury. Neither returned. ... CB <a href=\"http://www.espn.com/nfl/player/_/id/4368113/charles-woods\">Charles Woods</a> exited in the third quarter with a shoulder injury. \n\n\r\n              <hl2>Up next</hl2>\r\n              Raiders: Host the Bills next Sunday.\n\n\r\n              Patriots: Host the Jets next Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-11T20:30:27Z"}}