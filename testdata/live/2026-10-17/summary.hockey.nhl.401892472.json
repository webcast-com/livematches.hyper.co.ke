:{"id":"3114770","displayName":"Nick Schmaltz","shortName":"N. Schmaltz"}}]},{"id":"401892472000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Guenther Slap Shot saved by Colten Ellis","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"4874723","displayName":"Dylan Guenther","shortName":"D. Guenther"},"type":"shooter"},{"athlete":{"id":"4736758","displayName":"Colten Ellis","shortName":"C. Ellis"},"type":"saver"}]},{"id":"401892472000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:03"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892472000000780","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Logan Cooley faceoff won against Justin Danforth","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"5080143","displayName":"Logan Cooley","shortName":"L. Cooley"},"type":"face-off-winner"},{"athlete":{"id":"4894355","displayName":"Justin Danforth","shortName":"J. Danforth"}}]},{"id":"401892472000000810","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mikhail Sergachev shot blocked by Zach Metsa","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:18"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4024868","displayName":"Mikhail Sergachev","shortName":"M. Sergachev"},"type":"shooter"},{"athlete":{"id":"4419696","displayName":"Zach Metsa","shortName":"Z. Metsa"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1848","fullName":"KeyBank Center","address":{"city":"Buffalo","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1848.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19070,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Morgan MacPhee","displayName":"Morgan MacPhee","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Mammoth bounce back to beat the Sabres 4-1 to close trip","description":"— John Marino, Anders Lee and Kailer Yamamoto each had a goal and an assist to help the Utah Mammoth beat the Buffalo Sabres 4-1 on Saturday night.","story":"BUFFALO, N.Y. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3941974/john-marino\">John Marino</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5793/anders-lee\">Anders Lee</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233648/kailer-yamamoto\">Kailer Yamamoto</a> each had a goal and an assist to help the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 4-1 on Saturday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114770/nick-schmaltz\">Nick Schmaltz</a> also scored, and <a href=\"http://www.espn.com/nhl/player/_/id/4352699/barrett-hayton\">Barrett Hayton</a> had two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3942065/karel-vejmelka\">Karel Vejmelka</a> made 23 saves as the Mammoth bounced back from a 6-1 loss in Boston on Thursday night to win for the third time on a five-game trip.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> had a goal for the Sabres in their second straight loss at home. <a href=\"http://www.espn.com/nhl/player/_/id/4736758/colten-ellis\">Colten Ellis</a> stopped 26 shots.\n\n\r\n              Schmaltz and Lee scored 2:01 apart late in the second period to give the Mammoth a two-goal lead.\n\n\r\n              Thompson’s goal at 8:00 into the game was Buffalo’s first on the power play this season.\n\n\r\n              Yamamoto, making his season debut, tied it just past the midway point of the first period. Yamamoto entered the lineup in place of forward <a href=\"http://www.espn.com/nhl/player/_/id/4031645/michael-carcone\">Michael Carcone</a>, who is listed as week to week with an upper-body injury.\n\n\r\n              Schmaltz got his sixth goal in six games this season, and his fourth on the power play, when Cooley set him up at the left edge of the crease.\n\n\r\n              Marino’s goal at 1:45 into the third period also came on a power play.\n\n\r\n              Utah leads the NHL with 10 goals in 25 chances this season with the man-advantage. Buffalo ranks near the bottom in converting 1 of 18.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: Host Toronto on Tuesday night.\n\n\r\n              Sabres: Host Florida on Monday to conclude a five-game homestand.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://nam12.safelinks.protection.outlook.com/?url=https%3A%2F%2Fapnews.com%2Fhub%2Fnhl&data=05%7C02%7Csportsdesk%40ap.org%7Cf45c9cef928040c8edbd08df27394b81%7Ce442e1abfd6b4ba3abf3b020eb50df37%7C1%7C0%7C639272799179976392%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=HSZKu1AM1iKhVQQEyum7sOYwyQ%2FzTtKobU9gXsEeXvg%3D&reserved=0\">See AP’s full NHL coverage here</a>","published":"2026-10-11T01:51:27Z"}}