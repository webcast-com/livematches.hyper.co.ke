Name":"Jakob Chychrun","shortName":"J. Chychrun"},"type":"hitted"}]},{"id":"401892729000000860","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Matt Roy shot blocked by Anthony Cirelli","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3942924","displayName":"Matt Roy","shortName":"M. Roy"},"type":"shooter"},{"athlete":{"id":"3941973","displayName":"Anthony Cirelli","shortName":"A. Cirelli"},"type":"defender"}]},{"id":"401892729000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Aliaksei Protas Wrist Shot saved by Andrei Vasilevskiy","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:47"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"4587943","displayName":"Aliaksei Protas","shortName":"A. Protas"},"type":"shooter"},{"athlete":{"id":"2976847","displayName":"Andrei Vasilevskiy","shortName":"A. Vasilevskiy"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1396","guid":"713cae18-f94f-330c-ab1a-eb284df12c97","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Andrew Smith","displayName":"Andrew Smith","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Jake Guentzel scores 2 goals as Lightning beat Capitals 5-2 in Kucherov's 900th game","description":"— Jake Guentzel scored twice, Nikita Kucherov had two assists in his 900th career game, and John Carlson had three assists against his former team as the Tampa Bay Lightning beat the Washington Capitals 5-2 on Tuesday.","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> scored twice, <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had two assists in his 900th career game, and <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a> had three assists against his former team as the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> 5-2 on Tuesday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> finished with 27 saves for Tampa Bay, which improved to 9-1 at home on the season.\n\n\r\n              Rookie <a href=\"http://www.espn.com/nhl/player/_/id/5216901/sam-o'reilly\">Sam O'Reilly</a> scored his first career NHL goal. <a href=\"http://www.espn.com/nhl/player/_/id/4588175/charle-edouard-d'astous\">Charle-Edouard D'Astous</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> also scored for the Lightning.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149172/ryan-leonard\">Ryan Leonard</a> scored for Washington, which fell to 2-5 in the past seven games. <a href=\"http://www.espn.com/nhl/player/_/id/4272888/logan-thompson\">Logan Thompson</a> finished with 21 saves.\n\n\r\n              Tampa Bay scored three goals on the first four shots of the game.\n\n\r\n              O'Reilly came off the bench to take a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4588188/jeffrey-viel\">Jeffrey Viel</a> for a wrist shot to the top right post at 2:11 for his first goal in his fourth career game. \n\n\r\n              D'Astous scored from the slot at 10:36 while Guentzel scored his first of the game off a rebound of a Kucherov shot at 13:11.\n\n\r\n              Tuch cut the lead to 3-1 with his 12th of the season at 16:12.\n\n\r\n              Guentzel regained the three-goal lead for Tampa Bay at 11:34 of the second period, tipping a Carlson pass.\n\n\r\n              Cirelli added an empty net goal with 2:41 left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3151187/brayden-point\">Brayden Point</a> returned from injured reserve after three games and Cirelli and <a href=\"http://www.espn.com/nhl/player/_/id/3904178/erik-cernak\">Erik Cernak</a> both returned after two-game absences, but the Lightning were already without <a href=\"http://www.espn.com/nhl/player/_/id/5080155/conor-geekie\">Conor Geekie</a> and leading goal-scorer <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> for the game before center <a href=\"http://www.espn.com/nhl/player/_/id/2968829/zemgus-girgensons\">Zemgus Girgensons</a> left the game following a hit by <a href=\"http://www.espn.com/nhl/player/_/id/3942924/matt-roy\">Matt Roy</a> in the first period.\n\n\r\n              <hl2>Up next</hl2>\r\n              Capitals: host Philadelphia on Thursday\n\n\r\n              Lightning: host Edmonton on Thursday\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-18T15:13:13Z"}}