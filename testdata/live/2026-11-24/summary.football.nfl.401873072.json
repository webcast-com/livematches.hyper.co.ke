ntage":0},{"homeWinPercentage":0.7964,"playId":"4018730721558","tiePercentage":0},{"homeWinPercentage":0.7785,"playId":"4018730721570","tiePercentage":0},{"homeWinPercentage":0.8314,"playId":"4018730721600","tiePercentage":0},{"homeWinPercentage":0.8314,"playId":"4018730721610","tiePercentage":0},{"homeWinPercentage":0.8174,"playId":"4018730721620","tiePercentage":0},{"homeWinPercentage":0.8273,"playId":"4018730721644","tiePercentage":0},{"homeWinPercentage":0.8364,"playId":"4018730721669","tiePercentage":0},{"homeWinPercentage":0.7993,"playId":"4018730721692","tiePercentage":0},{"homeWinPercentage":0.8008,"playId":"4018730721703","tiePercentage":0},{"homeWinPercentage":0.7846,"playId":"4018730721714","tiePercentage":0},{"homeWinPercentage":0.8177,"playId":"4018730721746","tiePercentage":0},{"homeWinPercentage":0.83,"playId":"4018730721769","tiePercentage":0},{"homeWinPercentage":0.8321,"playId":"4018730721781","tiePercentage":0},{"homeWinPercentage":0.7857,"playId":"4018730721792","tiePercentage":0},{"homeWinPercentage":0.7897,"playId":"4018730721829","tiePercentage":0}],"gameInfo":{"venue":{"id":"3727","guid":"3a82e243-5f64-3ce4-bdaf-49367fb55391","fullName":"Ford Field","address":{"city":"Detroit","state":"MI","zipCode":"48226","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3727.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3727.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":64024,"officials":[{"fullName":"Trawick Boger","displayName":"Trawick Boger","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":2},{"fullName":"Adrian Hill","displayName":"Adrian Hill","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":1},{"fullName":"Greg Steed","displayName":"Greg Steed","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":3},{"fullName":"Roy Ellison","displayName":"Roy Ellison","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":4},{"fullName":"Julian Mapp","displayName":"Julian Mapp","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":5},{"fullName":"Danny Short","displayName":"Danny Short","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Glen Fucik","displayName":"Glen Fucik","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":7}]},"article":{"headline":"Jared Goff throws 2 TDs, Jahmyr Gibbs runs for 2 more and Lions beat Bucs 31-21 for 6th straight win","description":"— The Detroit Lions are finding their groove, leaning on a balanced attack offensively and a steadily improving defense that hasn't been hurt by the losses of ","story":"DETROIT -- — The <a href=\"https://apnews.com/hub/detroit-lions\"><a href=\"http://www.espn.com/nfl/team/_/name/det/detroit-lions\">Detroit Lions</a></a> are finding their groove, leaning on a balanced attack offensively and a steadily improving defense that hasn't been hurt by the losses of <a href=\"https://apnews.com/article/lions-aidan-hutchinson-dan-campbell-a1b1aa94701a3cf3cbe8933369caef0f\"><a href=\"http://www.espn.com/nfl/player/_/id/4372099/aidan-hutchinson\">Aidan Hutchinson</a></a> and <a href=\"https://apnews.com/article/lions-jack-campbell-injury-0fed0e3af367ce0c89e5d00a262fda9e\"><a href=\"http://www.espn.com/nfl/player/_/id/4569465/jack-campbell\">Jack Campbell</a></a>.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3046779/jared-goff\">Jared Goff</a> threw two touchdown passes through three quarters and <a href=\"http://www.espn.com/nfl/player/_/id/4429795/jahmyr-gibbs\">Jahmyr Gibbs</a> ran for two scores in the fourth, helping Detroit pull away and beat the <a href=\"https://apnews.com/hub/tampa-bay-buccaneers\"><a href=\"http://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers\">Tampa Bay Buccaneers</a></a> 31-21 on Sunday.\n\n\r\n              “We’re continuing to climb and it’s the right time,” coach Dan Campbell said.\n\n\r\n              The Lions (8-2) have won six straight, setting up a pivotal NFC North game against the <a href=\"http://www.espn.com/nfl/team/_/name/chi/chicago-bears\">Chicago Bears</a> (8-2) in a matchup of first-place teams on Thanksgiving to kick off the NFL's tripleheader on the holiday.\n\n\r\n              “We’re the first show and it’s exciting,” Campbell said. “It’s one of the reasons you do it — and love it.”\n\n\r\n              Tampa Bay (3-7) has dropped two straight to fall to four games under .500, but that doesn't doom its chances to win the NFC South.\n\n\r\n              “We’re past the mulligan stage of the season, so we can’t keep shooting ourselves in the foot,” coach Todd Bowles said. \n\n\r\n              Detroit's defense sealed the win by sacking <a href=\"http://www.espn.com/nfl/player/_/id/3052587/baker-mayfield\">Baker Mayfield</a> on two straight snaps and forcing the Bucs to turn it over on downs at their 34 with 3:16 remaining.\n\n\r\n              The Lions have held four straight teams to 275 or fewer total yards for the first time since 1976.\n\n\r\n              “That's been the biggest growth for us,” Campbell said. “The improvement we’ve had in that group even after losing guys, that’s the sign of a championship team.”\n\n\r\n              Goff was 20 of 28 for 279 yards, throwing a 14-yard pass in the end zone to Amon-Ra St. Brown in the first quarter and a 57-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4426388/jameson-williams\">Jameson Williams</a> in the third quarter. A week after Hutchinson had a season-ending knee injury, celebrating a sack, Williams flipped into the end zone on his score.\n\n\r\n              Detroit's veteran quarterback, who isn't known for his mobility, was nimble enough on his feet to have a season-high, 10-yard scramble to convert a third down for one of his three runs that picked up first downs and did two spin moves in the pocket to avoid a sack before completing a pass.\n\n\r\n              Gibbs ran for 98 yards against a team that was giving up an NFL-low 79 yards rushing per game and turned a three-point lead into a 17-point cushion with short touchdown runs in the final quarter.\n\n\r\n              The Bucs were averaging a league-high 163.9 yards rushing, but were held to 120 yards on the ground. <a href=\"http://www.espn.com/nfl/player/_/id/4596448/bucky-irving\">Bucky Irving</a> ran for just 68 yards on 18 carries and his 1-yard touchdown run late in the third made it 17-14 in a game Tampa Bay never led.\n\n\r\n              “They did a better job with what they do best than we did with what we do best,\" Bowles said.\n\n\r\n              Mayfield, playing with an injured foot and right thumb, was 20 of 33 for 187 yards with a season-high two touchdown passes on 23 and 4 yards to rookie receiver Ted Hurst.\n\n\r\n              “We made some plays, but we didn’t quite make enough,” Mayfield said. “That’s frustrating because we can do all of this in practice, but we haven’t been able to translate that to Sundays yet.”\n\n\r\n              <hl2>NFL history</hl2>\r\n              Lions edge rusher <a href=\"https://apnews.com/article/nfl-draft-lions-egypt-hassanein-ef9961e554b56e9aa9bd517a184e06f5\"><a href=\"http://www.espn.com/nfl/player/_/id/4710422/ahmed-hassanein\">Ahmed Hassanein</a></a> became the first Egyptian to play in an NFL game, making his debut in the league after Detroit drafted the former Boise State star in the sixth round in 2025.\n\n\r\n              <hl2>Familiar foes</hl2>\r\n              For the pregame coin toss, Tampa Bay sent <a href=\"https://x.com/BradGalli/status/2124564866639769672\">five former Lions</a> to midfield: <a href=\"https://apnews.com/article/gainwell-anzalone-otton-18183c875782a72b7734bd714c7c6830\"><a href=\"http://www.espn.com/nfl/player/_/id/3043107/alex-anzalone\">Alex Anzalone</a></a>, <a href=\"http://www.espn.com/nfl/player/_/id/3051942/al-quadin-muhammad\">Al-Quadin Muhammad</a>, A’Shawn Robinson, <a href=\"http://www.espn.com/nfl/player/_/id/2575164/miles-killebrew\">Miles Killebrew</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4240401/ifeatu-melifonwu\">Ifeatu Melifonwu</a>.\n\n\r\n              Each time Anzalone made a tackle, the crowd booed even though the veteran linebacker wanted to return for a sixth season in Detroit before he signed a $17 million, two-year deal with the Bucs in March.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Bucs: S <a href=\"http://www.espn.com/nfl/player/_/id/4034790/antoine-winfield-jr\">Antoine Winfield Jr</a>. (ankle) was inactive. CBs <a href=\"http://www.espn.com/nfl/player/_/id/4912847/jacob-parrish\">Jacob Parrish</a> (back) and <a href=\"http://www.espn.com/nfl/player/_/id/4816107/benjamin-morrison\">Benjamin Morrison</a> (hamstring) and DL <a href=\"http://www.espn.com/nfl/player/_/id/4430478/elijah-simmons\">Elijah Simmons</a> (concussion) were injured during the game.\n\n\r\n              Lions: CBs <a href=\"http://www.espn.com/nfl/player/_/id/3139387/dj-reed\">D.J. Reed</a> (hip) and Ennis Rakestraw (shoulder) were inactive.\n\n\r\n              <hl2>Up next</hl2>\r\n              Bucs: Host Carolina on Nov. 30.\n\n\r\n              Lions: Host the Bears on Thanksgiving.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-22T21:31:32Z"}}