e":0,"homeScore":0,"text":"Stephen Halliday faceoff won against Adam Lowry","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"5136706","displayName":"Stephen Halliday","shortName":"S. Halliday"},"type":"face-off-winner"},{"athlete":{"id":"2563066","displayName":"Adam Lowry","shortName":"A. Lowry"}}]},{"id":"401892736000000810","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Samuel Blais shot blocked by Tyler Boucher","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:06"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"3149697","displayName":"Sammy Blais","shortName":"S. Blais"},"type":"shooter"},{"athlete":{"id":"4874724","displayName":"Tyler Boucher","shortName":"T. Boucher"},"type":"defender"}]},{"id":"401892736000001040","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Tyrel Bauer hit Tim Stützle","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"28"},"participants":[{"athlete":{"id":"4697648","displayName":"Tyrel Bauer","shortName":"T. Bauer"},"type":"hit-credited"},{"athlete":{"id":"4697384","displayName":"Tim Stutzle","shortName":"T. Stutzle"},"type":"hitted"}]},{"id":"401892736000000940","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Tim Stützle Wrist Shot saved by Stuart Skinner","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"3:17"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4697384","displayName":"Tim Stutzle","shortName":"T. Stutzle"},"type":"shooter"},{"athlete":{"id":"4268767","displayName":"Stuart Skinner","shortName":"S. Skinner"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1397","fullName":"Canada Life Centre","address":{"city":"Winnipeg","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1397.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13516,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Tyler Boucher scores winner in NHL debut as the Senators beat the Jets 2-1","description":"— Tyler Boucher scored the game-winner in his NHL debut to lift the Ottawa Senators to a 2-1 victory over the Winnipeg Jets on Tuesday night.","story":"WINNIPEG, Manitoba -- — <a href=\"http://www.espn.com/nhl/player/_/id/4874724/tyler-boucher\">Tyler Boucher</a> scored the game-winner in his NHL debut to lift the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> to a 2-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> on Tuesday night.\n\n\r\n              Boucher’s second-period goal helped the Senators (14-6-2) extend their point streak to six games (5-0-1) and halted Winnipeg’s six-game win streak.\n\n\r\n              Forward <a href=\"http://www.espn.com/nhl/player/_/id/4271734/drake-batherson\">Drake Batherson</a> scored on the power play for Ottawa. <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> made 20 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5361711/viggo-bjorck\">Viggo Bjorck</a> scored for the Jets in his NHL debut. <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> stopped 25 shots for Winnipeg (10-9-3).\n\n\r\n              After a scoreless first period, Batherson recorded his 11th goal of the season at 3:06 of the second. Boucher’s goal followed 58 seconds later.\n\n\r\n              Boucher scored after a Jets turnover in their own end. <a href=\"http://www.espn.com/nhl/player/_/id/3900219/thomas-chabot\">Thomas Chabot</a> got the puck near the point and sent it to Boucher, who shot it through defenseman Tyrel Bauer’s legs and past Skinner. Boucher’s parents, Brian and Melissa, were in the stands and captured on the scoreboard video cheering for their son. Brian was an NHL goalie, playing 328 regular-season games for seven teams from 1999-2013.\n\n\r\n              Bjorck made it 2-1 at 9:24 of the middle period.\n\n\r\n              The 23-year-old Boucher was selected 10th overall in the 2021 NHL draft, but battled with injuries for a number of seasons. He was recalled from the AHL Belleville Senators on Sunday.\n\n\r\n              Bjorck was Winnipeg’s first-round pick (eighth overall) in this year’s draft.\n\n\r\n              Fans chanted “Viggo, Viggo!” after the 18-year-old Swede scored his first NHL goal in his 22nd game. After a Senators turnover behind their net, Winnipeg captain <a href=\"http://www.espn.com/nhl/player/_/id/2563066/adam-lowry\">Adam Lowry</a> got the puck and sent it out front to Bjorck for a quick shot past Ullmark. \n\n\r\n              Winnipeg's <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> remains one goal away (379) from setting the franchise record for career goals.\n\n\r\n              <hl2>Up next</hl2>\r\n              Senators: Host the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Thursday.\n\n\r\n              Jets: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-18T15:12:57Z"}}