:"T. Harley"},"type":"taker"}]},{"id":"401892458000000930","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Josh Doan hit Thomas Harley","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:30"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4874870","displayName":"Josh Doan","shortName":"J. Doan"},"type":"hit-credited"},{"athlete":{"id":"4565239","displayName":"Thomas Harley","shortName":"T. Harley"},"type":"hitted"}]},{"id":"401892458000000950","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Justin Hryckowian","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"9"},"participants":[{"athlete":{"id":"5229176","displayName":"Justin Hryckowian","shortName":"J. Hryckowian"},"type":"taker"}]}],"gameInfo":{"venue":{"id":"1848","fullName":"KeyBank Center","address":{"city":"Buffalo","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1848.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19070,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Justin Kea","displayName":"Justin Kea","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Jake Oettinger has second straight shutout in the Stars' 4-0 victory over the Sabres","description":"— Jake Oettinger made 26 saves for his second straight shutout, Mikko Rantanen had a goal and three assists and the Dallas Stars beat the Buffalo Sabres 4-0 on Thursday night.","story":"BUFFALO, N.Y. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4196914/jake-oettinger\">Jake Oettinger</a> made 26 saves for his second straight shutout, <a href=\"http://www.espn.com/nhl/player/_/id/3899938/mikko-rantanen\">Mikko Rantanen</a> had a goal and three assists and the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 4-0 on Thursday night.\n\n\r\n              Oettinger has 18 career shutouts. He stopped 13 shots Monday night in a 5-0 home victory over San Jose.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233875/jason-robertson\">Jason Robertson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4024998/sam-steel\">Sam Steel</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3904183/roope-hintz\">Roope Hintz</a> also scored to help Dallas win its second in a row after two opening losses. <a href=\"http://www.espn.com/nhl/player/_/id/4874740/wyatt-johnston\">Wyatt Johnston</a> had three assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> stopped 14 shots for Buffalo. The Sabres had won the first two games of a five-game homestand.\n\n\r\n              Robertson scored at 9:03 of the first period and the Stars added three more in the second. Sam Steel connected on a snap shot at 9:36, Rantanen scored on a backhander with 6:03 left and Roope put in a snapper on a power play with 4:26 remaining.\n\n\r\n              <hl2>Up next</hl2>\r\n              Stars: At Pittsburgh on Saturday night.\n\n\r\n              Sabres: Host Utah on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-09T01:41:27Z"}}