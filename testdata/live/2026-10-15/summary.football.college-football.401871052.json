omeWinPercentage":0.5498,"playId":"401871052247","tiePercentage":0},{"homeWinPercentage":0.5743,"playId":"401871052252","tiePercentage":0},{"homeWinPercentage":0.5903,"playId":"401871052256","tiePercentage":0},{"homeWinPercentage":0.5575,"playId":"401871052260","tiePercentage":0},{"homeWinPercentage":0.5402,"playId":"401871052264","tiePercentage":0},{"homeWinPercentage":0.5663,"playId":"401871052269","tiePercentage":0},{"homeWinPercentage":0.5303,"playId":"401871052274","tiePercentage":0},{"homeWinPercentage":0.5055,"playId":"401871052279","tiePercentage":0},{"homeWinPercentage":0.4863,"playId":"401871052283","tiePercentage":0},{"homeWinPercentage":0.4884,"playId":"401871052287","tiePercentage":0},{"homeWinPercentage":0.499,"playId":"401871052291","tiePercentage":0},{"homeWinPercentage":0.5192,"playId":"401871052294","tiePercentage":0},{"homeWinPercentage":0.4588,"playId":"401871052297","tiePercentage":0},{"homeWinPercentage":0.4683,"playId":"401871052302","tiePercentage":0},{"homeWinPercentage":0.5069,"playId":"401871052305","tiePercentage":0},{"homeWinPercentage":0.5069,"playId":"401871052312","tiePercentage":0},{"homeWinPercentage":0.5216,"playId":"401871052310","tiePercentage":0},{"homeWinPercentage":0.5127,"playId":"401871052316","tiePercentage":0},{"homeWinPercentage":0.5064,"playId":"401871052319","tiePercentage":0},{"homeWinPercentage":0.523,"playId":"401871052322","tiePercentage":0},{"homeWinPercentage":0.5548,"playId":"401871052326","tiePercentage":0},{"homeWinPercentage":0.5517,"playId":"401871052331","tiePercentage":0},{"homeWinPercentage":0.6857,"playId":"401871052335","tiePercentage":0},{"homeWinPercentage":0.6969,"playId":"401871052343","tiePercentage":0}],"gameInfo":{"venue":{"id":"3796","guid":"438f8cb6-06b5-30ee-968d-83e7837b9250","fullName":"Houchens Industries-L.T. Smith Stadium","address":{"city":"Bowling Green","state":"KY","zipCode":"42101","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3796.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":11102},"article":{"headline":"Ajay Allen rushes for 105 yards and 2 touchdowns as Western Kentucky beats Missouri State 34-13","description":"— Brock Glenn threw for a touchdown and ran for another, Ajay Allen rushed for 105 yards and two touchdowns, and Western Kentucky beat Missouri State 34-13 on Thursday night.","story":"BOWLING GREEN, Ky. -- — <a href=\"http://www.espn.com/college-football/player/_/id/4920158/brock-glenn\" target=\"_new\">Brock Glenn</a> threw for a touchdown and ran for another, <a href=\"https://x.com/WKUFootball/status/2108377289134112926\"><a href=\"http://www.espn.com/college-football/player/_/id/4878394/ajay-allen\" target=\"_new\">Ajay Allen</a> rushed for 105 yards and two touchdowns</a>, and Western Kentucky beat Missouri State 34-13 on Thursday night.\n\n\r\n              Glenn was 20 of 35 for 231 yards, and he ran it 15 times for 95 yards. He connected with freshman <a href=\"http://www.espn.com/college-football/player/_/id/5290902/jonathan-stafford-jr\" target=\"_new\">Jonathan Stafford Jr</a>. for a 42-yard touchdown with just under five minutes remaining in the first half and Allen capped an eight-play, 56-yard drive on a 3-yard touchdown run with 38 seconds left for a 21-6 lead at the break.\n\n\r\n              Allen, who only needed 13 carries to get over the century mark, added a 39-yard touchdown on a direct snap to cap the scoring with 5:46 left in the fourth quarter. \n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5394214/karl-campbell\" target=\"_new\">Karl Campbell</a> made field goals of 34 and 43 yards in the second half for Western Kentucky (2-4, 1-1 Conference USA), which has won 13 of its last 15 games at Houchens-Smith Stadium. \n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5083042/skyler-locklear\" target=\"_new\">Skyler Locklear</a> completed 12 of 24 passes for 89 yards with an interception for Missouri State (1-4, 0-1). Backup <a href=\"http://www.espn.com/college-football/player/_/id/4685252/henry-belin-iv\" target=\"_new\">Henry Belin IV</a> threw for 115 yards, including a 36-yard touchdown to <a href=\"http://www.espn.com/college-football/player/_/id/5219476/isaiah-myers\" target=\"_new\">Isaiah Myers</a> to pull within 21-13 midway through the third.\n\n\r\n              WKU has won 10 straight meetings in the 12-game series dating to 1984. It was just the second meeting as members of CUSA. \n\n\r\n              <hl2>Up next</hl2>\r\n              Missouri State: Returns home to play Kennesaw State on Wednesday. \n\n\r\n              Western Kentucky: Plays at Sam Houston on Wednesday.\n\n\r\n              ------\n\n\r\n              <a href=\"https://na01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fapnews.com%2Fnewsletters&data=05%7C02%7C%7Cdcd4c927a3014947713f08def3da887f%7C84df9e7fe9f640afb435aaaaaaaaaaaa%7C1%7C0%7C639216317087773713%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=592GG7Tx9gHi6vEFt3ytKh9NsJsnsJX5%2FPfFbPmAML8%3D&reserved=0\">Sign up for Top 25 poll alerts here</a>. Visit <a href=\"https://na01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fapnews.com%2Fhub%2Fap-top-25-college-football-poll&data=05%7C02%7C%7Cdcd4c927a3014947713f08def3da887f%7C84df9e7fe9f640afb435aaaaaaaaaaaa%7C1%7C0%7C639216317087791086%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=ia6nZ9tg%2FZcgm%2BFi8LWTUGjusXBzP7sDOqfdsmjeNig%3D&reserved=0\">the Top 25 here</a> and see AP’s full <a href=\"https://na01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fapnews.com%2Fhub%2Fcollege-football&data=05%7C02%7C%7Cdcd4c927a3014947713f08def3da887f%7C84df9e7fe9f640afb435aaaaaaaaaaaa%7C1%7C0%7C639216317087810304%7CUnknown%7CTWFpbGZsb3d8ey