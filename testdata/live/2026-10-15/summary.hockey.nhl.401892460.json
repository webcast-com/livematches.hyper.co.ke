scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Puck Frozen - Goalie","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:29"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892460000000670","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Anthony Cirelli faceoff won against Ryan Hartman","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:29"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3941973","displayName":"Anthony Cirelli","shortName":"A. Cirelli"},"type":"face-off-winner"},{"athlete":{"id":"3042063","displayName":"Ryan Hartman","shortName":"R. Hartman"}}]},{"id":"401892460000000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Jake Guentzel","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:35"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3042083","displayName":"Jake Guentzel","shortName":"J. Guentzel"},"type":"giver"}]},{"id":"401892460000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"John Carlson shot blocked by Jared Spurgeon","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:56"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"30"},"participants":[{"athlete":{"id":"5118","displayName":"John Carlson","shortName":"J. Carlson"},"type":"shooter"},{"athlete":{"id":"5079","displayName":"Jared Spurgeon","shortName":"J. Spurgeon"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1396","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Carlson scores twice to help the Lightning beat the Wild 3-2","description":"— Defenseman John Carlson scored twice for his 11th career multi-goal game, Nikita Kucherov had two assists and Dennis Hildeby made 34 saves in the Tampa Bay Lightning's 3-2 victory over the Minnesota Wild on Thursday night.","story":"TAMPA, Fla. -- — Defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a> scored twice for his 11th career multi-goal game, <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had two assists and <a href=\"http://www.espn.com/nhl/player/_/id/5174160/dennis-hildeby\">Dennis Hildeby</a> made 34 saves in the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a>'s 3-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> also scored to help Tampa Bay win its third straight game.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4320548/quinn-hughes\">Quinn Hughes</a> scored and assisted on <a href=\"http://www.espn.com/nhl/player/_/id/2563026/blake-coleman\">Blake Coleman</a>'s power-play goal for Minnesota. <a href=\"http://www.espn.com/nhl/player/_/id/4874737/jesper-wallstedt\">Jesper Wallstedt</a> finished with 32 saves.\n\n\r\n              Cirelli opened the scoring for the Lightning, getting his stick on <a href=\"http://www.espn.com/nhl/player/_/id/3904178/erik-cernak\">Erik Cernak</a>'s shot for a deflection past Wallstedt at 5:26 of the first period. Carlson scored 36 seconds later with a wrist shot from the right point. \n\n\r\n              Hughes cut the Wild deficit to 2-1 at the 2:32 mark with a wrist shot through traffic. <a href=\"http://www.espn.com/nhl/player/_/id/5079/jared-spurgeon\">Jared Spurgeon</a>, who picked up an assist on the goal, and Hughes both matched a franchise record for defensemen by scoring a point in four consecutive games to start the season, tying Ryan Suter, who did it twice.\n\n\r\n              Carlson regained the two-goal lead with a one-timer off a Kucherov pass at 4:55 to snap an 0-for-14 power-play drought to start the season. Coleman answered with a power-play goal off the rush with 5:59 left in second.\n\n\r\n              Minnesota played without defenseman <a href=\"http://www.espn.com/nhl/player/_/id/2976850/olli-maatta\">Olli Maatta</a> (lower-body injury) and forward <a href=\"http://www.espn.com/nhl/player/_/id/3535/nick-foligno\">Nick Foligno</a> (upper-body injury).\n\n\r\n              <hl2>Up next</hl2>\r\n              Wild: At Florida on Saturday night.\n\n\r\n              Lightning: at <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Saturday night.\n\n\r\n              ------","published":"2026-10-09T01:52:27Z"}}