k":{"displayValue":"1:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"3149603","displayName":"Michael Bunting","shortName":"M. Bunting"},"type":"shooter"},{"athlete":{"id":"3069285","displayName":"Linus Ullmark","shortName":"L. Ullmark"},"type":"saver"}]},{"id":"401891820000000060","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1832","fullName":"Canadian Tire Centre","address":{"city":"Ottawa","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1832.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17501,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Yakemchuk breaks late tie in the Senators' 2-1 victory over the Flyers","description":"— Carter Yakemchuk broke a tie on a power play with 6:59 left and the Ottawa Senators held on to beat the winless Philadelphia Flyers 2-1 on Thursday night.","story":"OTTAWA, Ontario -- — <a href=\"http://www.espn.com/nhl/player/_/id/5216868/carter-yakemchuk\">Carter Yakemchuk</a> broke a tie on a power play with 6:59 left and the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> held on to beat the winless <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 2-1 on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2563027/nick-cousins\">Nick Cousins</a> opened the scoring for Ottawa at midway through the first period. <a href=\"http://www.espn.com/nhl/player/_/id/5149170/matvei-michkov\">Matvei Michkov</a> tied it in a power play at 7:46 of the second.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> made 29 saves to help the Senators improve to 3-1-0.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a> stopped 24 shots for Philadelphia. The Flyers are 0-3-2.\n\n\r\n              Michael Bunting made his Flyers debut after signing with the team Tuesday and Ottawa defenseman Hoyt Stanley made his NHL debut.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flyers: At Boston on Saturday.\n\n\r\n              Senators: Host Nashville on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-09T02:08:27Z"}}