{"id":"11","abbreviation":"IND","displayName":"Indianapolis Colts"}},{"id":"4018729513145","awayScore":7,"homeScore":16,"text":"Spencer Shrader 37 Yd Field Goal","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":763,"displayValue":"12:43"},"period":{"number":4},"team":{"id":"11","abbreviation":"IND","displayName":"Indianapolis Colts"}},{"id":"4018729513417","awayScore":10,"homeScore":16,"text":"Ka'imi Fairbairn 24 Yd Field Goal ","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":453,"displayValue":"7:33"},"period":{"number":4},"team":{"id":"34","abbreviation":"HOU","displayName":"Houston Texans"}},{"id":"4018729513748","awayScore":17,"homeScore":16,"text":"Woody Marks 1 Yd Rush (Ka'imi Fairbairn Kick)","type":{"id":"68","text":"Rushing Touchdown","abbreviation":"TD"},"clock":{"value":108,"displayValue":"1:48"},"period":{"number":4},"team":{"id":"34","abbreviation":"HOU","displayName":"Houston Texans"}},{"id":"4018729513947","awayScore":17,"homeScore":19,"text":"Spencer Shrader 53 Yd Field Goal","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":16,"displayValue":"0:16"},"period":{"number":4},"team":{"id":"11","abbreviation":"IND","displayName":"Indianapolis Colts"}}],"winprobability":[{"homeWinPercentage":0.4693,"playId":"4018729511","tiePercentage":0},{"homeWinPercentage":0.4462,"playId":"40187295140","tiePercentage":0},{"homeWinPercentage":0.4541,"playId":"40187295163","tiePercentage":0},{"homeWinPercentage":0.467,"playId":"40187295190","tiePercentage":0},{"homeWinPercentage":0.4975,"playId":"401872951124","tiePercentage":0},{"homeWinPercentage":0.5016,"playId":"401872951147","tiePercentage":0},{"homeWinPercentage":0.5258,"playId":"401872951173","tiePercentage":0},{"homeWinPercentage":0.5145,"playId":"401872951198","tiePercentage":0}],"gameInfo":{"venue":{"id":"3812","guid":"f636eae9-da36-3954-83d5-3b24995d4e59","fullName":"Lucas Oil Stadium","address":{"city":"Indianapolis","state":"IN","zipCode":"46225","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3812.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3812.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":63400,"officials":[{"fullName":"Barry Anderson","displayName":"Barry Anderson","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":1},{"fullName":"Ronald Torbert","displayName":"Ronald Torbert","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":3},{"fullName":"Keith Washington","displayName":"Keith Washington","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":2},{"fullName":"Ryan Dickson","displayName":"Ryan Dickson","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":4},{"fullName":"Tripp Sutter","displayName":"Tripp Sutter","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":5},{"fullName":"Courtney Brown","displayName":"Courtney Brown","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":6},{"fullName":"John Braun","displayName":"John Braun","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Colts end 9-game skid with 19-17 victory over Texans as Shrader kicks winner with 16 seconds left","description":"— The Indianapolis Colts kept talking about turning the page on their season-ending seven-game losing streak that cost them a playoff spot last year.","story":"INDIANAPOLIS -- — The <a href=\"http://www.espn.com/nfl/team/_/name/ind/indianapolis-colts\">Indianapolis Colts</a> kept talking about turning the page on their season-ending seven-game losing streak that cost them a playoff spot last year. \n\n\r\n              Two more losses to start the season only exacerbated the pain.\n\n\r\n              On Sunday, they finally put an end to the league's longest active losing streak — and perhaps much of the chatter. \n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4571557/spencer-shrader\">Spencer Shrader</a> fought through a groin injury to make four field goals, including a 43-yarder with 16 seconds to go, and <a href=\"https://apnews.com/article/indianapolis-colts-texans-defense-3ee94a82b6f0338a8c2d75cad38c1b91\">the Colts' beleaguered defense</a> held up long enough to finally lose out a 19-17 victory over the <a href=\"http://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> — their first win since last November and their first win on American soil since last October.\n\n\r\n              “It's awesome, obviously, to get that victory,” coach Shane Steichen said. “To get that win against a division opponent is huge for our football team and now we've got to go to London and try to get that done over there, too.”\n\n\r\n              For the Colts (1-2), the celebration inside the locker room was a welcome respite from the loud critics outside of it.\n\n\r\n              No, Indy didn't win many style points.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3917792/daniel-jones\">Daniel Jones</a> was 24 of 36 for 235 yards and one touchdown, but also fumbled three times and lost two. The second set up Houston's late go-ahead touchdown. \n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a> had 23 carries for only 68 yards. <a href=\"http://www.espn.com/nfl/player/_/id/15818/keenan-allen\">Keenan Allen</a> hauled in six passes for 63 yards and his first TD with the Colts and <a href=\"http://www.espn.com/nfl/player/_/id/4688813/josh-downs\">Josh Downs</a> caught five passes for 77 yards. The defense also gave up a touchdown with 1:48 to play, once again putting the Colts hopes in peril.\n\n\r\n              This time, though, Jones made the most of his last chance. He hooked up with <a href=\"http://www.espn.com/nfl/player/_/id/3051889/laquon-treadwell\">Laquon Treadwell</a> for 20 yards. Taylor added a 5-yard run and Allen's 5-yard catch on third down came up 1 yard short of a first down, but it was enough to set up Shrader for the 53-yarder.\n\n\r\n              “I feel like today was one of my best days with how I was striking the ball,” said Shrader, who injured his groin after the opening kickoff. “So I kind of wonder whether it was one of those things where you know sometimes if you slow down a little bit, you actually end up getting a better result because you're smoother? I felt like might have happened today.\"\n\n\r\n              Houston's five-game winning streak in the series ended when <a href=\"http://www.espn.com/nfl/player/_/id/4432577/cj-stroud\">C.J. Stroud</a>'s desperation heave sailed out of bounds short and wide of the end zone as time expired. The Texans are <a href=\"https://apnews.com/article/texans-stroud-ryans-e875fe6aeeed023a78c92ee6d28d50ac\">0-3 for the straight year</a> as the offense sputters.\n\n\r\n              C.J. Stroud was 16 of 27 for 167 yards with one TD. The Texans rushed 21 times for 70 yards and had only 223 total yards against a team that allowed more than 500 yards in each of its first two games.\n\n\r\n              “These are the types of games we're supposed to win,” Stroud said. “We fought, but, at the end of the day, there's a lot of things that need to be fixed.”\n\n\r\n              It looked as though Indy's struggles would continue when Jones lost the football and <a href=\"http://www.espn.com/nfl/player/_/id/4361366/tommy-togiai\">Tommy Togiai</a> recovered at the Texans 46-yard line with 4:40 left in the game. Seven plays later, <a href=\"http://www.espn.com/nfl/player/_/id/4429059/woody-marks\">Woody Marks</a> scored on 1-yard run and the extra point gave Houston a 17-16 lead with 1:48 to go.\n\n\r\n              Instead, the Colts rallied to end their skid.\n\n\r\n              “Happy,” Steichen said, describing the locker room. “Very happy.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Texans: LB <a href=\"http://www.espn.com/nfl/player/_/id/3919117/azeez-al-shaair\">Azeez Al-Shaair</a> left in the first half with a groin injury, returned at the start of the second half, left again in the third quarter after re-injuring his groin and returned again late in the game. DE Mario Edwards and WR <a href=\"http://www.espn.com/nfl/player/_/id/4686422/xavier-hutchinson\">Xavier Hutchinson</a> both left with injuries late in the fourth quarter. Edwards went to the locker room with a left leg injury. Coach DeMeco Ryans had no postgame updates. \n\n\r\n              Colts: DE <a href=\"http://www.espn.com/nfl/player/_/id/4426473/laiatu-latu\">Laiatu Latu</a> left early with a chest injury. He returned in the second half.\n\n\r\n              <hl2>Moving up</hl2>\r\n              Allen's first catch of the day was not only his first score with the Colts, it also sent him past former Texans star and Hall of Famer Andre Johnson, for 12th on the NFL's career list. He now has 1,068 receptions — trailing Colts receivers coach Reggie Wayne by two for No. 11.\n\n\r\n              Allen also had his 71st career TD reception, moving him into a tie for 50th all-time with Hall of Famer Bob Hayes and Wesley Walker.\n\n\r\n              <hl2>Instructional lesson</hl2>\r\n              Referee Ronald Torbert gave the officiating crew a vulgar instruction while his microphone remained on after announcing the fumble on the kickoff had been reversed.\n\n\r\n              “You guys better get your (expletive) together,” Torbert blurted out, drawing laughter inside the stadium.\n\n\r\n              The reversal gave Houston the ball, instead of setting up Indy at the Texans 28, and Stroud led Houston to its first TD, a 1-yard pass from Stroud to <a href=\"http://www.espn.com/nfl/player/_/id/3843945/foster-moreau\">Foster Moreau</a> to make it 10-7 late in the third quarter..\n\n\r\n              <hl2>Up next</hl2>\r\n              Texans: Return home to face rival Dallas.\n\n\r\n              Colts: Travel to London next Sunday to face Washington.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-09-27T20:49:27Z"}}