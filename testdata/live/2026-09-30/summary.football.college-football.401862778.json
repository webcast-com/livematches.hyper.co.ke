tage":0},{"homeWinPercentage":0.3507,"playId":"401862778281","tiePercentage":0},{"homeWinPercentage":0.3346,"playId":"401862778285","tiePercentage":0},{"homeWinPercentage":0.3084,"playId":"401862778288","tiePercentage":0},{"homeWinPercentage":0.3486,"playId":"401862778293","tiePercentage":0},{"homeWinPercentage":0.3589,"playId":"401862778298","tiePercentage":0},{"homeWinPercentage":0.5478,"playId":"401862778303","tiePercentage":0},{"homeWinPercentage":0.5531,"playId":"401862778311","tiePercentage":0},{"homeWinPercentage":0.5264,"playId":"401862778314","tiePercentage":0},{"homeWinPercentage":0.5402,"playId":"401862778318","tiePercentage":0},{"homeWinPercentage":0.5409,"playId":"401862778323","tiePercentage":0},{"homeWinPercentage":0.5373,"playId":"401862778321","tiePercentage":0},{"homeWinPercentage":0.5402,"playId":"401862778328","tiePercentage":0},{"homeWinPercentage":0.5338,"playId":"401862778326","tiePercentage":0},{"homeWinPercentage":0.5321,"playId":"401862778331","tiePercentage":0},{"homeWinPercentage":0.5311,"playId":"401862778336","tiePercentage":0},{"homeWinPercentage":0.4567,"playId":"401862778334","tiePercentage":0}],"gameInfo":{"venue":{"id":"7221","guid":"75e3107c-62ec-3742-805a-4e4118e61d29","fullName":"Protective Stadium","address":{"city":"Birmingham","state":"AL","zipCode":"35203","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/7221.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":24647},"article":{"headline":"Bam McReynolds rushes for 2 TDs, including go-ahead 48-yarder as UAB edges Navy 24-20","description":"— Bam McReynolds followed a Navy turnover in the fourth quarter with a 48-yard touchdown run and UAB rallied to beat the Midshipman 24-20 on Friday night in the Blazers' American Conference opener.","story":"BIRMINGHAM, Ala. -- — <a href=\"http://www.espn.com/college-football/player/_/id/4897730/bam-mcreynolds\" target=\"_new\">Bam McReynolds</a> followed a Navy turnover in the fourth quarter with a 48-yard touchdown run and UAB rallied to beat the Midshipman 24-20 on Friday night in the Blazers' American Conference opener.\n\n\r\n              Navy (1-2, 0-2) led 20-17 and was driving when <a href=\"http://www.espn.com/college-football/player/_/id/5220652/marlin-dean\" target=\"_new\">Marlin Dean</a> forced a fumble by <a href=\"http://www.espn.com/college-football/player/_/id/5220473/jackson-gutierrez\" target=\"_new\">Jackson Gutierrez</a> with a first-down sack and <a href=\"http://www.espn.com/college-football/player/_/id/4912355/chris-spencer\" target=\"_new\">Chris Spencer</a> recovered. McReynolds was off to the races on the next play.\n\n\r\n              Neither team scored until UAB (2-2) took advantage of a 13-yard punt by <a href=\"http://www.espn.com/college-football/player/_/id/5220485/jacob-carlson\" target=\"_new\">Jacob Carlson</a> to put together a 40-yard drive that culminated with McReynolds' 10-yard touchdown run 4 seconds into the second quarter.\n\n\r\n              Navy answered with a 75-yard drive, tying it 7-all on Gutierrez's 4-yard touchdown run in his first career start.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5151663/jonah-delange\" target=\"_new\">Jonah Delange</a> kicked a 44-yard field goal, but Navy's <a href=\"http://www.espn.com/college-football/player/_/id/5391330/nolan-bartley\" target=\"_new\">Nolan Bartley</a> answered with a 34-yarder to tie it at the two-minute warning.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5057381/ryder-burton\" target=\"_new\">Ryder Burton</a> completed two passes for 22 yards before firing a 56-yard scoring strike to <a href=\"http://www.espn.com/college-football/player/_/id/5092470/ty-mims\" target=\"_new\">Ty Mims</a> and the Blazers needed only three plays and 49 seconds to take a 17-10 lead.\n\n\r\n              Gutierrez completed a 39-yard pass to running back <a href=\"http://www.espn.com/college-football/player/_/id/5158373/vic-listorti\" target=\"_new\">Vic Listorti</a> and Bartley booted a 31-yard field to cut the deficit to four at halftime.\n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5220476/charles-robinson\" target=\"_new\">Charles Robinson</a> returned a punt 23 yards to the Blazers' 47, and Listorti ran it in from 7 yards out nine players later to give Navy a three-point lead with 4:24 left in the third quarter.\n\n\r\n              Burton totaled 174 yards on 13-for-20 passing with an interception. McReynolds had 71 yards on eight carries.\n\n\r\n              Gutierrez rushed 34 times for 134 yards and completed 4 of 13 passes for 104 yards.\n\n\r\n              <hl2>Up next</hl2>\r\n              Navy: At Air Force on Oct. 3.\n\n\r\n              UAB: Hosts Samford on Oct. 3.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>. Visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-09-26T02:54:27Z"}}