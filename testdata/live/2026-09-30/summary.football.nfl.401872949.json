,"team":{"id":"29","abbreviation":"CAR","displayName":"Carolina Panthers"}},{"id":"4018729493121","awayScore":9,"homeScore":10,"text":"Ryan Fitzgerald 53 Yd Field Goal","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":197,"displayValue":"3:17"},"period":{"number":3},"team":{"id":"29","abbreviation":"CAR","displayName":"Carolina Panthers"}},{"id":"4018729493562","awayScore":12,"homeScore":10,"text":"Ryan Fitzgerald 37 Yd Field Goal","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":701,"displayValue":"11:41"},"period":{"number":4},"team":{"id":"29","abbreviation":"CAR","displayName":"Carolina Panthers"}},{"id":"4018729493751","awayScore":12,"homeScore":13,"text":"Andre Szmyt 45 Yd Field Goal","type":{"id":"59","text":"Field Goal Good","abbreviation":"FG"},"clock":{"value":450,"displayValue":"7:30"},"period":{"number":4},"team":{"id":"5","abbreviation":"CLE","displayName":"Cleveland Browns"}},{"id":"4018729493922","awayScore":18,"homeScore":13,"text":"John Metchie III 8 Yd pass from Bryce Young (Two-Point Run Conversion Failed)","type":{"id":"67","text":"Passing Touchdown","abbreviation":"TD"},"clock":{"value":265,"displayValue":"4:25"},"period":{"number":4},"team":{"id":"29","abbreviation":"CAR","displayName":"Carolina Panthers"}},{"id":"4018729494259","awayScore":18,"homeScore":21,"text":"Harold Fannin Jr. 14 Yd pass from Deshaun Watson (Deshaun Watson Pass to Denzel Boston for Two-Point Conversion)","type":{"id":"67","text":"Passing Touchdown","abbreviation":"TD"},"clock":{"value":108,"displayValue":"1:48"},"period":{"number":4},"team":{"id":"5","abbreviation":"CLE","displayName":"Cleveland Browns"}}],"winprobability":[{"homeWinPercentage":0.3617,"playId":"4018729491","tiePercentage":0},{"homeWinPercentage":0.3405,"playId":"40187294940","tiePercentage":0},{"homeWinPercentage":0.3585,"playId":"40187294963","tiePercentage":0},{"homeWinPercentage":0.3738,"playId":"40187294985","tiePercentage":0},{"homeWinPercentage":0.3289,"playId":"401872949109","tiePercentage":0},{"homeWinPercentage":0.3443,"playId":"401872949134","tiePercentage":0},{"homeWinPercentage":0.3808,"playId":"401872949156","tiePercentage":0},{"homeWinPercentage":0.3859,"playId":"401872949191","tiePercentage":0}],"gameInfo":{"venue":{"id":"3679","guid":"0febca4c-a926-3713-9088-240cc5db6e37","fullName":"Huntington Bank Field","address":{"city":"Cleveland","state":"OH","zipCode":"44114","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3679.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3679.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":65023,"officials":[{"fullName":"Brad Freeman","displayName":"Brad Freeman","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Mark Pellis","displayName":"Mark Pellis","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":2},{"fullName":"Jabir Walker","displayName":"Jabir Walker","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Land Clark","displayName":"Land Clark","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":4},{"fullName":"Dave Hawkshaw","displayName":"Dave Hawkshaw","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":5},{"fullName":"Dale Keller","displayName":"Dale Keller","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Stephen Ray","displayName":"Stephen Ray","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":7}]},"article":{"headline":"Deshaun Watson sparks a late Browns rally, sealing a 21-18 win over the Panthers","description":"— It came five weeks later than he thought, but Deshaun Watson earned cheers from Cleveland Browns fans.","story":"CLEVELAND -- — It came five weeks later than he thought, but <a href=\"http://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\">Deshaun Watson</a> earned cheers from <a href=\"http://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a> fans.\n\n\r\n              After struggling for most of the game, Watson came through when it counted on Sunday. He led a late fourth-quarter drive and threw a <a href=\"https://x.com/Browns/status/2104302459111809493?s=20\">14-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/5083076/harold-fannin-jr\">Harold Fannin Jr</a>.</a> with 1:48 remaining as the Browns rallied for a 21-18 victory over the <a href=\"http://www.espn.com/nfl/team/_/name/car/carolina-panthers\">Carolina Panthers</a>.\n\n\r\n              It was Watson’s 10th fourth-quarter comeback and game-winning drive, but possibly the sweetest of his 10-year career after working 22 months to come back from tearing his right Achilles tendon twice.\n\n\r\n              “It was a warm moment. I got a little teary-eyed feeling that energy because I put so much work to get back here, to be in this moment, to show that I can finish these games and get W’s for the city and this organization,” said Watson, who completed 16 of 30 passes for 144 yards and two TDs — both to Fannin — along with 45 rushing yards.\n\n\r\n              Browns coach Todd Monken — Watson’s biggest supporter — was happy to see his quarterback come up big in the late moments.\n\n\r\n              “He probably didn’t play as well as he wanted. But to get knocked down, come back and make a play, then a 2-point conversion, this is about him. I’m really happy for him,” Monken said.\n\n\r\n              The Panthers took an 18-13 lead with 4:25 remaining when <a href=\"http://www.espn.com/nfl/player/_/id/4567096/john-metchie\">John Metchie III</a> hauled in an <a href=\"https://x.com/Panthers/status/2104298549194178830?s=20\">8-yard touchdown pass</a> from <a href=\"http://www.espn.com/nfl/player/_/id/4685720/bryce-young\">Bryce Young</a>. But the Browns (2-1) went 65 yards in eight plays for their second straight comeback win.\n\n\r\n              Watson was 3 of 6 for 44 yards on the decisive drive. He also had a 21-yard scramble to the Panthers 21 on third-and-3 to move the sticks.\n\n\r\n              It appeared the Browns’ chances for a comeback were dashed when <a href=\"http://www.espn.com/nfl/player/_/id/4244607/akayleb-evans\">Akayleb Evans</a> picked off Watson’s pass intended for <a href=\"http://www.espn.com/nfl/player/_/id/4870653/kc-concepcion\">KC Concepcion</a> in the end zone with 2:29 remaining. But Carolina linebacker <a href=\"http://www.espn.com/nfl/player/_/id/3117253/bobby-okereke\">Bobby Okereke</a> was called for roughing the passer.\n\n\r\n              “We extended the drive for them, and if you give a guy like Deshaun Watson a little bit of extra time, and a few more opportunities, he’s going to get creative and find something,” Carolina coach <a href=\"http://www.espn.com/nfl/player/_/id/17762/dave-canales\">Dave Canales</a> said.\n\n\r\n              Watson came out for one play after the hit knocked the wind out of him but returned to cheers. The 10-year veteran QB and his teammates feared he would be showered with boos in the home opener after a negative reception during a preseason game against Buffalo on Aug. 22.\n\n\r\n              There were some boos during the third quarter when the Browns went three-and-out on three straight possessions, but everyone knew it was because of the team’s performance.\n\n\r\n              After overthrowing <a href=\"http://www.espn.com/nfl/player/_/id/4832800/denzel-boston\">Denzel Boston</a> in the end zone on second-and-10 at the 14, Watson stepped up in the pocket and rolled left before finding Fannin open in the end zone.\n\n\r\n              “During that whole drive, I told the offensive line that if something happens, give me a lane and I’m going to make something happen with my feet,” Watson said. “Harold, I just put the ball in the air and gave him a chance.”\n\n\r\n              Watson then connected with Boston for a <a href=\"https://x.com/Browns/status/2104303184093044805?s=20\">2-point conversion</a> to push the margin to a field goal.\n\n\r\n              Carolina (1-2) made a late drive, but <a href=\"http://www.espn.com/nfl/player/_/id/4569620/ronnie-hickman\">Ronnie Hickman</a> picked off Young’s pass at the Browns 46 with 9 seconds remaining. It was the Panthers' second turnover.\n\n\r\n              Watson took one snap and knelt to run out the clock. He kept that ball and also got a game ball from Monken.\n\n\r\n              “To finish a game like this, regardless of the energy outside, shows the character and person I am, and how strong mentally I am. Regardless of what’s going on, I fight like hell to accomplish what I want, no matter the chaos outside, good or bad. It was a great win, definitely one of the top ones,” Watson said.\n\n\r\n              <hl2>Tough day for Young</hl2>\r\n              Young, who came into the game tied for the NFL lead in passing touchdowns and second in passing yards, completed 26 of 48 passes for 291 yards with a touchdown and an interception.\n\n\r\n              Young appeared to tweak his ankle after <a href=\"http://www.espn.com/nfl/player/_/id/4873232/mason-graham\">Mason Graham</a> sacked him in the second quarter and briefly entered the medical tent during the third.\n\n\r\n              Canales said that Young is working through a <a href=\"https://apnews.com/article/panthers-bryce-young-injury-1e3f363abe96e126f355b6ffec833868\">lower-body injury</a> and would be evaluated.\n\n\r\n              The Panthers got four field goals from <a href=\"http://www.espn.com/nfl/player/_/id/4568263/ryan-fitzgerald\">Ryan Fitzgerald</a> before they found the end zone.\n\n\r\n              <hl2>Browns take advantage of Panthers’ fourth-down choices</hl2>\r\n              Cleveland capitalized on a couple of bad fourth-down decisions by Canales.\n\n\r\n              The Browns opened the scoring with the first of Andre Szmyt’s two field goals. Cleveland got the ball on the Panthers 47 after Graham sacked Young.\n\n\r\n              The Panthers went for it again on their next series, this time on fourth-and-short from their own 40, but Young was short on a throw intended for tight end <a href=\"http://www.espn.com/nfl/player/_/id/4372780/tommy-tremble\">Tommy Tremble</a>. The Browns found the end zone seven plays later when Watson found Fannin on a crossing route in the right back corner of the end zone on fourth-and-goal from the 2 to extend the lead to 10-0.\n\n\r\n              Fannin led Cleveland in receiving with seven catches for 51 yards.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Panthers: CB <a href=\"http://www.espn.com/nfl/player/_/id/3917853/mike-jackson\">Mike Jackson</a> suffered a groin injury in the first quarter and did not return. WR <a href=\"http://www.espn.com/nfl/player/_/id/4695883/jalen-coker\">Jalen Coker</a> (quad) came out in the third quarter and did not return.\n\n\r\n              Browns: WR <a href=\"http://www.espn.com/nfl/player/_/id/4241424/tylan-wallace\">Tylan Wallace</a> sustained a knee injury in the fourth quarter and did not return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Host Detroit next Sunday night.\n\n\r\n              Browns: Host Pittsburgh on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-09-27T20:43:39Z"}}