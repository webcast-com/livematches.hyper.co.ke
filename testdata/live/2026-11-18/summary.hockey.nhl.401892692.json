endance":18347,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Bouchard scores in OT to lift the Oilers past the Flyers, 3-2","description":"— Evan Bouchard scored on a one-timer from the left side 47 seconds into overtime and the Edmonton Oilers beat the Philadelphia Flyers 3-2 on Wednesday night for their third straight victory.","story":"EDMONTON, Alberta -- — <a href=\"http://www.espn.com/nhl/player/_/id/4352722/evan-bouchard\">Evan Bouchard</a> scored on a one-timer from the left side 47 seconds into overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 3-2 on Wednesday night for their third straight victory.\n\n\r\n              Bouchard leads NHL defenseman with 11 goals.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> picked up an assist in the second period to extend his season-starting points streak to 20 games, tying his career high and becoming the eighth player in NHL history with multiple 20-game streaks. The Oilers captain leads the league with 49 points.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5509/zach-hyman\">Zach Hyman</a> scored twice for Edmonton (14-3-3), which matched its second-best start in franchise history through 20 games. The Oilers are 12-0-2 when they score first this season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042020/tristan-jarry\">Tristan Jarry</a> made 30 saves to improve to 5-1-3.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697406/tyson-foerster\">Tyson Foerster</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114757/travis-sanheim\">Travis Sanheim</a> scored for Philadelphia (5-10-6), which has lost four of its last five. <a href=\"http://www.espn.com/nhl/player/_/id/3942459/dan-vladar\">Dan Vladar</a> stopped 21 shots.\n\n\r\n              Philadelphia defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3041999/rasmus-ristolainen\">Rasmus Ristolainen</a> returned after missing seven games after aggravating an upper-body injury he suffered against Anaheim on Oct. 24.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flyers: At Columbus on Saturday night.\n\n\r\n              Oilers: At Toronto on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-12T05:11:34Z"}}