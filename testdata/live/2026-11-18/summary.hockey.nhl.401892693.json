ghlan"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"5060","guid":"6ed1cdfd-5472-3076-b4de-7c38f29e395b","fullName":"T-Mobile Arena","address":{"city":"Las Vegas","state":"NV","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5060.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17186,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Onni Hautamaki","displayName":"Onni Hautamaki","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Stone moves within 2 points of breaking Vegas’ career scoring record in 5-3 win over Utah","description":"— Mark Stone had an early assist to move within two points of breaking Vegas’ career scoring record, Ivan Barbashev scored twice in the second period and the Golden Knights beat the Utah Mammoth 5-3 on Wednesday night.","story":"LAS VEGAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/5545/mark-stone\">Mark Stone</a> had an early assist to move within two points of breaking Vegas’ career scoring record, <a href=\"http://www.espn.com/nhl/player/_/id/3114985/ivan-barbashev\">Ivan Barbashev</a> scored twice in the second period and the Golden Knights beat the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> 5-3 on Wednesday night.\n\n\r\n              Stone helped set up <a href=\"http://www.espn.com/nhl/player/_/id/3648002/jack-eichel\">Jack Eichel</a>'s power-play goal at 2:15 of the first period to push his Vegas total to 416 points, one off <a href=\"http://www.espn.com/nhl/player/_/id/2967072/jonathan-marchessault\">Jonathan Marchessault</a>'s mark.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4064582/carter-hart\">Carter Hart</a> made 14 saves to help Vegas open a five-game homestand with its fourth straight victory. <a href=\"http://www.espn.com/nhl/player/_/id/3899937/mitch-marner\">Mitch Marner</a> had three assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3151096/victor-olofsson\">Victor Olofsson</a> made it 2-1 on a power play at 3:07 of the second, then set up Barbashev's goals at 4:51 and 8:16 — the second on a breakaway. \n\n\r\n              After <a href=\"http://www.espn.com/nhl/player/_/id/5149158/dmitri-simashev\">Dmitri Simashev</a> pulled Utah to 4-3 at 9:07 of the third, <a href=\"http://www.espn.com/nhl/player/_/id/4024989/brett-howden\">Brett Howden</a> slipped a shot through traffic 1:12 later to push the lead back to two goals.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3899951/lawson-crouse\">Lawson Crouse</a> scored for Utah in the first period and set up Jack McBain’s second-period goal.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a> stopped 23 shots for the Mammoth. \n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: Host St. Louis on Thursday night.\n\n\r\n              Golden Knights: Host Nashville on Friday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-12T05:28:34Z"}}