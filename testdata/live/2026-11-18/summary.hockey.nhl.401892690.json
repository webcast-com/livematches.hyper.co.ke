":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:10"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892690000000650","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Yanni Gourde faceoff won against Noah Ostlund","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"3094261","displayName":"Yanni Gourde","shortName":"Y. Gourde"},"type":"face-off-winner"},{"athlete":{"id":"5080160","displayName":"Noah Ostlund","shortName":"N. Ostlund"}}]},{"id":"401892690000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"J.J. Moser Snap Shot Short","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:12"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"4874929","displayName":"JJ Moser","shortName":"J. Moser"},"type":"shooter"},{"athlete":{"id":"4233889","displayName":"Ukko-Pekka Luukkonen","shortName":"U. Luukkonen"}}]},{"id":"401892690000000710","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Olen Zellweger Wrist Shot saved by Andrei Vasilevskiy","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:27"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4874863","displayName":"Olen Zellweger","shortName":"O. Zellweger"},"type":"shooter"},{"athlete":{"id":"2976847","displayName":"Andrei Vasilevskiy","shortName":"A. Vasilevskiy"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1848","fullName":"KeyBank Center","address":{"city":"Buffalo","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1848.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19070,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Kucherov has natural hat trick in Lightning's 8-3 romp over Sabres","description":"— Nikita Kucherov had a natural hat trick and an assist — all in the third period — and the Tampa Bay Lightning beat the Buffalo Sabres 8-3 on Wednesday night for their fourth victory in five games.","story":"BUFFALO, N.Y. -- — <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had a natural hat trick and an assist — all in the third period — and the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> 8-3 on Wednesday night for their fourth victory in five games.\n\n\r\n              Kucherov, the Russian star who requested a trade Oct. 30, had his eighth NHL hat trick after the Sabres scored three in a row to cut it to 4-3.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> scored twice, <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a> had a goal and four assists, and <a href=\"http://www.espn.com/nhl/player/_/id/3067840/scott-sabourin\">Scott Sabourin</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3094261/yanni-gourde\">Yanni Gourde</a> also scored. <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> had four assists, and <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> added three, and <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> made 28 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874870/josh-doan\">Josh Doan</a>, <a href=\"http://www.espn.com/nhl/player/_/id/2593315/jason-zucker\">Jason Zucker</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> scored for the Sabres, who have lost three of their last four. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> made nine saves on 14 shots and <a href=\"http://www.espn.com/nhl/player/_/id/4736758/colten-ellis\">Colten Ellis</a> stopped five of eight shots in relief.\n\n\r\n              Thompson cut it to 4-3 33 seconds into the third period, but Kucherov soon took over, scoring his first two in a 2:46 span.\n\n\r\n              <hl2>Up next</hl2>\r\n              Lightning: At Columbus on Thursday night.\n\n\r\n              Sabres: At Chicago on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-12T03:07:44Z"}}