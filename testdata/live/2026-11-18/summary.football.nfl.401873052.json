ntage":0},{"homeWinPercentage":0.5628,"playId":"4018730521634","tiePercentage":0},{"homeWinPercentage":0.5797,"playId":"4018730521645","tiePercentage":0},{"homeWinPercentage":0.6147,"playId":"4018730521686","tiePercentage":0},{"homeWinPercentage":0.6171,"playId":"4018730521719","tiePercentage":0},{"homeWinPercentage":0.5996,"playId":"4018730521726","tiePercentage":0},{"homeWinPercentage":0.5774,"playId":"4018730521756","tiePercentage":0},{"homeWinPercentage":0.5777,"playId":"4018730521769","tiePercentage":0},{"homeWinPercentage":0.5278,"playId":"4018730521781","tiePercentage":0},{"homeWinPercentage":0.5391,"playId":"4018730521818","tiePercentage":0},{"homeWinPercentage":0.4925,"playId":"4018730521840","tiePercentage":0},{"homeWinPercentage":0.4981,"playId":"4018730521872","tiePercentage":0}],"gameInfo":{"venue":{"id":"3839","guid":"604c24d0-2641-3553-82bc-1b005ac94765","fullName":"MetLife Stadium","address":{"city":"East Rutherford","state":"NJ","zipCode":"07073","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":80450,"officials":[{"fullName":"Greg Yette","displayName":"Greg Yette","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"David Meslow","displayName":"David Meslow","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":2},{"fullName":"Patrick Turner","displayName":"Patrick Turner","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":3},{"fullName":"Bryan Neale","displayName":"Bryan Neale","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":4},{"fullName":"Kevin Codey","displayName":"Kevin Codey","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":5},{"fullName":"Brad Rogers","displayName":"Brad Rogers","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":6},{"fullName":"Joe Blubaugh","displayName":"Joe Blubaugh","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":7}]},"article":{"headline":"Jayden Daniels and Commanders rally to stun the Giants 24-21 and keep their hopes alive","description":"— Even after Jayden Daniels threw two interceptions and it looked like the Washington Commanders were hurtling toward a painful loss at the New York Giants, teammates remembered what it was like when the franchise quarterback burst onto the scene in...","story":"EAST RUTHERFORD, N.J. -- — Even after <a href=\"http://www.espn.com/nfl/player/_/id/4426348/jayden-daniels\">Jayden Daniels</a> threw two interceptions and it looked like the <a href=\"http://www.espn.com/nfl/team/_/name/wsh/washington-commanders\">Washington Commanders</a> were hurtling toward a painful loss at the <a href=\"http://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a>, teammates remembered what it was like when the franchise quarterback burst onto the scene in 2024 and led some memorable comebacks in a magical rookie year.\n\n\r\n              “We felt it,” tight end <a href=\"http://www.espn.com/nfl/player/_/id/4690923/ben-sinnott\">Ben Sinnott</a> said. “Being able to get another opportunity with the ball in our hands to go win it, it definitely took me back to that season.”\n\n\r\n              Daniels delivered, making up for his first two interceptions this year by connecting with <a href=\"http://www.espn.com/nfl/player/_/id/2976212/stefon-diggs\">Stefon Diggs</a> on a go-ahead, 32-yard touchdown with 57 seconds left to complete a 24-21 victory Thursday night in what was essentially <a href=\"https://apnews.com/article/commanders-giants-jj-mccarthy-6bba3df13d20e525c57006bf172dfd8a\">a must-win game</a>.\n\n\r\n              “You could mess up the whole game but still have a chance to win,” said Daniels, who was 23 of 33 for 249 yards and also had TD throws to Sinnott and <a href=\"http://www.espn.com/nfl/player/_/id/4040629/antonio-williams\">Antonio Williams</a> while running 10 times for 28 yards.\n\n\r\n              Coming back keeps hope alive for the Commanders (3-5-1), who moved two games back of the NFC East-leading Giants (5-3-1) and now own the tiebreaker after <a href=\"https://apnews.com/a310c1eed78b9bc3df1eb17f9f9517f2\">the teams tied</a> last month. \n\n\r\n              “It just gives you confidence we can go out there and compete and we can close out a game versus the top dog,” Daniels said. “Last time we played them it didn’t go the way that we wanted to or planned to, so we went out there and we improved from the last time. We responded when we had those moments.”\n\n\r\n              Daniels getting picked off by <a href=\"http://www.espn.com/nfl/player/_/id/4373809/jevon-holland\">Jevon Holland</a> on his 208th pass attempt and <a href=\"http://www.espn.com/nfl/player/_/id/4362492/ar'darius-washington\">Ar'Darius Washington</a> on his 211th looked like it would haunt Washington, which allowed <a href=\"http://www.espn.com/nfl/player/_/id/4433970/jj-mccarthy\">J.J. McCarthy</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4361050/isaiah-likely\">Isaiah Likely</a> to hook up for a 66-yard, go-ahead TD midway through the fourth quarter and saw <a href=\"http://www.espn.com/nfl/player/_/id/4696981/cam-skattebo\">Cam Skattebo</a> run into the end zone twice.\n\n\r\n              But the Giants were unable to move the ball effectively enough on the ground to run the clock. One QB sneak by Winston was originally called a first down, but coach Dan Quinn challenged it and it got reversed.\n\n\r\n              Defensive lineman Deatrich Wise was adamant about Winston not getting it, simply, “Because I stopped him.”\n\n\r\n              Winston tried to get the Commanders to jump offside with a hard count of “Who Let the Dogs Out” — with a series of barks — but that did not work and New York kept giving Daniels the ball back by punting the ball multiple times.\n\n\r\n              “It’s a missed opportunity, certainly, but it doesn’t change things for us,” coach John Harbaugh said. “There is still a lot of football to play. We played well — just not well enough. We worked hard for this, but you can’t let it bring you down. This was one that got away.”\n\n\r\n              Aided by a pass interference call, Washington marched down the field and got in striking range. Diggs broke open and was able to walk and fall backwards into the end zone to celebrate his 80th career TD reception. He's the 30th player in league history to reach that mark.\n\n\r\n              McCarthy threw for a career-high 293 yards in his first home start for New York since a trade from Minnesota in late September but was intercepted by <a href=\"http://www.espn.com/nfl/player/_/id/3943270/rasul-douglas\">Rasul Douglas</a> in the final minute, sending fans to the exits. \n\n\r\n              “It’s easy to second-guess the final two passes,” McCarthy said. “The pressure was coming. It’s one-on-one outside. I wanted to give my playmaker a chance. This football team is going to get better from this. I know it.”\n\n\r\n              <hl2>Rookie kickers go in opposite directions</hl2>\r\n              Washington’s <a href=\"http://www.espn.com/nfl/player/_/id/5081335/drew-stevens\">Drew Stevens</a> made a 46-yard field goal, while New York’s <a href=\"http://www.espn.com/nfl/player/_/id/5082424/dominic-zvada\">Dominic Zvada</a> missed a 33-yard attempt wide left. Zvada is 8 of 14 since making nine in a row to start his NFL career.\n\n\r\n              “You can’t start firing guys left and right,” Harbaugh said. “I believe in him. He’s going to make kicks for us.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Commanders: Tight end Chig Onkonkwo left in the second quarter with a back injury and returned after halftime.\n\n\r\n              Giants: Safety <a href=\"http://www.espn.com/nfl/player/_/id/4240706/jason-pinnock\">Jason Pinnock</a> left with a back injury early in the third quarter. \n\n\r\n              <hl2>Up next</hl2>\r\n              Commanders: Host the <a href=\"http://www.espn.com/nfl/team/_/name/cin/cincinnati-bengals\">Cincinnati Bengals</a> on Monday, Nov. 23.\n\n\r\n              Giants: Host the <a href=\"http://www.espn.com/nfl/team/_/name/jax/jacksonville-jaguars\">Jacksonville Jaguars</a> on Sunday, Nov. 22.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-13T04:29:34Z"}}