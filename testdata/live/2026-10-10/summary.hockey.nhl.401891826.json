awayScore":0,"homeScore":1,"text":"Charle-Edouard D'Astous Goal (1) Wrist Shot, assists: Brandon Hagel (1), Jake Guentzel (1)","type":{"id":"505","text":"Goal","abbreviation":"goal"},"clock":{"displayValue":"2:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"4588175","displayName":"Charle-Edouard D'Astous","shortName":"C. D'Astous"},"type":"scorer"},{"athlete":{"id":"4065019","displayName":"Brandon Hagel","shortName":"B. Hagel"},"type":"assister"},{"athlete":{"id":"3042083","displayName":"Jake Guentzel","shortName":"J. Guentzel"},"type":"assister"}]},{"id":"401891826000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Ilya Protas faceoff won against Brayden Point","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"5229146","displayName":"Ilya Protas","shortName":"I. Protas"},"type":"face-off-winner"},{"athlete":{"id":"3151187","displayName":"Brayden Point","shortName":"B. Point"}}]},{"id":"401891826000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:41"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1396","guid":"713cae18-f94f-330c-ab1a-eb284df12c97","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Dylan Blujus","displayName":"Dylan Blujus","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kendrick Nicholson","displayName":"Kendrick Nicholson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Lightning beat the Capitals 3-1 in home opener","description":"— Andrei Vasilevskiy made 19 saves, Charle-Edouard D'Astous and Conor Geekie scored in the first period and the Tampa Bay Lightning won their home opener with a 3-1 victory over the Washington Capitals on Saturday night.","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> made 19 saves, <a href=\"http://www.espn.com/nhl/player/_/id/4588175/charle-edouard-d'astous\">Charle-Edouard D'Astous</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080155/conor-geekie\">Conor Geekie</a> scored in the first period and the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> won their home opener with a 3-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> on Saturday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> had two assists for the Lightning, and <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> scored into an empty net and had an assist. Tampa Bay opened play Thursday night in New York with a 5-1 loss to the Rangers.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3095975/charlie-lindgren\">Charlie Lindgren</a> finished with 27 saves for Washington. <a href=\"http://www.espn.com/nhl/player/_/id/4697783/justin-sourdif\">Justin Sourdif</a> scored for the Capitals.\n\n\r\n              D'Astous put Tampa Bay up 1-0 at 2:26 of the opening period as he cut down from the point into the middle slot to take a pass from Brandon Hagel and zipped a wrist shot past Lindgren.\n\n\r\n              The Lightning finished off the period with a goal from Geekie, who was off the right wing side to take a pass from Hagel for a quick shot to the inside of the post with 3:30 top go for a 2-0 lead.\n\n\r\n              The Capitals, who opened Friday with a win in Carolina, cut the deficit in half in the second period on a redirect from Sourdif off a point shot from Jacob Chychurn.\n\n\r\n              Guentzel scored with 2:05 left in the third.\n\n\r\n              Washington played the third period without defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3942924/matt-roy\">Matt Roy</a>, who suffered a lower-body injury and did not return.\n\n\r\n              Tampa Bay defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5118/john-carlson\">John Carlson</a>, who spent 17 seasons with the Capitals, played his first career game against Washington, picking up an assist on the empty-net goal.\n\n\r\n              <hl2>Up next</hl2>\r\n              Capitals: Host Pittsburgh on Wednesday night.\n\n\r\n              Lightning: Host Philadelphia on Monday night.\n\n\r\n              ------ <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-04T02:03:27Z"}}