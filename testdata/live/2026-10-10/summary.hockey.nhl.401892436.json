re":0,"homeScore":0,"text":"Valeri Nichushkin Wrist Shot saved by Sebastian Cossa","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:40"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"3042003","displayName":"Valeri Nichushkin","shortName":"V. Nichushkin"},"type":"shooter"},{"athlete":{"id":"4874732","displayName":"Sebastian Cossa","shortName":"S. Cossa"},"type":"saver"}]},{"id":"401892436000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892436000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Kevin Stenlund faceoff won against Sean Monahan","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"3904191","displayName":"Kevin Stenlund","shortName":"K. Stenlund"},"type":"face-off-winner"},{"athlete":{"id":"3041996","displayName":"Sean Monahan","shortName":"S. Monahan"}}]},{"id":"401892436000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Zach Werenski shot blocked by MacKenzie Weegar","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:06"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"3899972","displayName":"Zach Werenski","shortName":"Z. Werenski"},"type":"shooter"},{"athlete":{"id":"3042269","displayName":"MacKenzie Weegar","shortName":"M. Weegar"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1828","fullName":"Nationwide Arena","address":{"city":"Columbus","state":"OH","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1828.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17176,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"CJ Murray","displayName":"CJ Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Nick Schmaltz scores twice, reaches 500 points as Mammoth beat Blue Jackets 4-1","description":"— Nick Schmaltz had two goals and the Utah Mammoth scored three times on the power play to beat the Columbus Blue Jackets 4-1 on Saturday night for its second straight victory to open the season.","story":"COLUMBUS, Ohio -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114770/nick-schmaltz\">Nick Schmaltz</a> had two goals and the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> scored three times on the power play to beat the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> 4-1 on Saturday night for its second straight victory to open the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024868/mikhail-sergachev\">Mikhail Sergachev</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874723/dylan-guenther\">Dylan Guenther</a> each scored power-play goals. Sergachev added an assist and Guenther and <a href=\"http://www.espn.com/nhl/player/_/id/5080143/logan-cooley\">Logan Cooley</a> each had two assists. <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a> stopped 15 shots in his Utah debut.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024857/clayton-keller\">Clayton Keller</a> had two assists to reach 600 NHL career points. He has two goals and 15 assists for 17 points in 17 career games against the Blue Jackets and four assists this season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4781553/kent-johnson\">Kent Johnson</a> scored for Columbus, and <a href=\"http://www.espn.com/nhl/player/_/id/4894366/jet-greaves\">Jet Greaves</a> stopped 21 shots. <a href=\"http://www.espn.com/nhl/player/_/id/4874919/matthew-knies\">Matthew Knies</a> had an assist, giving him four points in his first two games with the Blue Jackets.\n\n\r\n              Sergachev put Utah ahead with a power-play goal from near the blue line at 11:55 of the first period. Schmaltz doubled the lead less than five minutes later.\n\n\r\n              Johnson scored on a breakaway 1:30 into the second period to make it 2-1 before Guenther scored on the power play at 5:59 of the third for his third power-play goal in Utah’s first two games.\n\n\r\n              Schmaltz made it 4-1 with a power-play goal at 14:13 for his 500th NHL point.\n\n\r\n              The game opened a five-game road trip for Utah and was the first half of a back-to-back.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: At the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Sunday night.\n\n\r\n              Blue Jackets: Hosts the Pittsburgh on Friday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-04T01:55:36Z"}}