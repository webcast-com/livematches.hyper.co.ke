ion":"hit"},"clock":{"displayValue":"1:35"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"2562629","displayName":"Rickard Rakell","shortName":"R. Rakell"},"type":"hit-credited"},{"athlete":{"id":"4893969","displayName":"Arber Xhekaj","shortName":"A. Xhekaj"},"type":"hitted"}]},{"id":"401891822000003010","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"}},{"id":"401891822000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Sidney Crosby faceoff won against Phillip Danault","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:42"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"3114","displayName":"Sidney Crosby","shortName":"S. Crosby"},"type":"face-off-winner"},{"athlete":{"id":"2562602","displayName":"Phillip Danault","shortName":"P. Danault"}}]}],"gameInfo":{"venue":{"id":"1837","fullName":"PPG Paints Arena","address":{"city":"Pittsburgh","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1837.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18382,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Trevor Hanson","displayName":"Trevor Hanson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Novak scores 2 goals, including OT winner, to help the Penguins beat the Canadiens 6-5","description":"— Tommy Novak scored his second goal of the game in overtime to give the Pittsburgh Penguins a 6-5 victory over the Montreal Canadiens on Saturday night.","story":"PITTSBURGH -- — <a href=\"http://www.espn.com/nhl/player/_/id/3942061/tommy-novak\">Tommy Novak</a> scored his second goal of the game in overtime to give the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> a 6-5 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> on Saturday night.\n\n\r\n              Novak converted a 2-on-1 from <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a> at 1:33 of overtime, as Pittsburgh recovered after allowing a four-goal lead in the second period slip away.\n\n\r\n              Malkin scored a power-play goal and had two assists. He recorded his 1,411th point, passing Dale Hawerchuk for 22nd place in NHL history.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5291947/ben-kindel\">Ben Kindel</a> was activated from injured reserve and scored a power-play goal, while Sam Girard and <a href=\"http://www.espn.com/nhl/player/_/id/5103825/declan-carlile\">Declan Carlile</a> also scored for Pittsburgh.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a> had an assist, the 1,109th of his career, which tied Hall of Fame forward Joe Thornton for seventh-most in NHL history.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a> stopped 20 shots.\n\n\r\n              Franchise icon, former owner and hockey Hall of Famer Mario Lemieux took part in a ceremonial puck drop to celebrate the Penguins’ 60th season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565236/cole-caufield\">Cole Caufield</a> scored twice, while <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5833/chris-kreider\">Chris Kreider</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5216860/ivan-demidov\">Ivan Demidov</a> also scored for the Canadiens, who trailed 5-1 in the second period. Kreider scored with 1:08 to play and Demidov tied the game with 44 seconds left in regulation.\n\n\r\n              Montreal, which reached the Eastern Conference Final last season, sought to win its first two games of a season for the first time since 2015-16.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a> made 24 saves.\n\n\r\n              The Penguins outshot Montreal 23-5 during a 25-minute stretch and opened a 5-1 lead thanks to a four-goal second period.\n\n\r\n              Malkin scored his second power-play goal of the season, while Carlile, Girard, Novak and Kindel added second-period goals.\n\n\r\n              Suzuki started the Canadiens comeback at 18:46 of the second period before Caufield, Kreider and Demidov forced overtime with goals in the third.\n\n\r\n              UP NEXT\n\n\r\n              Canadiens: Begin a four-game homestand Tuesday against Carolina.\n\n\r\n              Penguins: Host Winnipeg Monday before playing six of their next seven on the road.\n\n\r\n              ------\n\n\r\n              AP NHL: <a href=\"https://apnews.com/hub/nhl\">https://apnews.com/hub/nhl</a>","published":"2026-10-04T02:20:28Z"}}