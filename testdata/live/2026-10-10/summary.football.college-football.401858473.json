375,"playId":"401858473259","tiePercentage":0},{"homeWinPercentage":0.1455,"playId":"401858473263","tiePercentage":0},{"homeWinPercentage":0.1298,"playId":"401858473267","tiePercentage":0},{"homeWinPercentage":0.1371,"playId":"401858473272","tiePercentage":0},{"homeWinPercentage":0.1224,"playId":"401858473275","tiePercentage":0},{"homeWinPercentage":0.1251,"playId":"401858473279","tiePercentage":0},{"homeWinPercentage":0.1467,"playId":"401858473284","tiePercentage":0},{"homeWinPercentage":0.1554,"playId":"401858473290","tiePercentage":0},{"homeWinPercentage":0.1561,"playId":"401858473293","tiePercentage":0},{"homeWinPercentage":0.1622,"playId":"401858473300","tiePercentage":0},{"homeWinPercentage":0.1652,"playId":"401858473304","tiePercentage":0},{"homeWinPercentage":0.1756,"playId":"401858473308","tiePercentage":0},{"homeWinPercentage":0.1779,"playId":"401858473312","tiePercentage":0},{"homeWinPercentage":0.1703,"playId":"401858473316","tiePercentage":0},{"homeWinPercentage":0.1631,"playId":"401858473319","tiePercentage":0},{"homeWinPercentage":0.1624,"playId":"401858473326","tiePercentage":0},{"homeWinPercentage":0.1529,"playId":"401858473324","tiePercentage":0},{"homeWinPercentage":0.1594,"playId":"401858473328","tiePercentage":0},{"homeWinPercentage":0.1507,"playId":"401858473334","tiePercentage":0}],"gameInfo":{"venue":{"id":"3793","guid":"93937424-b8c3-3db1-b464-cb278c0e8a71","fullName":"Kinnick Stadium","address":{"city":"Iowa City","state":"IA","zipCode":"52240","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/3793.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3793.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":69250},"article":{"headline":"Julian Sayin, Jeremiah Smith lead No. 5 Ohio State past No. 14 Iowa, 31-14","description":"— Julian Sayin threw for 324 yards and three touchdowns, two to Jeremiah Smith, and No. 5 Ohio State beat No. 14 Iowa 31-14 on Saturday.","story":"IOWA CITY, Iowa -- — <a href=\"http://www.espn.com/college-football/player/_/id/5079712/julian-sayin\" target=\"_new\">Julian Sayin</a> threw for 324 yards and three touchdowns, two to <a href=\"http://www.espn.com/college-football/player/_/id/5079720/jeremiah-smith\" target=\"_new\">Jeremiah Smith</a>, and No. 5 Ohio State beat No. 14 Iowa 31-14 on Saturday.\n\n\r\n              Sayin was 20-of-27 passing, and his favorite target was Smith, the nation’s top receiver. Smith had 11 catches for 206 yards, becoming Ohio State’s leader in receptions (207), receiving yards (3,381) and receiving touchdowns (36).\n\n\r\n              Smith caught a 12-yard touchdown pass from Sayin with 12 seconds left in the first half to give the Buckeyes (4-1, 2-0 Big Ten) a 17-6 lead.\n\n\r\n              Sayin threw a 57-yard touchdown pass to Smith with 6:11 left in the third quarter. Smith struck a Heisman pose toward the Iowa fans in Kinnick Stadium’s north end zone after the catch.\n\n\r\n              Sayin opened the scoring with a 15-yard touchdown pass to <a href=\"http://www.espn.com/college-football/player/_/id/5076952/devin-mccuin\" target=\"_new\">Devin McCuin</a> on Ohio State’s first possession for an early 7-0 lead.\n\n\r\n              Ja’Kobi Jackson closed the scoring for the Buckeyes with a 7-yard touchdown run early in the fourth quarter.\n\n\r\n              Iowa (4-1, 1-1) got its only points on two field goals and <a href=\"http://www.espn.com/college-football/player/_/id/5295539/braeden-jackson\" target=\"_new\">Braeden Jackson</a>'s fourth-quarter 2-yard touchdown run. The Hawkeyes were held to just 238 yards as Ohio State, which had 484 yards, had almost a 17-minute advantage in time of possession.\n\n\r\n              <hl2>Takeaways</hl2>\r\n              Ohio State: Sayin and the Buckeyes slowly carved into Iowa’s defense, then hit the big play late with the long touchdown pass to Smith. Since the 24-23 loss to Texas on Sept. 12, Ohio State has outscored its last three opponents 136-36.\n\n\r\n              Iowa: The Hawkeyes were carrying momentum coming off last week’s 20-19 win over Michigan, but were too conservative early in this game. They answered Ohio State touchdowns with field goals, and that wasn’t going to be good enough in a game like this.\n\n\r\n              <hl2>Up next</hl2>\r\n              Ohio State: Hosts Maryland next Saturday.\n\n\r\n              Iowa: At Washington on Friday night.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-04T12:02:43Z"}}