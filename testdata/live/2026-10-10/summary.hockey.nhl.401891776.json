displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"5216882","displayName":"Konsta Helenius","shortName":"K. Helenius"},"type":"giver"}]},{"id":"401891776000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Ryan McLeod Snap Shot saved by Spencer Knight","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:25"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"2"},"participants":[{"athlete":{"id":"4378669","displayName":"Ryan McLeod","shortName":"R. McLeod"},"type":"shooter"},{"athlete":{"id":"4565234","displayName":"Spencer Knight","shortName":"S. Knight"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1848","fullName":"KeyBank Center","address":{"city":"Buffalo","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1848.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19070,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Cody Beach","displayName":"Cody Beach","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Anthony Lapointe","displayName":"Anthony Lapointe","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jiri Kulich scores go-ahead goal, Sabres rally to beat the Blackhawks 4-3","description":"— Jiri Kulich scored with 6:40 left and the Sabres overcame a two-goal deficit to beat the Chicago Blackhawks 4-3 in Buffalo’s home-opener on Saturday night.","story":"BUFFALO, N.Y. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5080176/jiri-kulich\">Jiri Kulich</a> scored with 6:40 left and the Sabres overcame a two-goal deficit to beat the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> 4-3 in Buffalo’s home-opener on Saturday night.\n\n\r\n              For Kulich, the goal was his first in nearly a calendar year, and after the 22-year-old missed the final 70 games of last season <a href=\"https://apnews.com/article/sabres-kulich-blood-clot-2a9a2d664d6b8bb2dd1d140e147bce54\">due to blood clot issues</a>. <a href=\"http://www.espn.com/nhl/player/_/id/4294163/rasmus-dahlin\">Rasmus Dahlin</a> tied the game 6:10 into the third period, and <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4024988/tage-thompson\">Tage Thompson</a> also scored for Buffalo. <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> made 12 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149194/oliver-moore\">Oliver Moore</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3115033/ryan-donato\">Ryan Donato</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3042056/tyler-bertuzzi\">Tyler Bertuzzi</a> scored for the Blackhawks, who dropped to 0-3 following road losses at Vegas and Utah. <a href=\"http://www.espn.com/nhl/player/_/id/4565234/spencer-knight\">Spencer Knight</a> stopped 24 shots. Chicago squandered a 2-0 first-period lead and a 3-2 lead entering the third.\n\n\r\n              Kulich’s goal came after he missed the net on a chance from in close. Thompson recovered the puck behind the net and fed <a href=\"http://www.espn.com/nhl/player/_/id/4781556/owen-power\">Owen Power</a> in the right circle. Power then set up Kulich to the left of the net, from where he beat Knight.\n\n\r\n              The Sabres have won seven straight over Chicago and are 10-0-1 since a 4-1 loss on Nov. 17, 2019.\n\n\r\n              Buffalo debuted a new banner to honor the team winning its first Atlantic Division title in a season the Sabres also snapped an NHL-record 14-year playoff drought.\n\n\r\n              The Blackhawks were <a href=\"https://apnews.com/article/blackhawks-bowen-byram-9285c6156179bf4b1af191982a652245\">without top defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4565225/bowen-byram\">Bowen Byram</a></a>, who was dealing with a family matter. Byram spent the previous two-plus seasons in Buffalo before being <a href=\"https://apnews.com/article/sabres-blackhawks-trade-byram-836ddca53c6730a269d93020aa92cf26\">acquired by Chicago in a June trade</a>.\n\n\r\n              Earlier in the day, <a href=\"http://www.espn.com/nhl/player/_/id/3735/patrick-kane\">Patrick Kane</a> revealed his choice of where to sign in free agency this offseason was between his hometown Sabres or returning to Chicago. Leaving Detroit after three years, <a href=\"https://apnews.com/article/blackhawks-patrick-kane-c9077f9857263007383b484270e109a9\">Kane signed a two-year deal with Chicago</a>, where he spent his first 16 seasons and won three Stanley Cups.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blackhawks: Home-opener against St. Louis on Tuesday night.\n\n\r\n              Sabres: Host Minnesota on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-04T01:55:31Z"}}