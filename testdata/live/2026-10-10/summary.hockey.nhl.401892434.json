ayName":"Dylan Cozens","shortName":"D. Cozens"}}]},{"id":"401892434000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Jordan Spence","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"0:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4588190","displayName":"Jordan Spence","shortName":"J. Spence"},"type":"giver"}]},{"id":"401892434000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Oliver Ekman-Larsson shot blocked by Thomas Chabot","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:19"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"5488","displayName":"Oliver Ekman-Larsson","shortName":"O. Ekman-Larsson"},"type":"shooter"},{"athlete":{"id":"3900219","displayName":"Thomas Chabot","shortName":"T. Chabot"},"type":"defender"}]},{"id":"401892434000001030","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Drake Batherson hit Jake McCabe","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4271734","displayName":"Drake Batherson","shortName":"D. Batherson"},"type":"hit-credited"},{"athlete":{"id":"3020803","displayName":"Jake McCabe","shortName":"J. McCabe"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18434,"officials":[{"fullName":"Ryan Daisy","displayName":"Ryan Daisy","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Senators open season with a 3-2 victory over the Maple Leafs","description":"— Stephen Halliday broke a tie at 9:46 of the third period, Linus Ullmark made 27 saves and the Ottawa Senators opened the season with a 3-2 victory over the Toronto Maple Leafs on Saturday night.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/5136706/stephen-halliday\">Stephen Halliday</a> broke a tie at 9:46 of the third period, <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> made 27 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> opened the season with a 3-2 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> on Saturday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3900219/thomas-chabot\">Thomas Chabot</a> had a goal and an assist in his first game as captain, and <a href=\"http://www.espn.com/nhl/player/_/id/3149829/michael-amadio\">Michael Amadio</a> provided the rest of the offense for Ottawa. <a href=\"http://www.espn.com/nhl/player/_/id/3775/claude-giroux\">Claude Giroux</a> added two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4587996/kirill-marchenko\">Kirill Marchenko</a> scored for Toronto, and <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> stopped 26 shots. The Maple Leafs are 1-2.\n\n\r\n              Chabot opened the scoring with 1:08 left in the first period. The Ottawa defenseman joined the rush and fired a rebound past Bobrovsky.\n\n\r\n              Matthews tied it 33 seconds into the second when he redirected Morgan Rielly’s point shot. Marchenko — acquired a day before the season from the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> in a blockbuster deal — backhanded his first past Ullmark on a power play after taking a pass from <a href=\"http://www.espn.com/nhl/player/_/id/3149843/darren-raddysh\">Darren Raddysh</a> at 7:06.\n\n\r\n              Amadio tied it again with 7:20 to go when he finished off a 2-on-1 break with <a href=\"http://www.espn.com/nhl/player/_/id/4697384/tim-stutzle\">Tim Stutzle</a>. Halliday provided the winning margin in the third just as a penalty expired.\n\n\r\n              <hl2>Up next</hl2>\r\n              <hl2 />\r\n              Senators: At Boston on Monday night.\n\n\r\n              Maple Leafs: Host Nashville on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-04T02:13:27Z"}}