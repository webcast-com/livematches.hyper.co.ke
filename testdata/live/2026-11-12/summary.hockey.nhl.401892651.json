Score":0,"homeScore":0,"text":"Giveaway by Connor Brown","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:13"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3067951","displayName":"Connor Brown","shortName":"C. Brown"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1826","fullName":"Prudential Center","address":{"city":"Newark","state":"NJ","zipCode":"07199","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1826.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16514,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Onni Hautamaki","displayName":"Onni Hautamaki","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jesper Bratt scores in OT to give the streaking Devils a 5-4 win over Blues","description":"— Jesper Bratt scored on a breakaway from Dougie Hamilton in overtime to lift the streaking New Jersey Devils to a 5-4 win over the St. Louis Blues on Thursday night.","story":"NEWARK, N.J. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4268771/jesper-bratt\">Jesper Bratt</a> scored on a breakaway from <a href=\"http://www.espn.com/nhl/player/_/id/2562605/dougie-hamilton\">Dougie Hamilton</a> in overtime to lift the streaking <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> to a 5-4 win over the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a> on Thursday night.\n\n\r\n              It was Bratt's fourth career overtime goal.\n\n\r\n              New Jersey is 8-2 in its last 10 games and has won six straight at the Prudential Center. The Devils, who have missed the playoffs the past two seasons, are in second place in the Metropolitan Division.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> stopped 28 shots and is 4-0-0 for the Devils since he was <a href=\"https://apnews.com/article/hellebuyck-trade-devils-jets-26c70cac1b23930670e1200f298ac80e\">acquired from Winnipeg in late October</a>. \n\n\r\n              New Jersey led 4-1 after two periods, but the Blues scored three goals in 3:08 to tie it at 4. <a href=\"http://www.espn.com/nhl/player/_/id/4874718/mason-mctavish\">Mason McTavish</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4565229/philip-broberg\">Philip Broberg</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149178/dalibor-dvorsky\">Dalibor Dvorsky</a> scored, the latter two coming 18 seconds apart with 5:06 to play.\n\n\r\n              Anthony Manta scored two goals and had an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4874719/luke-hughes\">Luke Hughes</a> had a goal and an assist for New Jersey. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a> contributed two assists, and has eight points in his last five games. He leads the Devils with 21 points.\n\n\r\n              The loss concluded a six-game stretch for the Blues against Eastern Conference teams, where they went 2-4.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2590874/jordan-binnington\">Jordan Binnington</a> had 31 saves for St. Louis.\n\n\r\n              The Devils scored 19 seconds apart late in the second period for a 4-1 lead. <a href=\"http://www.espn.com/nhl/player/_/id/4233872/jesper-boqvist\">Jesper Boqvist</a> struck from Luke Hughes and Mantha, then Mantha scored his second goal of the period on a backhand from <a href=\"http://www.espn.com/nhl/player/_/id/3025535/brett-pesce\">Brett Pesce</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3648008/evan-rodrigues\">Evan Rodrigues</a>.\n\n\r\n              New Jersey outshot the Blues 16-4 in the first period, with Hughes giving the Devils a 1-0 lead on his sixth goal of the season and third in the last five games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blues: conclude a four-game road trip at Nashville on Saturday.\n\n\r\n              Devils: at the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-06T03:16:35Z"}}