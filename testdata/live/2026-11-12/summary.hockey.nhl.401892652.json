aver"}]},{"id":"401892652000002010","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Brayden Schenn shot blocked by Jackson Blake","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:18"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"5219","displayName":"Brayden Schenn","shortName":"B. Schenn"},"type":"shooter"},{"athlete":{"id":"5103645","displayName":"Jackson Blake","shortName":"J. Blake"},"type":"defender"}]},{"id":"401892652000001010","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Nikolaj Ehlers Wrist Shot saved by Semyon Varlamov","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"7"},"participants":[{"athlete":{"id":"3114741","displayName":"Nikolaj Ehlers","shortName":"N. Ehlers"},"type":"shooter"},{"athlete":{"id":"3759","displayName":"Semyon Varlamov","shortName":"S. Varlamov"},"type":"saver"}]},{"id":"401892652000000080","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:29"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892652000000690","scoringPlay":false,"scoreValue":0,"awayScore":1,"homeScore":0,"text":"Jean-Gabriel Pageau faceoff won against Mark Jankowski","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:29"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"2593131","displayName":"Jean-Gabriel Pageau","shortName":"J. Pageau"},"type":"face-off-winner"},{"athlete":{"id":"2976849","displayName":"Mark Jankowski","shortName":"M. Jankowski"}}]}],"gameInfo":{"venue":{"id":"7226","fullName":"UBS Arena","address":{"city":"Elmont","state":"NY","zipCode":"11003","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/7226.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14234,"officials":[{"fullName":"Carter Sandlak","displayName":"Carter Sandlak","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Carrier's goal snaps 3rd-period tie as Hurricanes beat Islanders 5-3","description":"— William Carrier scored the go-ahead goal in the third period and the Carolina Hurricanes beat the New York Islanders 5-3 on Thursday night.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042054/william-carrier\">William Carrier</a> scored the go-ahead goal in the third period and the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> 5-3 on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874899/logan-stankoven\">Logan Stankoven</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4352692/jesperi-kotkaniemi\">Jesperi Kotkaniemi</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4352683/andrei-svechnikov\">Andrei Svechnikov</a> also scored for Carolina, which won for the fourth time in five games. <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> had two assists, and <a href=\"http://www.espn.com/nhl/player/_/id/4996097/brandon-bussi\">Brandon Bussi</a> finished with 24 saves. <a href=\"http://www.espn.com/nhl/player/_/id/4063449/jalen-chatfield\">Jalen Chatfield</a> added an empty-net goal in the final minute of the third.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5219/brayden-schenn\">Brayden Schenn</a> had a goal and an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/4419646/mitchell-chaffee\">Mitchell Chaffee</a> and Viktor Eklund also scored for the Islanders, who lost their second straight game. <a href=\"http://www.espn.com/nhl/player/_/id/3759/semyon-varlamov\">Semyon Varlamov</a> made 34 saves.\n\n\r\n              Aho fired a shot from the left wall, and Carrier buried the rebound with 5:08 remaining in regulation.\n\n\r\n              The Hurricanes jumped out to a two-goal lead in the first 3:20, scoring on two of their first three shots.\n\n\r\n              Carolina took advantage of a New York miscue when forwards <a href=\"http://www.espn.com/nhl/player/_/id/3042086/anthony-duclair\">Anthony Duclair</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2593131/jean-gabriel-pageau\">Jean-Gabriel Pageau</a> over-skated a bouncing puck, and Stankoven sent a wrist shot between Varlamov’s pads. <a href=\"http://www.espn.com/nhl/player/_/id/5103645/jackson-blake\">Jackson Blake</a> extended his point streak to eight games with the primary assist on the opening goal.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5291933/matthew-schaefer\">Matthew Schaefer</a> tried to keep a play alive in the offensive zone late in a shift and was caught up ice. <a href=\"http://www.espn.com/nhl/player/_/id/2989376/jordan-martinook\">Jordan Martinook</a> found Kotkaniemi behind the Islanders defense for an easy redirection 3:20 into the first to give Carolina a 2-0 lead.\n\n\r\n              New York responded with two goals in the first 5:44 of the second, tying the game.\n\n\r\n              Chaffee redirected Schaefer’s shot from the point for his first of the season, and Schenn converted a wraparound just over two minutes later to tie it.\n\n\r\n              Sixty seconds later, Svechnikov finished a feed from Aho to put Carolina in front.\n\n\r\n              Eklund answered with a one-timer from the slot with less than three minutes remaining in the period to even the score at 3.\n\n\r\n              The Islanders signed veteran defenseman Ben Hutton to a one-year contract Thursday. Hutton, 33, had joined New York on a professional tryout Monday after recording 15 points (six goals, nine assists) in 55 games with the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> last season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Hurricanes: Host Chicago on Saturday.\n\n\r\n              Islanders: Host New Jersey on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-06T02:53:36Z"}}