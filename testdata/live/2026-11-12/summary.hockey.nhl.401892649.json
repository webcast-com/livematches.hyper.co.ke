 Karlsson"},"type":"face-off-winner"},{"athlete":{"id":"5188599","displayName":"Emmitt Finnie","shortName":"E. Finnie"}}]}],"gameInfo":{"venue":{"id":"5404","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19515,"officials":[{"fullName":"Tom Chmielewski","displayName":"Tom Chmielewski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Caleb Apperson","displayName":"Caleb Apperson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mike Sullivan","displayName":"Mike Sullivan","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Connelly breaks late tie in the Golden Knights' 2-1 win over the Red Wings","description":"— Trevor Connelly broke a tie with 1:42 left and the Vegas Golden Knights beat the Detroit Red Wings 2-1 on Thursday night.","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/5216887/trevor-connelly\">Trevor Connelly</a> broke a tie with 1:42 left and the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> 2-1 on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5272307/braeden-bowman\">Braeden Bowman</a> tied it for Vegas at 4:20 of third, and <a href=\"http://www.espn.com/nhl/player/_/id/4064582/carter-hart\">Carter Hart</a> made 25 saves.\n\n\r\n              Playing the third game of four-game trip, the Golden Knights improved to 11-5-2 with their second straight victory.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5188582/anton-johansson\">Anton Johansson</a> scored for Detroit at 2:02 of the third.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587994/daniil-tarasov\">Daniil Tarasov</a> stopped 32 shots for the Red Wings in their lone home game in a seven-game span. They have lost two in a row to fall to 7-7-3.\n\n\r\n              <hl2>Up next</hl2>\r\n              Golden Knights: At Buffalo on Sunday.\n\n\r\n              Red Wings: At Colorado on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-06T02:52:34Z"}}