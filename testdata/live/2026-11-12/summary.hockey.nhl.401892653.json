":[{"athlete":{"id":"5149204","displayName":"Gabe Perreault","shortName":"G. Perreault"},"type":"hit-credited"},{"athlete":{"id":"4565230","displayName":"Trevor Zegras","shortName":"T. Zegras"},"type":"hitted"}]},{"id":"401892653000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Gabe Perreault Snap Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"5149204","displayName":"Gabe Perreault","shortName":"G. Perreault"},"type":"shooter"},{"athlete":{"id":"4271575","displayName":"Joseph Woll","shortName":"J. Woll"}}]},{"id":"401892653000000980","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Owen Tippett hit Alberts Smits","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:00"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"4392072","displayName":"Owen Tippett","shortName":"O. Tippett"},"type":"hit-credited"},{"athlete":{"id":"5334662","displayName":"Alberts Smits","shortName":"A. Smits"},"type":"hitted"}]},{"id":"401892653000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Eeli Tolvanen Snap Shot saved by Joseph Woll","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:02"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4233720","displayName":"Eeli Tolvanen","shortName":"E. Tolvanen"},"type":"shooter"},{"athlete":{"id":"4271575","displayName":"Joseph Woll","shortName":"J. Woll"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1830","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18006,"officials":[{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jordan Samuels-Thomas","displayName":"Jordan Samuels-Thomas","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kartye scores the winning goal as the Rangers down the Flyers 3-2","description":"— Tye Kartye scored the go-ahead goal, Dylan Garand made 23 saves and the New York Rangers rallied to beat the Philadelphia Flyers 3-2 on Thursday night.","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/4588750/tye-kartye\">Tye Kartye</a> scored the go-ahead goal, <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a> made 23 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> rallied to beat the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 3-2 on Thursday night.\n\n\r\n              After Rangers forward <a href=\"http://www.espn.com/nhl/player/_/id/4587588/pavel-dorofeyev\">Pavel Dorofeyev</a> beat goalie <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a> on a power-play to tie it, Kartye put the Rangers ahead with 4:39 left with his fifth goal. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149204/gabe-perreault\">Gabe Perreault</a> also scored for the Rangers, who won their second straight after a four-game losing streak. <a href=\"http://www.espn.com/nhl/player/_/id/4197146/adam-fox\">Adam Fox</a> had two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3096237/noel-acciari\">Noel Acciari</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4392642/simon-benoit\">Simon Benoit</a> scored for Philadelphia. The Flyers are 4-10-4.\n\n\r\n              Perreault opened the scoring with his fifth goal at 4:39 of the first, his first goal since Oct. 19.\n\n\r\n              Benoit tied it with 9:50 to go in the second before Acciari put the visitors ahead with 7:51 left in the period.\n\n\r\n              Dorofeyev, who signed a seven-year, $77 million contract to essentially replace high-scoring forward <a href=\"http://www.espn.com/nhl/player/_/id/3891952/artemi-panarin\">Artemi Panarin</a>, snapped his fifth goal past Woll with 6:08 left.\n\n\r\n              Kartye, a waiver wire pickup from Seattle late last season, then put the Rangers ahead to electrify the home crowd.\n\n\r\n              Garand improved to 6-6-1 this season. The 24-year-old netminder has started all but one game since <a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a> was injured on Oct. 9 and declared out for the season the next day.\n\n\r\n              Woll made 24 saves,\n\n\r\n              <hl2>Up next</hl2>\r\n              Rangers: At Seattle on Saturday.\n\n\r\n              Flyers: At Calgary on Sunday.\n\n\r\n              ------ <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-06T02:45:35Z"}}