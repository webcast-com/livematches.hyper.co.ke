{"header":{"id":"401872964","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401872964","uid":"s:20~l:28~e:401872964~c:401872964","date":"2026-10-02T00:15Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"5","uid":"s:20~l:28~t:5","order":0,"homeAway":"home","winner":true,"score":"27","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"21"},{"displayValue":"0"},{"displayValue":"6"}],"team":{"id":"5","abbreviation":"CLE","displayName":"Cleveland Browns","name":"Browns","location":"Cleveland","nickname":"Browns","color":"472a08","alternateColor":"ff3c00","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/cle.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/cle.png"}]}},{"id":"23","uid":"s:20~l:28~t:23","order":1,"homeAway":"away","winner":false,"score":"24","possession":false,"linescores":[{"displayValue":"7"},{"displayValue":"3"},{"displayValue":"0"},{"displayValue":"14"}],"team":{"id":"23","abbreviation":"PIT","displayName":"Pittsburgh Steelers","name":"Steelers","location":"Pittsburgh","nickname":"Steelers","color":"000000","alternateColor":"ffb612","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/pit.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/pit.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"23","abbreviation":"PIT","displayName":"Pittsburgh Steelers","shortDisplayName":"Steelers","name":"Steelers","location":"Pittsburgh","color":"000000","alternateColor":"ffb612","logo":"https://a.espncdn.com/i/teaml