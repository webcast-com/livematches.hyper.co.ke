{"header":{"id":"401873044","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873044","uid":"s:20~l:28~e:401873044~c:401873044","date":"2026-11-08T18:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"21","uid":"s:20~l:28~t:21","order":0,"homeAway":"home","winner":false,"score":"11","possession":false,"linescores":[{"displayValue":"8"},{"displayValue":"0"},{"displayValue":"0"},{"displayValue":"3"}],"team":{"id":"21","abbreviation":"PHI","displayName":"Philadelphia Eagles","name":"Eagles","location":"Philadelphia","nickname":"Eagles","color":"06424d","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/phi.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/phi.png"}]}},{"id":"19","uid":"s:20~l:28~t:19","order":1,"homeAway":"away","winner":true,"score":"19","possession":false,"linescores":[{"displayValue":"6"},{"displayValue":"0"},{"displayValue":"7"},{"displayValue":"6"}],"team":{"id":"19","abbreviation":"NYG","displayName":"New York Giants","name":"Giants","location":"New York","nickname":"Giants","color":"003c7f","alternateColor":"c9243f","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/nyg.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/nyg.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"19","abbreviation":"NYG","displayName":"New York Giants","shortDisplayName":"Giants","name":"Giants","location":"New York","color":"003c7f","alternateColor":"c9243f","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/