730441753","tiePercentage":0},{"homeWinPercentage":0.4985,"playId":"4018730441784","tiePercentage":0},{"homeWinPercentage":0.5344,"playId":"4018730441818","tiePercentage":0},{"homeWinPercentage":0.5628,"playId":"4018730441840","tiePercentage":0},{"homeWinPercentage":0.5581,"playId":"4018730441860","tiePercentage":0},{"homeWinPercentage":0.5469,"playId":"4018730441896","tiePercentage":0},{"homeWinPercentage":0.547,"playId":"4018730441906","tiePercentage":0},{"homeWinPercentage":0.5301,"playId":"4018730441916","tiePercentage":0},{"homeWinPercentage":0.5587,"playId":"4018730441962","tiePercentage":0},{"homeWinPercentage":0.5665,"playId":"4018730441992","tiePercentage":0}],"gameInfo":{"venue":{"id":"3806","guid":"a1e68291-b8a7-3428-9754-7bfc568e5d71","fullName":"Lincoln Financial Field","address":{"city":"Philadelphia","state":"PA","zipCode":"19148","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3806.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3806.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":69879,"officials":[{"fullName":"Bill Vinovich","displayName":"Bill Vinovich","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":1},{"fullName":"Todd Prukop","displayName":"Todd Prukop","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":2},{"fullName":"Aaron Santi","displayName":"Aaron Santi","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Mike Morton","displayName":"Mike Morton","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":4},{"fullName":"Brian Bolinger","displayName":"Brian Bolinger","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":5},{"fullName":"Frank LeBlanc","displayName":"Frank LeBlanc","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":6},{"fullName":"Justin Staehr","displayName":"Justin Staehr","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":7}]},"article":{"headline":"Winston, McCarthy combine to lead Giants to 19-11 win and hand Eagles 7th straight loss","description":"— J.J. McCarthy may as well have been any New York Giants fan nervously watching on TV as the injured quarterback tossed a football to keep warm and paced around the locker room.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nfl/player/_/id/4433970/jj-mccarthy\">J.J. McCarthy</a> may as well have been any <a href=\"http://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a> fan nervously watching on TV as the injured quarterback tossed a football to keep warm and paced around the locker room.\n\n\r\n              He felt a tinge of anxiety when <a href=\"http://www.espn.com/nfl/player/_/id/2969939/jameis-winston\">Jameis Winston</a> led a drive that could finally put the Giants ahead and end 13 years of misery in Philadelphia.\n\n\r\n              It took two QBs to get it done. Now, New York has control of the division.\n\n\r\n              Winston replaced McCarthy long enough to throw a go-ahead touchdown pass and help the New York Giants keep their grip on the NFC East and beat Philadelphia 19-11 on Sunday to hand the Eagles their seventh straight loss.\n\n\r\n              “The fact that J-Mo and I got to do it, it’s just a testament of what this team’s all about,” McCarthy said.\n\n\r\n              The Eagles (2-7) are on their longest losing streak since they lost eight straight games in Andy Reid’s final season in 2012. \n\n\r\n              With <a href=\"http://www.espn.com/nfl/player/_/id/4040715/jalen-hurts\">Jalen Hurts</a> likely out for the season with <a href=\"https://apnews.com/article/jalen-hurts-blood-clots-eagles-d92af6b7ce495640139dd66a39f1ee86\">blood clots</a> and a playoff berth all but gone, the Eagles could get a roster makeover at Tuesday’s NFL <a href=\"https://apnews.com/article/simmons-titans-nfl-trade-25cb37cb5b3773543697a15dd7465b8a\">trade deadline</a>.\n\n\r\n              The Giants (5-2-1) are the only team in the division with a winning record.\n\n\r\n              “Have there been games where everything’s been going well for us this year? I would like to have one or two of those,” Giants coach John Harbaugh said. “I think we need to find out how to win when everything’s going our way and see how we are, see how we handle that.”\n\n\r\n              The Eagles had beaten the Giants 13 straight times at home — including one playoff win — since New York last won on Oct. 27, 2013.\n\n\r\n              It doesn’t seem to matter who’s playing quarterback for the Giants.\n\n\r\n              McCarthy suffered a hip injury in the third quarter that briefly forced him out of the game and the Giants trailing 8-6. \n\n\r\n              Harbaugh turned to Winston — who held the starting job for four games after No. 1 QB <a href=\"http://www.espn.com/nfl/player/_/id/4689114/jaxson-dart\">Jaxson Dart</a> was injured — to rally New York.\n\n\r\n              Winston did enough in his cameo to keep New York’s first division title since 2011 within reach. He hit wide receiver <a href=\"http://www.espn.com/nfl/player/_/id/4682648/malachi-fields\">Malachi Fields</a> for 14 yards that took the ball to the Eagles 3-yard line and followed two plays later with a 5-yard TD pass to <a href=\"http://www.espn.com/nfl/player/_/id/4361050/isaiah-likely\">Isaiah Likely</a> that sent the Giants into the fourth quarter with a 13-8 lead.\n\n\r\n              Winston was 6 of 8 for 71 yards and the lone touchdown.\n\n\r\n              “Circumstances are the circumstances,” Winston said. \"But today we found a way.\"\n\n\r\n              McCarthy returned for the final play of the third quarter. He completed 12 of 19 passes for 127 yards and no touchdowns or interceptions. \n\n\r\n              “That’s big to fight through that kind of thing, fight through an injury, go back in, take care of it, get back out there,” Harbaugh said.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/5082424/dominic-zvada\">Dominic Zvada</a> kicked field goals of 53 and 49 yards for a 6-0 lead in the first quarter and connected from 38 and 49 yards in the second half for a 19-8 lead.\n\n\r\n              Like the Giants, the Eagles have also cycled through quarterbacks because of injuries and ineffectiveness.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4685201/tanner-mckee\">Tanner McKee</a> went 0-3 after taking over for Hurts as the starter before he was benched this week for <a href=\"http://www.espn.com/nfl/player/_/id/4360698/joe-milton\">Joe Milton</a>. \n\n\r\n              The 26-year-old Milton had appeared in five NFL games in relief and was suddenly tasked with saving the Eagles' season.\n\n\r\n              He showed flashes of the speed and strong arm that McKee doesn't have. Like McKee. Milton couldn't do much to move the offense.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3929630/saquon-barkley\">Saquon Barkley</a> scored on a 3-yard run late in the first quarter and — after a Giants penalty on the extra point — Milton ran in for the 2-point conversion for an 8-7 lead. Milton punctuated the score with a backflip in the end zone that got a rise out of the crowd.\n\n\r\n              Milton went 18 of 34 for 169 yards and was sacked seven times, including three times by linebacker <a href=\"http://www.espn.com/nfl/player/_/id/4950400/arvell-reese\">Arvell Reese</a>. \n\n\r\n              “Man, the Giants played great today,\" Milton said. “They had a great defensive (effort) and great players over there. What they did today was just pressure and play over top.”\n\n\r\n              <hl2>Greenard gets a sack</hl2>\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3916409/jonathan-greenard\">Jonathan Greenard</a> finally got his first sack as an Eagle after he was acquired from Minnesota in a draft-weekend trade. The edge rusher subsequently agreed to a four-year, $98 million extension, including <a href=\"https://apnews.com/article/philadelphia-eagles-nfl-draft-2026-791003d99fbab26ea970b0da085cbcf2\">$50 million</a> guaranteed. \n\n\r\n              <hl2>Mann's punts</hl2>\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4035239/braden-mann\">Braden Mann</a> unleashed an <a href=\"https://x.com/NFL/status/2119514207636877598?a=BrOlGb6hbmw1BV9dhYM&s=20\">86-yard punt</a> for the Eagles at the end of the first half. It was the longest punt in the NFL since 2001. Mann punted out of the end zone (the ball was spotted at the Eagles 8) and rolled out of bounds at the Giants' 6-yard line.\n\n\r\n              Mann followed with a 60-yarder to end the Eagles' first drive of the second half. He also lost 2 yards on a botched punt.\n\n\r\n              Former Eagles quarterback Randall Cunningham actually holds the franchise record with a <a href=\"https://x.com/EaglesHistory/status/1864062727389319571?a=KP-a-ayarCTPpunI0mc&s=20\">91-yarder</a> in 1989.\n\n\r\n              <hl2>Home improvement</hl2>\r\n              Harbaugh didn't deny a report that the Giants — with all their banged-up running backs — were interested in trading for Colts running back <a href=\"http://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a>.\n\n\r\n              “I’m not saying that report’s not true,” Harbaugh said. “Those conversations are taking place and if something happens for any player, I can’t talk about any player because they’re with other teams right now, but we’re not ruling anything out, but I don’t see anything particularly imminent right now either.”\n\n\r\n              <hl2>Up next</hl2>\r\n              Giants host the Commanders on Thursday.\n\n\r\n              Eagles head into a bye and return on Nov. 22 to host the Steelers.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-08T21:38:34Z"}}