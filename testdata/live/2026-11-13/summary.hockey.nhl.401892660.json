ortName":"D. Nurse"},"type":"shooter"},{"athlete":{"id":"4874737","displayName":"Jesper Wallstedt","shortName":"J. Wallstedt"},"type":"saver"}]},{"id":"401892660000000570","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:46"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892660000001280","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Yakov Trenin faceoff won against Collin Graf","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:46"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"30"},"participants":[{"athlete":{"id":"3904188","displayName":"Yakov Trenin","shortName":"Y. Trenin"},"type":"face-off-winner"},{"athlete":{"id":"5136607","displayName":"Collin Graf","shortName":"C. Graf"}}]},{"id":"401892660000000580","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:55"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892660000001320","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Collin Graf faceoff won against Danila Yurov","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:55"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"5136607","displayName":"Collin Graf","shortName":"C. Graf"},"type":"face-off-winner"},{"athlete":{"id":"5080172","displayName":"Danila Yurov","shortName":"D. Yurov"}}]}],"gameInfo":{"venue":{"id":"1835","guid":"ce0fbdb0-ab35-391e-9caf-9eff525fe619","fullName":"Grand Casino Arena","address":{"city":"Saint Paul","state":"MN","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1835.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19009,"officials":[{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Caleb Apperson","displayName":"Caleb Apperson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kilian McNamara","displayName":"Kilian McNamara","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kaprizov has NHL-leading 16th goal, adds 3 assists to lead Wild past Sharks, 4-1","description":"— Kirill Kaprizov scored his NHL-leading 16th goal and added three assists in the Minnesota Wild's 4-1 victory over the San Jose Sharks on Friday night.","story":"ST. PAUL, Minn. -- — <a href=\"http://www.espn.com/nhl/player/_/id/3942335/kirill-kaprizov\">Kirill Kaprizov</a> scored his NHL-leading 16th goal and added three assists in the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a>'s 4-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Friday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4320548/quinn-hughes\">Quinn Hughes</a> had a goal and two assists, and <a href=\"http://www.espn.com/nhl/player/_/id/5302535/maxim-shabanov\">Maxim Shabanov</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4002/zach-bogosian\">Zach Bogosian</a> also scored for the Wild. They are 6-0-1 in their last seven games and have 27 points, tops in the Western Conference.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874737/jesper-wallstedt\">Jesper Wallstedt</a> stopped 23 shots for his 11th victory in 16 starts, both tops among NHL goalies.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5206628/macklin-celebrini\">Macklin Celebrini</a> scored and <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a> made 25 saves for the Sharks. They are 1-6-0 in their last seven games\n\n\r\n              Shabanov broke a 1-1 tie with a power-play goal with 5:45 left in the second period. Kaprizov zipped a cross-ice pass through the slot that Shabanov redirected past Askarov at the far post.\n\n\r\n              Hughes made it 3-1 when he skated across the high slot before sending a wrist shot over Askarov's shoulder at 6:55 of the third period.\n\n\r\n              Bogosian later added his first goal of the season to seal the win for Minnesota.\n\n\r\n              Kaprizov opened the scoring when he beat Askarov from the right faceoff circle during a 5-on-3 power play at 7:56 of the first period.\n\n\r\n              San Jose tied it midway through the second period on Celebrini's seventh goal of the season. The Sharks' captain won a faceoff in the Minnesota zone and drove to the net as the puck found its way back <a href=\"http://www.espn.com/nhl/player/_/id/5646/dmitry-orlov\">Dmitry Orlov</a> at the point. Orlov fired a wrist shot that Celebrini deflected past Wallstedt.\n\n\r\n              Minnesota is 8-0-3 in its last 11 games against the Sharks.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sharks: At Dallas on Saturday night.\n\n\r\n              Wild: Host Tampa Bay on Saturday night.\n\n\r\n              ------\n\n\r\n              AP NHL: <a href=\"https://apnews.com/hub/nhl\">https://apnews.com/hub/nhl</a>","published":"2026-11-07T03:56:34Z"}}