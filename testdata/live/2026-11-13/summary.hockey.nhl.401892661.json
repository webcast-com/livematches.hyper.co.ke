arren","shortName":"N. Warren"},"type":"giver"}]},{"id":"401892661000000890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Noah Warren hit Yan Kuznetsov","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:53"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"5080210","displayName":"Noah Warren","shortName":"N. Warren"},"type":"hit-credited"},{"athlete":{"id":"4697453","displayName":"Yan Kuznetsov","shortName":"Y. Kuznetsov"},"type":"hitted"}]},{"id":"401892661000000810","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Zayne Parekh shot blocked by Noah Warren","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:15"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"5216878","displayName":"Zayne Parekh","shortName":"Z. Parekh"},"type":"shooter"},{"athlete":{"id":"5080210","displayName":"Noah Warren","shortName":"N. Warren"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1843","fullName":"Scotiabank Saddledome","address":{"city":"Calgary","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1843.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17455,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Graham Skilliter","displayName":"Graham Skilliter","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Gauthier breaks late tie to extend goals streak to 5 games, and help Ducks beat Flames 5-3","description":"— Cutter Gauthier broke a tie with 1:34 left to extend his goals streak to five games and help the Anaheim Ducks beat the Calgary Flames 5-3 on Friday night for their fourth straight victory.","story":"CALGARY, Alberta -- — <a href=\"http://www.espn.com/nhl/player/_/id/5080145/cutter-gauthier\">Cutter Gauthier</a> broke a tie with 1:34 left to extend his goals streak to five games and help the <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> 5-3 on Friday night for their fourth straight victory.\n\n\r\n              The Ducks are the first team since the 1991-92 <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> to score at least five goals in seven consecutive games.\n\n\r\n              Gauthier one-timed a pass from <a href=\"http://www.espn.com/nhl/player/_/id/5831/mikael-granlund\">Mikael Granlund</a>. He has scored 10 of his 12 goals this season during the five-game streak.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4895214/jeff-malott\">Jeff Malott</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5080220/tristan-luneau\">Tristan Luneau</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5149153/leo-carlsson\">Leo Carlsson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4755696/nikita-nesterenko\">Nikita Nesterenko</a>, into an empty net, also scored for Anaheim. Granlund and <a href=\"http://www.espn.com/nhl/player/_/id/5216858/beckett-sennecke\">Beckett Sennecke</a> each had two assists.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874893/william-stromgren\">William Stromgren</a>, <a href=\"http://www.espn.com/nhl/player/_/id/3149612/joel-hanley\">Joel Hanley</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4352750/joel-farabee\">Joel Farabee</a> scored for Calgary. <a href=\"http://www.espn.com/nhl/player/_/id/4233685/morgan-frost\">Morgan Frost</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5216878/zayne-parekh\">Zayne Parekh</a> each had a pair of assists as the Flames’ five-game home winning streak ended.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4588165/lukas-dostal\">Lukas Dostal</a> got the start for Anaheim, but was chased after giving up three goals on 11 shots in the first period. <a href=\"http://www.espn.com/nhl/player/_/id/3151137/ville-husso\">Ville Husso</a>, who gave up seven goals in his last appearance, came on in relief and stopped all 10 shots he faced. He improved to 2-3-0.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587952/dustin-wolf\">Dustin Wolf</a>, making his third straight start, had 24 stops for Calgary.\n\n\r\n              The Flames took a 3-2 lead to the third period, but when <a href=\"http://www.espn.com/nhl/player/_/id/4874730/matt-coronato\">Matt Coronato</a> was sent off for delay of game 17 seconds in, Anaheim’s red-hot power play took advantage with Carlsson tying it at 55 seconds.\n\n\r\n              The Ducks' <a href=\"http://www.espn.com/nhl/player/_/id/4565262/jackson-lacombe\">Jackson LaCombe</a> had an assist to extend his points streak to nine games, the longest in franchise history for a defenseman. He passed Scott Niedermayer (2006-07) and Oleg Tverdovsky (1999-00) on the team list.\n\n\r\n              <hl2>Up next</hl2>\r\n              Ducks: Host Pittsburgh on Sunday.\n\n\r\n              Flames: Host Philadelphia on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-07T04:16:36Z"}}