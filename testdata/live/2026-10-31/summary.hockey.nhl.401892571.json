00890","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Timothy Liljegren hit Ryan McLeod","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"4233618","displayName":"Timothy Liljegren","shortName":"T. Liljegren"},"type":"hit-credited"},{"athlete":{"id":"4378669","displayName":"Ryan McLeod","shortName":"R. McLeod"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1823","fullName":"Capital One Arena","address":{"city":"Washington","state":"DC","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1823.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18347,"officials":[{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Alex Tuch gets winner against former team and Dylan Strome scores twice, as Capitals beat Sabres 4-3","description":"— Alex Tuch scored two goals, including the winner in overtime, to lead the Washington Capitals to a win over the Buffalo Sabres, 4-3 on Saturday night.","story":"WASHINGTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> scored two goals, including the winner in overtime, to lead the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> to a win over the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a>, 4-3 on Saturday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3095975/charlie-lindgren\">Charlie Lindgren</a> made 18 saves for the Capitals.\n\n\r\n              Tuch opened the scoring for Washington when a pass bounced off Tage Thompson’s stick and into his own net. <a href=\"http://www.espn.com/nhl/player/_/id/3899933/dylan-strome\">Dylan Strome</a> scored 2:59 into the second period, then once more with 2:36 left in the period. \n\n\r\n              Tuch was acquired this summer by the Capitals from the Sabres via sign-and-trade. He signed an eight-year, $84 million deal to help bolster the Capitals' offense. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697389/jack-quinn\">Jack Quinn</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874870/josh-doan\">Josh Doan</a> scored early for Buffalo to put the visitors up by two. The Capitals’ offense found its footing, though, and turned up the pressure on the Sabres’ defense to gain the lead in the second period, only to have <a href=\"http://www.espn.com/nhl/player/_/id/5080160/noah-ostlund\">Noah Ostlund</a> tie it once again 2:20 into the third period. The game remained tied through the remainder of the third period, despite multiple power play opportunities and scoring chances for both teams.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233889/ukko-pekka-luukkonen\">Ukko-Pekka Luukkonen</a> made 30 saves for the Sabres.\n\n\r\n              The <a href=\"https://apnews.com/article/kings-capitals-score-9767bca46c327d2c4a99af4ca0493159\">Capitals were coming off a loss</a> to the previously winless <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> on Tuesday. And, after a three-day break which allowed them to get both Pierre Luc-Dubois and <a href=\"http://www.espn.com/nhl/player/_/id/4697783/justin-sourdif\">Justin Sourdif</a> back into the forward lines, the looked far more complete against the Sabres. \n\n\r\n              <a href=\"https://apnews.com/hub/buffalo-sabres\">Buffalo</a> has now lost three games in a row and has just three points in its last five games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sabres: At the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Tuesday \n\n\r\n              Capitals: Host the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-25T01:53:45Z"}}