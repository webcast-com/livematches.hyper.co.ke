splayName":"Ty Dellandrea","shortName":"T. Dellandrea"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1824","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Bruins extend points streak to 8 games with 6-4 win over Sharks","description":"— James Hagens and David Pastrnak scored in a 40-second span in the third period, and the Boston Bruins extended their points streak to eight games with a 6-4 victory over the San Jose Sharks on Saturday night.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/5275337/james-hagens\">James Hagens</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> scored in a 40-second span in the third period, and the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> extended their points streak to eight games with a 6-4 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> on Saturday night. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233575/casey-mittelstadt\">Casey Mittelstadt</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697442/marat-khusnutdinov\">Marat Khusnutdinov</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5080207/fraser-minten\">Fraser Minten</a> and Will Morgan also scored for the Bruins, who have won seven of their past eight. <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> made 21 saves for his seventh victory.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5291934/michael-misa\">Michael Misa</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4391255/kiefer-sherwood\">Kiefer Sherwood</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5646/dmitry-orlov\">Dmitry Orlov</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149155/will-smith\">Will Smith</a> scored for San Jose, and <a href=\"http://www.espn.com/nhl/player/_/id/3114994/alex-nedeljkovic\">Alex Nedeljkovic</a> made 29 saves. The Sharks had won two in a row.\n\n\r\n              The game was tied at 2-2 through two periods, with the Sharks responding each time the Bruins took a one-goal lead. \n\n\r\n              San Jose took its first lead of the game when Orlove fired a one-timer on the power play at 4:03 of the third. It was the third special-teams goal of the game for the Sharks and Orlove’s second goal of the season. \n\n\r\n              Pastrnak exited the penalty box and took a feed from J.J. Peterka before firing in a shot from the right circle for his seventh goal at 8:27 of the third. The tying goal pushed Pastrnak into a tie for third place with former Bruin Patrice Bergeron in career goals (427). \n\n\r\n              <hl2>Up next </hl2>\r\n              Sharks: Host Buffalo on Tuesday night. \n\n\r\n              Bruins: At Carolina on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-25T02:06:48Z"}}