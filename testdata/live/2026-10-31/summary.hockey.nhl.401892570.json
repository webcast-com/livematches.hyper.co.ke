splayValue":"1st"},"team":{"id":"16"},"participants":[{"athlete":{"id":"5080158","displayName":"Rutger McGroarty","shortName":"R. McGroarty"},"type":"shooter"},{"athlete":{"id":"3042109","displayName":"Juuse Saros","shortName":"J. Saros"}}]},{"id":"401892570000001050","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892570000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mavrik Bourque faceoff won against Sidney Crosby","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"27"},"participants":[{"athlete":{"id":"4697413","displayName":"Mavrik Bourque","shortName":"M. Bourque"},"type":"face-off-winner"},{"athlete":{"id":"3114","displayName":"Sidney Crosby","shortName":"S. Crosby"}}]},{"id":"401892570000000870","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Filip Forsberg","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:48"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"27"},"participants":[{"athlete":{"id":"2968772","displayName":"Filip Forsberg","shortName":"F. Forsberg"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1837","fullName":"PPG Paints Arena","address":{"city":"Pittsburgh","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1837.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18191,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Ville Koivunen scores in OT as Penguins rally for 3-2 win over Predators","description":"— Ville Koivunen scored at 3:44 of overtime and the Pittsburgh Penguins rallied to beat the Nashville Predators 3-2 on Saturday night.","story":"PITTSBURGH -- — <a href=\"http://www.espn.com/nhl/player/_/id/4874911/ville-koivunen\">Ville Koivunen</a> scored at 3:44 of overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> rallied to beat the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a> 3-2 on Saturday night.\n\n\r\n              Koivunen beat <a href=\"http://www.espn.com/nhl/player/_/id/3042109/juuse-saros\">Juuse Saros</a> with a wrist shot from the top of the left circle.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2562629/rickard-rakell\">Rickard Rakell</a> scored the tying goal for Pittsburgh with 1:06 to play in regulation on a cross-ice pass from <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a>. It was Crosby’s 1,111th career assist, tying Hall of Fame defenseman Ray Bourque for the most with one franchise.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4588004/connor-dewar\">Connor Dewar</a> also scored for the Penguins, who have points in 10 straight and 23 of their last 27 games against Nashville dating to Oct. 21, 2010.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a> stopped 24 shots. The Penguins, who were playing without <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a> (illness) and <a href=\"http://www.espn.com/nhl/player/_/id/4697404/egor-chinakhov\">Egor Chinakhov</a> (lower body), have won two straight following a four-game losing streak. Chinakhov has missed four of the last five games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5037/steven-stamkos\">Steven Stamkos</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565269/jayden-struble\">Jayden Struble</a> scored for Nashville. Stamkos is two goals from passing Dino Ciccarelli for 19th place in NHL history.\n\n\r\n              Saros made 34 saves for the Predators, who have lost two in a row and five of six. Nashville was blanked 6-0 at Boston on Thursday.\n\n\r\n              Struble put Nashville in front 2-1 at 6:40 of the second period when he beat Silovs from the right faceoff dot.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4378671/jack-drury\">Jack Drury</a> nearly scored at the end of the second to make it a 3-1 game. Drury dove at a loose puck and pushed it across the line, but time expired before it crossed.\n\n\r\n              That allowed Rakell and Koivunen to help the Penguins rally in the third period and overtime.\n\n\r\n              <hl2>Up next</hl2>\r\n              Predators: Host the <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> on Sunday.\n\n\r\n              Penguins: Host the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-25T02:09:45Z"}}