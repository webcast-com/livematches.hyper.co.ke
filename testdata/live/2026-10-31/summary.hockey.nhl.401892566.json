coringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Sean Couturier Wrist Shot Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"2562601","displayName":"Sean Couturier","shortName":"S. Couturier"},"type":"shooter"},{"athlete":{"id":"4588165","displayName":"Lukas Dostal","shortName":"L. Dostal"}}]}],"gameInfo":{"venue":{"id":"1845","fullName":"Xfinity Mobile Arena","address":{"city":"Philadelphia","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1845.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19336,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shawn Oliver","displayName":"Shawn Oliver","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Leo Carlsson rallies the Ducks to a 5-4 victory over the Flyers","description":"— Leo Carlsson scored a goal and set up the game-winner against the team that tried to sign him away from Anaheim last summer, as the Ducks overcame a two-goal deficit to beat the Philadelphia Flyers 5-4 on Saturday.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nhl/player/_/id/5149153/leo-carlsson\">Leo Carlsson</a> scored a goal and set up the game-winner against the team that tried to sign him away from Anaheim last summer, as the Ducks overcame a two-goal deficit to beat the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 5-4 on Saturday. \n\n\r\n              Philadelphia signed Carlsson to a five-year, $80 million offer sheet as a restricted free agent last July, only to have the Ducks match it and retain him. He scored the Ducks' first goal at 8:38 of the second period on a pass from <a href=\"http://www.espn.com/nhl/player/_/id/5080145/cutter-gauthier\">Cutter Gauthier</a>, who continued to hear vitriolic chants from Philadelphia fans for forcing his way out of Philadelphia three years ago.\n\n\r\n              Carlsson later assisted on a power-play goal by <a href=\"http://www.espn.com/nhl/player/_/id/5216858/beckett-sennecke\">Beckett Sennecke</a> in the third period, firing a pass toward the net that Sennecke tipped past Flyers goalie <a href=\"http://www.espn.com/nhl/player/_/id/4271575/joseph-woll\">Joseph Woll</a>. \n\n\r\n              Carlsson leads the Ducks in scoring with 13 points (3 goals, 10 assists).\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3648015/aj-greer\">A.J. Greer</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4755684/judd-caulfield\">Judd Caulfield</a>, and <a href=\"http://www.espn.com/nhl/player/_/id/5080220/tristan-luneau\">Tristan Luneau</a> also scored for Anaheim, and <a href=\"http://www.espn.com/nhl/player/_/id/4588165/lukas-dostal\">Lukas Dostal</a> made 28 saves to snap the Ducks’ five-game losing streak.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149170/matvei-michkov\">Matvei Michkov</a> extended his point streak to five games when he scored the first of two goals for the Flyers on the same power-play opportunity. Michkov snapped a wrister through <a href=\"http://www.espn.com/nhl/player/_/id/5291941/porter-martone\">Porter Martone</a>'s screen during a 5-on-3 advantage to score his seventh goal of the season. Martone followed 1:03 later to build an early two-goal lead for the Flyers. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697406/tyson-foerster\">Tyson Foerster</a> also scored a goal and Michkov added a second tally in the third period, but Philadelphia never could draw back even, and had its three-game winning streak snapped. \n\n\r\n              <hl2>Up next</hl2>\r\n              Ducks: Begin a three-game homestand Tuesday against Vancouver.\n\n\r\n              Flyers: Host the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> on Tuesday.","published":"2026-10-24T20:03:46Z"}}