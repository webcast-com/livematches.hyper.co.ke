{"header":{"id":"401873059","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873059","uid":"s:20~l:28~e:401873059~c:401873059","date":"2026-11-15T18:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"11","uid":"s:20~l:28~t:11","order":0,"homeAway":"home","winner":true,"score":"24","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"14"},{"displayValue":"10"},{"displayValue":"0"}],"team":{"id":"11","abbreviation":"IND","displayName":"Indianapolis Colts","name":"Colts","location":"Indianapolis","nickname":"Colts","color":"003b75","alternateColor":"ffffff","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ind.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/ind.png"}]}},{"id":"15","uid":"s:20~l:28~t:15","order":1,"homeAway":"away","winner":false,"score":"22","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"7"},{"displayValue":"9"},{"displayValue":"6"}],"team":{"id":"15","abbreviation":"MIA","displayName":"Miami Dolphins","name":"Dolphins","location":"Miami","nickname":"Dolphins","color":"008e97","alternateColor":"fc4c02","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/mia.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/mia.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"15","abbreviation":"MIA","displayName":"Miami Dolphins","shortDisplayName":"Dolphins","name":"Dolphins","location":"Miami","color":"008e97","alternateColor":"fc4c02","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/m