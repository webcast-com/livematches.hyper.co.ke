nner"},{"athlete":{"id":"5160","displayName":"John Tavares","shortName":"J. Tavares"}}]},{"id":"401892710000000070","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:13"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892710000000590","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jason Dickinson faceoff won against John Tavares","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:13"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"3042062","displayName":"Jason Dickinson","shortName":"J. Dickinson"},"type":"face-off-winner"},{"athlete":{"id":"5160","displayName":"John Tavares","shortName":"J. Tavares"}}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19002,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"McDavid extends season-opening points streak to 21 games, Oilers beat Maple Leafs 1-0","description":"— Connor McDavid extended his season-opening points streak to 21 games with an assist, Devon Levi made 19 saves for his first NHL shutout and the Edmonton Oilers beat Toronto 1-0 on Saturday night to hand the Maple Leafs their sixth straight home loss.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> extended his season-opening points streak to 21 games with an assist, <a href=\"http://www.espn.com/nhl/player/_/id/4894487/devon-levi\">Devon Levi</a> made 19 saves for his first NHL shutout and the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> beat Toronto 1-0 on Saturday night to hand the Maple Leafs their sixth straight home loss.\n\n\r\n              Defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4352722/evan-bouchard\">Evan Bouchard</a> scored his 12th goal of the season for Edmonton (15-3-3). The Oilers are 7-1-1 in their last nine games.\n\n\r\n              McDavid picked up an assist to give him 50 points (11 goals, 39 assists) and add to his NHL lead.\n\n\r\n              Oilers coach Mike Babcock faced his former team in Toronto for the first time since being fired in November 2019.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3067313/anthony-stolarz\">Anthony Stolarz</a> stopped 22 shots for Toronto (8-12-2), which suffered its sixth consecutive regulation loss to complete a disastrous six-game stretch at Scotiabank Arena.\n\n\r\n              The goaltender started consecutive games for the first time this season with <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> struggling to find traction after signing with the Maple Leafs in free agency on July 1.\n\n\r\n              Toronto dropped to 1-8-0 over its last nine.\n\n\r\n              <hl2>Up next</hl2>\r\n              Oilers: At Philadelphia on Sunday.\n\n\r\n              Maple Leafs: At Chicago on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-15T03:07:34Z"}}