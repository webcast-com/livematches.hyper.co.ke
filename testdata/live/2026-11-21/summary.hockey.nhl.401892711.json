eviation":"stoppage"},"clock":{"displayValue":"1:33"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892711000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Nicolas Roy faceoff won against Phillip Danault","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:33"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"3943996","displayName":"Nicolas Roy","shortName":"N. Roy"},"type":"face-off-winner"},{"athlete":{"id":"2562602","displayName":"Phillip Danault","shortName":"P. Danault"}}]},{"id":"401892711000000790","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Noah Juulsen","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"3900504","displayName":"Noah Juulsen","shortName":"N. Juulsen"},"type":"giver"}]},{"id":"401892711000000760","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Alexandre Texier Snap Shot High and Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:40"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"10"},"participants":[{"athlete":{"id":"4233880","displayName":"Alexandre Texier","shortName":"A. Texier"},"type":"shooter"},{"athlete":{"id":"3904177","displayName":"Mackenzie Blackwood","shortName":"M. Blackwood"}}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Avalanche beat Canadiens 4-1 without injured stars MacKinnon, Makar","description":"— Artturi Lehkonen had a goal and an assist and the short-handed Colorado Avalanche beat the Montreal Canadiens 4-1 on Saturday night without injured stars Nathan MacKinnon and Cale Makar.","story":"MONTREAL -- — <a href=\"http://www.espn.com/nhl/player/_/id/3042050/artturi-lehkonen\">Artturi Lehkonen</a> had a goal and an assist and the short-handed <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> 4-1 on Saturday night without injured stars <a href=\"http://www.espn.com/nhl/player/_/id/3041969/nathan-mackinnon\">Nathan MacKinnon</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233563/cale-makar\">Cale Makar</a>.\n\n\r\n              MacKinnon and Makar both sustained lower-body injuries Thursday night in a 4-3 overtime loss in Ottawa. Avalanche coach Jared Bednar said MacKinnon will be out at least a month, while Makar is expected to miss two weeks.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874736/fedor-svechkov\">Fedor Svechkov</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5798/brock-nelson\">Brock Nelson</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3943996/nicolas-roy\">Nicolas Roy</a> also scored for Colorado (12-6-3). <a href=\"http://www.espn.com/nhl/player/_/id/3904177/mackenzie-blackwood\">Mackenzie Blackwood</a> stopped 25 shots.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> replied with a highlight-reel goal for Montreal (12-4-4), which had gone 12 consecutive games without losing in regulation (9-0-3).\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697686/jakub-dobes\">Jakub Dobes</a> made 22 saves in his first start in nine days.\n\n\r\n              Colorado defenseman <a href=\"http://www.espn.com/nhl/player/_/id/2300/brent-burns\">Brent Burns</a> became the 14th player in NHL history — and only active player — to play in 1,600 games. The 41-year-old defender has suited up in 1,028 consecutive contests dating to Nov. 21, 2013. Phil Kessel holds the NHL’s “Ironman” record at 1,064 straight games, a number Burns could pass Feb. 15.\n\n\r\n              <hl2>Up next</hl2>\r\n              Avalanche: At Utah on Wednesday night.\n\n\r\n              Canadiens: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Monday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-15T03:19:34Z"}}