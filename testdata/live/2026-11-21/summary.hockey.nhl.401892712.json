"abbreviation":"shot-blocked"},"clock":{"displayValue":"2:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"4697470","displayName":"Gage Goncalves","shortName":"G. Goncalves"},"type":"shooter"},{"athlete":{"id":"5246","displayName":"Ben Chiarot","shortName":"B. Chiarot"},"type":"defender"}]},{"id":"401892712000001210","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Sam O'Reilly hit Michael Rasmussen","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"5216901","displayName":"Sam O'Reilly","shortName":"S. O'Reilly"},"type":"hit-credited"},{"athlete":{"id":"4233576","displayName":"Michael Rasmussen","shortName":"M. Rasmussen"},"type":"hitted"}]},{"id":"401892712000001390","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Anton Johansson hit Ilya Mikheyev","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:06"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"5188582","displayName":"Anton Johansson","shortName":"A. Johansson"},"type":"hit-credited"},{"athlete":{"id":"4422415","displayName":"Ilya Mikheyev","shortName":"I. Mikheyev"},"type":"hitted"}]},{"id":"401892712000001430","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Zemgus Girgensons hit Lucas Raymond","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:13"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"2968829","displayName":"Zemgus Girgensons","shortName":"Z. Girgensons"},"type":"hit-credited"},{"athlete":{"id":"4697385","displayName":"Lucas Raymond","shortName":"L. Raymond"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1396","fullName":"Benchmark International Arena","address":{"city":"Tampa","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1396.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19092,"officials":[{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Tarasov gets shutout, Raymond has 2 points as Red Wings defeat Lightning 2-0","description":"— Daniil Tarasov stopped 31 shots for his second shutout of the season, Lucas Raymond had a goal and two points and the Detroit Red Wings beat the Tampa Bay Lightning 2-0 on Saturday.","story":"TAMPA, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4587994/daniil-tarasov\">Daniil Tarasov</a> stopped 31 shots for his second shutout of the season, <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> had a goal and two points and the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> 2-0 on Saturday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216883/michael-brandsegg-nygard\">Michael Brandsegg-Nygard</a> also scored to help the Red Wings snap a five-game losing streak.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2976847/andrei-vasilevskiy\">Andrei Vasilevskiy</a> stopped 20 shots for Tampa Bay, which was shut out for the first time since December 8, 2025 at Toronto.\n\n\r\n              The Lightning lost for the first time at home this season, ending a franchise record eight-game home winning streak to start the season.\n\n\r\n              Detroit, after failing to hold on to a three-goal lead <a href=\"https://apnews.com/article/red-wings-panthers-score-46723e7beb09a54dda35e52e3b7d6fdf\">on Thursday against Florida</a>, took the lead late in the second period.\n\n\r\n              Less than a minute after Tarasov made a lunging stick save on <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> at the left post, <a href=\"http://www.espn.com/nhl/player/_/id/4697436/william-wallinder\">William Wallinder</a> sent a pass up ice to Raymond, who was able to settle the puck with his skate and kick it to his stick to split the defense at center ice. Raymond skated in alone on a breakaway before beating Vasilevskiy to the glove side at 13:12.\n\n\r\n              Tampa Bay failed to convert on a pair of power play chances in the third.\n\n\r\n              Brandsegg-Nygard added the empty net goal with 43 seconds left.\n\n\r\n              The Lightning played their second consecutive game without center <a href=\"http://www.espn.com/nhl/player/_/id/3941973/anthony-cirelli\">Anthony Cirelli</a> and defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3904178/erik-cernak\">Erik Cernak</a>, while <a href=\"http://www.espn.com/nhl/player/_/id/3151187/brayden-point\">Brayden Point</a> missed his third consecutive game.\n\n\r\n              <hl2>Up Next</hl2>\r\n              Detroit: hosts Boston on Wednesday.\n\n\r\n              Tampa Bay: hosts Washington on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-15T02:53:36Z"}}