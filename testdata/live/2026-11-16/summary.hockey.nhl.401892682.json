a Sorokin","shortName":"I. Sorokin"}}]},{"id":"401892682000000860","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Michael Kesselring hit Simon Holmstrom","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"0:43"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"4331604","displayName":"Michael Kesselring","shortName":"M. Kesselring"},"type":"hit-credited"},{"athlete":{"id":"4565244","displayName":"Simon Holmstrom","shortName":"S. Holmstrom"},"type":"hitted"}]},{"id":"401892682000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jean-Gabriel Pageau Wrist Shot saved by Yaroslav Askarov","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:05"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"2593131","displayName":"Jean-Gabriel Pageau","shortName":"J. Pageau"},"type":"shooter"},{"athlete":{"id":"4697394","displayName":"Yaroslav Askarov","shortName":"Y. Askarov"},"type":"saver"}]},{"id":"401892682000000880","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Ondrej Palat","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"2590389","displayName":"Ondrej Palat","shortName":"O. Palat"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1653","fullName":"SAP Center at San Jose","address":{"city":"San Jose","state":"CA","zipCode":"95196","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1653.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13769,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Riley Brace","displayName":"Riley Brace","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Ivar Stenberg leads the Sharks past the Islanders 3-2 in a shootout to stop their 5-game skid","description":"— Ivar Stenberg scored the only goal in a shootout that lasted eight rounds, and the San Jose Sharks beat the New York Islanders 3-2 on Monday night to snap a five-game losing streak.","story":"SAN JOSE, Calif. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5361709/ivar-stenberg\">Ivar Stenberg</a> scored the only goal in a shootout that lasted eight rounds, and the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> 3-2 on Monday night to snap a five-game losing streak.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5550/tyler-toffoli\">Tyler Toffoli</a> had a goal and an assist, and Stenberg also scored in regulation for the Sharks (8-11-1). Stenberg has six goals and is tied for the scoring lead among NHL rookies.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a> made 30 saves for San Jose.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3571762/ben-hutton\">Ben Hutton</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5291952/victor-eklund\">Victor Eklund</a> scored for the Islanders (7-6-4), who have lost four straight games (0-2-2). <a href=\"http://www.espn.com/nhl/player/_/id/3151981/ilya-sorokin\">Ilya Sorokin</a> stopped 37 shots.\n\n\r\n              Stenberg put the Sharks on the board late in the first period after Toffoli sent a shot toward the net. Stenberg got a piece of the puck to redirect it past Sorokin and tie the game at 1.\n\n\r\n              San Jose again rallied from a goal down midway through the second when Toffoli’s shot deflected off Islanders defenseman <a href=\"http://www.espn.com/nhl/player/_/id/3069621/adam-pelech\">Adam Pelech</a> and into the net. It was Toffoli’s first goal in eight games.\n\n\r\n              Hutton opened the scoring early in the first after Simon Holmstrom’s pass found him with an open look.\n\n\r\n              Eklund put New York ahead 2-1 early in the second with a power-play goal. Sharks center <a href=\"http://www.espn.com/nhl/player/_/id/3042017/alexander-wennberg\">Alexander Wennberg</a>, who returned after missing 10 games, was called for the penalty that led to the power play.\n\n\r\n              The game got chippy late in the second as fights broke out, leading to four five-minute major penalties. <a href=\"http://www.espn.com/nhl/player/_/id/3069411/barclay-goodrow\">Barclay Goodrow</a> received a penalty for fighting <a href=\"http://www.espn.com/nhl/player/_/id/4419646/mitchell-chaffee\">Mitchell Chaffee</a>, and <a href=\"http://www.espn.com/nhl/player/_/id/4352747/ty-dellandrea\">Ty Dellandrea</a> was penalized for fighting <a href=\"http://www.espn.com/nhl/player/_/id/4393199/kyle-maclean\">Kyle MacLean</a>.\n\n\r\n              <hl2>Up next</hl2>\r\n              Islanders: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/la/los-angeles-kings\">Los Angeles Kings</a> on Thursday night.\n\n\r\n              Sharks: Host the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-10T06:28:34Z"}}