{"header":{"id":"401873058","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873058","uid":"s:20~l:28~e:401873058~c:401873058","date":"2026-11-15T18:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"1","uid":"s:20~l:28~t:1","order":0,"homeAway":"home","winner":false,"score":"13","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"3"},{"displayValue":"0"},{"displayValue":"10"}],"team":{"id":"1","abbreviation":"ATL","displayName":"Atlanta Falcons","name":"Falcons","location":"Atlanta","nickname":"Falcons","color":"a71930","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png"}]}},{"id":"12","uid":"s:20~l:28~t:12","order":1,"homeAway":"away","winner":true,"score":"35","possession":false,"linescores":[{"displayValue":"7"},{"displayValue":"7"},{"displayValue":"7"},{"displayValue":"14"}],"team":{"id":"12","abbreviation":"KC","displayName":"Kansas City Chiefs","name":"Chiefs","location":"Kansas City","nickname":"Chiefs","color":"e31837","alternateColor":"ffb612","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/kc.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/kc.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"12","abbreviation":"KC","displayName":"Kansas City Chiefs","shortDisplayName":"Chiefs","name":"Chiefs","location":"Kansas City","color":"e31837","alternateColor":"ffb612","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/