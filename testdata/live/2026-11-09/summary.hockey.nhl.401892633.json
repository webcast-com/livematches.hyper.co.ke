athlete":{"id":"3042111","displayName":"Nick Paul","shortName":"N. Paul"},"type":"face-off-winner"},{"athlete":{"id":"4352699","displayName":"Barrett Hayton","shortName":"B. Hayton"}}]},{"id":"401892633000000640","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Easton Cowan Wrist Shot saved by Sebastian Cossa","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"0:39"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"5149211","displayName":"Easton Cowan","shortName":"E. Cowan"},"type":"shooter"},{"athlete":{"id":"4874732","displayName":"Sebastian Cossa","shortName":"S. Cossa"},"type":"saver"}]},{"id":"401892633000000690","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Lawson Crouse Wrist Shot Above Crossbar","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:04"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"3899951","displayName":"Lawson Crouse","shortName":"L. Crouse"},"type":"shooter"},{"athlete":{"id":"5571","displayName":"Sergei Bobrovsky","shortName":"S. Bobrovsky"}}]},{"id":"401892633000000070","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:10"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892633000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Auston Matthews faceoff won against Nick Schmaltz","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"4024123","displayName":"Auston Matthews","shortName":"A. Matthews"},"type":"face-off-winner"},{"athlete":{"id":"3114770","displayName":"Nick Schmaltz","shortName":"N. Schmaltz"}}]},{"id":"401892633000000740","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jack McBain shot blocked by Auston Matthews","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:32"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"4755695","displayName":"Jack McBain","shortName":"J. McBain"},"type":"shooter"},{"athlete":{"id":"4024123","displayName":"Auston Matthews","shortName":"A. Matthews"},"type":"defender"}]},{"id":"401892633000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jack McBain Snap Shot saved by Sergei Bobrovsky","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"4755695","displayName":"Jack McBain","shortName":"J. McBain"},"type":"shooter"},{"athlete":{"id":"5571","displayName":"Sergei Bobrovsky","shortName":"S. Bobrovsky"},"type":"saver"}]},{"id":"401892633000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:37"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18889,"officials":[{"fullName":"David Brisebois","displayName":"David Brisebois","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Garrett Rank","displayName":"Garrett Rank","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Grillo","displayName":"Brandon Grillo","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Schmaltz scores on the power play late in regulation to lift Mammoth past Maple Leafs 3-2","description":"— Nick Schmaltz scored the winner on a power play with 6:48 left in regulation and the Utah Mammoth beat the Toronto Maple Leafs 3-2 on Tuesday night.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114770/nick-schmaltz\">Nick Schmaltz</a> scored the winner on a power play with 6:48 left in regulation and the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> 3-2 on Tuesday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874723/dylan-guenther\">Dylan Guenther</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4064936/andrew-peeke\">Andrew Peeke</a> also scored for Utah. <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a> made 27 saves. <a href=\"http://www.espn.com/nhl/player/_/id/4024857/clayton-keller\">Clayton Keller</a> added three assists and Mikail Sergachev had a pair.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3904098/jack-roslovic\">Jack Roslovic</a> scored twice for Toronto, which got 33 stops from <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a>. <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> assisted on Roslovic's goals.\n\n\r\n              Schmaltz snapped a 2-all tie when he buried a loose puck in the crease on the man advantage after Bobrovsky made a huge stop on Keller.\n\n\r\n              Down 2-1 in the third period, the Maple Leafs tied it at 9:05 when Rosolvic moved in alone on Cossa and scored his second of the night on a backhand shot.\n\n\r\n              A two-time Stanley Cup champion signed over the summer to a big-money deal in free agency for the next three seasons, Bobrovsky entered with a 3-5-2 record, .885 save percentage and a 3.29 goals-against average.\n\n\r\n              The 38-year-old, who had allowed three goals or more in nine of 10 starts entering Tuesday, was helped out by some posts in the first, but could do nothing against the NHL’s top-ranked power play when Guenther shot through a screen with 12.4 seconds left on the clock in the first.\n\n\r\n              Toronto tied it at 10:20 of the second when Roslovic scored past Cossa moments after Maple Leafs defenseman Troy Stecher’s stick exploded on an odd-man rush before Peeke pushed the visitors ahead with a controversial goal at 13:42.\n\n\r\n              Peeke’s blast through traffic beat Bobrovsky at 13:42 of the second for a 2-1 lead. Mammoth center <a href=\"http://www.espn.com/nhl/player/_/id/4352699/barrett-hayton\">Barrett Hayton</a> appeared to interfere with the netminder when their skates touched, but the officials ruled the sequence a good goal. The Maple Leafs then declined to challenge and risk a minor penalty.\n\n\r\n              The Mammoth will have played 13 of their first 19 games on the road before returning home on Nov. 12 against the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a>.\n\n\r\n              <hl2>Up next</hl2>\r\n              Mammoth: At <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> on Thursday.\n\n\r\n              Maple Leafs: Host the Montreal Canadiens on Saturday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-04T03:05:47Z"}}