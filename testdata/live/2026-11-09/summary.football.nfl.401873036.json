playId":"4018730361382","tiePercentage":0},{"homeWinPercentage":0.3514,"playId":"4018730361407","tiePercentage":0},{"homeWinPercentage":0.3514,"playId":"4018730361417","tiePercentage":0},{"homeWinPercentage":0.3501,"playId":"4018730361427","tiePercentage":0},{"homeWinPercentage":0.3411,"playId":"4018730361462","tiePercentage":0},{"homeWinPercentage":0.3397,"playId":"4018730361487","tiePercentage":0},{"homeWinPercentage":0.3116,"playId":"4018730361509","tiePercentage":0},{"homeWinPercentage":0.3227,"playId":"4018730361532","tiePercentage":0},{"homeWinPercentage":0.3223,"playId":"4018730361545","tiePercentage":0},{"homeWinPercentage":0.32,"playId":"4018730361558","tiePercentage":0},{"homeWinPercentage":0.2894,"playId":"4018730361587","tiePercentage":0},{"homeWinPercentage":0.3072,"playId":"4018730361612","tiePercentage":0},{"homeWinPercentage":0.2438,"playId":"4018730361634","tiePercentage":0},{"homeWinPercentage":0.2438,"playId":"4018730361661","tiePercentage":0},{"homeWinPercentage":0.242,"playId":"4018730361672","tiePercentage":0},{"homeWinPercentage":0.2452,"playId":"4018730361683","tiePercentage":0},{"homeWinPercentage":0.2747,"playId":"4018730361715","tiePercentage":0},{"homeWinPercentage":0.2733,"playId":"4018730361737","tiePercentage":0},{"homeWinPercentage":0.2748,"playId":"4018730361741","tiePercentage":0}],"gameInfo":{"venue":{"id":"3673","guid":"35e528a7-d270-3182-b51f-612c9ad0045d","fullName":"Lumen Field","address":{"city":"Seattle","state":"WA","zipCode":"98134","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3673.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3673.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":68739,"officials":[{"fullName":"Dino Paganelli","displayName":"Dino Paganelli","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":2},{"fullName":"Dyrol Prioleau","displayName":"Dyrol Prioleau","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Jeff Seeman","displayName":"Jeff Seeman","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":1},{"fullName":"Keith Parham","displayName":"Keith Parham","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":4},{"fullName":"Shawn Smith","displayName":"Shawn Smith","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":5},{"fullName":"Tra Blake","displayName":"Tra Blake","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":6},{"fullName":"Jay Bilbo","displayName":"Jay Bilbo","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Caleb Williams and Jeffery Simmons lead the Bears past the Seahawks 34-17","description":"— Jeffery Simmons ran out of the tunnel for the first time since joining the Chicago Bears with a new uniform, orange sleeves and a wide smile as he welcomed the move that put right into contention...","story":"SEATTLE -- — <a href=\"http://www.espn.com/nfl/player/_/id/4035369/jeffery-simmons\">Jeffery Simmons</a> ran out of the tunnel for the first time since joining the <a href=\"https://apnews.com/hub/chicago-bears\"><a href=\"http://www.espn.com/nfl/team/_/name/chi/chicago-bears\">Chicago Bears</a></a> with a new uniform, orange sleeves and a wide smile as he welcomed the move that put right into contention with important games on big stages.\n\n\r\n              Then he delivered exactly what the Bears needed.\n\n\r\n              Simmons had a sack in his Bears debut as part of a dominant defensive performance that helped lead Chicago to a 34-17 victory over the <a href=\"https://apnews.com/hub/seattle-seahawks\"><a href=\"http://www.espn.com/nfl/team/_/name/sea/seattle-seahawks\">Seattle Seahawks</a></a> 34-17 on Monday night.\n\n\r\n              “When I attacked the field, I wasn’t worried about the trade,” Simmons said. “I wasn’t worried about all the outside noise. All I was worried about is play after play, just give the team everything I got.”\n\n\r\n              <a href=\"https://apnews.com/article/chicago-bears-jeffery-simmons-50a7f8526496fa7a47930b73ff5ef7af\">Acquired last week from Tennessee</a> for a package that included two first-round picks, Simmons took little time to make a big impact on a defense that had lacked difference-makers.\n\n\r\n              He had a sack on the opening drive, added another tackle for loss and finished with six tackles, three pressures and a pass defensed with coach Ben Johnson describing his impact as “profound.\" Chicago held Seattle to 252 yards and one third-down conversion on 11 tries.\n\n\r\n              “He has me up off of the bench,” receiver <a href=\"http://www.espn.com/nfl/player/_/id/4431299/rome-odunze\">Rome Odunze</a> said. “Watching them third downs, watching the defense in general to see what he’s going to do next. He brings the energy to them. Obviously, his play-making ability ignites the defense, ignites the offense, ignites the team as a whole.”\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4431611/caleb-williams\">Caleb Williams</a> was extremely efficient for the Bears (6-2) against one of the NFL's stingiest defenses, committing no turnovers, taking just one sack and throwing for 247 yards while completing 71% of his passes.\n\n\r\n              Williams' play helped set up three short touchdown runs by <a href=\"http://www.espn.com/nfl/player/_/id/4259545/d'andre-swift\">D'Andre Swift</a> and that proved to be more than enough against <a href=\"http://www.espn.com/nfl/player/_/id/3912547/sam-darnold\">Sam Darnold</a> and the Seahawks (4-4), thanks to the impact Simmons had on the defense.\n\n\r\n              “We knew it was going to be challenging and this was one of the more elaborate game plans in terms of what we were asking (Williams) to do as well,” Johnson said. “He stayed calm and collected throughout. I think that there are some times where it can get a little bit chaotic and yet he didn’t allow that to happen.” \n\n\r\n              The defending champion Seahawks lost for the third time in four games and are now looking up at the NFC playoff standings and can ill afford many more slip-ups. \n\n\r\n              The loss ended a 30-game streak for Seattle in the regular season and playoffs — the fourth longest for any team in the Super Bowl era — of not losing by more than four points.\n\n\r\n              “We got beat. No other way to sugar coat it,” coach Mike Macdonald said. “When you look at the things that it takes to win in our league, we didn't do those things and they did.”\n\n\r\n              Sam Darnold went 17 of 34 for 188 yards and two touchdowns for Seattle, but his interception in the fourth quarter set up Swift's third TD that made it 34-17 with 4:41 to play.\n\n\r\n              The Seahawks struggled once again to run the ball despite their trade last week for <a href=\"https://apnews.com/article/indianapolis-colts-quenton-nelson-trade-seattle-seahawks-c85ab329267f01d54ed278d7179fb1d5\">three-time All-Pro guard <a href=\"http://www.espn.com/nfl/player/_/id/3129308/quenton-nelson\">Quenton Nelson</a></a> and the return of <a href=\"http://www.espn.com/nfl/player/_/id/4426385/zach-charbonnet\">Zach Charbonnet</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4685512/jadarian-price\">Jadarian Price</a> from injures. Seattle ran for only 81 yards.\n\n\r\n              “We’ve got to improve very quickly in the run game,” guard <a href=\"http://www.espn.com/nfl/player/_/id/4693346/grey-zabel\">Grey Zabel</a> said. “Got to get back to running the ball, take the pressure off our quarterback and wide receivers and our play-caller. Got to be able to move the line of scrimmage.”\n\n\r\n              The Bears started off well against Seattle's stout defense by putting together a 17-play drive on the opening possession to take the lead when Williams threw a 1-yard touchdown pass to Luther Burden.\n\n\r\n              The Bears added two more field goals in the first half and built the lead to 20-9 in the third quarter with another efficient touchdown drive that ended with a 1-yard run by Swift.\n\n\r\n              The Seahawks were bottled up by Simmons and the Bears for almost the entire first half before Darnold connected with <a href=\"http://www.espn.com/nfl/player/_/id/4430878/jaxon-smith-njigba\">Jaxon Smith-Njigba</a> on a 43-yard pass with 30 seconds left in the second quarter.\n\n\r\n              Things looked bleak for Seattle when <a href=\"http://www.espn.com/nfl/player/_/id/2473037/jason-myers\">Jason Myers</a> had a 33-yard field goal blocked in the opening minute of the fourth quarter.\n\n\r\n              But <a href=\"http://www.espn.com/nfl/player/_/id/16802/demarcus-lawrence\">DeMarcus Lawrence</a> forced a fumble by <a href=\"http://www.espn.com/nfl/player/_/id/4723086/colston-loveland\">Colston Loveland</a> on the next possession that set up Darnold's 7-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/2977187/cooper-kupp\">Cooper Kupp</a>, and Seattle converted the 2-point conversion to make it 20-17.\n\n\r\n              The Bears answered with another TD drive and put the game away after Darnold's interception.\n\n\r\n              <hl2>Caleb covers his cleats</hl2>\r\n              Williams covered up the logo on his Caddix brand cleats after reportedly getting fined about $35,000 the past two weeks for displaying an unauthorized logo.\n\n\r\n              Williams wore all black shoes in the game with no logo displayed to avoid another run-in with the league.\n\n\r\n              “Just to just to calm things down, man,” he said. \"It was a big week, and not here to create any BS toward the team. I want to keep that to a minimum from my side. Obviously, I get a lot of media, and so just trying to minimize that as much as possible.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Bears: DL <a href=\"http://www.espn.com/nfl/player/_/id/2576492/grady-jarrett\">Grady Jarrett</a> (groin) and DL Kenatvius Street (knee) left the game with injuries.\n\n\r\n              Seahawks: DL <a href=\"http://www.espn.com/nfl/player/_/id/2971622/leonard-williams\">Leonard Williams</a> left in the second half with a stinger and didn't return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Bears: Host Tampa Bay on Sunday night.\n\n\r\n              Seahawks: Host Arizona on Sunday,\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-03T04:32:47Z"}}