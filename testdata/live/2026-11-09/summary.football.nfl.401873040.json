tage":0.3438,"playId":"4018730401357","tiePercentage":0},{"homeWinPercentage":0.3314,"playId":"4018730401386","tiePercentage":0},{"homeWinPercentage":0.2978,"playId":"4018730401414","tiePercentage":0},{"homeWinPercentage":0.2958,"playId":"4018730401434","tiePercentage":0},{"homeWinPercentage":0.2982,"playId":"4018730401447","tiePercentage":0},{"homeWinPercentage":0.2812,"playId":"4018730401460","tiePercentage":0},{"homeWinPercentage":0.2709,"playId":"4018730401489","tiePercentage":0},{"homeWinPercentage":0.2908,"playId":"4018730401516","tiePercentage":0},{"homeWinPercentage":0.3336,"playId":"4018730401540","tiePercentage":0},{"homeWinPercentage":0.3269,"playId":"4018730401563","tiePercentage":0},{"homeWinPercentage":0.3269,"playId":"4018730401573","tiePercentage":0},{"homeWinPercentage":0.3374,"playId":"4018730401583","tiePercentage":0},{"homeWinPercentage":0.3353,"playId":"4018730401612","tiePercentage":0},{"homeWinPercentage":0.2918,"playId":"4018730401634","tiePercentage":0},{"homeWinPercentage":0.3017,"playId":"4018730401669","tiePercentage":0},{"homeWinPercentage":0.3017,"playId":"4018730401679","tiePercentage":0},{"homeWinPercentage":0.2842,"playId":"4018730401689","tiePercentage":0},{"homeWinPercentage":0.3137,"playId":"4018730401718","tiePercentage":0},{"homeWinPercentage":0.309,"playId":"4018730401730","tiePercentage":0},{"homeWinPercentage":0.2798,"playId":"4018730401742","tiePercentage":0},{"homeWinPercentage":0.291,"playId":"4018730401790","tiePercentage":0},{"homeWinPercentage":0.2653,"playId":"4018730401812","tiePercentage":0},{"homeWinPercentage":0.2964,"playId":"4018730401837","tiePercentage":0}],"gameInfo":{"venue":{"id":"3812","guid":"f636eae9-da36-3954-83d5-3b24995d4e59","fullName":"Lucas Oil Stadium","address":{"city":"Indianapolis","state":"IN","zipCode":"46225","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3812.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3812.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":65479,"officials":[{"fullName":"Greg Wilson","displayName":"Greg Wilson","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Clay Martin","displayName":"Clay Martin","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":2},{"fullName":"Eugene Hall","displayName":"Eugene Hall","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":3},{"fullName":"Steven Woods","displayName":"Steven Woods","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":4},{"fullName":"Jerod Phillips","displayName":"Jerod Phillips","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":5},{"fullName":"Alonzo Ramsey III","displayName":"Alonzo Ramsey III","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":6},{"fullName":"Brian Perry","displayName":"Brian Perry","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":7}]},"article":{"headline":"Javonte Williams' late TD run helps Cowboys avoid another 4th-quarter collapse and beat Colts 27-23","description":"— With the Dallas Cowboys trailing by three points and on the verge of yet another fourth-quarter collapse, Dak Prescott needed 29 seconds to bail them out.","story":"INDIANAPOLIS -- — With the <a href=\"http://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a> trailing by three points and <a href=\"https://apnews.com/article/cowboys-jerry-jones-69e617dc02b869ab72ff8b3e03bdd240\">on the verge of yet another fourth-quarter collapse</a>, <a href=\"http://www.espn.com/nfl/player/_/id/2577417/dak-prescott\">Dak Prescott</a> needed 29 seconds to bail them out.\n\n\r\n              He hooked up with <a href=\"http://www.espn.com/nfl/player/_/id/5083754/ryan-flournoy\">Ryan Flournoy</a> on a 46-yard pass. Three plays and two Indianapolis penalties later, the Colts let <a href=\"http://www.espn.com/nfl/player/_/id/4361579/javonte-williams\">Javonte Williams</a> waltz in from 1 yard out with 1:08 remaining, and the Cowboys held on for a 27-23 victory one week after they blew a 14-point lead and <a href=\"https://apnews.com/article/cowboys-cardinals-score-6a8b77441b3d94511760bf38bd7cdd11\">lost in overtime to Arizona at home</a>.\n\n\r\n              Prescott, <a href=\"http://www.espn.com/nfl/player/_/id/4241389/ceedee-lamb\">CeeDee Lamb</a> and Williams refused to let it happen again.\n\n\r\n              “We got it done,” Prescott said. “It wasn't the prettiest, it wasn't the best second half from the whole team, but we got it done. We said at the beginning of the game, whatever it takes to come out with a win and we did that.”\n\n\r\n              The Cowboys (4-5) won for just the second time in five games, and it came on a day they dominated the stat sheet. They outgained the Colts 508 yards to 271. CeeDee Lamb caught 10 passes for 195 yards — the second-highest total of his career. And Williams finished with 101 yards rushing, his second 100-yard game.\n\n\r\n              Dallas also made enough miscues to lose.\n\n\r\n              The Cowboys were flagged 14 times for 153 yards, their highest total since 2021. The total even included an unsportsmanlike conduct call against inactive linebacker <a href=\"http://www.espn.com/nfl/player/_/id/4362088/demarvion-overshown\">DeMarvion Overshown</a>, who ran onto the field in street clothes to celebrate a takeaway.\n\n\r\n              Lamb had a 44-yard TD catch with 21 seconds left in the first half but failed to get both feet down on a second potential TD catch and cost Dallas another scoring chance when he realized he hadn't been touched, got up and ran inside the Colts 15-yard line — only to fumble the ball away.\n\n\r\n              Prescott, who was 21 of 34 for 335 yards and two TDs, lost a fumble at the Dallas 19-yard line that set up Indy's first touchdown.\n\n\r\n              But Dallas overcame all those mistakes — and Indy's <a href=\"http://www.espn.com/nfl/player/_/id/4571557/spencer-shrader\">Spencer Shrader</a> kicking field goals from 59 and 50 yards in the final six minutes that left Dallas in a 23-20 deficit with 1:37 to go.\n\n\r\n              Four plays and two Colts penalties later, the Cowboys were back on top — thanks in part to Colts coach Shane Steichen, who made the strategic decision to give his team the ball with time left for a winning drive.\n\n\r\n              “Yeah, we let them score,” Steichen said. “I mean they've got four shots from the 1-yard line so we have a chance to get the ball back. If not, they're bleeding the clock.”\n\n\r\n              If Sunday was the final game with Indy for quarterback <a href=\"http://www.espn.com/nfl/player/_/id/3917792/daniel-jones\">Daniel Jones</a> or <a href=\"https://apnews.com/article/indianapolis-colts-trades-focus-1a3495b3820eb4a31c49965fe7dc8179\">running back <a href=\"http://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a>,</a> both of whom could be dealt before Tuesday's deadline, it wasn't the ending they wanted.\n\n\r\n              Taylor rushed 13 times for 46 yards and lost a fumble that cost Indy (2-6) a scoring chance. Jones was picked off by <a href=\"http://www.espn.com/nfl/player/_/id/4870706/caleb-downs\">Caleb Downs</a> with 35 seconds left to seal the game and finished 20 of 34 for 180 yards with one TD as the Colts lost their fifth in a row.\n\n\r\n              “I just hope they appreciate and know that I appreciate them,” Taylor said of the Colts' fans. “They should know it was a pleasure to put on display my hard work and the team’s hard work.”\n\n\r\n              The fans booed Indy again as it went to the locker at halftime trailing 17-7.\n\n\r\n              But after the teams traded third-quarter field goals, <a href=\"http://www.espn.com/nfl/player/_/id/4061956/ashton-dulin\">Ashton Dulin</a> caught a short pass from Jones, made two defenders miss and sprinted down the sideline for a 55-yard score to cut the deficit 20-17 late in the third to set up the exciting finish.\n\n\r\n              “It's good to clean things up with a win,” Prescott said. “The way to get consistent is to get back to work and make sure we're doing everything right, discipline and details and make sure we're playing better.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Cowboys: Three starters, including receiver <a href=\"http://www.espn.com/nfl/player/_/id/4426354/george-pickens\">George Pickens</a>, were inactive. There has also been speculation Pickens could be traded. Sunday's most serious injury was to tight end <a href=\"http://www.espn.com/nfl/player/_/id/4242355/jake-ferguson\">Jake Ferguson</a>, who did not return after hurting his left knee in the third quarter.\n\n\r\n              Colts: Linebacker <a href=\"http://www.espn.com/nfl/player/_/id/4601021/jaylon-carlies\">Jaylon Carlies</a> (neck) and right tackle <a href=\"http://www.espn.com/nfl/player/_/id/4892240/jalen-travis\">Jalen Travis</a> (knee) left in the first half and did not return.\n\n\r\n              <hl2>Caleb Downs gets the better of his older brother</hl2>\r\n              Fifteen members of the Downs family attended the game to watch as younger brother Caleb got the better of Colts receiver <a href=\"http://www.espn.com/nfl/player/_/id/4688813/josh-downs\">Josh Downs</a>. It was the first time the brothers squared off since their Georgia prep days. Yes, they lined up against one another, and, yes, there was some trash-talking long before Caleb Downs' game-sealing interception.\n\n\r\n              <hl2>Allen reaches another career milestone</hl2>\r\n              Indy's <a href=\"http://www.espn.com/nfl/player/_/id/15818/keenan-allen\">Keenan Allen</a> passed Hall of Famer Tim Brown for No. 8 on the league's career receptions list. Allen finished with four catches for 26 yards, giving him 1,095 receptions — one more than Brown had.\n\n\r\n              <hl2>Up next</hl2>\r\n              Cowboys: Begin a three-game homestand next Sunday against San Francisco.\n\n\r\n              Colts: Host Miami next Sunday in what could be a matchup of rebuilding teams.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-08T22:21:35Z"}}