yName":"Stuart Skinner","shortName":"S. Skinner"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1831","fullName":"Bell Centre","address":{"city":"Montreal","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1831.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":20962,"officials":[{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Alex Lepkowski","displayName":"Alex Lepkowski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jonathan Deschamps","displayName":"Jonathan Deschamps","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Samberg lifts Jets past Canadiens 5-4 with OT goal to complete comeback from 4-goal deficit","description":"— Dylan Samberg scored in overtime as the Winnipeg Jets snapped a nine-game losing streak by storming back from a four-goal deficit to beat the Montreal Canadiens 5-4 on Tuesday night.","story":"MONTREAL -- — <a href=\"http://www.espn.com/nhl/player/_/id/4233878/dylan-samberg\">Dylan Samberg</a> scored in overtime as the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> snapped a nine-game losing streak by storming back from a four-goal deficit to beat the <a href=\"http://www.espn.com/nhl/team/_/name/mtl/montreal-canadiens\">Montreal Canadiens</a> 5-4 on Tuesday night.\n\n\r\n              Montreal led 4-0 when <a href=\"http://www.espn.com/nhl/player/_/id/4565236/cole-caufield\">Cole Caufield</a> scored his second of the game and 10th of the season 46 seconds into the third period.\n\n\r\n              But Winnipeg scored four goals in 2 minutes, 8 seconds to tie the game with 32 seconds remaining in regulation on <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a>'s power-play strike, his second goal of the game.\n\n\r\n              It was the latest four-goal comeback in NHL history.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697648/tyrel-bauer\">Tyrel Bauer</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4316970/morgan-barron\">Morgan Barron</a> started the rally to break Montreal goalie Jacob Fowler’s shutout bid for the Jets, who were coming off a 7-0 loss to the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> on Sunday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4268767/stuart-skinner\">Stuart Skinner</a> made 18 saves, while <a href=\"http://www.espn.com/nhl/player/_/id/2562632/mark-scheifele\">Mark Scheifele</a> and Dylan Demelo had two assists each. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080202/owen-beck\">Owen Beck</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3069687/josh-anderson\">Josh Anderson</a> also scored for Montreal and <a href=\"http://www.espn.com/nhl/player/_/id/4915349/juraj-slafkovsky\">Juraj Slafkovsky</a> added two assists. Fowler stopped 42 shots. On Beck’s goal, <a href=\"http://www.espn.com/nhl/player/_/id/4893969/arber-xhekaj\">Arber Xhekaj</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5188457/florian-xhekaj\">Florian Xhekaj</a> became the first brothers to record a point on the same Canadiens goal since Andrei Kostitsyn and Sergei Kostitsyn on Jan. 17, 2009.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233594/nick-suzuki\">Nick Suzuki</a> missed his sixth consecutive game with a hand injury. The Canadiens captain had played 546 straight regular-season games to begin his NHL career. He appears close to returning after practising without any obvious limitations Monday and Tuesday morning.\n\n\r\n              Winnipeg reunited its prolific top line of Scheifele, Connor and <a href=\"http://www.espn.com/nhl/player/_/id/4233583/gabriel-vilardi\">Gabriel Vilardi</a> in search of a spark. The Jets piled on the shots and eventually broke Fowler late in the game.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: Host the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> on Thursday night.\n\n\r\n              Canadiens: Host the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-04T03:47:46Z"}}