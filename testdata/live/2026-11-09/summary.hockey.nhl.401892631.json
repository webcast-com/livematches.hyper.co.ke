Patrick Kane","shortName":"P. Kane"},"type":"shooter"},{"athlete":{"id":"3904177","displayName":"Mackenzie Blackwood","shortName":"M. Blackwood"}}]},{"id":"401892631000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Noah Juulsen hit Frank Nazar","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:37"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"3900504","displayName":"Noah Juulsen","shortName":"N. Juulsen"},"type":"hit-credited"},{"athlete":{"id":"5080157","displayName":"Frank Nazar","shortName":"F. Nazar"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1847","fullName":"United Center","address":{"city":"Chicago","state":"IL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1847.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17838,"officials":[{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Mike Sullivan","displayName":"Mike Sullivan","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Kadri and Schwartz lead the Avalanche past the Blackhawks 5-2 for their 3rd straight win","description":"— Nazem Kadri and Jaden Schwartz scored two goals apiece, and the Colorado Avalanche beat the struggling Chicago Blackhawks 5-2 on Monday night for their third consecutive win.","story":"CHICAGO -- — <a href=\"http://www.espn.com/nhl/player/_/id/5349/nazem-kadri\">Nazem Kadri</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5835/jaden-schwartz\">Jaden Schwartz</a> scored two goals apiece, and the <a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a> beat the struggling <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> 5-2 on Monday night for their third consecutive win.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5136616/tj-hughes\">T.J. Hughes</a> had two assists as Colorado improved to 15-4-0 in its last 19 games against Chicago. <a href=\"http://www.espn.com/nhl/player/_/id/3096249/devon-toews\">Devon Toews</a> scored an empty-net goal with 2:22 left, and <a href=\"http://www.espn.com/nhl/player/_/id/3904177/mackenzie-blackwood\">Mackenzie Blackwood</a> finished with 21 saves.\n\n\r\n              Chicago dropped to 1-5-1 in its last seven games. Forward <a href=\"http://www.espn.com/nhl/player/_/id/3735/patrick-kane\">Patrick Kane</a> departed in the second period with an upper-body injury, and defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4565225/bowen-byram\">Bowen Byram</a> missed his eighth consecutive game with an upper-body injury.\n\n\r\n              The banged-up Blackhawks jumped out to a 2-0 lead on first-period goals by defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4697717/wyatt-kaiser\">Wyatt Kaiser</a> and rookie <a href=\"http://www.espn.com/nhl/player/_/id/5149231/roman-kantserov\">Roman Kantserov</a>. <a href=\"http://www.espn.com/nhl/player/_/id/5149125/connor-bedard\">Connor Bedard</a> extended his point streak to six games with an assist on Kantserov's sixth goal on a 2-on-1 rush.\n\n\r\n              The Avalanche rallied with two goals in 26 seconds. Kadri poked home a loose puck on the goal line at 15:23, and a wide-open Schwartz scored from the left circle at 15:49.\n\n\r\n              Colorado grabbed its first lead after Bedard was sent off for holding Kadri 13:10 into the second period. Kadri got a piece of <a href=\"http://www.espn.com/nhl/player/_/id/4233563/cale-makar\">Cale Makar</a>'s wrist shot from just inside the blue line.\n\n\r\n              Kadri has four goals this season — all in the last six games. \n\n\r\n              Schwartz made it 4-2 when he beat <a href=\"http://www.espn.com/nhl/player/_/id/4565234/spencer-knight\">Spencer Knight</a> for his sixth goal in the final seconds of the second. He has three goals and an assist in his last three games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Avalanche: At the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> on Tuesday night.\n\n\r\n              Blackhawks: At the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-03T04:03:48Z"}}