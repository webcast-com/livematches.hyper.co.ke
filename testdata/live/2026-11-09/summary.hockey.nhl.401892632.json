eValue":0,"awayScore":0,"homeScore":0,"text":"Filip Bystedt faceoff won against Morgan Frost","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"5080175","displayName":"Filip Bystedt","shortName":"F. Bystedt"},"type":"face-off-winner"},{"athlete":{"id":"4233685","displayName":"Morgan Frost","shortName":"M. Frost"}}]}],"gameInfo":{"venue":{"id":"1653","fullName":"SAP Center at San Jose","address":{"city":"San Jose","state":"CA","zipCode":"95196","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1653.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":13098,"officials":[{"fullName":"Graham Skilliter","displayName":"Graham Skilliter","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"4th-line wingers Klapka and Stromgren score to back Wolf in Flames' 2-1 win over Sharks","description":"— Fourth-line wingers Adam Klapka and William Stromgren scored, Dustin Wolf made 26 saves and the Calgary Flames beat the San Jose Sharks 2-1 on Monday night.","story":"SAN JOSE, Calif. -- — Fourth-line wingers <a href=\"http://www.espn.com/nhl/player/_/id/5073306/adam-klapka\">Adam Klapka</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874893/william-stromgren\">William Stromgren</a> scored, <a href=\"http://www.espn.com/nhl/player/_/id/4587952/dustin-wolf\">Dustin Wolf</a> made 26 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> 2-1 on Monday night.\n\n\r\n              Klapka opened the scoring on a wrist shot with 5:24 left in the first period off a feed from center <a href=\"http://www.espn.com/nhl/player/_/id/5188608/jonathan-castagna\">Jonathan Castagna</a>. William Stromgren batted in his first of the season at 9:14 of the third, with Klapka and Castagna assisting.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5216880/sam-dickinson\">Sam Dickinson</a> pulled San Jose within a goal with 8:03 left in the third, beating Wolf with a wrist shot.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a> stopped 20 shots for the Sharks.\n\n\r\n              Calgary improved to 7-8-0, and San Jose fell to 7-8-1.\n\n\r\n              <hl2>Up next</hl2>\r\n              Flames: At Seattle on Wednesday night.\n\n\r\n              Sharks: At Los Angeles on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-03T04:44:45Z"}}