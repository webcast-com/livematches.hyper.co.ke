age":0},{"homeWinPercentage":0.0376,"playId":"401866456289","tiePercentage":0},{"homeWinPercentage":0.0387,"playId":"401866456296","tiePercentage":0},{"homeWinPercentage":0.035,"playId":"401866456299","tiePercentage":0},{"homeWinPercentage":0.0346,"playId":"401866456304","tiePercentage":0},{"homeWinPercentage":0.0328,"playId":"401866456310","tiePercentage":0},{"homeWinPercentage":0.0322,"playId":"401866456315","tiePercentage":0},{"homeWinPercentage":0.0344,"playId":"401866456318","tiePercentage":0},{"homeWinPercentage":0.0339,"playId":"401866456324","tiePercentage":0},{"homeWinPercentage":0.0324,"playId":"401866456329","tiePercentage":0},{"homeWinPercentage":0.0311,"playId":"401866456334","tiePercentage":0},{"homeWinPercentage":0.0322,"playId":"401866456339","tiePercentage":0}],"gameInfo":{"venue":{"id":"3727","guid":"3a82e243-5f64-3ce4-bdaf-49367fb55391","fullName":"Ford Field","address":{"city":"Detroit","state":"MI","zipCode":"48226","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3727.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":12656},"article":{"headline":"Nick Woodford scores 3 times and Central Michigan defeats Eastern Michigan 35-7 in Detroit","description":"— Nick Woodford ran for three touchdowns and Central Michigan rolled past Eastern Michigan 35-7 on Wednesday night at Ford Field.","story":"DETROIT -- — <a href=\"http://www.espn.com/college-football/player/_/id/5305463/nick-woodford\" target=\"_new\">Nick Woodford</a> ran for three touchdowns and Central Michigan rolled past Eastern Michigan 35-7 on Wednesday night at Ford Field.\n\n\r\n              The Chippewas (4-5, 2/3 Mid-American Conference) had a total of 235 yards rushing, 123 by Woodford, who scored on runs of 11, 2 and 1 yard. <a href=\"http://www.espn.com/college-football/player/_/id/5149056/jadyn-glasser\" target=\"_new\">Jadyn Glasser</a> completed 14 of 19 passes for 175 yards, including an 8-yard touchdown pass to <a href=\"http://www.espn.com/college-football/player/_/id/5193288/nasir-williams\" target=\"_new\">Nasir Williams</a> for the game's first score.\n\n\r\n              The Chippewas had more than double the total offense of the Eagles, outgaining them 418-177.\n\n\r\n              Eastern Michigan got on the board with 10 seconds remaining when backup quarterback <a href=\"http://www.espn.com/college-football/player/_/id/5144207/jace-stuckey\" target=\"_new\">Jace Stuckey</a> and <a href=\"http://www.espn.com/college-football/player/_/id/5211694/harold-mack\" target=\"_new\">Harold Mack</a> connected on a 6-yard touchdown pass. The Eagles (4-6, 3-3) had 103 yards passing and 74 yards rushing.\n\n\r\n              Eastern Michigan won 61-58 in four overtimes the last time these two played at Ford Field, in 2004.\n\n\r\n              Central Michigan has a 66-32-6 advantage in the series that dates to 1902.\n\n\r\n              <hl2>Up next</hl2>\r\n              Central Michigan: vs. Sacramento State next Wednesday.\n\n\r\n              Eastern Michigan: at Western Michigan on Nov. 17. ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-11-05T04:17:34Z"}}