type":"hit-credited"},{"athlete":{"id":"4565266","displayName":"Alex Vlasic","shortName":"A. Vlasic"},"type":"hitted"}]},{"id":"401892600000000680","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Connor Bedard shot blocked by Anton Johansson","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:23"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"5149125","displayName":"Connor Bedard","shortName":"C. Bedard"},"type":"shooter"},{"athlete":{"id":"5188582","displayName":"Anton Johansson","shortName":"A. Johansson"},"type":"defender"}]},{"id":"401892600000000100","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:38"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892600000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"J.T. Compher faceoff won against Anton Frondell","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:38"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"3041995","displayName":"J.T. Compher","shortName":"J.T. Compher"},"type":"face-off-winner"},{"athlete":{"id":"5291935","displayName":"Anton Frondell","shortName":"A. Frondell"}}]}],"gameInfo":{"venue":{"id":"5404","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19515,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Pierre Lambert","displayName":"Pierre Lambert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tyson Baker","displayName":"Tyson Baker","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Arvidsson nets sixth career hat trick as Red Wings down Blackhawks, 4-1","description":"— Viktor Arvidsson scored his sixth career hat trick and added an assist as the Detroit Red Wings overcame the suspension of former captain Dylan Larkin...","story":"DETROIT -- — <a href=\"http://www.espn.com/nhl/player/_/id/3120307/viktor-arvidsson\">Viktor Arvidsson</a> scored his sixth career hat trick and added an assist as the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> overcame the <a href=\"https://apnews.com/article/red-wings-dylan-larkin-1f13ee2ba18e94ee89da619c2f7551c9\">suspension of former captain <a href=\"http://www.espn.com/nhl/player/_/id/3114755/dylan-larkin\">Dylan Larkin</a></a> with a 4-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> on Thursday.\n\n\r\n              The third four-point game of Arvidsson's career gave Detroit a 5-1-1 record over its last seven games. <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> added a power-play goal and <a href=\"http://www.espn.com/nhl/player/_/id/4063433/alex-debrincat\">Alex DeBrincat</a> had two assists. <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> made 18 saves, including one on Frank Nazar’s second-period penalty shot.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5149125/connor-bedard\">Connor Bedard</a> scored for the Blackhawks, who are 0-5 on the road this season. <a href=\"http://www.espn.com/nhl/player/_/id/4565234/spencer-knight\">Spencer Knight</a> stopped 25 shots.\n\n\r\n              The Red Wings suspended Larkin without pay prior to the game. Larkin, who requested a trade during the offseason, through his agent said would no longer play for the organization. Larkin has two goals and six assists in 10 games this season, including the tying goal during a shootout victory at Edmonton on Monday.\n\n\r\n              Bedard scored at 5:59 of the first period, backhanding a rebound of <a href=\"http://www.espn.com/nhl/player/_/id/4697717/wyatt-kaiser\">Wyatt Kaiser</a>'s shot. After the Red Wings wasted three power plays, they scored at even strength to tie it. Arvidsson deflected <a href=\"http://www.espn.com/nhl/player/_/id/4697436/william-wallinder\">William Wallinder</a>'s shot from the point past Knight at 7:31 of the second period.\n\n\r\n              Nazar was awarded the penalty shot at 11:18 of the period after <a href=\"http://www.espn.com/nhl/player/_/id/3114997/andreas-englund\">Andreas Englund</a> hooked him. Gibson made a pad save to keep the score at 1-all.\n\n\r\n              With <a href=\"http://www.espn.com/nhl/player/_/id/3735/patrick-kane\">Patrick Kane</a> in the penalty box for high sticking, Raymond scored from the right circle at 1:09 of the third.\n\n\r\n              Arvidsson tipped in the rebound of DeBrincat shot's with 4:34 left and added an empty-netter for the hat trick.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blackhawks: Visit Boston on Saturday.\n\n\r\n              Red Wings: Host St. Louis on Saturday.\n\n\r\n              ------\n\n\r\n              AP NHL: <a href=\"https://apnews.com/hub/nhl\">https://apnews.com/hub/nhl</a>","published":"2026-10-30T02:21:45Z"}}