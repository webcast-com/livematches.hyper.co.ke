0000800","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Aliaksei Protas Wrist Shot High and Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"2:09"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"4587943","displayName":"Aliaksei Protas","shortName":"A. Protas"},"type":"shooter"},{"athlete":{"id":"3042109","displayName":"Juuse Saros","shortName":"J. Saros"}}]},{"id":"401892605000000950","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Jack St. Ivany","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:15"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"23"},"participants":[{"athlete":{"id":"4755690","displayName":"Jack St. Ivany","shortName":"J. St. Ivany"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1834","fullName":"Bridgestone Arena","address":{"city":"Nashville","state":"TN","zipCode":"37250","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1834.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17159,"officials":[{"fullName":"Kyle Rehman","displayName":"Kyle Rehman","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jesse Marquis","displayName":"Jesse Marquis","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Schrader","displayName":"Brandon Schrader","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Cole Hutson scores twice as the Capitals beat the Predators 4-3","description":"— Cole Hutson scored twice to lead the Washington Capitals to a 4-3 victory over the Nashville Predators on Thursday night.","story":"NASHVILLE, Tenn. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5216918/cole-hutson\">Cole Hutson</a> scored twice to lead the <a href=\"http://www.espn.com/nhl/team/_/name/wsh/washington-capitals\">Washington Capitals</a> to a 4-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a> on Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2563054/boone-jenner\">Boone Jenner</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114766/alex-tuch\">Alex Tuch</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/3095975/charlie-lindgren\">Charlie Lindgren</a> made 25 saves for Washington, winners of three straight and five of six. <a href=\"http://www.espn.com/nhl/player/_/id/4587943/aliaksei-protas\">Aliaksei Protas</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4755690/jack-st-ivany\">Jack St. Ivany</a> each had two assists. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2968772/filip-forsberg\">Filip Forsberg</a> scored twice, <a href=\"http://www.espn.com/nhl/player/_/id/4392471/ross-colton\">Ross Colton</a> also scored and <a href=\"http://www.espn.com/nhl/player/_/id/3042109/juuse-saros\">Juuse Saros</a> made 25 saves for Nashville, losers of four of five. <a href=\"http://www.espn.com/nhl/player/_/id/5436/roman-josi\">Roman Josi</a> had three assists. \n\n\r\n              Forsberg opened the scoring with 7:12 left in the first period.\n\n\r\n              With the Predators on a 5-on-3, Ryan O’Reilly sent a pass from the high slot to Forsberg at the top of the left circle, where he beat Lindgren with a one-timer.\n\n\r\n              Forsberg has scored a power-play goal in three-straight games. O’Reilly extended his points streak to four games. He has three goals and four assists over that span.\n\n\r\n              Hutson tied it with 3:47 left on the first with a sharp angle shot from near the goal line on the right side.\n\n\r\n              Jenner gave Washington a 2-1 lead at 4:15 of the second.\n\n\r\n              Forsberg struck again at 9:09 of the second, avoiding a Lindgren poke check before slipping the puck inside the right post for his second of the game.\n\n\r\n              It was Forsberg’s first multi-goal game of the season.\n\n\r\n              Hutson scored his second of the game with 6:14 to go in the second, skating through the slot and beating Saros with a wrist shot on the stick side for the first two-goal game of his career.\n\n\r\n              Colton tied it at 3 at 6:34 of the third, but Tuch scored the winner with 9:51 remaining on a wrist shot from the left faceoff dot for his 10th of the season and fifth goal in his last three games.\n\n\r\n              <hl2>Up next</hl2>\r\n              Capitals: Host Minnesota on Sunday.\n\n\r\n              Predators: Host Tampa Bay on Saturday.\n\n\r\n              ------ <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-30T03:00:45Z"}}