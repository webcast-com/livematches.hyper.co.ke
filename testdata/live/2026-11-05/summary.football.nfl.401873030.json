WinPercentage":0.459,"playId":"4018730301750","tiePercentage":0},{"homeWinPercentage":0.4129,"playId":"4018730301772","tiePercentage":0},{"homeWinPercentage":0.4239,"playId":"4018730301795","tiePercentage":0},{"homeWinPercentage":0.4118,"playId":"4018730301815","tiePercentage":0},{"homeWinPercentage":0.4114,"playId":"4018730301829","tiePercentage":0},{"homeWinPercentage":0.4005,"playId":"4018730301843","tiePercentage":0}],"gameInfo":{"venue":{"id":"3727","guid":"3a82e243-5f64-3ce4-bdaf-49367fb55391","fullName":"Ford Field","address":{"city":"Detroit","state":"MI","zipCode":"48226","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3727.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3727.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":64008,"officials":[{"fullName":"Max Causey","displayName":"Max Causey","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":2},{"fullName":"Frank Steratore","displayName":"Frank Steratore","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":1},{"fullName":"Craig Wrolstad","displayName":"Craig Wrolstad","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":3},{"fullName":"Rich Martinez","displayName":"Rich Martinez","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":4},{"fullName":"Brandon Cruse","displayName":"Brandon Cruse","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":5},{"fullName":"Jeff Shears","displayName":"Jeff Shears","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":6},{"fullName":"John Braun","displayName":"John Braun","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Goff throws go-ahead touchdown pass to Williams and Lions beat Vikings 19-15 for their 1st loss","description":"— The Detroit Lions handed the Minnesota Vikings their first loss of the season and had a muted celebration because All-Pro linebacker ","story":"DETROIT -- — The <a href=\"https://apnews.com/hub/detroit-lions\"><a href=\"http://www.espn.com/nfl/team/_/name/det/detroit-lions\">Detroit Lions</a></a> handed the <a href=\"https://apnews.com/hub/minnesota-vikings\"><a href=\"http://www.espn.com/nfl/team/_/name/min/minnesota-vikings\">Minnesota Vikings</a></a> their first loss of the season and had a muted celebration because All-Pro linebacker <a href=\"https://apnews.com/article/jack-campbell-lions-d424e948b5d3b35483c8057da459d850\"><a href=\"http://www.espn.com/nfl/player/_/id/4569465/jack-campbell\">Jack Campbell</a></a> was taken to a hospital with a neck injury.\n\n\r\n              “It's a little bittersweet,” Detroit coach Dan Campbell said after a 19-15 win on Sunday.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3046779/jared-goff\">Jared Goff</a> threw a go-ahead, 7-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4426388/jameson-williams\">Jameson Williams</a> with 4:35 left and the Lions made plays on both sides of the ball in a key NFC North matchup.\n\n\r\n              Detroit’s defense held the Vikings to a three-and-out possession and sealed the win with a running game that had 164 yards rushing in the second half to finish with 230 yards against one of the league’s best defenses that was giving up fewer than 100 yards on the ground per game.\n\n\r\n              The Lions (5-2) have won three straight, including their first two division games, but they were far from joyful following the game after seeing <a href=\"https://apnews.com/article/lions-jack-campbell-contract-extension-767fcef0541dc7f44b29f3a47f47bfd5\">Campbell</a> lay motionless face down on the turf after a tackle.\n\n\r\n              “That was definitely scary,” Goff said. “He’s a husband and a father.”\n\n\r\n              The Vikings (6-1) had a chance to stay unbeaten, but the league's stingiest defense couldn't hold onto a late lead, after coach Kevin O’Connell chose to punt on fourth-and-5 from his 33.\n\n\r\n              “We still had all three timeouts and we have total trust and confidence in our defense,” O’Connell said. “We thought we could get a stop and get the ball back.”\n\n\r\n              Minnesota, which like the Lions didn't make the playoffs last season, lost for the first time since Nov. 30, 2025, at Seattle.\n\n\r\n              Detroit's <a href=\"http://www.espn.com/nfl/player/_/id/4429795/jahmyr-gibbs\">Jahmyr Gibbs</a> ran for 153 yards, including a 30-yard, tackle-breaking touchdown in the third quarter. Goff was 18 of 25 for 176 yards with a touchdown and his first interception of the season.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3917315/kyler-murray\">Kyler Murray</a> was 17 of 29 for 210 yards with two touchdown and an interception, leading an offensively challenged team that had just 81 yards rushing.\n\n\r\n              The Lions broke a scoreless tie late in the first quarter on <a href=\"http://www.espn.com/nfl/player/_/id/4689936/jake-bates\">Jake Bates</a>' 25-yard field goal after their star receivers — Amon Ra-St. Brown and Williams — stunted the first two drives with taunting penalties. \n\n\r\n              St. Brown had a chance to make up for his flag with a touchdown catch, but the play was reversed after a review that showed he didn't secure the football as he fell after making a reception with his fingertips and getting both feet in the end zone.\n\n\r\n              The Vikings went ahead 7-3 early in the second quarter when Murray lofted a 1-yard pass to the left side of the end zone that <a href=\"http://www.espn.com/nfl/player/_/id/4262921/justin-jefferson\">Justin Jefferson</a> snagged with his left hand before going to the turf and completing the catch.\n\n\r\n              Lions cornerback <a href=\"http://www.espn.com/nfl/player/_/id/3139387/dj-reed\">D.J. Reed</a>, who broke up a pass in the end zone on the game's first drive, cut in front of <a href=\"http://www.espn.com/nfl/player/_/id/4429205/jordan-addison\">Jordan Addison</a> to make a diving interception late in the second quarter. \n\n\r\n              Detroit converted a fourth-and-1 from its 47 and Bates later made a 37-yard field goal to make it 7-6.\n\n\r\n              Murray threw an 8-yard touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4036133/tj-hockenson\">T.J. Hockenson</a> and a 2-point conversion pass to Jordan Addison for a 15-12 lead midway through the fourth quarter.\n\n\r\n              Minnesota's defense, though, allowed Gibbs to run for 17 yards on the next snap and for the running back to gain 9 yards on consecutive carries to set up the game-winning touchdown. \n\n\r\n              “This is the first adversity we’ve faced in terms of results, and it didn’t happen until Nov. 1,” O’Connell said. “We have some things to work on, so I’m glad we have an extra day before a very tough game against the <a href=\"http://www.espn.com/nfl/team/_/name/buf/buffalo-bills\">Buffalo Bills</a>.\"\n\n\r\n              <hl2>Injuries</hl2>\r\n              Vikings: Safety <a href=\"http://www.espn.com/nfl/player/_/id/4242436/theo-jackson\">Theo Jackson</a> (quad) was injured during the game.\n\n\r\n              Lions: Linebacker Jack Campbell was placed on a backboard, carted off the field in the fourth quarter and taken to a hospital with a neck injury. Safety <a href=\"http://www.espn.com/nfl/player/_/id/4692025/brian-branch\">Brian Branch</a> and edge <a href=\"http://www.espn.com/nfl/player/_/id/4038849/dj-wonnum\">DJ Wonnum</a> were evaluated for concussions after colliding late in the second quarter and didn't return. Center <a href=\"http://www.espn.com/nfl/player/_/id/4361788/cade-mays\">Cade Mays</a> (ankle), kick returner <a href=\"http://www.espn.com/nfl/player/_/id/4383429/jacob-saylors\">Jacob Saylors</a> (neck), linebacker <a href=\"http://www.espn.com/nfl/player/_/id/4896353/jimmy-rolder\">Jimmy Rolder</a> (hamstring) and Reed (hip) were also hurt.\n\n\r\n              <hl2>Up next</hl2>\r\n              Vikings: Host the Bills on Monday, Nov. 9.\n\n\r\n              Lions: at Miami on Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-01T21:21:58Z"}}