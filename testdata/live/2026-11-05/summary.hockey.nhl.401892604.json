Play":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Cam Fowler Slap Shot saved by Jeremy Swayman","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"19"},"participants":[{"athlete":{"id":"5495","displayName":"Cam Fowler","shortName":"C. Fowler"},"type":"shooter"},{"athlete":{"id":"4712036","displayName":"Jeremy Swayman","shortName":"J. Swayman"},"type":"saver"}]},{"id":"401892604000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jimmy Snuggerud Snap Shot Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:12"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"19"},"participants":[{"athlete":{"id":"5080171","displayName":"Jimmy Snuggerud","shortName":"J. Snuggerud"},"type":"shooter"},{"athlete":{"id":"4712036","displayName":"Jeremy Swayman","shortName":"J. Swayman"}}]},{"id":"401892604000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Nikita Zadorov hit Robert Thomas","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:18"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"1"},"participants":[{"athlete":{"id":"3042021","displayName":"Nikita Zadorov","shortName":"N. Zadorov"},"type":"hit-credited"},{"athlete":{"id":"4233637","displayName":"Robert Thomas","shortName":"R. Thomas"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1839","fullName":"Enterprise Center","address":{"city":"St. Louis","state":"MO","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1839.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18096,"officials":[{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Schlenker","displayName":"Chris Schlenker","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Thomas, Broberg lead Blues to 4-1 win over Bruins","description":"— Robert Thomas and Philip Broberg each had a goal and two assists to lead the St. Louis Blues to a 4-1 win over the Boston Bruins on Thursday night.","story":"ST. LOUIS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4233637/robert-thomas\">Robert Thomas</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565229/philip-broberg\">Philip Broberg</a> each had a goal and two assists to lead the <a href=\"http://www.espn.com/nhl/team/_/name/stl/st-louis-blues\">St. Louis Blues</a> to a 4-1 win over the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> on Thursday night.\n\n\r\n              Before the win, the Blues were 0-3-3 in their last six games against Bruins at home since Game 4 of Stanley Cup Final on June 3, 2019.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080171/jimmy-snuggerud\">Jimmy Snuggerud</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4697409/jake-neighbours\">Jake Neighbours</a> scored a power-play goal for St. Louis and <a href=\"http://www.espn.com/nhl/player/_/id/4587909/joel-hofer\">Joel Hofer</a> recorded 31 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5275337/james-hagens\">James Hagens</a> scored for the Bruins and <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> stopped 14 shots.\n\n\r\n              St. Louis went ahead 2-1 on a wrist shot from the top of the slot by Broberg at 5:17 of the second period. <a href=\"http://www.espn.com/nhl/player/_/id/4565246/connor-mcmichael\">Connor McMichael</a> passed from behind the net to an open Broberg, whose shot went just inside the right post.\n\n\r\n              The Blues extended the lead to 3-1 on a goal by Thomas at 12:08. He took the puck from <a href=\"http://www.espn.com/nhl/player/_/id/4697408/justin-barron\">Justin Barron</a> at the blue line, skated to the high slot and fired a wrist shot high to beat Swayman.\n\n\r\n              Neighbours scored a power-play goal at 12:42 of the third period.\n\n\r\n              Hagens deflected a shot by <a href=\"http://www.espn.com/nhl/player/_/id/4233575/casey-mittelstadt\">Casey Mittelstadt</a>, giving the Bruins a 1-0 lead at 5:28 of the first period. \n\n\r\n              Snuggerud tied it 1-1 when he scored a power-play goal on a one-timer from the left faceoff circle. The goal at 15:43 snapped a 138:38 scoreless skid for the Blues.\n\n\r\n              Thomas assisted on the goal. He passed Brian Sutter for sole possession of fourth place on the Blues franchise list.\n\n\r\n              <hl2>Up next</hl2>\r\n              Bruins: Host Blackhawks on Saturday. \n\n\r\n              Blues: Play Red Wings in Detroit on Saturday.\n\n\r\n              ----\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nba\">See AP’s full NBA coverage here</a>","published":"2026-10-30T02:51:46Z"}}