Id":"4018730531570","tiePercentage":0},{"homeWinPercentage":0.8027,"playId":"4018730531602","tiePercentage":0},{"homeWinPercentage":0.8201,"playId":"4018730531625","tiePercentage":0},{"homeWinPercentage":0.8202,"playId":"4018730531648","tiePercentage":0},{"homeWinPercentage":0.8209,"playId":"4018730531687","tiePercentage":0},{"homeWinPercentage":0.8194,"playId":"4018730531709","tiePercentage":0},{"homeWinPercentage":0.85,"playId":"4018730531731","tiePercentage":0},{"homeWinPercentage":0.8376,"playId":"4018730531772","tiePercentage":0},{"homeWinPercentage":0.8309,"playId":"4018730531794","tiePercentage":0},{"homeWinPercentage":0.9055,"playId":"4018730531817","tiePercentage":0},{"homeWinPercentage":0.9287,"playId":"4018730531842","tiePercentage":0}],"gameInfo":{"venue":{"id":"11930","guid":"f92de39b-83d5-35f4-92da-cacb758e38a5","fullName":"FC Bayern Munich Stadium","address":{"city":"Munich","country":"Germany"},"grass":true,"images":[]},"attendance":70225,"officials":[{"fullName":"Greg Wilson","displayName":"Greg Wilson","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Clay Martin","displayName":"Clay Martin","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":2},{"fullName":"Eugene Hall","displayName":"Eugene Hall","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":3},{"fullName":"Steven Woods","displayName":"Steven Woods","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":4},{"fullName":"Jerod Phillips","displayName":"Jerod Phillips","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":5},{"fullName":"Alonzo Ramsey III","displayName":"Alonzo Ramsey III","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":6},{"fullName":"Brian Perry","displayName":"Brian Perry","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":7}]},"article":{"headline":"St. Brown and Gibbs score 2 TDs each in Lions' 35-10 rout of Patriots after Maye injured in Munich","description":"— Amon-Ra St. Brown wore lederhosen, carried a German flag onto the field, and then went out and scored two touchdowns.","story":"MUNICH -- — Amon-Ra St. Brown <a href=\"https://apnews.com/article/lions-amonra-stbrown-celebration-lederhosen-munich-nfl-5fc97bb340e204d8b3bce9a4d4aa12b5\">wore lederhosen</a>, carried a German flag onto the field, and then went out and scored two touchdowns.\n\n\r\n              Talk about a homecoming.\n\n\r\n              The German-speaking St. Brown, whose mother is from Leverkusen, said it's been a trip he'll “never forget.”\n\n\r\n              St. Brown caught two touchdown passes and <a href=\"http://www.espn.com/nfl/player/_/id/4429795/jahmyr-gibbs\">Jahmyr Gibbs</a> ran for 153 yards and two scores in a 35-10 win over the <a href=\"http://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a>, who <a href=\"https://apnews.com/article/drake-maye-injured-patriots-munich-da978b8d633b4f5d79d5f4a7172eb093\">lost quarterback <a href=\"http://www.espn.com/nfl/player/_/id/4431452/drake-maye\">Drake Maye</a></a> to an ankle injury on their opening drive Sunday.\n\n\r\n              “Being in Germany, number one, was a blessing, it’s been amazing,” St. Brown said. “But being able to win like that — with the guys, my teammates in front of the fans here in Germany, it’s like a dream come true.”\n\n\r\n              The Lions (7-2) have won five straight games but also lost edge rusher <a href=\"http://www.espn.com/nfl/player/_/id/4372099/aidan-hutchinson\">Aidan Hutchinson</a>, who hurt his right knee while <a href=\"https://apnews.com/article/aidan-hutchinson-injury-celebration-sack-bb7bcd52d192c8f8006d4f5086072c7e\">celebrating the sack</a> that knocked Maye out of the game. A person familiar with the situation later told The Associated Press that Hutchinson's injury was season-ending.\n\n\r\n              “Any time you lose a player like that and you don’t know the entirety of it ... it hurts a little bit,” Lions coach Dan Campbell said.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3046779/jared-goff\">Jared Goff</a> threw three touchdown passes, along with two interceptions, completing 20 of 31 passes for 303 yards.\n\n\r\n              St. Brown caught a 56-yard touchdown pass in the first quarter to give Detroit a 7-3 lead. And his 28-yard TD reception — after <a href=\"https://x.com/Lions/status/2122007943344279821\">teammates pushed him over the goal line</a> in a scrum with Patriots defenders — made it 28-3 in the third quarter.\n\n\r\n              St. Brown, who wore lederhosen for his arrival to the stadium, charged onto the field carrying a German flag. St. Brown and his two brothers spent many <a href=\"https://apnews.com/article/amonra-stbrown-lions-patriots-germany-munich-6814b30e74d65cefa8bd4a10d2cc59ab\">summers in their childhood visiting the country</a>.\n\n\r\n              In between St. Brown's scores, Goff found <a href=\"http://www.espn.com/nfl/player/_/id/5123663/isaac-teslaa\">Isaac TeSlaa</a> for a <a href=\"https://x.com/Lions/status/2121986085572014392\">12-yard touchdown pass</a> and a 14-3 lead after a 97-yard drive, and Gibbs ran it in from 5 yards one play after he rumbled down the sideline for a 50-yard reception.\n\n\r\n              Gibbs added a 28-yard touchdown run in the fourth quarter to make it 35-10. He is the first NFL player since Priest Holmes in 2002 to produce more than 150 yards rushing with two rushing touchdowns and at least 95 yards receiving in a game, <a href=\"https://x.com/LionsPR/status/2122016431122346464\">the Lions said</a>.\n\n\r\n              Gibbs caught seven passes for 99 yards. St. Brown finished with four receptions for 98 yards.\n\n\r\n              The Patriots (5-5) have lost back-to-back games and three of four.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4240391/tommy-devito\">Tommy DeVito</a> completed 12 of 24 for 81 yards with one interception and a fourth-quarter touchdown pass to <a href=\"http://www.espn.com/nfl/player/_/id/4698253/lan-larison\">Lan Larison</a> for New England.\n\n\r\n              On his only drive, Maye completed three of four passes for 48 yards. He also scrambled for 11 yards. Hutchinson sacked Maye at the Detroit 15-yard line on third down. <a href=\"http://www.espn.com/nfl/player/_/id/4569923/andy-borregales\">Andy Borregales</a> then kicked a 33-yard field goal.\n\n\r\n              New England coach Mike Vrabel he didn’t know the extent of Maye's injury: “We’ll have to get some more tests run and we’ll see when we come back what it ends up being and the severity of whatever injury he has.”\n\n\r\n              After DeVito entered the game, the Patriots punted on four straight possessions. DeVito then threw an interception to <a href=\"http://www.espn.com/nfl/player/_/id/4371973/roger-mccreary\">Roger McCreary</a> late in the first half. The Lions couldn't capitalize, though. Goff was picked off in the back of the end zone by <a href=\"http://www.espn.com/nfl/player/_/id/2574056/kevin-byard\">Kevin Byard</a> III.\n\n\r\n              Patriots cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4686772/christian-gonzalez\">Christian Gonzalez</a> had his first interception of the season in the first half. <a href=\"http://www.espn.com/nfl/player/_/id/2991662/mack-hollins\">Mack Hollins</a> led the Patriots with five catches for 48 yards.\n\n\r\n              “We’re heading into the bye and we have to get some things fixed and changed and corrected and figure out ways to win as opposed to what we’re doing right now, which is not giving ourselves enough of a chance,” Vrabel said.\n\n\r\n              <hl2>New field incoming</hl2>\r\n              Immediately after the game, workers will start installing <a href=\"https://x.com/NPappas23/status/2120947249488506906\">a new field</a>. Bayern Munich hosts Cologne on Friday night in a Bundesliga game. The NFL wouldn’t confirm a German media report that said the league would pay up to 200,000 euros ($220,000) for the new pitch. In a statement to AP, the league said only that it will “work in partnership with Allianz Arena to replace the field following Sunday’s game.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Patriots: Besides Maye, WR <a href=\"http://www.espn.com/nfl/player/_/id/4047646/aj-brown\">A.J. Brown</a> left in the second half with a hamstring injury. Brown had missed the past two games with ankle and knee problems... RT <a href=\"http://www.espn.com/nfl/player/_/id/16771/morgan-moses\">Morgan Moses</a> left in the first quarter but returned before halftime ... RB <a href=\"http://www.espn.com/nfl/player/_/id/4432710/treveyon-henderson\">TreVeyon Henderson</a>, who didn’t make the trip, was placed on injured reserve Saturday.\n\n\r\n              <hl2>Up next</hl2>\r\n              Patriots: Bye week.\n\n\r\n              Lions: Host the <a href=\"http://www.espn.com/nfl/team/_/name/tb/tampa-bay-buccaneers\">Tampa Bay Buccaneers</a> next Sunday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-15T17:48:40Z"}}