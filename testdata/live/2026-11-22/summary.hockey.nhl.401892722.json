oreValue":0,"awayScore":0,"homeScore":0,"text":"Puck in Netting","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:43"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"516","fullName":"American Airlines Center","address":{"city":"Dallas","state":"TX","zipCode":"75398","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/516.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18532,"officials":[{"fullName":"Jordan Samuels-Thomas","displayName":"Jordan Samuels-Thomas","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Graham Skilliter","displayName":"Graham Skilliter","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Caleb Apperson","displayName":"Caleb Apperson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jason Robertson scores overtime goal to lift Stars past Panthers 2-1","description":"— Jason Robertson scored at 2:56 of overtime to lift the Dallas Stars past the Florida Panthers 2-1 on Sunday night.","story":"DALLAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4233875/jason-robertson\">Jason Robertson</a> scored at 2:56 of overtime to lift the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> past the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> 2-1 on Sunday night.\n\n\r\n              Robertson took a pass from <a href=\"http://www.espn.com/nhl/player/_/id/3904183/roope-hintz\">Roope Hintz</a> and scored on a backhander for his team-leading 10th goal this season and his seventh career overtime score.\n\n\r\n              Dallas’ <a href=\"http://www.espn.com/nhl/player/_/id/3025540/casey-desmith\">Casey DeSmith</a> won the matchup of backup goaltenders with 25 saves while Florida’s <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a> stopped 20 shots.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4874740/wyatt-johnston\">Wyatt Johnston</a> also scored for the Stars, who snapped a six-game losing streak against the Panthers, beating them for the first time since Jan. 8, 2023.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024854/matthew-tkachuk\">Matthew Tkachuk</a> scored for the Panthers, who had a three-game winning streak snapped.\n\n\r\n              Both teams completed a back-to-back and played a third game in four nights. Dallas won both, shutting out Buffalo 2-0 on Saturday and completing a 3-1-0 homestand. Florida won 4-1 at St. Louis on Saturday.\n\n\r\n              The Stars are 3-0 in overtime this season, the Panthers 2-3.\n\n\r\n              Tkachuk opened the scoring with a power-play goal at 4:27 of the second period with a shot from the right circle off the bottom of the crossbar, with brother Brady screening DeSmith, for his 700th career NHL point. It was only the fourth goal allowed by Dallas’ league-best home penalty kill in 45 shorthanded situations.\n\n\r\n              Johnston tied the score about five minutes later when he controlled a cross-ice pass from <a href=\"http://www.espn.com/nhl/player/_/id/4565239/thomas-harley\">Thomas Harley</a> and scored easily with Schmid on the far side of the net. Three of Florida’s skaters had been on the ice for close to two minutes.\n\n\r\n              Harley has nine points (two goals, seven assists) in his last seven games\n\n\r\n              The Stars played with five defensemen from early in the second period with <a href=\"http://www.espn.com/nhl/player/_/id/5052/tyler-myers\">Tyler Myers</a> sidelined with an upper-body injury.\n\n\r\n              <hl2>Up next</hl2>\r\n              Panthers: Host Edmonton on Tuesday.\n\n\r\n              Stars: Play the first of two consecutive games at Vegas on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-16T04:04:34Z"}}