07","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:59"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"5188651","displayName":"Eric Pohlkamp","shortName":"E. Pohlkamp"},"type":"shooter"},{"athlete":{"id":"3042109","displayName":"Juuse Saros","shortName":"J. Saros"}}]}],"gameInfo":{"venue":{"id":"1653","fullName":"SAP Center at San Jose","address":{"city":"San Jose","state":"CA","zipCode":"95196","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1653.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":14949,"officials":[{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Corey Syvret","displayName":"Corey Syvret","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Sharks beat Predators 4-2 to end Nashville's 7-game win streak","description":"— Macklin Celebrini and Will Smith each had a goal and two assists as the San Jose Sharks snapped the Nashville Predators' seven-game win streak, 4-2 on Sunday night.","story":"SAN JOSE, Calif. -- — <a href=\"http://www.espn.com/nhl/player/_/id/5206628/macklin-celebrini\">Macklin Celebrini</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149155/will-smith\">Will Smith</a> each had a goal and two assists as the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a> snapped the <a href=\"http://www.espn.com/nhl/team/_/name/nsh/nashville-predators\">Nashville Predators</a>' seven-game win streak, 4-2 on Sunday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5361709/ivar-stenberg\">Ivar Stenberg</a> had a goal and an assist and <a href=\"http://www.espn.com/nhl/player/_/id/5136607/collin-graf\">Collin Graf</a> also scored for the Sharks, while <a href=\"http://www.espn.com/nhl/player/_/id/3114994/alex-nedeljkovic\">Alex Nedeljkovic</a> made 32 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565263/nils-hoglander\">Nils Hoglander</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5037/steven-stamkos\">Steven Stamkos</a> scored for the Predators and <a href=\"http://www.espn.com/nhl/player/_/id/3042109/juuse-saros\">Juuse Saros</a> stopped 20 shots.\n\n\r\n              Smith opened the scoring with 7:35 left in the first period with his eighth goal of the season after a breakaway that left him all alone after Stenberg found him.\n\n\r\n              Graf made it 2-0 with 3:50 left in the first period with his third goal of the season and first in 11 games.\n\n\r\n              Stenberg made it 3-0 at 4:45 of the second period with his third goal of the season, as Smith found him right in front for a tap-in while Saros had lost his stick.\n\n\r\n              Nashville got on the board late in the second period when Hoglander scored his fifth of the season after San Jose wasn’t able to clear the puck. <a href=\"http://www.espn.com/nhl/player/_/id/4697765/adam-wilsby\">Adam Wilsby</a> had the assist.\n\n\r\n              Celebrini made it 4-1 at 7:40 of the third period, with assists from Smith and defenseman <a href=\"http://www.espn.com/nhl/player/_/id/2976839/jacob-trouba\">Jacob Trouba</a>.\n\n\r\n              Nashville cut the lead to 4-2 with 3:25 left to play on a power-play goal by Stamkos, his 12th of the season. The puck just sneaked inside the post and the goal was upheld after a review.\n\n\r\n              The Sharks have yet to record a shutout this season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Predators: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a> on Tuesday night.\n\n\r\n              Sharks: Host the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-16T04:57:34Z"}}