lay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Parker Wotherspoon","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"3942638","displayName":"Parker Wotherspoon","shortName":"P. Wotherspoon"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"5060","fullName":"T-Mobile Arena","address":{"city":"Las Vegas","state":"NV","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5060.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16336,"officials":[{"fullName":"Kyle Rehman","displayName":"Kyle Rehman","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Trent Knorr","displayName":"Trent Knorr","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Ben O'Quinn","displayName":"Ben O'Quinn","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Mike Sullivan","displayName":"Mike Sullivan","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Chytil, Karlsson score twice as Canucks snap 7-game skid with win over Golden Knights","description":"— Filip Chytil and Linus Karlsson each scored twice and the Vancouver Canucks snapped a seven-game losing streak with a 6-3 victory over the Vegas Golden Knights on Sunday night.","story":"LAS VEGAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4233643/filip-chytil\">Filip Chytil</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4587713/linus-karlsson\">Linus Karlsson</a> each scored twice and the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> snapped a seven-game losing streak with a 6-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> on Sunday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4233566/elias-pettersson\">Elias Pettersson</a> and Drew O’Connor also scored for the Canucks. <a href=\"http://www.espn.com/nhl/player/_/id/4894703/leevi-merilainen\">Leevi Merilainen</a> stopped 34 shots. <a href=\"http://www.espn.com/nhl/player/_/id/3899979/brock-boeser\">Brock Boeser</a> had two assists to extend his points streak to seven games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3151096/victor-olofsson\">Victor Olofsson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5272307/braeden-bowman\">Braeden Bowman</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5545/mark-stone\">Mark Stone</a> scored for the Golden Knights. <a href=\"http://www.espn.com/nhl/player/_/id/4064582/carter-hart\">Carter Hart</a>, who made 21 saves, allowed three or more goals for the fifth time this season.\n\n\r\n              Vancouver ended an eight-game losing streak against Vegas and halted the Golden Knights’ six-game points streak. The Canucks had lost nine of their previous 10 games.\n\n\r\n              Stone’s power-play goal at 1:24 of the third period cut the deficit to 4-3 and gave him 417 points with the Golden Knights, tying Jonathan Marchessault’s franchise record.\n\n\r\n              O’Connor answered just 24 seconds later to restore Vancouver’s two-goal cushion. Karlsson added an empty-net goal with 2:14 remaining.\n\n\r\n              Chytil, activated from injured reserve Friday, scored his first two goals of the season. He tipped in a shot with 2:24 left in the first period for a 3-1 lead, then scored short0handed at 2:14 of the second to make it 4-1.\n\n\r\n              Pettersson opened the scoring on a power play at 5:20 of the first, and Karlsson doubled the lead at 9:49. Olofsson’s power-play goal at 13:30 extended his goals streak to three games.\n\n\r\n              Bowman cut Vancouver’s lead to 4-2 with 8:03 to go in the second.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3899937/mitch-marner\">Mitch Marner</a> had two assists for Vegas, extending his home points streak to 11 games. <a href=\"http://www.espn.com/nhl/player/_/id/2976844/tomas-hertl\">Tomas Hertl</a> assisted on Olofsson’s goal, extending his points streak to seven.\n\n\r\n              <hl2>Up next</hl2>\r\n              Canucks: At Utah on Monday night.\n\n\r\n              Golden Knights: Host Dallas on Tuesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-16T04:58:34Z"}}