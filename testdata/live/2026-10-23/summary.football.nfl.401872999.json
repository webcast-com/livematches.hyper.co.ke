{"header":{"id":"401872999","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401872999","uid":"s:20~l:28~e:401872999~c:401872999","date":"2026-10-18T17:00Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"1","uid":"s:20~l:28~t:1","order":0,"homeAway":"home","winner":false,"score":"23","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"7"},{"displayValue":"0"},{"displayValue":"16"}],"team":{"id":"1","abbreviation":"ATL","displayName":"Atlanta Falcons","name":"Falcons","location":"Atlanta","nickname":"Falcons","color":"a71930","alternateColor":"000000","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/atl.png"}]}},{"id":"3","uid":"s:20~l:28~t:3","order":1,"homeAway":"away","winner":true,"score":"31","possession":false,"linescores":[{"displayValue":"14"},{"displayValue":"7"},{"displayValue":"7"},{"displayValue":"3"}],"team":{"id":"3","abbreviation":"CHI","displayName":"Chicago Bears","name":"Bears","location":"Chicago","nickname":"Bears","color":"0b1c3a","alternateColor":"e64100","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/chi.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/chi.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"3","abbreviation":"CHI","displayName":"Chicago Bears","shortDisplayName":"Bears","name":"Bears","location":"Chicago","color":"0b1c3a","alternateColor":"e64100","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/chi.png"},"statistics"