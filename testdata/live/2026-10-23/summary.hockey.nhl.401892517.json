ame":"Mackenzie Blackwood","shortName":"M. Blackwood"},"type":"saver"}]},{"id":"401892517000001020","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Parker Kelly","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"2:00"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"4392309","displayName":"Parker Kelly","shortName":"P. Kelly"},"type":"giver"}]},{"id":"401892517000000950","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Gavin Brindley hit Spencer Stastney","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:16"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"5136614","displayName":"Gavin Brindley","shortName":"G. Brindley"},"type":"hit-credited"},{"athlete":{"id":"4393406","displayName":"Spencer Stastney","shortName":"S. Stastney"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"892","guid":"9550602e-29ea-36e1-a8e9-1946f7ef53aa","fullName":"Ball Arena","address":{"city":"Denver","state":"CO","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/892.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18111,"officials":[{"fullName":"Scott Cherrey","displayName":"Scott Cherrey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Chris Rooney","displayName":"Chris Rooney","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Tom Chmielewski","displayName":"Tom Chmielewski","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Nathan MacKinnon has goal and 3 assists, Artturi Lehkonen scores twice as Avs beat Penguins 5-2","description":"— Nathan MacKinnon had three assists and a power-play goal, Artturi Lehkonen scored twice and the Colorado Avalanche rallied to beat the Pittsburgh Penguins 5-2 on Friday night.","story":"DENVER -- — <a href=\"http://www.espn.com/nhl/player/_/id/3041969/nathan-mackinnon\">Nathan MacKinnon</a> had three assists and a power-play goal, <a href=\"http://www.espn.com/nhl/player/_/id/3042050/artturi-lehkonen\">Artturi Lehkonen</a> scored twice and the <a href=\"https://apnews.com/hub/colorado-avalanche\"><a href=\"http://www.espn.com/nhl/team/_/name/col/colorado-avalanche\">Colorado Avalanche</a></a> rallied to beat the <a href=\"http://www.espn.com/nhl/team/_/name/pit/pittsburgh-penguins\">Pittsburgh Penguins</a> 5-2 on Friday night.\n\n\r\n               <a href=\"http://www.espn.com/nhl/player/_/id/5136616/tj-hughes\">T.J. Hughes</a> scored his first NHL goal, while <a href=\"http://www.espn.com/nhl/player/_/id/3904177/mackenzie-blackwood\">Mackenzie Blackwood</a> settled in after a shaky start to stop 29 shots. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3124/evgeni-malkin\">Evgeni Malkin</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2591155/bryan-rust\">Bryan Rust</a> gave Pittsburgh a 2-0 lead after scoring 29 seconds apart midway through the first period. The Avalanche erupted for five straight tallies, including three in the second period. \n\n\r\n              Colorado finished 1 of 4 on the power play in the Avalanche debut of assistant coach Brett McLean. He's in charge of the unit after <a href=\"https://apnews.com/article/arizona-state-matthew-mayich-collapse-503c57f2366178b48ededa376476745c\">Dave Hakstol</a> left to take over as head coach of the men's hockey program at Arizona State.\n\n\r\n              Lehkonen's second goal tied it 25 seconds into the second period. Captain <a href=\"http://www.espn.com/nhl/player/_/id/2562609/gabriel-landeskog\">Gabriel Landeskog</a> had a goal nearly four minutes later for his 83rd career go-ahead score. He's tied with <a href=\"http://www.espn.com/nhl/player/_/id/3899938/mikko-rantanen\">Mikko Rantanen</a> for sixth-most in Avalanche history. Hall of Famer Joe Sakic tops the list with 210.\n\n\r\n              Hughes got free down low and poked in a pass from MacKinnon. He was hugged by <a href=\"http://www.espn.com/nhl/player/_/id/4233563/cale-makar\">Cale Makar</a> and then playfully <a href=\"https://x.com/Avalanche/status/2111286744989720670\">squirted with water</a> by Landeskog as Hughes made his way past the bench. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114/sidney-crosby\">Sidney Crosby</a> notched his 1,110th career assist to move into sole possession of seventh place in NHL history. He's also one assist shy of matching Ray Bourque (1,111 with Boston) for the most in league history with a one franchise.\n\n\r\n              MacKinnon improved to 12-6-3 when playing against Crosby, his good buddy from Nova Scotia. MacKinnon was awarded a penalty shot, but was stopped by <a href=\"http://www.espn.com/nhl/player/_/id/4576894/arturs-silovs\">Arturs Silovs</a>. \n\n\r\n              <hl2>UP NEXT</hl2>\r\n              Penguins: At Vegas on Saturday night.\n\n\r\n              Avalanche: Two-game road swing starting Monday night at Philadelphia.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-17T03:52:39Z"}}