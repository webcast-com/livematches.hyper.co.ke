,"clock":{"displayValue":"1:05"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"4587854","displayName":"Alexander Romanov","shortName":"A. Romanov"},"type":"shooter"},{"athlete":{"id":"3067313","displayName":"Anthony Stolarz","shortName":"A. Stolarz"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18801,"officials":[{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Trevor Hanson","displayName":"Trevor Hanson","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Maple Leafs beat the Islanders 2-1 to rebound from opening loss","description":"— Easton Cowan had a goal and an assist in the first period and the Toronto Maple Leafs beat the New York Islanders 2-1 on Wednesday night for their first victory under coach Jim Hiller.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/5149211/easton-cowan\">Easton Cowan</a> had a goal and an assist in the first period and the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> 2-1 on Wednesday night for their first victory under coach Jim Hiller.\n\n\r\n              The Maple Leafs rebounded from a 3-2 home loss to Montreal in their opener Tuesday night, spoiling the Islanders' first game of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/2993474/colton-sissons\">Colton Sissons</a> also scored for Toronto, and <a href=\"http://www.espn.com/nhl/player/_/id/3067313/anthony-stolarz\">Anthony Stolarz</a> made 26 saves.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697447/emil-heineman\">Emil Heineman</a> scored in the third period for New York. <a href=\"http://www.espn.com/nhl/player/_/id/3151981/ilya-sorokin\">Ilya Sorokin</a> stopped 24 shots.\n\n\r\n              Sissons redirected his first goal for Toronto at 7:14 of the first period off <a href=\"http://www.espn.com/nhl/player/_/id/3042111/nick-paul\">Nick Paul</a>'s setup. Cowan then shoveled home a power-play rebound with 8:05 left in the period.\n\n\r\n              Reunited with fellow netminder <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> after winning the Stanley Cup together with Florida in 2024, Stolarz was perfect until Heineman scored short-handed with 5:51 left.\n\n\r\n              <hl2>Up next</hl2>\r\n              Islanders: Host New Jersey on Saturday night.\n\n\r\n              Maple Leafs: Host Ottawa on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-01T02:36:27Z"}}