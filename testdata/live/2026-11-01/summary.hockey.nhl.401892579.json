er":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"5517","displayName":"Kyle Palmieri","shortName":"K. Palmieri"},"type":"giver"}]},{"id":"401892579000000700","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mikko Rantanen Wrist Shot saved by Ilya Sorokin","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:19"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"9"},"participants":[{"athlete":{"id":"3899938","displayName":"Mikko Rantanen","shortName":"M. Rantanen"},"type":"shooter"},{"athlete":{"id":"3151981","displayName":"Ilya Sorokin","shortName":"I. Sorokin"},"type":"saver"}]},{"id":"401892579000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892579000000750","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Brayden Schenn faceoff won against Roope Hintz","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"12"},"participants":[{"athlete":{"id":"5219","displayName":"Brayden Schenn","shortName":"B. Schenn"},"type":"face-off-winner"},{"athlete":{"id":"3904183","displayName":"Roope Hintz","shortName":"R. Hintz"}}]}],"gameInfo":{"venue":{"id":"516","fullName":"American Airlines Center","address":{"city":"Dallas","state":"TX","zipCode":"75398","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/516.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18532,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Graedy Hamilton","displayName":"Graedy Hamilton","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Jason Robertson scores twice to help the Stars beat the Islanders 6-3","description":"— Jason Robertson scored twice and the Dallas Stars had a three-goal third period in a 6-3 victory over the New York Islanders on Sunday night.","story":"DALLAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/4233875/jason-robertson\">Jason Robertson</a> scored twice and the <a href=\"http://www.espn.com/nhl/team/_/name/dal/dallas-stars\">Dallas Stars</a> had a three-goal third period in a 6-3 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/nyi/new-york-islanders\">New York Islanders</a> on Sunday night.\n\n\r\n              Robertson’s breakaway at 9:45 of the third period came five minutes after Wyatt Johnston’s tiebreaker. <a href=\"http://www.espn.com/nhl/player/_/id/3899938/mikko-rantanen\">Mikko Rantanen</a> added a goal four minutes after Robertson with his team-high sixth goal of the season.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5430/tyler-seguin\">Tyler Seguin</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5229176/justin-hryckowian\">Justin Hryckowian</a> also scored for the Stars, who have won five consecutive games. <a href=\"http://www.espn.com/nhl/player/_/id/4196914/jake-oettinger\">Jake Oettinger</a> made 16 saves.\n\n\r\n              Defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5291933/matthew-schaefer\">Matthew Schaefer</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5517/kyle-palmieri\">Kyle Palmieri</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5219/brayden-schenn\">Brayden Schenn</a> scored for the Islanders, who erased three one-goal deficits only to lose two straight (0-1-1) for the first time this season. <a href=\"http://www.espn.com/nhl/player/_/id/3151981/ilya-sorokin\">Ilya Sorokin</a> stopped 32 shots allowing a season high in goals.\n\n\r\n              Johnston scored from the slot 4:10 into the final period on a feed from Nils Lundqvist. After scoring a career-most 45 goals last season, Johnston has goals in consecutive games after going goalless in his first seven outings.\n\n\r\n              Sunday marked the Dallas return of Pete DeBoer, who took over the Islanders with four games to play last season. DeBoer was fired by the Stars in June 2025 after losing in the conference finals in each of his three Dallas seasons.\n\n\r\n              The Stars have 20 straight penalty kills through its last five games, three on Sunday.\n\n\r\n              The game was Dallas’ third in a six-game homestand and began a three-game Central Division trip for New York.\n\n\r\n              Hryckowian’s younger brother, Dylan, and fellow forward <a href=\"http://www.espn.com/nhl/player/_/id/5139042/matthew-seminoff\">Matthew Seminoff</a> made their NHL debuts on Dallas' fourth line. The brothers were in the starting lineup.\n\n\r\n              <hl2>Up next</hl2>\r\n              Islanders: At Nashville on Tuesday night.\n\n\r\n              Stars: Host New Jersey on Tuesday night\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-26T00:39:46Z"}}