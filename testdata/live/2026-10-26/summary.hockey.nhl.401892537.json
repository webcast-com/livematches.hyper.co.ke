,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"3095892","displayName":"Vinni Lettieri","shortName":"V. Lettieri"},"type":"shooter"},{"athlete":{"id":"5188591","displayName":"Luca Cagnoni","shortName":"L. Cagnoni"},"type":"defender"}]},{"id":"401892537000001180","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mason Marchment hit Vinni Lettieri","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:56"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"18"},"participants":[{"athlete":{"id":"4272192","displayName":"Mason Marchment","shortName":"M. Marchment"},"type":"hit-credited"},{"athlete":{"id":"3095892","displayName":"Vinni Lettieri","shortName":"V. Lettieri"},"type":"hitted"}]},{"id":"401892537000000820","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Nick Blankenburg Wrist Shot saved by Yaroslav Askarov","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:27"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"21"},"participants":[{"athlete":{"id":"4781550","displayName":"Nick Blankenburg","shortName":"N. Blankenburg"},"type":"shooter"},{"athlete":{"id":"4697394","displayName":"Yaroslav Askarov","shortName":"Y. Askarov"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19011,"officials":[{"fullName":"Jean Hebert","displayName":"Jean Hebert","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Michael Markovic","displayName":"Michael Markovic","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ryan Jackson","displayName":"Ryan Jackson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Gavin McKenna scores and the Maple Leafs end a 3-game slide with 3-1 win over the Sharks","description":"— Gavin McKenna scored the go-ahead goal on a third-period power play and the Toronto Maple Leafs snapped a three-game slide Monday night with a 3-1 victory over the San Jose Sharks.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/5342529/gavin-mckenna\">Gavin McKenna</a> scored the go-ahead goal on a third-period power play and the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> snapped a three-game slide Monday night with a 3-1 victory over the <a href=\"http://www.espn.com/nhl/team/_/name/sj/san-jose-sharks\">San Jose Sharks</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4024123/auston-matthews\">Auston Matthews</a> added a goal and two assists for Toronto. <a href=\"http://www.espn.com/nhl/player/_/id/5571/sergei-bobrovsky\">Sergei Bobrovsky</a> made 30 saves to pick up his first home win for the Maple Leafs. <a href=\"http://www.espn.com/nhl/player/_/id/3042111/nick-paul\">Nick Paul</a> added an empty-netter.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4272192/mason-marchment\">Mason Marchment</a> scored for San Jose, which got 28 stops from <a href=\"http://www.espn.com/nhl/player/_/id/4697394/yaroslav-askarov\">Yaroslav Askarov</a>.\n\n\r\n              The game featured the first meeting between the No. 1 and 2 picks of the 2026 NHL draft — McKenna and Sharks winger <a href=\"http://www.espn.com/nhl/player/_/id/5361709/ivar-stenberg\">Ivar Stenberg</a>.\n\n\r\n              Marchment opened the scoring at 13:54 of the first when he was left alone in front of Bobrovsky after Matthews turned the puck over in the defensive zone.\n\n\r\n              Matthews made up for that mistake and got his team even with 12 seconds left in the second on a power play. Toronto’s captain took a pass from <a href=\"http://www.espn.com/nhl/player/_/id/4587996/kirill-marchenko\">Kirill Marchenko</a> and ripped a shot upstairs on Askarov before McKenna pushed the Leafs in front in the third.\n\n\r\n              <hl2>Up next</hl2>\r\n              Sharks: At Montreal on Tuesday.\n\n\r\n              Maple Leafs: At Columbus on Tuesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-20T02:52:07Z"}}