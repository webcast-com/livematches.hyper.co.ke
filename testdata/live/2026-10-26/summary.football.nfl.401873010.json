inPercentage":0.7681,"playId":"4018730101368","tiePercentage":0},{"homeWinPercentage":0.7844,"playId":"4018730101395","tiePercentage":0},{"homeWinPercentage":0.741,"playId":"4018730101422","tiePercentage":0},{"homeWinPercentage":0.7154,"playId":"4018730101455","tiePercentage":0},{"homeWinPercentage":0.7255,"playId":"4018730101489","tiePercentage":0},{"homeWinPercentage":0.7255,"playId":"4018730101501","tiePercentage":0},{"homeWinPercentage":0.7126,"playId":"4018730101512","tiePercentage":0},{"homeWinPercentage":0.6902,"playId":"4018730101542","tiePercentage":0},{"homeWinPercentage":0.692,"playId":"4018730101567","tiePercentage":0},{"homeWinPercentage":0.665,"playId":"4018730101589","tiePercentage":0},{"homeWinPercentage":0.6426,"playId":"4018730101614","tiePercentage":0},{"homeWinPercentage":0.6145,"playId":"4018730101636","tiePercentage":0},{"homeWinPercentage":0.6143,"playId":"4018730101647","tiePercentage":0},{"homeWinPercentage":0.7521,"playId":"4018730101658","tiePercentage":0},{"homeWinPercentage":0.752,"playId":"4018730101676","tiePercentage":0},{"homeWinPercentage":0.7583,"playId":"4018730101693","tiePercentage":0},{"homeWinPercentage":0.7459,"playId":"4018730101730","tiePercentage":0},{"homeWinPercentage":0.7651,"playId":"4018730101753","tiePercentage":0},{"homeWinPercentage":0.7486,"playId":"4018730101787","tiePercentage":0},{"homeWinPercentage":0.7451,"playId":"4018730101810","tiePercentage":0},{"homeWinPercentage":0.8127,"playId":"4018730101848","tiePercentage":0},{"homeWinPercentage":0.8129,"playId":"4018730101866","tiePercentage":0},{"homeWinPercentage":0.8235,"playId":"4018730101884","tiePercentage":0}],"gameInfo":{"venue":{"id":"3933","guid":"adbe5c1d-8923-3bf4-8e31-fe78211484a9","fullName":"Soldier Field","address":{"city":"Chicago","state":"IL","zipCode":"60605","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3933.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3933.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":60520,"officials":[{"fullName":"Greg Bradley","displayName":"Greg Bradley","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":1},{"fullName":"Paul King","displayName":"Paul King","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":2},{"fullName":"Dale Shaw","displayName":"Dale Shaw","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":3},{"fullName":"Alan Eck","displayName":"Alan Eck","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":4},{"fullName":"David Oliver","displayName":"David Oliver","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":5},{"fullName":"Grantis Bell","displayName":"Grantis Bell","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":6},{"fullName":"Frederick Dimpfel VI","displayName":"Frederick Dimpfel VI","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":7}]},"article":{"headline":"Caleb Williams throws 2 TD passes as the Bears beat Drake Maye and the Patriots 30-24","description":"— Round 2 went to Caleb Williams and the Chicago Bears.","story":"CHICAGO -- — Round 2 went to <a href=\"http://www.espn.com/nfl/player/_/id/4431611/caleb-williams\">Caleb Williams</a> and the <a href=\"http://www.espn.com/nfl/team/_/name/chi/chicago-bears\">Chicago Bears</a>.\n\n\r\n              Williams passed for 308 yards and two touchdowns, and the Bears cooled off <a href=\"http://www.espn.com/nfl/player/_/id/4431452/drake-maye\">Drake Maye</a> and the <a href=\"http://www.espn.com/nfl/team/_/name/ne/new-england-patriots\">New England Patriots</a> with a 30-24 victory Thursday night.\n\n\r\n              It was the second meeting between the young quarterbacks since they were part of the 2024 NFL draft. Maye, who was selected by New England at No. 3, directed the Patriots to <a href=\"https://apnews.com/article/patriots-bears-score-maye-9726d3599ad17308f2a311347d9e8b37\">a 19-3 victory</a> over Williams and the Bears when the longtime friends were rookies.\n\n\r\n              But Williams, the No. 1 overall pick, leaned on Luther Burden and <a href=\"http://www.espn.com/nfl/player/_/id/4723086/colston-loveland\">Colston Loveland</a> while outlasting Maye and the Patriots in the rematch. Williams connected on 22 of 33 passes in his second game back after being sidelined by a right hamstring injury.\n\n\r\n              “These nights are awesome,” Williams said. “You play against another good team on a primetime game in a short week, these games are awesome because you get to see who you are as a team. That’s who we are. We’re a smashmouth football team, an innovative team. And when things happen and things don’t go our way and the water is rocky, we stay steady.”\n\n\r\n              Maye was 24 for 31 for 321 yards and two touchdowns. He also had a 7-yard run for New England's first TD with 11:33 left in the first half.\n\n\r\n              But Maye also was intercepted by Bears linebacker <a href=\"http://www.espn.com/nfl/player/_/id/4241007/d'marco-jackson\">D'Marco Jackson</a> in the end zone on a pass intended for rookie tight end <a href=\"http://www.espn.com/nfl/player/_/id/4831959/eli-raridon\">Eli Raridon</a> late in the second quarter.\n\n\r\n              “It’s those plays, I talk about it all the time,” Maye said. “You know those plays that can swing the game, can impact the game and that was definitely one of them right there. Yeah, I wish I definitely had that one back.”\n\n\r\n              New England (4-3) had won three consecutive games behind Maye, who threw 10 TD passes and one interception during the win streak.\n\n\r\n              “He gave us a chance,\" Patriots coach Mike Vrabel said. \"He competed and I know he’d like to have that throw back to Eli, but I thought he really competed. Whether that was running around and scrambling or finding good places to go with the football. He gave us a chance. ... I’m glad he’s ours.”\n\n\r\n              Burden had four catches for 130 yards for Chicago (5-2), and Loveland had a 12-yard touchdown reception. <a href=\"http://www.espn.com/nfl/player/_/id/17427/cairo-santos\">Cairo Santos</a> kicked a 58-yard field goal with 1:34 left, a career long and matching the franchise record, after he missed a 53-yard attempt earlier in the final quarter.\n\n\r\n              Williams became the first Bears quarterback to throw for more than 300 yards in consecutive games since Mitch Trubisky had a three-game run in 2018.\n\n\r\n              “I think he did a pretty good job throughout the night,” Bears coach Ben Johnson said. “I know he had a number of explosive plays. He found some of those guys at the second level that were huge for us.”\n\n\r\n              After Santos’ long field goal, Maye drove New England into range for Andy Borregales’ 47-yarder with 37 seconds to go. But Chicago recovered the ensuing onside kick.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4569173/rhamondre-stevenson\">Rhamondre Stevenson</a> had five catches for 93 yards and a touchdown for the Patriots. Raridon had a 30-yard TD catch in the third quarter.\n\n\r\n              “We did some good things,” Vrabel said. “But again, didn’t do enough.” \n\n\r\n              It was Chicago’s first home game since <a href=\"https://apnews.com/article/mike-ditka-dies-bears-74ce49079f324ca0a9fa8e61857783fb\">Mike Ditka</a> died on Oct. 9. The Bears saluted the Hall of Fame tight end and longtime coach with a pregame moment of silence, and they also handed out fake mustaches to the crowd of 60,520 at Soldier Field.\n\n\r\n              Ditka’s No. 89 jersey dotted the stands, and fans also donned Bears sweaters in a callback to what he wore on the sideline as a coach.\n\n\r\n              Chicago opened a 20-7 lead on Burden’s 24-yard touchdown with 14 seconds left in the first half. Burden got the ball on a screen on third-and-17, and Loveland, <a href=\"http://www.espn.com/nfl/player/_/id/2973405/kalif-raymond\">Kalif Raymond</a> and <a href=\"http://www.espn.com/nfl/player/_/id/4426358/darnell-wright\">Darnell Wright</a> helped clear the way for his second TD reception of the season.\n\n\r\n              “The whole calvary came ... and it was like a wave carrying him through there,” Johnson said. “He saw a little crease and hit the jets.” \n\n\r\n              Set to receive the second-half kickoff, the Bears were in position to pull away. But the Patriots responded with Stevenson’s <a href=\"https://x.com/Patriots/status/2113446816603570284?s=20\">48-yard touchdown reception</a> on the final play of the period.\n\n\r\n              Stevenson <a href=\"https://apnews.com/article/patriots-rhamondre-stevenson-f829d80256d4214eca01adc91a652e83\">slipped out of the backfield</a> and Maye lobbed the ball over the head of Bears safety <a href=\"http://www.espn.com/nfl/player/_/id/3916577/cam-lewis\">Cam Lewis</a>. Stevenson ran away from Lewis and got a downfield block from <a href=\"http://www.espn.com/nfl/player/_/id/4427095/demario-douglas\">DeMario Douglas</a> before cutting past Bears cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4243253/jaylon-johnson\">Jaylon Johnson</a> on his way to the end zone.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Patriots: CB <a href=\"http://www.espn.com/nfl/player/_/id/4686772/christian-gonzalez\">Christian Gonzalez</a> played after being listed as questionable because of an illness. ... S <a href=\"http://www.espn.com/nfl/player/_/id/2574056/kevin-byard\">Kevin Byard</a> departed after he was checked out by trainers with 9:44 left in first half. He later returned. ... DT <a href=\"http://www.espn.com/nfl/player/_/id/4372030/christian-barmore\">Christian Barmore</a> departed late in the game.\n\n\r\n              Bears: CB Malik Muhammad left in the third quarter with a toe injury. ... TE <a href=\"http://www.espn.com/nfl/player/_/id/4258595/cole-kmet\">Cole Kmet</a> hurt his right knee on a reception with 5:34 left. \"We’ll know more tomorrow, but I don’t think it looked very good,” Johnson said.\n\n\r\n              <hl2>Up next</hl2>\r\n              Patriots: At Miami on Nov. 1.\n\n\r\n              Bears: At Seattle for a Monday night game Nov. 2.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-23T03:32:08Z"}}