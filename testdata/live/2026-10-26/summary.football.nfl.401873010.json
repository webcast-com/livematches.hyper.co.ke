{"header":{"id":"401873010","league":{"id":"28","name":"National Football League","abbreviation":"NFL","slug":"nfl","logos":[{"href":"https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png","rel":["full","default"]},{"href":"https://a.espncdn.com/i/teamlogos/leagues/500-dark/nfl.png","rel":["full","dark"]}]},"season":{"year":2026,"type":2},"competitions":[{"id":"401873010","uid":"s:20~l:28~e:401873010~c:401873010","date":"2026-10-23T00:15Z","neutralSite":false,"status":{"type":{"id":"3","name":"STATUS_FINAL","state":"post","completed":true,"description":"Final","detail":"Final","shortDetail":"Final"}},"competitors":[{"id":"3","uid":"s:20~l:28~t:3","order":0,"homeAway":"home","winner":true,"score":"30","possession":false,"linescores":[{"displayValue":"10"},{"displayValue":"10"},{"displayValue":"7"},{"displayValue":"3"}],"team":{"id":"3","abbreviation":"CHI","displayName":"Chicago Bears","name":"Bears","location":"Chicago","nickname":"Bears","color":"0b1c3a","alternateColor":"e64100","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/chi.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/chi.png"}]}},{"id":"17","uid":"s:20~l:28~t:17","order":1,"homeAway":"away","winner":false,"score":"24","possession":false,"linescores":[{"displayValue":"0"},{"displayValue":"14"},{"displayValue":"7"},{"displayValue":"3"}],"team":{"id":"17","abbreviation":"NE","displayName":"New England Patriots","name":"Patriots","location":"New England","nickname":"Patriots","color":"002a5c","alternateColor":"c60c30","logo":"https://a.espncdn.com/i/teamlogos/nfl/500/ne.png","logos":[{"href":"https://a.espncdn.com/i/teamlogos/nfl/500/ne.png"}]}}],"broadcasts":[{"market":{"id":"1","type":"National"}}]}]},"boxscore":{"teams":[{"homeAway":"away","displayOrder":1,"team":{"id":"17","abbreviation":"NE","displayName":"New England Patriots","shortDisplayName":"Patriots","name":"Patriots","location":"New England","color":"002a5c","alternateColor":"c60c30","logo":"https://a.espncdn.com/i/teamlogos/n