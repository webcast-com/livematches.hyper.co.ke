e":"1st"},"team":{"id":"25"},"participants":[{"athlete":{"id":"3648015","displayName":"A.J. Greer","shortName":"A.J. Greer"},"type":"hit-credited"},{"athlete":{"id":"4697402","displayName":"Braden Schneider","shortName":"B. Schneider"},"type":"hitted"}]},{"id":"401892535000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Eeli Tolvanen Tip-In Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:41"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4233720","displayName":"Eeli Tolvanen","shortName":"E. Tolvanen"},"type":"shooter"},{"athlete":{"id":"3151137","displayName":"Ville Husso","shortName":"V. Husso"}}]},{"id":"401892535000000940","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":1,"text":"Will Cuylle hit Cutter Gauthier","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:46"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"13"},"participants":[{"athlete":{"id":"4697468","displayName":"Will Cuylle","shortName":"W. Cuylle"},"type":"hit-credited"},{"athlete":{"id":"5080145","displayName":"Cutter Gauthier","shortName":"C. Gauthier"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"1830","guid":"6ae0ec9b-ec2f-35f3-a3c8-98b1076a9623","fullName":"Madison Square Garden","address":{"city":"New York","state":"NY","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1830.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18006,"officials":[{"fullName":"Travis Gawryletz","displayName":"Travis Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jon McIsaac","displayName":"Jon McIsaac","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Furman South","displayName":"Furman South","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Rangers beat the Ducks 5-2 to improve to 6-0-0 at home to start the season","description":"— Sean Durzi scored 78 seconds in, Dylan Garand made 29 saves and the New York Rangers defeated ","story":"NEW YORK -- — <a href=\"http://www.espn.com/nhl/player/_/id/4378683/sean-durzi\">Sean Durzi</a> scored 78 seconds in, <a href=\"https://apnews.com/article/rangers-life-after-igor-shesterkin-75576d8d0509e84b2270b1ecb8cef0c5\"><a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a></a> made 29 saves and the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> defeated <a href=\"https://apnews.com/article/anaheim-ducks-travel-trouble-a84b1301b38fe9f7b3bf2909c7fc9f58\">the travel-weary <a href=\"http://www.espn.com/nhl/team/_/name/ana/anaheim-ducks\">Anaheim Ducks</a></a> 5-2 on Monday night to improve to 6-0-0 at home this fall.\n\n\r\n              The Rangers did not pick up their sixth victory at Madison Square Garden last season until Jan. 26, their 23rd game there. They lost 27 of 41 at home on the way to missing the playoffs and finishing last in the Eastern Conference.\n\n\r\n              There is hope of a turnaround given this start, even <a href=\"https://apnews.com/article/igor-shesterkin-rangers-knee-injury-dbd661e9c2097c02d217e9496c717ae6\">missing franchise goaltender <a href=\"http://www.espn.com/nhl/player/_/id/3151297/igor-shesterkin\">Igor Shesterkin</a></a> for the rest of the season. Garand was making a fifth consecutive start since Shesterkin went down, and he has allowed two or fewer goals in nine of 10 NHL appearances dating to his debut last spring.\n\n\r\n              He got support early and often, with Durzi's goal making it three home games in a row where the Rangers have a goal in the first two minutes. That has only happened once before for New York, in March 1989.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042095/oliver-bjorkstrand\">Oliver Bjorkstrand</a> scored twice, captain <a href=\"http://www.espn.com/nhl/player/_/id/2590852/jt-miller\">J.T. Miller</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5149204/gabe-perreault\">Gabe Perreault</a> each had a goal and Alexis Lafrenière recorded two assists. <a href=\"http://www.espn.com/nhl/player/_/id/4587588/pavel-dorofeyev\">Pavel Dorofeyev</a>, the team's most notable trade acquisition over the summer, came close on several occasions but remained stuck on two goals for the season.\n\n\r\n              Putting goalie <a href=\"http://www.espn.com/nhl/player/_/id/3151137/ville-husso\">Ville Husso</a> in a tough spot with sloppy play, the Ducks looked every bit like a group that endured a 15-hour, delay-filled travel ordeal to the East Coast from southern California. They did not arrive at their hotel until 2:30 a.m., were on the ice for their morning skate less than nine hours later and were getting shut out until scoring twice in the final 70 seconds.\n\n\r\n              <hl2>Up next</hl2>\r\n              Ducks: <a href=\"http://www.espn.com/nhl/player/_/id/4588165/lukas-dostal\">Lukas Dostal</a> is expected to start in net for the second half of their New York back-to-back set, Tuesday night at the Islanders.\n\n\r\n              Rangers: Visit the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-20T01:49:08Z"}}