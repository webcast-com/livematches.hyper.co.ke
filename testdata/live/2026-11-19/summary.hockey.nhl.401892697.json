meScore":0,"text":"Matt Boldy Deflected Wide Left","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"3:11"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"30"},"participants":[{"athlete":{"id":"4565233","displayName":"Matt Boldy","shortName":"M. Boldy"},"type":"shooter"},{"athlete":{"id":"3067313","displayName":"Anthony Stolarz","shortName":"A. Stolarz"}}]},{"id":"401892697000000080","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Icing","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"3:19"},"period":{"number":1,"displayValue":"1st"}}],"gameInfo":{"venue":{"id":"1838","fullName":"Scotiabank Arena","address":{"city":"Toronto","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1838.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18397,"officials":[{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Shandor Alphonso","displayName":"Shandor Alphonso","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Beau Halkidis","displayName":"Beau Halkidis","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Matt Boldy has 2nd hat trick of season to help Wild beat Maple Leafs, 5-2","description":"— Matt Boldy completed his second hat trick of the season and the sixth of his career early in the third period and the Minnesota Wild sent the Toronto Maple Leafs to a fifth straight regulation home loss with a 5-2 victory Thursday night.","story":"TORONTO -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565233/matt-boldy\">Matt Boldy</a> completed his second hat trick of the season and the sixth of his career early in the third period and the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a> sent the <a href=\"http://www.espn.com/nhl/team/_/name/tor/toronto-maple-leafs\">Toronto Maple Leafs</a> to a fifth straight regulation home loss with a 5-2 victory Thursday night.\n\n\r\n              Boldy’s third goal of the night came after Maple Leafs winger <a href=\"http://www.espn.com/nhl/player/_/id/3114736/william-nylander\">William Nylander</a> and defenseman <a href=\"http://www.espn.com/nhl/player/_/id/5488/oliver-ekman-larsson\">Oliver Ekman-Larsson</a> got their wires crossed off the rush to open a clear lane for the Wild winger.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042048/michael-mccarron\">Michael McCarron</a> and <a href=\"http://www.espn.com/nhl/player/_/id/5080172/danila-yurov\">Danila Yurov</a>, into an empty net, also scored for Minnesota (14-3-4), which got 26 saves from <a href=\"http://www.espn.com/nhl/player/_/id/4874737/jesper-wallstedt\">Jesper Wallstedt</a>. <a href=\"http://www.espn.com/nhl/player/_/id/3942335/kirill-kaprizov\">Kirill Kaprizov</a> had three assists, and Yurov added an assist for a two-point night.\n\n\r\n              The Maple Leafs (8-11-2) have lost the first of five contests of what has turned into a disastrous six-game homestand to move to 1-7-0 over their last eight.\n\n\r\n              The Wild improved to 8-0-2 over their last 10 since last losing in regulation to the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> on Oct. 22.\n\n\r\n              <hl2>Up next</hl2>\r\n              Wild: At Boston on Saturday night.\n\n\r\n              Maple Leafs: Host Edmonton on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-13T03:01:35Z"}}