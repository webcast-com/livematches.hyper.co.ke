ot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:44"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"4024959","displayName":"Dante Fabbro","shortName":"D. Fabbro"},"type":"shooter"},{"athlete":{"id":"5174160","displayName":"Dennis Hildeby","shortName":"D. Hildeby"},"type":"saver"}]},{"id":"401892701000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Cole Sillinger Snap Shot saved by Dennis Hildeby","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:20"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"4874725","displayName":"Cole Sillinger","shortName":"C. Sillinger"},"type":"shooter"},{"athlete":{"id":"5174160","displayName":"Dennis Hildeby","shortName":"D. Hildeby"},"type":"saver"}]},{"id":"401892701000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Max Crozier Wrist Shot saved by Jet Greaves","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:23"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"20"},"participants":[{"athlete":{"id":"5104716","displayName":"Max Crozier","shortName":"M. Crozier"},"type":"shooter"},{"athlete":{"id":"4894366","displayName":"Jet Greaves","shortName":"J. Greaves"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1828","fullName":"Nationwide Arena","address":{"city":"Columbus","state":"OH","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1828.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":15101,"officials":[{"fullName":"Dan Kelly","displayName":"Dan Kelly","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Gord Dwyer","displayName":"Gord Dwyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Kyle Flemington","displayName":"Kyle Flemington","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Hagel scores twice as Lightning beat Blue Jackets 3-1 for 5th win in 6 games","description":"— Brandon Hagel had two goals and an assist and the Tampa Bay Lightning beat the Columbus Blue Jackets 3-1 on Thursday for their second victory in two nights and fifth in their last six games.","story":"COLUMBUS, Ohio -- — <a href=\"http://www.espn.com/nhl/player/_/id/4065019/brandon-hagel\">Brandon Hagel</a> had two goals and an assist and the <a href=\"http://www.espn.com/nhl/team/_/name/tb/tampa-bay-lightning\">Tampa Bay Lightning</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> 3-1 on Thursday for their second victory in two nights and fifth in their last six games.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042083/jake-guentzel\">Jake Guentzel</a> scored in his 700th NHL game and added an assist, and <a href=\"http://www.espn.com/nhl/player/_/id/2563060/nikita-kucherov\">Nikita Kucherov</a> had two assists a night after having a natural hat trick in an 8-3 victory in Buffalo. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5174160/dennis-hildeby\">Dennis Hildeby</a> stopped 28 shots for Tampa Bay, and joined Sean Burke as the only goalies in Lightning history with at least one standings point in each of their first five starts with the team.\n\n\r\n              The Blue Jackets have lost three straight. <a href=\"http://www.espn.com/nhl/player/_/id/4874919/matthew-knies\">Matthew Knies</a> scored his first goal since opening night, ending a 15-game drought. <a href=\"http://www.espn.com/nhl/player/_/id/4894366/jet-greaves\">Jet Greaves</a> stopped 25 shots for Columbus.\n\n\r\n              Hagel gave Tampa Bay the lead at 2:57 of the first period. Kucherov’s assist was his 16th against Columbus since Feb. 10, 2024, and extended his points streak against the Blue Jackets to eight games.\n\n\r\n              Knies pulled Columbus even with a power-play goal with 7:40 left in the first, giving him 12 goals and 19 points in 13 career games against the Lightning.\n\n\r\n              The goal also sparked a pair of fights off consecutive faceoffs, with <a href=\"http://www.espn.com/nhl/player/_/id/4064781/mathieu-olivier\">Mathieu Olivier</a> taking on <a href=\"http://www.espn.com/nhl/player/_/id/3067840/scott-sabourin\">Scott Sabourin</a> before <a href=\"http://www.espn.com/nhl/player/_/id/3942548/ryan-lomberg\">Ryan Lomberg</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4588188/jeffrey-viel\">Jeffrey Viel</a> dropped the gloves two seconds later.\n\n\r\n              The Lightning appeared to take the lead with 4:42 left in the second period, but Hagel’s goal was waved off for a high stick.\n\n\r\n              Guentzel put Tampa Bay ahead for good at 1:06 of the third period on a shot Greaves initially appeared to stop before the puck trickled under his pads. Hagel added the insurance goal at 7:41, his fifth in three games.\n\n\r\n              Blue Jackets forward <a href=\"http://www.espn.com/nhl/player/_/id/3041996/sean-monahan\">Sean Monahan</a> left the game after suffering an upper-body injury in the second period and did not return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Lightning: Host Detroit on Saturday night.\n\n\r\n              Blue Jackets: Host Philadelphia on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-13T02:55:34Z"}}