730561446","tiePercentage":0},{"homeWinPercentage":0.0579,"playId":"4018730561471","tiePercentage":0},{"homeWinPercentage":0.0561,"playId":"4018730561507","tiePercentage":0},{"homeWinPercentage":0.0615,"playId":"4018730561529","tiePercentage":0},{"homeWinPercentage":0.0633,"playId":"4018730561554","tiePercentage":0},{"homeWinPercentage":0.0661,"playId":"4018730561576","tiePercentage":0},{"homeWinPercentage":0.066,"playId":"4018730561589","tiePercentage":0},{"homeWinPercentage":0.1149,"playId":"4018730561602","tiePercentage":0},{"homeWinPercentage":0.1373,"playId":"4018730561634","tiePercentage":0},{"homeWinPercentage":0.1373,"playId":"4018730561665","tiePercentage":0},{"homeWinPercentage":0.1393,"playId":"4018730561672","tiePercentage":0},{"homeWinPercentage":0.1319,"playId":"4018730561718","tiePercentage":0},{"homeWinPercentage":0.1236,"playId":"4018730561742","tiePercentage":0},{"homeWinPercentage":0.133,"playId":"4018730561772","tiePercentage":0},{"homeWinPercentage":0.1331,"playId":"4018730561783","tiePercentage":0},{"homeWinPercentage":0.1126,"playId":"4018730561794","tiePercentage":0},{"homeWinPercentage":0.1022,"playId":"4018730561831","tiePercentage":0},{"homeWinPercentage":0.1477,"playId":"4018730561856","tiePercentage":0},{"homeWinPercentage":0.1569,"playId":"4018730561883","tiePercentage":0}],"gameInfo":{"venue":{"id":"3679","guid":"0febca4c-a926-3713-9088-240cc5db6e37","fullName":"Huntington Bank Field","address":{"city":"Cleveland","state":"OH","zipCode":"44114","country":"USA"},"grass":true,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3679.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3679.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":58342,"officials":[{"fullName":"Frank Steratore","displayName":"Frank Steratore","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":1},{"fullName":"Mark Pellis","displayName":"Mark Pellis","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":2},{"fullName":"Shawn Smith","displayName":"Shawn Smith","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":3},{"fullName":"Matt Edwards","displayName":"Matt Edwards","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":4},{"fullName":"Dominique Pender","displayName":"Dominique Pender","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":5},{"fullName":"Brett Bergman","displayName":"Brett Bergman","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":6},{"fullName":"Marcus Allen","displayName":"Marcus Allen","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":7}]},"article":{"headline":"Deshaun Watson throws for 312 yards against his old team as the Browns rally past the Texans 27-24","description":"— Deshaun Watson can talk all he wants about how playing the Houston Texans is just another game.","story":"CLEVELAND -- — <a href=\"http://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\">Deshaun Watson</a> can talk all he wants about how playing the <a href=\"http://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> is just another game.\n\n\r\n              His coach doesn’t quite believe him. Not after Watson's latest bit of last-minute thievery lifted the <a href=\"http://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a> to a thrilling 27-24 win over the Texans on Sunday.\n\n\r\n              “I don’t care what he says,” coach Todd Monken. “This meant a lot.” \n\n\r\n              And, perhaps more important to Watson, it might also say a lot about a group that's turning last-minute stunners into a habit.\n\n\r\n              “Everything is in our hands,” Watson said.\n\n\r\n              Those hands are getting increasingly comfortable when things get tight. \n\n\r\n              The Browns improved to 6-4 by snapping a two-game losing streak, with all six wins coming by four points or fewer, and all of them featuring go-ahead, fourth-quarter drives by led Watson. <a href=\"http://www.espn.com/nfl/player/_/id/4685702/quinshon-judkins\">Quinshon Judkins</a> capped a rally from an early 17-point deficit when he <a href=\"https://nam12.safelinks.protection.outlook.com/?url=https%3A%2F%2Fx.com%2Fbrowns%2Fstatus%2F2122072963629375833%3Fs%3D46&data=05%7C02%7Cwgraves%40ap.org%7C636dc1e8300b417bb9b408df435df9db%7Ce442e1abfd6b4ba3abf3b020eb50df37%7C1%7C0%7C639303743038336552%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=gBsW8NuWzq8sQwG6gvLlaiTgX8HdwADI3%2FwL7qYPcEs%3D&reserved=0\">barreled into the end zone from 5 yards</a> out with 53 seconds remaining.\n\n\r\n              Asked how his team keeps finding ways to win, Monken just shook his head.\n\n\r\n              “I don’t have the end of the story,” the first-year coach said after the Browns improved to 4-0 at home for the first time since 1963. “I just know if our guys keep fighting, keep battling, keep scratching and clawing, they always have a chance.”\n\n\r\n              It helps that Watson has revived his career this season.\n\n\r\n              Four-plus years after being acquired from Houston <a href=\"https://apnews.com/article/cleveland-browns-nfl-sports-lifestyle-deshaun-watson-4d4778a1967b48875544d214aa972dd8\">in a staggering deal</a> that seemed destined to be among the most franchise-crippling in league history <a href=\"https://apnews.com/article/deshaun-watson-cleveland-browns-jaguars-73410af2fffa5ea8b2298b42e1debf20\">due to Watson's injuries</a>, ineffective play and <a href=\"https://apnews.com/article/deshaun-watson-lawsuit-browns-b8363bddc1b70e367a94474d898de4ac\">off-the-field issues</a> stemming from his time with the Texans, the 31-year-old is playing like the difference-maker the Browns have long needed at the game's most important position.\n\n\r\n              Watson passed for 312 yards, rushed for 50 more — including a high-stepping 6-yard touchdown run — and shook off a fourth-quarter interception to send the Browns into their bye week on a high.\n\n\r\n              “This is what I’ve been working on, working for, my whole career,” Watson said, later adding, “People create stories and narratives. But my actions speak louder than my words.”\n\n\r\n              Trailing by four with less than two minutes to go, Watson guided the Browns 49 yards in just three plays. An unnecessary roughness penalty on Houston cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4602699/kamari-lassiter\">Kamari Lassiter</a> for hitting a defenseless <a href=\"http://www.espn.com/nfl/player/_/id/4241424/tylan-wallace\">Tylan Wallace</a> moved the ball 15 yards.\n\n\r\n              “I don’t know what I’m supposed to do,” Lassiter said. “Am I supposed to let him catch it? I’m just trying to rip the ball out of his hands. We play a violent sport.”\n\n\r\n              A 30-yard catch-and-run by tight end <a href=\"http://www.espn.com/nfl/player/_/id/5083076/harold-fannin-jr\">Harold Fannin Jr</a>. moved the Browns to the 5, and Judkins did the rest.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4432577/cj-stroud\">C.J. Stroud</a> passed for 211 yards with three touchdowns and an interception for Houston (3-6), which looked unstoppable early and inept late.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4258173/nico-collins\">Nico Collins</a> caught nine passes for 94 yards and a score for the Texans, who began the season with Super Bowl aspirations but now have little margin for error after another baffling loss.\n\n\r\n              “We ain’t got no more time,” safety <a href=\"http://www.espn.com/nfl/player/_/id/4431517/calen-bullock\">Calen Bullock</a> said. “No time and no more excuses. Every game is a playoff game for us.”\n\n\r\n              Houston seemed poised to take another step toward digging out of the hole it created with an 0-4 start. The Texans were dominant during the opening 20 minutes.\n\n\r\n              Playing without edge rusher <a href=\"http://www.espn.com/nfl/player/_/id/2976560/danielle-hunter\">Danielle Hunter</a>, three-time Pro Bowl guard <a href=\"http://www.espn.com/nfl/player/_/id/3045474/wyatt-teller\">Wyatt Teller</a> and wide receiver <a href=\"http://www.espn.com/nfl/player/_/id/4432708/marvin-harrison-jr\">Marvin Harrison Jr</a>., the defense harassed Watson while Stroud led an offense that ripped off big play after big play.\n\n\r\n              And then it all vanished. The Texans, who racked up 194 yards on their first three drives, managed just 96 the rest of the way.\n\n\r\n              “They've come back on a lot of teams this season and won a lot of games with two-minute drives,” Stroud said. “We knew what it was. We were just dead.”\n\n\r\n              Still, Houston appeared in position to pull it out after Stroud <a href=\"https://nam12.safelinks.protection.outlook.com/?url=https%3A%2F%2Fx.com%2FNFL%2Fstatus%2F2122066423325626531%2Fvideo%2F1%3Fs%3D46&data=05%7C02%7Cwgraves%40ap.org%7C636dc1e8300b417bb9b408df435df9db%7Ce442e1abfd6b4ba3abf3b020eb50df37%7C1%7C0%7C639303743038356565%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=jkl8mFqCH1Ed%2FxOkHgfWh8thI1TQbJfMrw%2BDiW6ls9w%3D&reserved=0\">hit <a href=\"http://www.espn.com/nfl/player/_/id/3117256/dalton-schultz\">Dalton Schultz</a></a> for an 11-yard touchdown with 9:20 to go. Cleveland's next two drives ended with a punt and a pick by Watson.\n\n\r\n              But when Houston's defense — thought to be the team's biggest strength — needed one more stop, it faltered again.\n\n\r\n              And the Browns and their quarterback, who may finally be shedding the “embattled” moniker that has followed him since he arrived in Cleveland, delivered again.\n\n\r\n              The player who seemed to be on the cusp of being run out of town is now a leading candidate for Comeback Player of the Year.\n\n\r\n              “Even three months ago, people wasn’t even talking about that,” Watson said. “Just again, another opportunity for me to prove myself right and prove everybody else wrong. I believe in myself, and I believe in the people around me, and I’m going to continue to do that.”\n\n\r\n              <hl2>Injuries</hl2>\r\n              Texans: RB <a href=\"http://www.espn.com/nfl/player/_/id/4429059/woody-marks\">Woody Marks</a> ran for 50 yards in little over a half before being placed in the concussion protocol in the third after absorbing a helmet-to-helmet hit.\n\n\r\n              Brown: DE <a href=\"http://www.espn.com/nfl/player/_/id/3115336/derek-barnett\">Derek Barnett</a> left in the first quarter with a hamstring injury.\n\n\r\n              <hl2>Up next</hl2>\r\n              Texans: Host Indianapolis on Thursday night. \n\n\r\n              Browns: Off next week, then welcome Las Vegas on Nov. 29.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-11-15T21:39:46Z"}}