ore":0,"text":"Takeaway by Cale Makar","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"0:54"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"4233563","displayName":"Cale Makar","shortName":"C. Makar"},"type":"taker"}]},{"id":"401892698000000660","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jaden Schwartz Wrist Shot saved by Linus Ullmark","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"0:58"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"5835","displayName":"Jaden Schwartz","shortName":"J. Schwartz"},"type":"shooter"},{"athlete":{"id":"3069285","displayName":"Linus Ullmark","shortName":"L. Ullmark"},"type":"saver"}]},{"id":"401892698000000070","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Goalie Stopped","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"1:01"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892698000000670","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dylan Cozens faceoff won against Brock Nelson","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"1:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"14"},"participants":[{"athlete":{"id":"4565228","displayName":"Dylan Cozens","shortName":"D. Cozens"},"type":"face-off-winner"},{"athlete":{"id":"5798","displayName":"Brock Nelson","shortName":"B. Nelson"}}]},{"id":"401892698000000910","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by T.J. Hughes","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:26"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"17"},"participants":[{"athlete":{"id":"5136616","displayName":"T.J. Hughes","shortName":"T.J. Hughes"},"type":"giver"}]}],"gameInfo":{"venue":{"id":"1832","fullName":"Canadian Tire Centre","address":{"city":"Ottawa","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1832.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":16289,"officials":[{"fullName":"Kelly Sutherland","displayName":"Kelly Sutherland","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Mark Shewchyk","displayName":"Mark Shewchyk","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Julien Fournier","displayName":"Julien Fournier","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Avs lose MacKinnon, Makar to injury in 4-3 overtime loss at Ottawa","description":"— Shane Pinto celebrated his 26th birthday by scoring his second goal of the game 2:08 into overtime and the Ottawa Senators beat Colorado 4-3 on Thursday night after the Avalanche lost superstars Nathan MacKinnon and Cale Makar to injuries.","story":"OTTAWA, Ontario -- — <a href=\"http://www.espn.com/nhl/player/_/id/4565255/shane-pinto\">Shane Pinto</a> celebrated his 26th birthday by scoring his second goal of the game 2:08 into overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> beat Colorado 4-3 on Thursday night after the Avalanche lost superstars <a href=\"http://www.espn.com/nhl/player/_/id/3041969/nathan-mackinnon\">Nathan MacKinnon</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4233563/cale-makar\">Cale Makar</a> to injuries.\n\n\r\n              MacKinnon and Makar left in the second period because of lower-body injuries. MacKinnon left with just over eight minutes remaining after a check from <a href=\"http://www.espn.com/nhl/player/_/id/4712021/artem-zub\">Artem Zub</a> in the hip area and was seen grabbing his right side. Makar was injured moments earlier.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697384/tim-stutzle\">Tim Stutzle</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4271734/drake-batherson\">Drake Batherson</a> also scored for the Senators (12-6-2). <a href=\"http://www.espn.com/nhl/player/_/id/3069285/linus-ullmark\">Linus Ullmark</a> returned to the lineup for the first time since Oct. 21 and made 26 saves.\n\n\r\n              Arturi Lehkonen, <a href=\"http://www.espn.com/nhl/player/_/id/4392309/parker-kelly\">Parker Kelly</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2562609/gabriel-landeskog\">Gabriel Landeskog</a> scored for the Avalanche (11-6-3). <a href=\"http://www.espn.com/nhl/player/_/id/5622/scott-wedgewood\">Scott Wedgewood</a> stopped 22 shots.\n\n\r\n              The Senators tied it with 3:56 remaining in regulation when Batherson snagged a loose puck in the crease and buried his 10th of the season.\n\n\r\n              In OT, Pinto intercepted a pass in Colorado’s zone and fired in a wrist shot.\n\n\r\n              <hl2>Up next</hl2>\r\n              Avalanche: At Montreal on Saturday night.\n\n\r\n              Senators: At Pittsburgh on Saturday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-13T03:27:34Z"}}