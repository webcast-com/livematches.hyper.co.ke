rtName":"E. Pettersson"}}]}],"gameInfo":{"venue":{"id":"1833","fullName":"Rogers Arena","address":{"city":"Vancouver","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1833.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17156,"officials":[{"fullName":"Riley Brace","displayName":"Riley Brace","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Eric Furlatt","displayName":"Eric Furlatt","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jonny Murray","displayName":"Jonny Murray","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Kiel Murchison","displayName":"Kiel Murchison","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Glenn Gawdin scores his first 2 NHL goals in the Rangers' 5-1 victory over the Canucks","description":"— Glenn Gawdin scored his first two NHL goals in New York's four-goal second period and the Rangers won for the first time this season when allowing the first goal, beating the Vancouver Canucks 5-1 on Friday night.","story":"VANCOUVER, British Columbia -- — <a href=\"http://www.espn.com/nhl/player/_/id/3942352/glenn-gawdin\">Glenn Gawdin</a> scored his first two NHL goals in New York's four-goal second period and the Rangers won for the first time this season when allowing the first goal, beating the <a href=\"http://www.espn.com/nhl/team/_/name/van/vancouver-canucks\">Vancouver Canucks</a> 5-1 on Friday night.\n\n\r\n              The Rangers finished a four-game trip with three victories have won five of their last six to improve to 12-8-1. They were 0-7-1 when allowing the first goal before Friday.\n\n\r\n              The NHL-worst Canucks have dropped seven straight to fall to 3-17-1.\n\n\r\n              Playing his second NHL game of the season and 15th overall, the 29-year-old Gawdin made it 3-1 on a snap shot with seven minutes left in the second. He added the second with 3:50 to go in the period for a 5-1 advantage.\n\n\r\n              Gawdin is from the Vancouver suburb of Richmond. He was called up from Hartford of the American Hockey League on Tuesday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4697705/dylan-garand\">Dylan Garand</a> made 27 saves for New York.\n\n\r\n              Canucks center <a href=\"http://www.espn.com/nhl/player/_/id/4233566/elias-pettersson\">Elias Pettersson</a> opened the scoring on a tip with 7:47 left in the first period. <a href=\"http://www.espn.com/nhl/player/_/id/5149204/gabe-perreault\">Gabe Perreault</a> tied it with 1:13 remaining in the period.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042095/oliver-bjorkstrand\">Oliver Bjorkstrand</a> started the second-period spree with a power-play goal at 8:21. <a href=\"http://www.espn.com/nhl/player/_/id/4697382/alexis-lafreniere\">Alexis Lafreniere</a> also scored in the period.\n\n\r\n              Canucks winger <a href=\"http://www.espn.com/nhl/player/_/id/3899979/brock-boeser\">Brock Boeser</a> hit a milestone, assisting on Pettersson’s goal for the 500th point of his NHL career.\n\n\r\n              <hl2>Up next</hl2>\r\n              Rangers: Host Montreal on Monday night.\n\n\r\n              Canucks: At Vegas on Sunday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-14T04:57:34Z"}}