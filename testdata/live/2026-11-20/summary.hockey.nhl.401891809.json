Value":"1st"}},{"id":"401891809000000570","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Freddy Gaudreau faceoff won against Jordan Martinook","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"0:37"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"3149649","displayName":"Frederick Gaudreau","shortName":"F. Gaudreau"},"type":"face-off-winner"},{"athlete":{"id":"2989376","displayName":"Jordan Martinook","shortName":"J. Martinook"}}]},{"id":"401891809000000810","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Freddy Gaudreau hit Jordan Martinook","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"0:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"3149649","displayName":"Frederick Gaudreau","shortName":"F. Gaudreau"},"type":"hit-credited"},{"athlete":{"id":"2989376","displayName":"Jordan Martinook","shortName":"J. Martinook"},"type":"hitted"}]},{"id":"401891809000000640","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Seth Jarvis shot blocked by Ryker Evans","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4697396","displayName":"Seth Jarvis","shortName":"S. Jarvis"},"type":"shooter"},{"athlete":{"id":"4874864","displayName":"Ryker Evans","shortName":"R. Evans"},"type":"defender"}]},{"id":"401891809000000790","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Ryker Evans","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:08"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4874864","displayName":"Ryker Evans","shortName":"R. Evans"},"type":"giver"}]},{"id":"401891809000000650","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Seth Jarvis shot blocked by Freddy Gaudreau","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:10"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"124292"},"participants":[{"athlete":{"id":"4697396","displayName":"Seth Jarvis","shortName":"S. Jarvis"},"type":"shooter"},{"athlete":{"id":"3149649","displayName":"Frederick Gaudreau","shortName":"F. Gaudreau"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"11587","fullName":"Veikkaus Arena","address":{"city":"Helsinki","country":"Finland"},"grass":false,"images":[]},"attendance":12813,"officials":[{"fullName":"Francois St. Laurent","displayName":"Francois St. Laurent","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Jake Brenk","displayName":"Jake Brenk","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"James Tobias","displayName":"James Tobias","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Svechnikov and Jankowski each score twice, Carolina beats Kraken 5-1 to sweep series in Finland","description":"— Jordan Staal returned from injury, Andrei Svechnikov and Mark Jankowski each scored twice and the Carolina Hurricanes beat the Seattle Kraken 5-1 on Saturday to sweep the NHL’s Global Series in Finland’s capital.","story":"HELSINKI -- — <a href=\"http://www.espn.com/nhl/player/_/id/3541/jordan-staal\">Jordan Staal</a> returned from injury, <a href=\"http://www.espn.com/nhl/player/_/id/4352683/andrei-svechnikov\">Andrei Svechnikov</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2976849/mark-jankowski\">Mark Jankowski</a> each scored twice and the <a href=\"http://www.espn.com/nhl/team/_/name/car/carolina-hurricanes\">Carolina Hurricanes</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/sea/seattle-kraken\">Seattle Kraken</a> 5-1 on Saturday to sweep the NHL’s Global Series in Finland’s capital.\n\n\r\n              The Hurricanes (16-3-2) followed on their dominant <a href=\"https://apnews.com/article/hurricanes-kraken-score-5bff0dd8fc50afa59c3049ffc1d08b31\">4-1 victory</a> on Thursday and extended their winning streak to four.\n\n\r\n              Carolina became the first NHL franchise to win each of its first four regular-season games played outside North America following a sweep of a 2010 series against the <a href=\"http://www.espn.com/nhl/team/_/name/min/minnesota-wild\">Minnesota Wild</a>, also in Helsinki.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5103645/jackson-blake\">Jackson Blake</a> also scored for the Hurricanes, <a href=\"http://www.espn.com/nhl/player/_/id/3114741/nikolaj-ehlers\">Nikolaj Ehlers</a> had three assists and <a href=\"http://www.espn.com/nhl/player/_/id/3025662/shayne-gostisbehere\">Shayne Gostisbehere</a> had two assists and <a href=\"http://www.espn.com/nhl/player/_/id/4565259/pyotr-kochetkov\">Pyotr Kochetkov</a> stopped 12 shots for his 12th win in 13 games.\n\n\r\n              Svechnikov scored on power plays with two identical goals from the right circle in the middle period, one-timing a precise snap shot to make it 3-0 and another for a 4-1 advantage. He has five goals in his four-game point streak and has 11 goals on the season.\n\n\r\n              His second goal with 9:55 left in the second period prompted the Kraken to pull <a href=\"http://www.espn.com/nhl/player/_/id/3942073/joey-daccord\">Joey Daccord</a> after he allowed four goals on 14 shots. <a href=\"http://www.espn.com/nhl/player/_/id/5657/philipp-grubauer\">Philipp Grubauer</a> made 22 saves in relief.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4781552/matty-beniers\">Matty Beniers</a> scored for the Kraken (9-8-1) to reduce the deficit to 3-1.\n\n\r\n              Blake beat Daccord with a snap shot after <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a> sent him a backhand pass in between his legs in the first period. Blake extended his career-best point streak to 11 games.\n\n\r\n              Jankowski doubled that advantage with 2:30 left in the period. He added his second with 8:54 left in the final period, tapping in a precise pass from <a href=\"http://www.espn.com/nhl/player/_/id/5428/taylor-hall\">Taylor Hall</a>.\n\n\r\n              Staal, Carolina's captain, played his first game for the reigning champions after missing 14 following a calf tear on Oct 11. The 38-year-old center skated on the third line alongside wingers <a href=\"http://www.espn.com/nhl/player/_/id/4697396/seth-jarvis\">Seth Jarvis</a> and <a href=\"http://www.espn.com/nhl/player/_/id/2989376/jordan-martinook\">Jordan Martinook</a> and played 13:55.\n\n\r\n              The game Saturday was the 50th contested outside North America and ninth in Helsinki to tie Prague, with only Stockholm hosting more.\n\n\r\n              The NHL returns to Europe next month, this time to grow the fan base in Germany with a series between the <a href=\"http://www.espn.com/nhl/team/_/name/ott/ottawa-senators\">Ottawa Senators</a> and the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> in Düsseldorf on Dec. 18 and 20.\n\n\r\n              <hl2>Up next</hl2>\r\n              Kraken: Host Canucks on Thursday.\n\n\r\n              Hurricanes: Host Montreal on Thursday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-11-14T21:28:34Z"}}