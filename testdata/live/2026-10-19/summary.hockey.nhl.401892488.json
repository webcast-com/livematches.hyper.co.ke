y John Gibson","type":{"id":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"1:03"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3899978","displayName":"Timo Meier","shortName":"T. Meier"},"type":"shooter"},{"athlete":{"id":"2590824","displayName":"John Gibson","shortName":"J. Gibson"},"type":"saver"}]},{"id":"401892488000000630","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dawson Mercer Snap Shot High and Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:09"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"4697401","displayName":"Dawson Mercer","shortName":"D. Mercer"},"type":"shooter"},{"athlete":{"id":"2590824","displayName":"John Gibson","shortName":"J. Gibson"}}]},{"id":"401892488000000720","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Michael Brandsegg-Nygård hit Jonas Siegenthaler","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:12"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"5216883","displayName":"Michael Brandsegg-Nygard","shortName":"M. Brandsegg-Nygard"},"type":"hit-credited"},{"athlete":{"id":"3904190","displayName":"Jonas Siegenthaler","shortName":"J. Siegenthaler"},"type":"hitted"}]},{"id":"401892488000000840","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Giveaway by Alex DeBrincat","type":{"id":"1402","text":"Giveaway","abbreviation":"giveaway"},"clock":{"displayValue":"1:15"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"4063433","displayName":"Alex DeBrincat","shortName":"A. DeBrincat"},"type":"giver"}]},{"id":"401892488000000940","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Andreas Englund hit Evan Rodrigues","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"1:36"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"3114997","displayName":"Andreas Englund","shortName":"A. Englund"},"type":"hit-credited"},{"athlete":{"id":"3648008","displayName":"Evan Rodrigues","shortName":"E. Rodrigues"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"5404","guid":"6be97869-fecf-343e-bc15-c9fef2f0ced1","fullName":"Little Caesars Arena","address":{"city":"Detroit","state":"MI","zipCode":"48288","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5404.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18306,"officials":[{"fullName":"Wes McCauley","displayName":"Wes McCauley","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jordan Samuels-Thomas","displayName":"Jordan Samuels-Thomas","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Libor Suchanek","displayName":"Libor Suchanek","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Onni Hautamaki","displayName":"Onni Hautamaki","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Jack Hughes scores on a breakaway in OT, lifts Devils to a 5-4 win over Red Wings","description":"— Jack Hughes scored on a breakaway off a slick pass from Jesper Bratt early in overtime, lifting the ","story":"DETROIT -- — <a href=\"https://apnews.com/article/jack-hughes-teeth-hockey-dentists-97c5e8c02a9956d09ade2e59a79bf0d8\"><a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a></a> scored on a breakaway off a slick pass from <a href=\"http://www.espn.com/nhl/player/_/id/4268771/jesper-bratt\">Jesper Bratt</a> early in overtime, lifting the <a href=\"https://apnews.com/hub/new-jersey-devils\"><a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a></a> to a 5-4 win over the <a href=\"https://apnews.com/hub/detroit-red-wings\"><a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a></a> on Tuesday night.\n\n\r\n              New Jersey's <a href=\"http://www.espn.com/nhl/player/_/id/3648008/evan-rodrigues\">Evan Rodrigues</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4233555/nico-hischier\">Nico Hischier</a> and Bratt scored tiebreaking goals and <a href=\"http://www.espn.com/nhl/player/_/id/3042037/anthony-mantha\">Anthony Mantha</a> had a tying goal. <a href=\"http://www.espn.com/nhl/player/_/id/5111/jake-allen\">Jake Allen</a> stopped 22 shots for the Devils.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4063433/alex-debrincat\">Alex DeBrincat</a> had a pair of tying goals after Emmitt Finne and <a href=\"http://www.espn.com/nhl/player/_/id/5216883/michael-brandsegg-nygard\">Michael Brandsegg-Nygard</a> scored to give the Red Wings a 2-1 lead.\n\n\r\n              Detroit's <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> made 32 saves, including a kick save that denied <a href=\"http://www.espn.com/nhl/player/_/id/4915855/arseny-gritsyuk\">Arseny Gritsyuk</a> on an odd-man rush late in regulation to send the game to overtime.\n\n\r\n              The Red Wings got off to a rough start, getting outshot 16-0 midway through the first period. New Jersey, though, didn't take full advantage as Rodrigues scored its only goal in the opening period.\n\n\r\n              Finne scored on Detroit's third shot with 1:25 left in the first period and Brandsegg-Nygard scored on the team's next shot early in the second period.\n\n\r\n              The Devils, hoping to get back to the playoffs after finishing seventh in the division last year, acquired Rodrigues in a trade and signed Mantha — a former Red Wing — in free agency to boost their third line.\n\n\r\n              Detroit, meanwhile, had a shaky offseason.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114755/dylan-larkin\">Dylan Larkin</a> asked to be traded and the former captain is still on the team. <a href=\"https://apnews.com/article/nhl-training-camps-e5eb6ab0a68c38e2aff9aa103b4548ec\"><a href=\"http://www.espn.com/nhl/player/_/id/4874720/simon-edvinsson\">Simon Edvinsson</a></a>, a standout defenseman, remains unsigned as a restricted free agent.\n\n\r\n              Devils forward <a href=\"http://www.espn.com/nhl/player/_/id/4697446/luke-evangelista\">Luke Evangelista</a> was out with an illness after feeling worse throughout the game Monday night against Ottawa and was replaced by <a href=\"http://www.espn.com/nhl/player/_/id/2562623/stefan-noesen\">Stefan Noesen</a>. New Jersey defenseman <a href=\"http://www.espn.com/nhl/player/_/id/4587933/johnathan-kovacevic\">Johnathan Kovacevic</a> made his season debut after missing all of training camp recovering from knee surgery this past spring.\n\n\r\n              <hl2>Up next</hl2>\r\n              Devils: Host the <a href=\"http://www.espn.com/nhl/team/_/name/nyr/new-york-rangers\">New York Rangers</a> on Thursday night.\n\n\r\n              Red Wings: Host Philadelphia on Thursday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-14T00:48:27Z"}}