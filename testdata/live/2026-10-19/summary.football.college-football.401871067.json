tiePercentage":0},{"homeWinPercentage":0.4678,"playId":"401871067364","tiePercentage":0},{"homeWinPercentage":0.4812,"playId":"401871067369","tiePercentage":0},{"homeWinPercentage":0.4408,"playId":"401871067372","tiePercentage":0},{"homeWinPercentage":0.4407,"playId":"401871067379","tiePercentage":0},{"homeWinPercentage":0.4473,"playId":"401871067377","tiePercentage":0}],"gameInfo":{"venue":{"id":"3725","guid":"4b7e2309-d825-3689-abc1-f8a26e4973ca","fullName":"Johnny \"Red\" Floyd Stadium","address":{"city":"Murfreesboro","state":"TN","zipCode":"37130","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3725.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":8606},"article":{"headline":"Ryan Gagliano's 4 TDs power Middle Tennessee past Delaware 33-30 in Conference USA showdown","description":"— Roman Gagliano threw for 291 yards and three touchdowns and rushed for another score as Middle Tennessee rallied past Delaware 33-30 on Tuesday night.","story":"MURFREESBORO, Tenn. -- — <a href=\"http://www.espn.com/college-football/player/_/id/5194626/roman-gagliano\" target=\"_new\">Roman Gagliano</a> threw for 291 yards and three touchdowns and rushed for another score as Middle Tennessee rallied past Delaware 33-30 on Tuesday night.\n\n\r\n              The Blue Raiders (3-3, 1-1 Conference USA) trailed 30-26 in the fourth quarter before Gagliano led a 10-play, 93-yard drive and connected with <a href=\"http://www.espn.com/college-football/player/_/id/5217200/neo-clifton\" target=\"_new\">Neo Clifton</a> for a 14-yard touchdown with 3:06 remaining.\n\n\r\n              Delaware (2-4, 0-2) played without starting quarterback <a href=\"http://www.espn.com/college-football/player/_/id/5153846/nick-minicucci\" target=\"_new\">Nick Minicucci</a> for the second straight game. <a href=\"http://www.espn.com/college-football/player/_/id/5119568/tyler-bell\" target=\"_new\">Tyler Bell</a> threw for 306 yards and two touchdowns in his place.\n\n\r\n              Middle Tennessee took a 19-16 lead on the first play of the second half when Gagliano found <a href=\"http://www.espn.com/college-football/player/_/id/5383058/koraun-perdue\" target=\"_new\">Koraun Perdue</a> for an 80-yard touchdown. Bell answered with a 33-yard scoring pass to <a href=\"http://www.espn.com/college-football/player/_/id/5295765/josh-humes\" target=\"_new\">Josh Humes</a> before Gagliano connected with Clifton for an 18-yard touchdown.\n\n\r\n              Bell’s 23-yard touchdown pass to <a href=\"http://www.espn.com/college-football/player/_/id/4887640/kaderris-roberts\" target=\"_new\">Kaderris Roberts</a> gave Delaware a 30-26 lead with 9:57 left.\n\n\r\n              Delaware took a 16-12 halftime lead after <a href=\"http://www.espn.com/college-football/player/_/id/5166833/george-mullins\" target=\"_new\">George Mullins</a> intercepted Gagliano with 24 seconds remaining. <a href=\"http://www.espn.com/college-football/player/_/id/5157266/bryson-graves\" target=\"_new\">Bryson Graves</a> then threw a 15-yard touchdown pass to Bell.\n\n\r\n              Clifton caught four passes for 64 yards and two touchdowns, and Perdue had four catches for 103 yards and a score.\n\n\r\n              <hl2>Up next</hl2>\r\n              Middle Tennessee: At Florida International University next Tuesday.\n\n\r\n              Delaware: Hosts Missouri State next Tuesday.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-14T02:29:26Z"}}