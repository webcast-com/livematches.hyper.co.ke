ceoff"},"clock":{"displayValue":"1:30"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"5793","displayName":"Anders Lee","shortName":"A. Lee"},"type":"face-off-winner"},{"athlete":{"id":"3041994","displayName":"Elias Lindholm","shortName":"E. Lindholm"}}]},{"id":"401892457000000730","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Mason Lohrei shot blocked by Anders Lee","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"1:34"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"129764"},"participants":[{"athlete":{"id":"4697461","displayName":"Mason Lohrei","shortName":"M. Lohrei"},"type":"shooter"},{"athlete":{"id":"5793","displayName":"Anders Lee","shortName":"A. Lee"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1824","guid":"58cac4d0-a208-3028-b2a6-ff7aba657bc3","fullName":"TD Garden","address":{"city":"Boston","state":"MA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1824.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17850,"officials":[{"fullName":"Francis Charron","displayName":"Francis Charron","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Ryan Jackson","displayName":"Ryan Jackson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Joe Mahon","displayName":"Joe Mahon","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Stephen Hiff","displayName":"Stephen Hiff","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Pastrnak scores 2 goals, adds 2 assists in the Bruins' 6-1 rout of the Mammoth","description":"— David Pastrnak scored his first two goals of the season and added two assists as the Boston Bruins routed the Utah Mammoth 6-1 in Thursday night.","story":"BOSTON -- — <a href=\"http://www.espn.com/nhl/player/_/id/3114778/david-pastrnak\">David Pastrnak</a> scored his first two goals of the season and added two assists as the <a href=\"http://www.espn.com/nhl/team/_/name/bos/boston-bruins\">Boston Bruins</a> routed the <a href=\"http://www.espn.com/nhl/team/_/name/utah/utah-mammoth\">Utah Mammoth</a> 6-1 in Thursday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5080221/matthew-poitras\">Matthew Poitras</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4233575/casey-mittelstadt\">Casey Mittelstadt</a>, <a href=\"http://www.espn.com/nhl/player/_/id/4697461/mason-lohrei\">Mason Lohrei</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4268466/morgan-geekie\">Morgan Geekie</a> also scored for the Bruins, who led 3-0 after one period and 6-0 after two. <a href=\"http://www.espn.com/nhl/player/_/id/4712036/jeremy-swayman\">Jeremy Swayman</a> made 36 saves.\n\n\r\n              Pastrnak scored his first goal with 5:38 left in the first period on a power-play wrist shot, assisted by <a href=\"http://www.espn.com/nhl/player/_/id/5103647/frederic-brunet\">Frederic Brunet</a> and Geekie. He tacked on a power-play slap shot 4:40 into the second period, assisted by Geekie and <a href=\"http://www.espn.com/nhl/player/_/id/2968818/hampus-lindholm\">Hampus Lindholm</a>.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4755695/jack-mcbain\">Jack McBain</a> scored for the Mammoth midway through the third period to spoil Swayman's shutout bid.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3942065/karel-vejmelka\">Karel Vejmelka</a> stopped 11 of 14 shots he faced before he was replaced by <a href=\"http://www.espn.com/nhl/player/_/id/4874732/sebastian-cossa\">Sebastian Cossa</a>, who made five saves for the Mammoth.\n\n\r\n              The Bruins scored three power-play goals, while the Mammoth went scoreless on the power play. The Bruins blocked 23 shots in the win.\n\n\r\n              <hl2>Up next</hl2>\r\n              Utah: Visits the <a href=\"http://www.espn.com/nhl/team/_/name/buf/buffalo-sabres\">Buffalo Sabres</a> on Saturday night.\n\n\r\n              Boston: Hosts the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> on Saturday.\n\n\r\n              ------\n\n\r\n              The Associated Press created this story using technology provided by <a href=\"https://www.dataskrive.com/\">Data Skrive</a> and data from <a href=\"https://www.sportradar.com/\">Sportradar</a>.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-09T02:02:26Z"}}