ge":0.7984,"playId":"4018729801630","tiePercentage":0},{"homeWinPercentage":0.8034,"playId":"4018729801640","tiePercentage":0},{"homeWinPercentage":0.7876,"playId":"4018729801680","tiePercentage":0},{"homeWinPercentage":0.7785,"playId":"4018729801703","tiePercentage":0},{"homeWinPercentage":0.7637,"playId":"4018729801726","tiePercentage":0},{"homeWinPercentage":0.7575,"playId":"4018729801749","tiePercentage":0},{"homeWinPercentage":0.7933,"playId":"4018729801775","tiePercentage":0},{"homeWinPercentage":0.7711,"playId":"4018729801809","tiePercentage":0},{"homeWinPercentage":0.7795,"playId":"4018729801831","tiePercentage":0},{"homeWinPercentage":0.8005,"playId":"4018729801854","tiePercentage":0},{"homeWinPercentage":0.8002,"playId":"4018729801871","tiePercentage":0}],"gameInfo":{"venue":{"id":"3687","guid":"a6d02626-ee51-3e35-98f1-2b05c0b9b2b3","fullName":"AT&T Stadium","address":{"city":"Arlington","state":"TX","zipCode":"76011","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nfl/day/3687.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]},{"href":"https://a.espncdn.com/i/venues/nfl/day/interior/3687.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":92351,"officials":[{"fullName":"Dana McKenzie","displayName":"Dana McKenzie","position":{"name":"Down Judge","displayName":"Down Judge","id":"112"},"order":2},{"fullName":"Terrence Miles","displayName":"Terrence Miles","position":{"name":"Back Judge","displayName":"Back Judge","id":"110"},"order":1},{"fullName":"Mearl Robinson","displayName":"Mearl Robinson","position":{"name":"Field Judge","displayName":"Field Judge","id":"111"},"order":3},{"fullName":"Anthony Jeffries","displayName":"Anthony Jeffries","position":{"name":"Side Judge","displayName":"Side Judge","id":"115"},"order":4},{"fullName":"Terry Killens Jr.","displayName":"Terry Killens Jr.","position":{"name":"Umpire","displayName":"Umpire","id":"116"},"order":5},{"fullName":"Thomas Eaton","displayName":"Thomas Eaton","position":{"name":"Line Judge","displayName":"Line Judge","id":"113"},"order":6},{"fullName":"Alex Moore","displayName":"Alex Moore","position":{"name":"Referee","displayName":"Referee","id":"114"},"order":7}]},"article":{"headline":"Bucky Irving and rookie QB Jalon Daniels help Bucs beat sloppy Cowboys 24-16 for 1st win of season","description":"— Bucky Irving already had his first 100-yard game since his rookie year in 2024 when the Tampa Bay running back finished off the Dallas Cowboys with a run that gave him a career high.","story":"ARLINGTON, Texas -- — <a href=\"http://www.espn.com/nfl/player/_/id/4596448/bucky-irving\">Bucky Irving</a> already had his first 100-yard game since his rookie year in 2024 when the Tampa Bay running back finished off the <a href=\"http://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a> with a run that gave him a career high.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/4596472/jalon-daniels\">Jalon Daniels</a>, the undrafted rookie filling in for franchise quarterback <a href=\"http://www.espn.com/nfl/player/_/id/3052587/baker-mayfield\">Baker Mayfield</a>, enjoyed the view while doing plenty himself to get the Buccaneers their first win of the season in just his second start. \n\n\r\n              Irving ran for 165 yards, including <a href=\"https://x.com/NFL/status/2108376113613251048\">a 72-yard run</a> to set up the touchdown that put Tampa Bay ahead for good while scoring twice himself, and the Buccaneers beat the Cowboys 24-16 on Thursday night.\n\n\r\n              Daniels threw a TD pass to Irving in the first half while directing a turnover-free offense and amid several Dallas miscues, finishing an efficient 19 of 25 for 189 yards as the Bucs piled up 241 yards rushing.\n\n\r\n              Daniels is filling in for Baker Mayfield, who's expected to be sidelined at least one more game with a dislocated thumb on his throwing hand.\n\n\r\n              “Six months ago, if you would have told me that my first win would have been on a Thursday night, (Amazon) Prime football game, I don’t know what I would have told you,” said Daniels, who threw three interceptions in <a href=\"https://apnews.com/article/packers-buccaneers-score-36e890cc381bf056ab69c7099149c639\">a 17-14 loss to Green Bay</a> in his debut. “Like I keep saying, through all the highs and lows, the bads, the goods, go through every single emotion because at the end of the day, it makes you better and prepares you for any situation that comes down the line.”\n\n\r\n              Irving had 21 carries and a 7.9-yard average while scoring on a 5-yard pass and a 1-yard plunge as the Bucs (1-4) finally found some footing in a season that started with expectations of winning the NFC South.\n\n\r\n              “We lost the first quarter of the season,” Bucs coach Todd Bowles said. “We didn’t lose the second, third or fourth. We’ve still got to play those. So we started the second quarter tonight. It’s a long way to climb out, but at the same time, we’re upbeat and if we played as hard and played as effective, we’ll be OK.”\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/2577417/dak-prescott\">Dak Prescott</a> led a 99-yard drive and threw a 13-yard TD pass to <a href=\"http://www.espn.com/nfl/player/_/id/4426354/george-pickens\">George Pickens</a> in the fourth quarter before his second interception off a tipped pass helped Tampa Bay clinch the win in the final two minutes.\n\n\r\n              The Cowboys (2-3) continued an up-and-down start to the season, this time with an offense that was as times as sloppy as the defense has been in both seasons under coach Brian Schottenheimer.\n\n\r\n              “I didn’t plan on being 2-3, disappointed by that for sure,” Schottenheimer said. “But we’re just getting started. There’s a lot of football left and we’re gonna play better. We know that.”\n\n\r\n              After Irving's long run on the first play of the second half was followed by receiver <a href=\"http://www.espn.com/nfl/player/_/id/4567750/emeka-egbuka\">Emeka Egbuka</a>'s 14-yard TD run on a jet sweep, Prescott threw his first interception and the Dallas defense left <a href=\"http://www.espn.com/nfl/player/_/id/4608810/tez-johnson\">Tez Johnson</a> wide open on a 64-yard grab that led to Irving's 1-yard plunge for a 21-10 lead.\n\n\r\n              <a href=\"http://www.espn.com/nfl/player/_/id/3676833/kavontae-turpin\">KaVontae Turpin</a>'s fumble on the subsequent kickoff led to a Tampa Bay field goal, but only after the Bucs converted a third-and-21 from the Dallas 48-yard line with Daniels' 21-yard pass to Egbuka. \n\n\r\n              The Cowboys were missing one of the pieces they recently added to try to fix a porous defense. Cornerback <a href=\"http://www.espn.com/nfl/player/_/id/4426506/joey-porter-jr\">Joey Porter Jr</a>. was a late scratch in what was supposed to be his second appearance since arriving in a trade from Pittsburgh last week.\n\n\r\n              Prescott was 24 of 42 for 316 yards in his first two-interception game of the season — his first picks since the opener.\n\n\r\n              <hl2>Bucs have long and short TD drives</hl2>\r\n              Irving's 5-yard TD catch capped a 15-play, 73-yard drive that ran the final 10:44 off the clock in the first quarter and had a final count of 10:58. Then his 72-yard run was the first of two plays on an 86-yard drive that took exactly 1 minute.\n\n\r\n              <hl2>Feast, then famine for Lamb</hl2>\r\n              Dallas receiver <a href=\"http://www.espn.com/nfl/player/_/id/4241389/ceedee-lamb\">CeeDee Lamb</a> followed his career high of 17 catches, when he had 189 yards receiving and a touchdown last weekend against Houston, with just two catches for 9 yards on five targets. He was targeted 21 times against the Texans. Lamb exited the game with a quadriceps injury.\n\n\r\n              <hl2>Injuries</hl2>\r\n              Buccaneers: LT <a href=\"http://www.espn.com/nfl/player/_/id/4240589/tristan-wirfs\">Tristan Wirfs</a> was sidelined by cramps in the second half.\n\n\r\n              Cowboys: LT <a href=\"http://www.espn.com/nfl/player/_/id/4609048/tyler-guyton\">Tyler Guyton</a> left with a back issue in the second half. ... DB <a href=\"http://www.espn.com/nfl/player/_/id/4595352/alijah-clark\">Alijah Clark</a> exited with a hamstring injury in the first half and didn't return.\n\n\r\n              <hl2>Up next</hl2>\r\n              Buccaneers: Home against Pittsburgh on Oct. 18.\n\n\r\n              Cowboys: At Green Bay on Oct. 18.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nfl\">See AP’s full NFL coverage here</a>","published":"2026-10-09T03:33:39Z"}}