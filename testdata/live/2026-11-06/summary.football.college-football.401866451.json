2714,"playId":"401866451266","tiePercentage":0},{"homeWinPercentage":0.2569,"playId":"401866451270","tiePercentage":0},{"homeWinPercentage":0.2565,"playId":"401866451275","tiePercentage":0},{"homeWinPercentage":0.2453,"playId":"401866451279","tiePercentage":0},{"homeWinPercentage":0.253,"playId":"401866451282","tiePercentage":0},{"homeWinPercentage":0.2464,"playId":"401866451285","tiePercentage":0},{"homeWinPercentage":0.3257,"playId":"401866451289","tiePercentage":0},{"homeWinPercentage":0.3344,"playId":"401866451298","tiePercentage":0},{"homeWinPercentage":0.3307,"playId":"401866451301","tiePercentage":0},{"homeWinPercentage":0.2983,"playId":"401866451305","tiePercentage":0},{"homeWinPercentage":0.2927,"playId":"401866451308","tiePercentage":0},{"homeWinPercentage":0.3009,"playId":"401866451312","tiePercentage":0},{"homeWinPercentage":0.2783,"playId":"401866451315","tiePercentage":0},{"homeWinPercentage":0.2623,"playId":"401866451319","tiePercentage":0},{"homeWinPercentage":0.2477,"playId":"401866451323","tiePercentage":0},{"homeWinPercentage":0.2519,"playId":"401866451327","tiePercentage":0},{"homeWinPercentage":0.2742,"playId":"401866451332","tiePercentage":0},{"homeWinPercentage":0.276,"playId":"401866451339","tiePercentage":0},{"homeWinPercentage":0.29,"playId":"401866451337","tiePercentage":0},{"homeWinPercentage":0.2083,"playId":"401866451343","tiePercentage":0}],"gameInfo":{"venue":{"id":"3757","guid":"a4e25b2c-6a94-3b3c-93b5-c3147fdf8f1f","fullName":"Hornet Stadium","address":{"city":"Sacramento","state":"CA","zipCode":"95819","country":"USA"},"grass":false,"images":[]},"attendance":9931},"article":{"headline":"Isaiah Ene helps Sacramento State beat Kent State 31-10 for first MAC win","description":"— Freshman Isaiah Ene had a career-high 107 yards rushing and two touchdowns on 19 carries, Donovan Turner returned an interception 36-yards for a score and Sacramento State beat Kent State on Friday night to win its first Mid-American Conference game.","story":"SACRAMENTO, Calif. -- — Freshman <a href=\"http://www.espn.com/college-football/player/_/id/5161820/isaiah-ene\" target=\"_new\">Isaiah Ene</a> had a career-high 107 yards rushing and two touchdowns on 19 carries, <a href=\"http://www.espn.com/college-football/player/_/id/4916957/donovan-turner\" target=\"_new\">Donovan Turner</a> returned an interception 36-yards for a score and Sacramento State beat Kent State on Friday night to win its first Mid-American Conference game. \n\n\r\n              Sacramento State (2-7. 1-5) is in its first season at the Bowl Subdivision level, moving from the Big Sky Conference to the MAC. The Hornets snapped a six-game losing streak (by an average of 30 points). \n\n\r\n              Ene ran off left tackle, stepped out of a would-be tackle near the 30 and juked another defender just inside the 20 as he raced the end zone for a 35-yard touchdown. The 5-foot-8, 212-pound freshman then ran in the 2-point conversion that made it 17-10 with 2:58 left in the third quarter and gave Sacramento State its first second-half lead against an FBS opponent this season. \n\n\r\n              DeShields hit <a href=\"http://www.espn.com/college-football/player/_/id/5147053/wayne-harris\" target=\"_new\">Wayne Harris</a> near midfield on his way to a <a href=\"https://x.com/KentStFootball/status/2116365508086059381\">92-yard touchdown</a> that gave Kent State (3-6, 2-3) a 7-0 lead midway through the first quarter. <a href=\"http://www.espn.com/college-football/player/_/id/5194691/tommy-newcomb\" target=\"_new\">Tommy Newcomb</a> kicked a 29-yard field goal as time expired that made it 10-6 at halftime. \n\n\r\n              The Golden Flashes are 0-5 on the road this season. \n\n\r\n              Turner's pick-6 made it a 14-point game with 9:04 to play, the first of five straight Golden Flashes turnovers (one on downs) to end the game. <a href=\"http://www.espn.com/college-football/player/_/id/4718461/miles-bailey\" target=\"_new\">Miles Bailey</a> recovered fumbles by <a href=\"http://www.espn.com/college-football/player/_/id/5119841/dru-deshields\" target=\"_new\">Dru DeShields</a> to end Kent State's next two possessions forced by <a href=\"http://www.espn.com/college-football/player/_/id/4696984/xavier-williams\" target=\"_new\">Xavier Williams</a>' strip-sack and <a href=\"http://www.espn.com/college-football/player/_/id/5152799/fata-puloka\" target=\"_new\">Fata Puloka</a>'s punchout before <a href=\"http://www.espn.com/college-football/player/_/id/5227272/malikai-nichols\" target=\"_new\">Malikai Nichols</a>' first career interception with 1:55 left. \n\n\r\n              Ene's 5-yard rushing TD capped the scoring with 2:55 left. \n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/5158467/grant-meadors\" target=\"_new\">Grant Meadors</a> made field goals of 42, 28 and 36 yards for Sacramento State. \n\n\r\n              <hl2>Up next </hl2>\r\n              Sacramento State: Hosts Toledo on Wednesday. \n\n\r\n              Kent State: Visits Bowling Green on Nov. 10. \n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here</a>","published":"2026-10-31T06:26:45Z"}}