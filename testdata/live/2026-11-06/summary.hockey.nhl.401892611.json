coreValue":0,"awayScore":0,"homeScore":0,"text":"Takeaway by Arseny Gritsyuk","type":{"id":"1401","text":"Takeaway","abbreviation":"takeaway"},"clock":{"displayValue":"1:15"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"4915855","displayName":"Arseny Gritsyuk","shortName":"A. Gritsyuk"},"type":"taker"}]},{"id":"401892611000000090","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Off-side","type":{"id":"516","text":"Stoppage","abbreviation":"stoppage"},"clock":{"displayValue":"2:05"},"period":{"number":1,"displayValue":"1st"}},{"id":"401892611000000770","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Evan Rodrigues faceoff won against Brett Howden","type":{"id":"502","text":"Face Off","abbreviation":"faceoff"},"clock":{"displayValue":"2:05"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"11"},"participants":[{"athlete":{"id":"3648008","displayName":"Evan Rodrigues","shortName":"E. Rodrigues"},"type":"face-off-winner"},{"athlete":{"id":"4024989","displayName":"Brett Howden","shortName":"B. Howden"}}]},{"id":"401892611000001030","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Jeremy Lauzon hit Evan Rodrigues","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"2:46"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"3904185","displayName":"Jeremy Lauzon","shortName":"J. Lauzon"},"type":"hit-credited"},{"athlete":{"id":"3648008","displayName":"Evan Rodrigues","shortName":"E. Rodrigues"},"type":"hitted"}]},{"id":"401892611000001040","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Marc Gatcomb hit Jonas Siegenthaler","type":{"id":"503","text":"Hit","abbreviation":"hit"},"clock":{"displayValue":"3:11"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"37"},"participants":[{"athlete":{"id":"5103547","displayName":"Marc Gatcomb","shortName":"M. Gatcomb"},"type":"hit-credited"},{"athlete":{"id":"3904190","displayName":"Jonas Siegenthaler","shortName":"J. Siegenthaler"},"type":"hitted"}]}],"gameInfo":{"venue":{"id":"5060","guid":"6ed1cdfd-5472-3076-b4de-7c38f29e395b","fullName":"T-Mobile Arena","address":{"city":"Las Vegas","state":"NV","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5060.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17615,"officials":[{"fullName":"Frederick L'Ecuyer","displayName":"Frederick L'Ecuyer","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Garrett Rank","displayName":"Garrett Rank","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Bevan Mills","displayName":"Bevan Mills","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Hellebuyck stops 19 shots in 5-2 victory over Golden Knights, wins 2nd straight since joining Devils","description":"— Connor Hellebuyck stopped 19 shots, Arseny Gritsyuk and Jack Hughes each scored twice and the New Jersey Devils beat the Vegas Golden Knights 5-2 on Friday.","story":"LAS VEGAS -- — <a href=\"http://www.espn.com/nhl/player/_/id/3020225/connor-hellebuyck\">Connor Hellebuyck</a> stopped 19 shots, <a href=\"http://www.espn.com/nhl/player/_/id/4915855/arseny-gritsyuk\">Arseny Gritsyuk</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4565222/jack-hughes\">Jack Hughes</a> each scored twice and the <a href=\"http://www.espn.com/nhl/team/_/name/nj/new-jersey-devils\">New Jersey Devils</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/vgk/vegas-golden-knights\">Vegas Golden Knights</a> 5-2 on Friday.\n\n\r\n              Hellebuyck, who spent his first 11 seasons in the NHL with the <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a>, had his second win since the Devils <a href=\"https://apnews.com/article/hellebuyck-trade-devils-jets-26c70cac1b23930670e1200f298ac80e\">acquired him Oct. 23</a>. The three-time Vezina Trophy also was in goal Tuesday night in Dallas in a 5-1 win.\n\n\r\n              Gritsyuk has scored at least a goal in six of the last eight games and has 10 points during the stretch. <a href=\"http://www.espn.com/nhl/player/_/id/4874719/luke-hughes\">Luke Hughes</a> also scored for New Jersey. The Devils improved to 10-1-0 when the Hughes brothers score in the same game.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5545/mark-stone\">Mark Stone</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114985/ivan-barbashev\">Ivan Barbashev</a> scored for the Golden Knights, and <a href=\"http://www.espn.com/nhl/player/_/id/3939714/adin-hill\">Adin Hill</a> stopped 26 shots.\n\n\r\n              Luke Hughes got things going early in the first when he rifled a one-timer from the top of the left circle past Hill.\n\n\r\n              Stone tied it when he deflected Mitch Marner’s blast from the point past Hellebuyck. Barbashev gave the Knights a 2-1 lead moments later when he tapped Marner’s pass home after a picture-perfect cross-crease pass.\n\n\r\n              The lead didn’t last one minute, as Gritsyuk took advantage of a turnover and sniped Hill top shelf from the left circle.\n\n\r\n              Jack Hughes put New Jersey back in front when he stole the puck from <a href=\"http://www.espn.com/nhl/player/_/id/3648002/jack-eichel\">Jack Eichel</a> in the neutral zone, then passed it to himself through Stone’s legs before beating Hill.\n\n\r\n              Gritsyuk scored his second goal by backhanding his rebound after Hill blocked his first attempt.\n\n\r\n              Hughes’ empty-net goal provided the final margin.\n\n\r\n              <hl2>UP NEXT</hl2>\r\n              Devils: Host Edmonton on Tuesday night.\n\n\r\n              Golden Knights: At Boston on Monday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-31T00:47:45Z"}}