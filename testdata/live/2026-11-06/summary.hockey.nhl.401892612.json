d":"506","text":"Shot","abbreviation":"shot-on-goal"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"26"},"participants":[{"athlete":{"id":"5103599","displayName":"Sandis Vilmanis","shortName":"S. Vilmanis"},"type":"shooter"},{"athlete":{"id":"4697683","displayName":"Nico Daws","shortName":"N. Daws"},"type":"saver"}]}],"gameInfo":{"venue":{"id":"1840","guid":"f00bda1b-21b7-372c-838c-b5c9977d1834","fullName":"Amerant Bank Arena","address":{"city":"Sunrise","state":"FL","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1840.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":19656,"officials":[{"fullName":"Tommy Hughes","displayName":"Tommy Hughes","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Peter MacDougall","displayName":"Peter MacDougall","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Libor Suchanek","displayName":"Libor Suchanek","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Brandon Blandina","displayName":"Brandon Blandina","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0}]},"article":{"headline":"Anton Lundell scores 3 goals, Seth Jones caps record month and Panthers beat reeling Jets 5-2","description":"— Anton Lundell had a hat trick, Seth Jones capped a record-setting month with a goal and two assists, and the Florida Panthers topped the reeling Winnipeg Jets 5-2 on Friday night for their sixth win in eight games.","story":"SUNRISE, Fla. -- — <a href=\"http://www.espn.com/nhl/player/_/id/4697395/anton-lundell\">Anton Lundell</a> had a hat trick, <a href=\"http://www.espn.com/nhl/player/_/id/3041992/seth-jones\">Seth Jones</a> capped a record-setting month with a goal and two assists, and the <a href=\"http://www.espn.com/nhl/team/_/name/fla/florida-panthers\">Florida Panthers</a> topped the reeling <a href=\"http://www.espn.com/nhl/team/_/name/wpg/winnipeg-jets\">Winnipeg Jets</a> 5-2 on Friday night for their sixth win in eight games.\n\n\r\n              Jones finished October with 18 points — two goals and 16 assists — to break the record for most points by a Florida defenseman in any month. Keith Yandle had 17 points for the Panthers in March 2018.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3114722/sam-reinhart\">Sam Reinhart</a> also scored for Florida.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3899952/kyle-connor\">Kyle Connor</a> had his team-best 11th goal for Winnipeg, which dropped both ends of a home-and-home with Florida this week and is winless in its last eight games — going 0-6-2 in that span. <a href=\"http://www.espn.com/nhl/player/_/id/4316970/morgan-barron\">Morgan Barron</a> had his first goal of the season midway through the third to get the Jets to 3-2, but Lundell's second of the night restored Florida's two-goal edge.\n\n\r\n              Lundell finished off the hat trick — Florida's fifth already this season — with an empty-netter with 1:39 left.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4587845/akira-schmid\">Akira Schmid</a> stopped 22 shots for Florida, which remains without standout forwards <a href=\"http://www.espn.com/nhl/player/_/id/3041970/aleksander-barkov\">Aleksander Barkov</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3852/brad-marchand\">Brad Marchand</a> because of injuries. Both resumed skating this week; Marchand could be back in about three weeks and Barkov in about four, Panthers coach Paul Maurice said.\n\n\r\n              Florida's <a href=\"http://www.espn.com/nhl/player/_/id/3939856/bokondji-imama\">Bokondji Imama</a> and Winnipeg's <a href=\"http://www.espn.com/nhl/player/_/id/4697648/tyrel-bauer\">Tyrel Bauer</a> brawled just 2:04 into the game, a reenactment of sorts of their still-talked-about fight in the AHL in 2024. They went at it for more than a minute Friday and — similar to what happened at the end of their fight two years ago — shared a respectful nod toward the other when it was over.\n\n\r\n              The Panthers entered Friday having played only three home games this season, the fewest in the NHL. More than half the league had logged at least seven home games going into the day.\n\n\r\n              <hl2>Up next</hl2>\r\n              Jets: At Carolina on Sunday.\n\n\r\n              Panthers: Host Detroit on Monday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-31T01:50:46Z"}}