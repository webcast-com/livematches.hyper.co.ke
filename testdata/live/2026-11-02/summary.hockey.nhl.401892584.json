lue":"1st"},"team":{"id":"6"},"participants":[{"athlete":{"id":"4587566","displayName":"Ty Emberson","shortName":"T. Emberson"},"type":"shooter"},{"athlete":{"id":"5302578","displayName":"Michal Postava","shortName":"M. Postava"},"type":"saver"}]},{"id":"401892584000001510","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Andrew Copp Backhand Wide Right","type":{"id":"507","text":"Missed","abbreviation":"shot-missed"},"clock":{"displayValue":"1:45"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"5"},"participants":[{"athlete":{"id":"3042114","displayName":"Andrew Copp","shortName":"A. Copp"},"type":"shooter"},{"athlete":{"id":"3042020","displayName":"Tristan Jarry","shortName":"T. Jarry"}}]}],"gameInfo":{"venue":{"id":"5282","fullName":"Rogers Place","address":{"city":"Edmonton","country":"Canada"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/5282.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":17043,"officials":[{"fullName":"Francis Charron","displayName":"Francis Charron","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Graham Skilliter","displayName":"Graham Skilliter","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Brandon Gawryletz","displayName":"Brandon Gawryletz","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"Travis Toomey","displayName":"Travis Toomey","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Raymond scores in shootout to lift Red Wings to 4-3 decision over Oilers","description":"— Lucas Raymond scored the only goal of the shootout and had a pair of assists in regulation as the Detroit Red Wings beat the Edmonton Oilers 4-3 on Monday night.","story":"EDMONTON, Alberta -- — <a href=\"http://www.espn.com/nhl/player/_/id/4697385/lucas-raymond\">Lucas Raymond</a> scored the only goal of the shootout and had a pair of assists in regulation as the <a href=\"http://www.espn.com/nhl/team/_/name/det/detroit-red-wings\">Detroit Red Wings</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/edm/edmonton-oilers\">Edmonton Oilers</a> 4-3 on Monday night.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3120307/viktor-arvidsson\">Viktor Arvidsson</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5188599/emmitt-finnie\">Emmitt Finnie</a> and <a href=\"http://www.espn.com/nhl/player/_/id/3114755/dylan-larkin\">Dylan Larkin</a> scored in regulation for the Red Wings, who went 2-1-1 on a four-game road trip.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/5302578/michal-postava\">Michal Postava</a> made 25 stops in regulation and three more in the shootout to earn the win in his first career start. The 24-year-old undrafted netminder from Czechia was appearing in his second career game, after replacing <a href=\"http://www.espn.com/nhl/player/_/id/2590824/john-gibson\">John Gibson</a> in the third period of a 5-2 win against Vancouver last Thursday.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4565231/vasily-podkolzin\">Vasily Podkolzin</a>, <a href=\"http://www.espn.com/nhl/player/_/id/5080179/isaac-howard\">Isaac Howard</a> and <a href=\"http://www.espn.com/nhl/player/_/id/4874940/colton-dach\">Colton Dach</a> scored for the Oilers, who have lost two straight as well as forward <a href=\"http://www.espn.com/nhl/player/_/id/5509/zach-hyman\">Zach Hyman</a> to what looked to be a concussion.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3042020/tristan-jarry\">Tristan Jarry</a> made 26 saves for Edmonton.\n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/3895074/connor-mcdavid\">Connor McDavid</a> had an assist to extend his season-starting points streak to 12 games, now with an NHL-best 34 points. He set a team record for most points before Nov. 1, and also matched the longest season-opening assist streak in NHL history, matching <a href=\"http://www.espn.com/nhl/player/_/id/3904173/sebastian-aho\">Sebastian Aho</a>, Ken Linseman and Wayne Gretzky.\n\n\r\n              Detroit fell behind three times and tied the game for a third time with 1:17 remaining in the third and their goalie pulled as a bouncing puck came to Larkin in front and he shoveled in his second of the season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Red Wings: Host the <a href=\"http://www.espn.com/nhl/team/_/name/chi/chicago-blackhawks\">Chicago Blackhawks</a> on Thursday night.\n\n\r\n              Oilers: Host the <a href=\"http://www.espn.com/nhl/team/_/name/cgy/calgary-flames\">Calgary Flames</a> on Wednesday night.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-27T04:59:48Z"}}