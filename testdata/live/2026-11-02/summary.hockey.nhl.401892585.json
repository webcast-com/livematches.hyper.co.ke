displayValue":"1:57"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"29"},"participants":[{"athlete":{"id":"5080211","displayName":"Luca Del Bel Belluz","shortName":"L. Del Bel Belluz"},"type":"face-off-winner"},{"athlete":{"id":"5173105","displayName":"Denver Barkey","shortName":"D. Barkey"}}]},{"id":"401892585000000830","scoringPlay":false,"scoreValue":0,"awayScore":0,"homeScore":0,"text":"Dmitri Voronkov shot blocked by Tyson Foerster","type":{"id":"508","text":"Blocked","abbreviation":"shot-blocked"},"clock":{"displayValue":"2:01"},"period":{"number":1,"displayValue":"1st"},"team":{"id":"15"},"participants":[{"athlete":{"id":"4915856","displayName":"Dmitri Voronkov","shortName":"D. Voronkov"},"type":"shooter"},{"athlete":{"id":"4697406","displayName":"Tyson Foerster","shortName":"T. Foerster"},"type":"defender"}]}],"gameInfo":{"venue":{"id":"1845","fullName":"Xfinity Mobile Arena","address":{"city":"Philadelphia","state":"PA","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/nhl/day/1845.jpg","width":2000,"height":1125,"alt":"","rel":["full","day"]}]},"attendance":18469,"officials":[{"fullName":"Matt MacPherson","displayName":"Matt MacPherson","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0},{"fullName":"TJ Luxmore","displayName":"TJ Luxmore","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Liam Maaskant","displayName":"Liam Maaskant","position":{"name":"Referee","displayName":"Referee","id":"24"},"order":0},{"fullName":"Jeremy Faucher","displayName":"Jeremy Faucher","position":{"name":"Linesman","displayName":"Linesman","id":"25"},"order":0}]},"article":{"headline":"Kent Johnson lifts Blue Jackets to 4-3 OT win after Flyers rally from 3-goal deficit","description":"— Kent Johnson scored his second goal of the game 2:22 into overtime and the Columbus Blue Jackets beat the Philadelphia Flyers 4-3 on Tuesday night after coughing up a three-goal lead.","story":"PHILADELPHIA -- — <a href=\"http://www.espn.com/nhl/player/_/id/4781553/kent-johnson\">Kent Johnson</a> scored his second goal of the game 2:22 into overtime and the <a href=\"http://www.espn.com/nhl/team/_/name/cbj/columbus-blue-jackets\">Columbus Blue Jackets</a> beat the <a href=\"http://www.espn.com/nhl/team/_/name/phi/philadelphia-flyers\">Philadelphia Flyers</a> 4-3 on Tuesday night after coughing up a three-goal lead.\n\n\r\n              Columbus scored three goals in a 2:46 span of the first period to lead 3-0 after one.\n\n\r\n              Johnson set up <a href=\"http://www.espn.com/nhl/player/_/id/5136617/adam-fantilli\">Adam Fantilli</a> for the first goal at 10:58 of the first period, and then deflected <a href=\"http://www.espn.com/nhl/player/_/id/3899972/zach-werenski\">Zach Werenski</a>'s shot past Flyers goalie <a href=\"http://www.espn.com/nhl/player/_/id/3942459/dan-vladar\">Dan Vladar</a> at 12:54. <a href=\"http://www.espn.com/nhl/player/_/id/5080156/denton-mateychuk\">Denton Mateychuk</a> scored for Columbus 50 seconds later. <a href=\"http://www.espn.com/nhl/player/_/id/5734/cam-talbot\">Cam Talbot</a> made 28 saves for his third win this season. \n\n\r\n              Johnson scored the overtime winner on a two-on-none breakaway, following a give-and-go with Fantilli. It was Johnson's sixth goal of the season. \n\n\r\n              Philadelphia forced overtime by outshooting Columbus 28-6 over the final two periods. \n\n\r\n              <a href=\"http://www.espn.com/nhl/player/_/id/4419682/noah-cates\">Noah Cates</a> scored his first goal of the season by poking a loose puck past Talbot, while <a href=\"http://www.espn.com/nhl/player/_/id/4565230/trevor-zegras\">Trevor Zegras</a> cut the deficit to 3-2 with just under five minutes left in regulation. Zegras slid a pass to <a href=\"http://www.espn.com/nhl/player/_/id/4697406/tyson-foerster\">Tyson Foerster</a>, who fired a shot on Talbot that <a href=\"http://www.espn.com/nhl/player/_/id/4697387/jamie-drysdale\">Jamie Drysdale</a> tipped into the net with 11 seconds remaining. \n\n\r\n              Vladar made 11 saves.\n\n\r\n              Despite losing consecutive games, the Flyers have scored points in four of five games after starting the season with a franchise-record nine-game winless streak. Columbus won consecutive games for the first time this season.\n\n\r\n              <hl2>Up next</hl2>\r\n              Blue Jackets: Continue their road trip in Carolina on Thursday.\n\n\r\n              Flyers: Travel to Washington to play the Capitals on Wednesday.\n\n\r\n              ------\n\n\r\n              \r\n                <a href=\"https://apnews.com/hub/nhl\">See AP’s full NHL coverage here</a>","published":"2026-10-28T02:17:45Z"}}