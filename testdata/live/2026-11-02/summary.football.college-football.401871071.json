ge":0.5775,"playId":"401871071304","tiePercentage":0},{"homeWinPercentage":0.5668,"playId":"401871071309","tiePercentage":0},{"homeWinPercentage":0.5902,"playId":"401871071314","tiePercentage":0},{"homeWinPercentage":0.5997,"playId":"401871071318","tiePercentage":0},{"homeWinPercentage":0.6051,"playId":"401871071323","tiePercentage":0},{"homeWinPercentage":0.6269,"playId":"401871071328","tiePercentage":0},{"homeWinPercentage":0.625,"playId":"401871071332","tiePercentage":0},{"homeWinPercentage":0.5759,"playId":"401871071337","tiePercentage":0},{"homeWinPercentage":0.5508,"playId":"401871071341","tiePercentage":0},{"homeWinPercentage":0.5553,"playId":"401871071345","tiePercentage":0},{"homeWinPercentage":0.5391,"playId":"401871071349","tiePercentage":0},{"homeWinPercentage":0.5511,"playId":"401871071354","tiePercentage":0},{"homeWinPercentage":0.5575,"playId":"401871071358","tiePercentage":0},{"homeWinPercentage":0.524,"playId":"401871071363","tiePercentage":0},{"homeWinPercentage":0.5298,"playId":"401871071368","tiePercentage":0},{"homeWinPercentage":0.4793,"playId":"401871071371","tiePercentage":0},{"homeWinPercentage":0.3845,"playId":"401871071376","tiePercentage":0},{"homeWinPercentage":0.3204,"playId":"401871071382","tiePercentage":0},{"homeWinPercentage":0.3155,"playId":"401871071390","tiePercentage":0},{"homeWinPercentage":0.3277,"playId":"401871071393","tiePercentage":0}],"gameInfo":{"venue":{"id":"3796","guid":"438f8cb6-06b5-30ee-968d-83e7837b9250","fullName":"Houchens Industries-L.T. Smith Stadium","address":{"city":"Bowling Green","state":"KY","zipCode":"42101","country":"USA"},"grass":false,"images":[{"href":"https://a.espncdn.com/i/venues/college-football/day/interior/3796.jpg","width":2000,"height":1125,"alt":"","rel":["full","day","interior"]}]},"attendance":12147},"article":{"headline":"Nick Minicucci throws for 414 yards and 4 TDs as Delaware beats Western Kentucky 35-21","description":"— Nick Minicucci threw for 414 yards and four touchdowns, with 183 yards and two scores going to Sean Wilson, and Delaware beat Western Kentucky 35-21 on Tuesday night to snap a seven-game road losing streak.","story":"BOWLING GREEN, Ky. -- — <a href=\"http://www.espn.com/college-football/player/_/id/5153846/nick-minicucci\" target=\"_new\">Nick Minicucci</a> threw for 414 yards and four touchdowns, with 183 yards and two scores going to <a href=\"http://www.espn.com/college-football/player/_/id/5152679/sean-wilson\" target=\"_new\">Sean Wilson</a>, and Delaware beat Western Kentucky 35-21 on Tuesday night to snap a seven-game road losing streak. \n\n\r\n              Minicucci, who matched Delaware’s single-game record with five passing touchdowns last week, set another program record against WKU for consecutive completions to start a game at 17 before finishing 32 of 38. Minicucci moved into fourth in program history with 6,459 career yards. \n\n\r\n              Wilson made nine catches for an average of 20.3 yards for Delaware (4-4, 2-2 Conference USA), which entered No. 1 in passing offence in the conference with 258.0 yards per game. Wilson's touchdown catches went for 21 and 40 yards. <a href=\"http://www.espn.com/college-football/player/_/id/4887640/kaderris-roberts\" target=\"_new\">Kaderris Roberts</a> and <a href=\"http://www.espn.com/college-football/player/_/id/5082971/jo-silver\" target=\"_new\">Jo Silver</a> also had a touchdown grab. \n\n\r\n              <a href=\"http://www.espn.com/college-football/player/_/id/4920158/brock-glenn\" target=\"_new\">Brock Glenn</a> was 25 of 37 for 224 yards with one touchdown and two interceptions for Western Kentucky (3-5, 2-2). He also carried it 17 times for 129 yards. <a href=\"http://www.espn.com/college-football/player/_/id/4878394/ajay-allen\" target=\"_new\">Ajay Allen</a> had 73 yards rushing and a score. \n\n\r\n              The first incomplete pass for either team — in 14 attempts — was an interception by Delaware CB <a href=\"http://www.espn.com/college-football/player/_/id/5327493/kevin-moore\" target=\"_new\">Kevin Moore</a> late in the first quarter. <a href=\"http://www.espn.com/college-football/player/_/id/5296322/aj-graham\" target=\"_new\">AJ Graham</a> also secured his first career interception on the first play of the fourth quarter deep in Delaware territory. \n\n\r\n              <hl2>Up next</hl2>\r\n              Delaware: Plays at Kennesaw State on Nov. 7.\n\n\r\n              Western Kentucky: Plays at Middle Tennessee on Nov. 7.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts</a> here. Visit <a href=\"https://apnews.com/hub/ap-top-25-college-football-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/college-football\">college football coverage here.</a>","published":"2026-10-28T02:40:57Z"}}